# QA environment — agent qa's federation stack.
# Bring up: docker compose -f environments/stack/docker-compose.yml --env-file environments/qa/.env -p qa up -d --build
#
# Port scheme: 30xxx block (dev1=1, dev2=2, qa=3).
#   +01 iris-a, +02 iris-b, +11 lemmy, +12 mastodon.

ENV_PREFIX=qa
# Build context = qa's worktree (this agent builds from its own branch).
REPO_ROOT=/workspace/.worktrees/qa

FQDN_IRIS_A=qa-iris-a.luit.ink
FQDN_IRIS_B=qa-iris-b.luit.ink
FQDN_MASTODON=qa-mastodon.luit.ink
FQDN_LEMMY=qa-lemmy.luit.ink

PORT_IRIS_A=30081
PORT_IRIS_B=30082
PORT_MASTODON=30092
PORT_LEMMY=30091

IRIS_DB_PASS=iris-qa-pw

MASTODON_DB_PASS=mastodon-qa-pw
MASTODON_SECRET_KEY_BASE=49d85ca63d8aaaedda6fc11118c4721410e35060fe408f5217fdfdaf106713c1fb4c2dbeca5f4e52788ab365b7fac3c028e65d4db220176c126a5233a112dfc9
MASTODON_AE_DETERMINISTIC_KEY=5d4d6c7fca3f4daaa7947295eafe596cde7d5f7ebcf517c1e74593098c7c33d07092a5d2bc1db61797aa92e17bc1bba0aa32ef48651e302792768dc2bbc17d9d
