# DEV2 environment — agent dev2's federation stack.
# Bring up: docker compose -f environments/stack/docker-compose.yml --env-file environments/dev2/.env -p dev2 up -d --build
#
# Port scheme: 20xxx block (dev1=1, dev2=2, qa=3).
#   +01 iris-a, +02 iris-b, +11 lemmy, +12 mastodon.

ENV_PREFIX=dev2
# Build context = dev2's worktree (this agent builds from its own branch).
REPO_ROOT=/workspace/.worktrees/dev2

FQDN_IRIS_A=dev2-iris-a.luit.ink
FQDN_IRIS_B=dev2-iris-b.luit.ink
FQDN_MASTODON=dev2-mastodon.luit.ink
FQDN_LEMMY=dev2-lemmy.luit.ink

PORT_IRIS_A=20081
PORT_IRIS_B=20082
PORT_MASTODON=20092
PORT_LEMMY=20091

IRIS_DB_PASS=iris-dev2-pw

MASTODON_DB_PASS=mastodon-dev2-pw
MASTODON_SECRET_KEY_BASE=c9f800add082c5bb92655bdebc14da73569b842e230663bd697e4412960bf0cf27fd8ad7ead465f513113359bad999bfb68d4836174c80c797b7b0fe18b0e6f8
MASTODON_AE_DETERMINISTIC_KEY=3206a1a6aaff1658438ddf63f95436d65a5ae656fe0c8196129955b537c197a2ddf094ef63101b9fb4523622be542d29699dcc13563fc1c622b5b1abe167c3a3
