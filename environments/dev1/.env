# DEV1 environment — agent dev1's federation stack.
# Bring up: docker compose -f environments/stack/docker-compose.yml --env-file environments/dev1/.env -p dev1 up -d --build
#
# Port scheme: 10xxx block (dev1=1, dev2=2, qa=3).
#   +01 iris-a, +02 iris-b, +11 lemmy, +12 mastodon.

ENV_PREFIX=dev1
# Build context = dev1's worktree (this agent builds from its own branch).
REPO_ROOT=/workspace/.worktrees/dev1

FQDN_IRIS_A=dev1-iris-a.luit.ink
FQDN_IRIS_B=dev1-iris-b.luit.ink
FQDN_MASTODON=dev1-mastodon.luit.ink
FQDN_LEMMY=dev1-lemmy.luit.ink

PORT_IRIS_A=10081
PORT_IRIS_B=10082
PORT_MASTODON=10092
PORT_LEMMY=10091

IRIS_DB_PASS=iris-dev1-pw

MASTODON_DB_PASS=mastodon-dev1-pw
MASTODON_SECRET_KEY_BASE=c351bde390395843e655e8d1804f1db27a8f5f54d0ddf9c09a0419f3fefd75fe7cbbbaef7e0c920874c03e1384274c6cbc8bc5876fab6d8ec96bed2c713ca4c8
MASTODON_AE_DETERMINISTIC_KEY=06df71ac950f0702f183fbf65a82b435b11665cc096d9c34aac8578aaba58a2c3b24968004fe1ad597cdb4e9512148a9788fcbffb5f651cd05cd6aec070b6027
