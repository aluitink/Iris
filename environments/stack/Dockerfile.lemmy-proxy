# QA Lemmy nginx front (single published port: host 18091 -> container 8082). Bakes the QA nginx.conf
# (upstream = qa-lemmy / qa-lemmy-ui) into the image. No TLS: TLS is terminated by the external
# reverse proxy on the other server, and X-Forwarded-Proto: https makes the backend + UI emit
# https://qa-lemmy.luit.ink IRIs.
FROM nginx:1.27-alpine
COPY lemmy-nginx.conf /etc/nginx/conf.d/default.conf
