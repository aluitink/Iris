# Shared federation stack — environment variable reference.
#
# One compose file (docker-compose.yml) serves both dev and QA; a per-environment .env supplies
# the values below. Copy this to environments/dev/.env or environments/qa/.env and adjust.
#
#   docker compose -f environments/stack/docker-compose.yml --env-file environments/<env>/.env -p <env> up -d --build

# ── Identity ────────────────────────────────────────────────────────────────────────────────────
# Prefix for `container_name` (docker ps clarity) AND must match the -p project flag you pass.
# dev -> dev, qa -> qa. Volumes/networks are isolated by the project name, not this prefix.
ENV_PREFIX=dev
# Absolute path to the repo root (build context for the Iris + lemmy-ui builds). Set this to the
# machine-absolute path where the repo is checked out.
REPO_ROOT=/path/to/repo

# ── FQDNs (provision these on the EXTERNAL reverse proxy on the other server; TLS terminates
#    there; each forwards its :443 to the matching PORT_* host port below) ──────────────────────
FQDN_IRIS_A=dev-iris-a.luit.ink
FQDN_IRIS_B=dev-iris-b.luit.ink
FQDN_MASTODON=mastodon.luit.ink
FQDN_LEMMY=lemmy.luit.ink

# ── Host ports (the external reverse-proxy targets) ─────────────────────────────────────────────
PORT_IRIS_A=8081
PORT_IRIS_B=8082
PORT_MASTODON=8092
PORT_LEMMY=8091

# ── Iris (both instances share one password) ────────────────────────────────────────────────────
IRIS_DB_PASS=iris-dev-pw

# ── Mastodon ─────────────────────────────────────────────────────────────────────────────────────
MASTODON_DB_PASS=mastodon-dev-pw
# Crypto keys: 128 hex chars each (SECRET_KEY_BASE) / 256 hex chars (the AE keys). Generate with
#   openssl rand -hex 64   (SECRET_KEY_BASE)
#   openssl rand -hex 64   (each AE key)
# They only need to be stable WITHIN one environment (so sessions/encrypted fields survive
# restarts); dev and QA can use different keys.
MASTODON_SECRET_KEY_BASE=CHANGE_ME_128_hex_chars
MASTODON_AE_DETERMINISTIC_KEY=CHANGE_ME_256_hex_chars
MASTODON_AE_KEY_DERIVATION_SALT=CHANGE_ME_256_hex_chars
MASTODON_AE_PRIMARY_KEY=CHANGE_ME_256_hex_chars

# ── Lemmy (must match the build args baked into the Lemmy image — see Dockerfile.lemmy) ─────────
LEMMY_DB_PASS=lemmy-dev-pw
