@inherits LayoutComponentBase
@implements IDisposable

<div class="explorer-header">
    <h1>Iris · server explorer</h1>
    @if (Session.IsLoggedIn)
    {
        <div class="identity">
            <span class="identity-actor" title="@IdentityIri?.Value">@IdentityIri?.Value</span>
        </div>
    }
    else
    {
        <span class="instance">not logged on</span>
    }
</div>

<nav class="explorer-nav">
    <a href="/">Home</a>
    <a href="/instance">Instance</a>
    <a href="/feed">Feed</a>
    <a href="/actors">Actors</a>
    <a href="/actor">Actor detail</a>
    <a href="/object">Object</a>
    <a href="/community">Community</a>
    <a href="/compose">Compose</a>
    <a href="/deliver">Raw delivery</a>
</nav>

@Body

@code {
    [Inject]
    private ExplorerSession Session { get; set; } = default!;

    /// <summary>
    /// The authoritative advertised actor IRI to show in the identity bar (the WebFinger-resolved IRI
    /// when available, else the direct IRI), or <see langword="null"/> when logged out.
    /// </summary>
    private Iri? IdentityIri => Session.ResolvedActorIri ?? Session.ActorIri;

    protected override void OnInitialized()
    {
        Session.PropertyChanged += OnSessionChanged;
    }

    public void Dispose()
    {
        Session.PropertyChanged -= OnSessionChanged;
    }

    private void OnSessionChanged(object? sender, PropertyChangedEventArgs e)
    {
        StateHasChanged();
    }
}
