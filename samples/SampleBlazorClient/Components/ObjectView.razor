@using Iris.Core
@using Iris.Core.Identity
@using KristofferStrube.ActivityStreams
@using Microsoft.Extensions.DependencyInjection
@using ActivityObject = KristofferStrube.ActivityStreams.Object

<div class="object-view">
    @if (Item is IObject { Id: { Length: > 0 } id } obj)
    {
        <div class="object-item">
            <span class="object-type">@obj.GetType().Name</span>
            @if (obj is Actor { PreferredUsername: { Length: > 0 } username })
            {
                <span class="object-handle">@username</span>
            }
            @if (AuthorIri is { } author)
            {
                <span class="object-author">
                    by
                    <a href="@ActorHref(author)" title="@author" class="object-actor">
                        @HandleOf(author)
                    </a>
                </span>
            }
            <a href="@ObjectHref(new Iri(id))" title="@id" class="object-iri">@id</a>
            @if (JoinStrings(obj.Content) is { Length: > 0 } content)
            {
                @if (IsSensitive)
                {
                    <div class="object-sensitive">
                        <div class="object-sensitive-notice">
                            @if (Summary is { Length: > 0 } summary)
                            {
                                <span class="object-sensitive-summary">@summary</span>
                            }
                            <span class="object-sensitive-label">This content may be sensitive.</span>
                            <button type="button" class="object-sensitive-reveal" @onclick="() => Revealed = !Revealed">
                                @(Revealed ? "Hide" : "Show")
                            </button>
                        </div>
                        @if (Revealed)
                        {
                            <div class="object-content">@RenderedContent</div>
                        }
                    </div>
                }
                else
                {
                    <div class="object-content">@RenderedContent</div>
                }
            }
            @foreach (var audience in AudienceIris)
            {
                <div class="object-audience">
                    to
                    <a href="@ActorHref(audience)" title="@audience" class="object-actor">@HandleOf(audience)</a>
                </div>
            }
            @if (Published is { } published)
            {
                <div class="object-published" title="@published.ToString("o")">@published.ToLocalTime().ToString("g")</div>
            }
            @if (ParentIri is { } parent)
            {
                <div class="object-parent">
                    in reply to
                    <a href="@ObjectHref(parent)" title="@parent" class="object-iri">@parent</a>
                </div>
            }
            @foreach (var mention in MentionIris)
            {
                <div class="object-mention">
                    mentions
                    <a href="@ActorHref(mention)" title="@mention" class="object-actor">@HandleOf(mention)</a>
                </div>
            }
            @foreach (var attachment in AttachmentIris)
            {
                <div class="object-attachment">
                    attachment
                    <a href="@attachment" title="@attachment" class="object-iri">@attachment</a>
                </div>
            }
            @foreach (var media in MediaAttachments)
            {
                <div class="object-media">
                    @* The img loads the same-origin IRI (rewritten at the render boundary, Decision 057).
                       When the proxy returns 502 (a dead/unreachable remote URL) the onerror handler
                       replaces the broken image with a link-out to the raw URL (a degraded case is a
                       link, never a broken image). *@
                    <img src="@media.Url" alt="@media.Name" loading="lazy"
                         @onerror="@(e => OnMediaLoadErrorAsync(e, media))" />
                    @if (string.IsNullOrWhiteSpace(media.Name) is false)
                    {
                        <div class="object-media-name" title="@media.Name">@media.Name</div>
                    }
                </div>
            }
        </div>
    }
    else if (Item is ILink { Href: { } linkHref })
    {
        <div class="object-item">
            <span class="object-type">Link</span>
            <a href="@ObjectHref(new Iri(linkHref))" title="@linkHref" class="object-iri">@linkHref</a>
        </div>
    }
    else
    {
        <div class="object-item"><span class="object-type">Unknown</span></div>
    }
</div>

@code {
    /// <summary>
    /// The object (or link) to render. Pattern-matched into <see cref="IObject"/> / <see cref="ILink"/>
    /// per the 3rd-Party ActivityStreams rules — never a concrete type.
    /// </summary>
    [Parameter]
    public IObjectOrLink? Item { get; set; }

    /// <summary>
    /// The service provider (used to resolve the logged-on <see cref="ExplorerSession"/> lazily, so the
    /// component renders in contexts where the session is not registered — e.g. the bunit component
    /// tests — without a hard dependency).
    /// </summary>
    [Inject]
    private IServiceProvider Services { get; set; } = default!;

    /// <summary>
    /// The logged-on session (the instance's dial base URI, the render-boundary rewrite's instance
    /// base), resolved lazily from the service provider. <see langword="null"/> when the session is not
    /// registered (the component renders without the media-proxy rewrite — the raw URL is used) or when
    /// logged out. Resolving it this way (rather than a hard <c>[Inject]</c>) keeps <c>ObjectView</c>
    /// renderable standalone (the bunit tests) while still doing the same-origin rewrite in the app.
    /// </summary>
    private ExplorerSession? Session
        => Services.GetService(typeof(ExplorerSession)) as ExplorerSession;

    /// <summary>JS interop (the <c>&lt;img onerror&gt;</c> link-out fallback, Decision 057).</summary>
    [Inject]
    private IJSRuntime JsRuntime { get; set; } = default!;

    private IObject? Obj => Item as IObject;

    /// <summary>
    /// The author's IRI (the first <c>attributedTo</c> entry), when present — rendered as a link to the
    /// actor page (S2 deep-linking).
    /// </summary>
    private Iri? AuthorIri => (Obj as ActivityObject)?.AttributedTo?.FirstOrDefault()?.ResolveObjectIri();

    /// <summary>
    /// The parent object's IRI (the <c>inReplyTo</c>), when present — rendered as a link to the parent
    /// (F-12 threading, S2). Uses <see cref="IriExtensions.GetParentIri"/>.
    /// </summary>
    private Iri? ParentIri => Obj?.GetParentIri();

    /// <summary>
    /// The mentioned actors' IRIs (the <c>mention</c> tags), when present — rendered as links to the
    /// actors' pages (S2). Uses <see cref="IriExtensions.GetMentionIris"/>.
    /// </summary>
    private IReadOnlyList<Iri> MentionIris => Obj?.GetMentionIris() ?? [];

    /// <summary>
    /// The audience IRIs (the object's <c>to</c> + <c>cc</c>, de-duplicated, the public sentinel
    /// excluded), when present — rendered as links to the recipients' pages (19.8.2). Uses
    /// <see cref="IriExtensions.GetAudienceIris"/>.
    /// </summary>
    private IReadOnlyList<Iri> AudienceIris => Obj?.GetAudienceIris() ?? [];

    /// <summary>
    /// The object's <c>published</c> timestamp, when present — rendered as a local time (19.8.2).
    /// </summary>
    private DateTime? Published => Obj?.Published;

    /// <summary>
    /// Whether the object is content-sensitive — when true the content renders behind a notice and
    /// is not shown until the viewer reveals it (20.4). Uses
    /// <see cref="IriExtensions.IsSensitive"/>.
    /// </summary>
    private bool IsSensitive => Obj?.IsSensitive() ?? false;

    /// <summary>
    /// The object's <c>summary</c> (the sensitivity preview / warning), when present — shown in the
    /// notice in place of a sensitive object's content (20.4). Uses
    /// <see cref="IriExtensions.GetSummary"/>.
    /// </summary>
    private string? Summary => Obj?.GetSummary();

    /// <summary>
    /// The object's <c>content</c> rendered as HTML from Markdown (20.4c). The content is run through
    /// the dependency-free <see cref="Markdown"/> renderer (HTML-escaped first, so it is safe to emit
    /// as a <see cref="MarkupString"/>). An empty or null content renders as an empty string.
    /// </summary>
    private MarkupString RenderedContent
        => new(Markdown.ToHtml(JoinStrings(Obj?.Content)));

    /// <summary>
    /// The attachment IRIs, when present — rendered as links (S2).
    /// Uses <see cref="IriExtensions.GetAttachmentIris"/>.
    /// </summary>
    private IReadOnlyList<Iri> AttachmentIris => Obj?.GetAttachmentIris() ?? [];

    /// <summary>
    /// The object's media attachments (embedded <see cref="Image"/> entries with a resolvable media IRI),
    /// when present — rendered as <c>&lt;img&gt;</c> (Phase 20.4 (a) + (d)). Each attachment's media IRI
    /// is rewritten at the render boundary to its browser-loadable form (Decision 057): a same-origin
    /// IRI (the instance's own <c>/ap/v1/media/{id}</c>) passes through unchanged; a cross-origin
    /// IRI becomes the same-origin media-proxy IRI
    /// (<c>{base}/ap/v1/media/proxy?url={originator-url}</c>) so the browser loads it from the
    /// instance's own origin, never a cross-origin media host. The <c>alt</c> is the file's name. Uses
    /// <see cref="IriExtensions.GetMediaAttachments"/> + <see cref="IriMediaProxyExtensions.ToBrowserMediaIri"/>.
    /// </summary>
    private IReadOnlyList<MediaAttachment> MediaAttachments
    {
        get
        {
            // The render boundary (Decision 057): the wire stays AP-native/verbatim; the rewrite happens
            // here. The instance base is the logged-on session's dial base URI; when there is no session
            // (not registered) or it is logged out (DialBaseUri null), the rewrite is a no-op (the raw
            // URL is used).
            Iri? instanceBase = Session?.DialBaseUri is { } baseUri ? new Iri(baseUri) : null;
            return (Obj?.GetMediaAttachments() ?? [])
                .Select(m =>
                {
                    var browserIri = instanceBase is { } b ? m.Iri.ToBrowserMediaIri(b) : m.Iri;
                    return new MediaAttachment(browserIri.Value, m.Iri.Value, m.Name);
                })
                .ToList();
        }
    }

    /// <summary>
    /// A rendered media attachment: the browser-loadable IRI to <c>&lt;img&gt;</c> (the same-origin
    /// proxy IRI or a passthrough same-origin IRI, Decision 057), the raw originator URL (the link-out
    /// target when the proxy 502s), and the file's name (the <c>&lt;img&gt;</c> <c>alt</c>).
    /// </summary>
    private sealed record MediaAttachment(string Url, string RawUrl, string? Name);

    /// <summary>
    /// The <c>&lt;img onerror&gt;</c> fallback (Decision 057): when the proxy returns <c>502</c> (a dead
    /// or unreachable remote URL), the broken image is replaced by a link-out to the raw URL. A
    /// degraded case is a link, never a broken image.
    /// </summary>
    private async Task OnMediaLoadErrorAsync(
        Microsoft.AspNetCore.Components.Web.ErrorEventArgs e,
        MediaAttachment media)
    {
        // The error target is the DOM <img>; swap it for an anchor pointing at the raw originator URL
        // (open in a new tab, no referrer). The raw URL is carried by the attachment (the link-out
        // target), distinct from the browser-loadable proxy IRI used as the <img> src. (The handler
        // itself is the fallback — a broken image never stays broken.)
        await JsRuntime.InvokeVoidAsync(
            "eval",
            $"var el=window.event.target; " +
            $"if(el){{var a=document.createElement('a');a.href='{media.RawUrl}';a.textContent='media unavailable — open original';a.target='_blank';a.rel='noopener';el.replaceWith(a);}}");
    }

    /// <summary>
    /// Whether the viewer has revealed a sensitive object's content. Per-instance UI state: a
    /// sensitive object's real content is not rendered (nor present in the DOM) until this flips to
    /// <c>true</c> via the reveal button (20.4).
    /// </summary>
    private bool Revealed;

    private static string? JoinStrings(IEnumerable<string>? values)
        => values is null ? null : string.Join(" ", values);

    /// <summary>
    /// The href for an object IRI: the explorer's object page with the IRI as a query param.
    /// </summary>
    private static string ObjectHref(Iri iri) => $"/object?iri={Uri.EscapeDataString(iri.Value)}";

    /// <summary>
    /// The href for an actor IRI: the explorer's actor page with the IRI as a query param.
    /// </summary>
    private static string ActorHref(Iri iri) => $"/actor?iri={Uri.EscapeDataString(iri.Value)}";

    /// <summary>
    /// A short display for an actor IRI: the path's last segment (the username) when it looks like a
    /// user IRI (<c>/ap/v1/u/{user}</c>), else the full IRI.
    /// </summary>
    private static string HandleOf(Iri iri)
    {
        var path = Uri.UnescapeDataString(new Uri(iri.Value).AbsolutePath).TrimEnd('/');
        var last = path.Split('/').LastOrDefault();
        return string.IsNullOrWhiteSpace(last) ? iri.Value : last;
    }
}
