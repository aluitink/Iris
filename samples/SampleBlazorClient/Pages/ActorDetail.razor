@page "/actor"
@using Iris.Client
@using CollectionQuery = Iris.Client.Collections.CollectionQuery
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using KristofferStrube.ActivityStreams

<PageTitle>Actor · Iris</PageTitle>

<h2>Actor</h2>

<BackLink />

@if (!Session.IsLoggedIn)
{
    <div class="card">
        <p class="muted">Log on to an instance to view an actor.</p>
    </div>
}
else
{
    <div class="card">
        <label for="handle">Actor (username on this instance, or a full IRI)</label>
        <input id="handle" type="text" @bind="Handle" placeholder="alice" />
        <button @onclick="LoadAsync" disabled="@(Busy)">Load</button>
        @if (Busy)
        {
            <span class="muted">Loading…</span>
        }
        @if (Error is not null)
        {
            <div class="error">@Error</div>
        }
    </div>

    @if (ActorIri is { } actorIri)
    {
        <ActorProfile Actor="ActorDoc" ActorId="actorIri.Value" />

        <nav class="tabs" aria-label="Actor sections">
            @foreach (var tab in Tabs)
            {
                <button class="tab @(tab.Key == ActiveTab ? "active" : null)" @onclick="() => SetActiveTab(tab.Key)" title="@(tab.Title)">
                    @tab.Title
                    @if (tab.Badge is { Length: > 0 } badge)
                    {
                        <span class="tab-badge">@badge</span>
                    }
                </button>
            }
        </nav>

        @if (ActiveTab is "outbox")
        {
            <CollectionBrowser
                Client="@Session.GetClient()"
                CollectionIri="@(ActorIri?.OutboxOf())"
                Title="Outbox"
                Description="The activities this actor authored or accepted (their outbox), paged with next-link walking — local or remote. Each item is a navigable object view."
                EmptyMessage="No items in the outbox."
                ItemTemplate="@ObjectItemTemplate" />
        }

        @if (ActiveTab is "liked")
        {
            <CollectionBrowser
                Client="@Session.GetClient()"
                CollectionIri="@(ActorIri?.LikedOf())"
                Title="Liked"
                Description="The objects this actor liked (their <c>liked</c> collection), paged with next-link walking. Each item is a navigable object view (a like is recorded as the liked object)."
                EmptyMessage="Nothing liked."
                ItemTemplate="@ObjectItemTemplate" />
        }

        @if (ActiveTab is "followers")
        {
            <CollectionBrowser
                Client="@Session.GetClient()"
                CollectionIri="@(ActorIri?.FollowersOf())"
                Title="Followers"
                Description="Actors that follow this actor (their followers collection), paged with next-link walking. Each item links to the follower's actor detail."
                EmptyMessage="No followers recorded."
                ItemTemplate="@ActorLinkTemplate"
                ItemActions="@FollowerActionsTemplate"
                HeaderContent="@FollowerManagementHeader" />
        }

        @if (ActiveTab is "following")
        {
            <CollectionBrowser
                Client="@Session.GetClient()"
                CollectionIri="@(ActorIri?.FollowingOf())"
                Title="Following"
                Description="Actors that this actor follows (their following collection), paged with next-link walking. Each item links to the followed actor's detail."
                EmptyMessage="Not following anyone."
                ItemTemplate="@ActorLinkTemplate" />
        }

        @if (ActiveTab is "raw")
        {
            <RawInspector Document="ActorDoc" />
        }

        @if (Moderation is { } mod)
        {
            @if (ActiveTab is "moderation")
            {
            <div class="card">
                <h3>Moderation (this actor)</h3>
                <p class="muted">
                    The counts below are <em>this actor's own</em> mutes / blocks / flags collections —
                    not your moderation of them.
                </p>
                <table class="kv">
                    <tr><th>Mutes</th><td>@mod.Mutes</td></tr>
                    <tr><th>Blocks</th><td>@mod.Blocks</td></tr>
                    <tr><th>Flags</th><td>@mod.Flags</td></tr>
                </table>
            </div>

            @if (MyModeration is { } mine)
            {
                <div class="card">
                    <h3>My moderation (you)</h3>
                    <p class="muted">
                        Your own mutes / blocks / flags (as <code>@(Session.ActorIri?.Value ?? "…")</code>) —
                        what *you* have muted, blocked, or flagged. The Mute / Block / Flag buttons below
                        change these.
                    </p>
                    <table class="kv">
                        <tr><th>Mutes</th><td>@mine.Mutes</td></tr>
                        <tr><th>Blocks</th><td>@mine.Blocks</td></tr>
                        <tr><th>Flags</th><td>@mine.Flags</td></tr>
                    </table>
                </div>
            }

            <div class="card">
                <h3>Moderation (this actor's collections)</h3>
                <p class="muted">
                    The collections below show who <em>this actor</em> has muted, blocked, and flagged (their
                    <c>mutes</c>/<c>blocks</c>/<c>flags</c> collections), paged with <c>next</c>-link walking.
                    Each item links to the moderated actor's detail. No per-item undo buttons: the
                    Decision 055 learned-id model requires the id of the original activity to undo it, which
                    these collections do not carry (they carry actor IRIs, not activity ids). The
                    unmute/unblock/unflag capability is provided by the "Moderation" card below.
                </p>
            </div>

            <CollectionBrowser
                Client="@Session.GetClient()"
                CollectionIri="@actorIri.MutesOf()"
                Title="Mutes"
                Description="Actors this actor has muted (its mutes collection), paged with next-link walking. Each item links to the muted actor's detail."
                EmptyMessage="No mutes recorded."
                ItemTemplate="@ActorLinkTemplate" />

            <CollectionBrowser
                Client="@Session.GetClient()"
                CollectionIri="@actorIri.BlocksOf()"
                Title="Blocks"
                Description="Actors this actor has blocked (its blocks collection), paged with next-link walking. Each item links to the blocked actor's detail."
                EmptyMessage="No blocks recorded."
                ItemTemplate="@ActorLinkTemplate" />

            <CollectionBrowser
                Client="@Session.GetClient()"
                CollectionIri="@actorIri.FlagsOf()"
                Title="Flags"
                Description="Actors this actor has flagged (its flags collection), paged with next-link walking. Each item links to the flagged actor's detail."
                EmptyMessage="No flags recorded."
                ItemTemplate="@ActorLinkTemplate" />

            <CollectionBrowser
                Client="@Session.GetClient()"
                CollectionIri="@actorIri.InboxOf()"
                Title="Inbox"
                Description="The activities delivered to this actor (their inbox collection), paged with next-link walking. Each item is an activity (a Follow, Like, Announce, Create, etc.) that was delivered to this actor."
                EmptyMessage="No activities delivered."
                ItemTemplate="@InboxItemTemplate" />

            <div class="card">
                <h3>Follow / unfollow</h3>
                <p class="muted">As <code>@(Session.ActorIri?.Value ?? "…")</code></p>
                @if (IsOwnActor)
                {
                    <p class="muted">This is you — you can't follow yourself.</p>
                }
                else
                {
                    <button @onclick="FollowAsync" disabled="@(WriteBusy)">@FollowButtonLabel</button>
                    <button @onclick="UnfollowAsync" disabled="@(WriteBusy || !IsFollowing || FollowLearnedId is null)">Unfollow</button>
                    @if (IsFollowing)
                    {
                        <span class="muted">You follow this actor.</span>
                    }
                }
                @if (WriteBusy)
                {
                    <span class="muted">Working…</span>
                }
                @if (WriteResult is not null)
                {
                    <p class="muted">Status: <code>@WriteResult</code></p>
                }
                @if (WriteError is not null)
                {
                    <div class="error">@WriteError</div>
                }
            </div>

            <div class="card">
                <h3>Inbound follows</h3>
                <p class="muted">
                    Follows <em>of</em> <code>@(ActorIri?.Value)</code> (actors that follow this actor). Accept /
                    reject are AP-native: the client authors an <c>Accept</c>/<c>Reject</c> and publishes it to
                    this actor's outbox; the instance records the edge and delivers the activity to the
                    follower's inbox.
                </p>
                @if (PendingFollows is not null && PendingFollows.Count == 0)
                {
                    <p class="muted">No inbound follows recorded.</p>
                }
                @if (PendingFollows is not null)
                {
                    @foreach (var follow in PendingFollows)
                    {
                        <div class="pending-follow">
                            <code>@follow.FollowerIri</code>
                            <button @onclick="() => AcceptFollowAsync(follow.FollowIri)" disabled="@(FollowDecisionBusy)">Accept</button>
                            <button @onclick="() => RejectFollowAsync(follow.FollowIri)" disabled="@(FollowDecisionBusy)">Reject</button>
                            @if (FollowDecisionResult is not null)
                            {
                                <span class="muted">Status: <code>@FollowDecisionResult</code></span>
                            }
                        </div>
                    }
                }
                @if (FollowDecisionBusy)
                {
                    <span class="muted">Working…</span>
                }
                @if (FollowDecisionError is not null)
                {
                    <div class="error">@FollowDecisionError</div>
                }
            </div>

            <div class="card">
                <h3>Moderation</h3>
                <p class="muted">As <code>@(Session.ActorIri?.Value ?? "…")</code> → <code>@(ActorIri?.Value)</code></p>
                <button @onclick="MuteAsync" disabled="@(WriteBusy)">Mute</button>
                <button @onclick="UnmuteAsync" disabled="@(WriteBusy)">Unmute</button>
                <button @onclick="BlockAsync" disabled="@(WriteBusy)">Block</button>
                <button @onclick="UnblockAsync" disabled="@(WriteBusy)">Unblock</button>
                <button @onclick="FlagAsync" disabled="@(WriteBusy)">Flag</button>
                <button @onclick="UnflagAsync" disabled="@(WriteBusy)">Unflag</button>
                <p class="muted">
                    Block / flag are signed writes to this actor's own outbox (the instance records the edge
                    and federates to the target's inbox); mute is a local, Basic-authenticated decision
                    (no federation).
                </p>
                @if (WriteBusy)
                {
                    <span class="muted">Working…</span>
                }
                @if (WriteResult is not null)
                {
                    <p class="muted">Status: <code>@WriteResult</code></p>
                }
                @if (WriteError is not null)
                {
                    <div class="error">@WriteError</div>
                }
            </div>

            <div class="card">
                <h3>Relays</h3>
                <p class="muted">
                    The relays (fan-out servers, ActivityPub §5.1.3) this actor's content is fanned out
                    through. Subscribe / unsubscribe are local, Basic-authenticated decisions on this
                    actor's own instance.
                </p>
                @if (Relays is not null)
                {
                    @if (Relays.Count == 0)
                    {
                        <p class="muted">No relays subscribed.</p>
                    }
                    else
                    {
                        <ul class="object-list">
                            @foreach (var relay in Relays)
                            {
                                <li><code>@relay</code></li>
                            }
                        </ul>
                    }
                }
                <label for="relay-iri">Relay IRI</label>
                <input id="relay-iri" type="text" @bind="RelayIriInput"
                       placeholder="https://relay.example/" />
                <button @onclick="SubscribeRelayAsync" disabled="@(RelayBusy)">Subscribe</button>
                <button @onclick="UnsubscribeRelayAsync" disabled="@(RelayBusy)">Unsubscribe</button>
                @if (RelayBusy)
                {
                    <span class="muted">Working…</span>
                }
                @if (RelayResult is not null)
                {
                    <p class="muted">Status: <code>@RelayResult</code></p>
                }
                @if (RelayError is not null)
                {
                    <div class="error">@RelayError</div>
                }
            </div>
            }
        }
    }
}

@code {
    [Inject]
    private ExplorerSession Session { get; set; } = default!;

    private string Handle { get; set; } = "alice";
    private bool Busy { get; set; }
    private string? Error { get; set; }
    private Iri? ActorIri { get; set; }
    private IObject? ActorDoc { get; set; }

    // 31.5: the active detail tab (the sections are organized into tabs so the one-long page is
    // navigable). The key doubles as the @if selector in the markup (a string literal match).
    private string ActiveTab { get; set; } = "outbox";

    /// <summary>
    /// A detail tab: its key (the markup's @if selector), its title (the button label), and an optional
    /// badge (a short count shown on the button — the moderation tab carries the target actor's
    /// mutes/blocks/flags total).
    /// </summary>
    private sealed record Tab(string Key, string Title, string? Badge = null);

    /// <summary>
    /// The detail tabs, in display order. "raw" (the raw inspector) is always present; "moderation" is
    /// present only once the target actor's moderation counts have loaded (the section is otherwise
    /// empty — a remote actor's counts are unknown).
    /// </summary>
    private IReadOnlyList<Tab> Tabs
    {
        get
        {
            var tabs = new List<Tab>
            {
                new("outbox", "Outbox"),
                new("liked", "Liked"),
                new("followers", "Followers"),
                new("following", "Following"),
                new("raw", "Raw"),
            };

            if (Moderation is { } mod)
            {
                tabs.Add(new("moderation", "Moderation", (mod.Mutes + mod.Blocks + mod.Flags).ToString()));
            }

            return tabs;
        }
    }

    /// <summary>
    /// Selects a detail tab. Switching to the moderation tab when it is not (yet) present (its counts
    /// have not loaded) falls back to "outbox" rather than leaving an empty pane.
    /// </summary>
    private void SetActiveTab(string key) => ActiveTab = key;

    /// <summary>
    /// The last deep-link param key (<c>iri:&lt;value&gt;</c> / <c>handle:&lt;value&gt;</c>) that triggered an
    /// auto-load in <see cref="OnParametersSetAsync"/>. Guards against re-loading on every re-render (a
    /// write such as Mute/Block re-renders the component with the param still set) — only a param change
    /// re-loads the actor.
    /// </summary>
    private string? _lastLoadedParamKey;

    // 21.1.1: followers-list management (block a follower from the list, owner only)
    private bool FollowersManagementBusy { get; set; }
    private string? FollowersManagementError { get; set; }
    private string? FollowersManagementResult { get; set; }

    /// <summary>
    /// True when the logged-on actor owns the actor being viewed (i.e. <c>ActorIri</c> == <c>Session.ActorIri</c>).
    /// Used to gate management actions (unfollow from the following list).
    /// </summary>
    private bool IsOwnActor => Session.ActorIri is { } own && ActorIri is { } target && own.Value == target.Value;

    /// <summary>
    /// The <em>target</em> actor's moderation counts (its <c>mutes</c>/<c>blocks</c>/<c>flags</c> collections).
    /// S6: shown alongside the logged-on actor's own moderation so the user can tell the two apart.
    /// </summary>
    private (int Mutes, int Blocks, int Flags)? Moderation { get; set; }

    /// <summary>
    /// The <em>logged-on</em> actor's own moderation counts (its <c>mutes</c>/<c>blocks</c>/<c>flags</c>
    /// collections — what *they* have muted/blocked/flagged). S6: the write buttons below act as the
    /// logged-on actor, so surfacing their own state makes the buttons' effect visible.
    /// </summary>
    private (int Mutes, int Blocks, int Flags)? MyModeration { get; set; }

    private bool WriteBusy { get; set; }
    private DeliveryResult? WriteResult { get; set; }
    private string? WriteError { get; set; }

    /// <summary>
    /// Inbound follows of the loaded actor (actors that follow this actor), read from the actor's outbox —
    /// the "pending follows" list the operator accepts/rejects (each is a (follower IRI, follow IRI) pair).
    /// </summary>
    private IReadOnlyList<(string FollowerIri, Iri FollowIri)>? PendingFollows { get; set; }
    private bool FollowDecisionBusy { get; set; }
    private DeliveryResult? FollowDecisionResult { get; set; }
    private string? FollowDecisionError { get; set; }

    private IReadOnlyList<string>? Relays { get; set; }
    private string RelayIriInput { get; set; } = "";
    private bool RelayBusy { get; set; }
    private DeliveryResult? RelayResult { get; set; }
    private string? RelayError { get; set; }

    // 22.2 (US-15): the follow state of the logged-on actor toward the actor being viewed. `IsFollowing`
    // is the authoritative read (does the logged-on actor's `following` collection contain this actor) —
    // it reflects a follow made anywhere (not only this page's session). `FollowLearnedId` (below) is
    // the id captured when THIS page made the follow, and is what the Unfollow references (Decision 055).
    private bool IsFollowing { get; set; }

    /// <summary>
    /// The label of the follow button (the current follow state). Kept as a property (not an inline
    /// ternary in the markup) because a ternary inside a Razor attribute/element with quoted string
    /// literals is mis-parsed — the <c>?</c> is read as markup rather than the C# conditional.
    /// </summary>
    private string FollowButtonLabel => IsFollowing ? "Following" : "Follow";

    /// <summary>
    /// The actor IRI deep-linked via the <c>?iri=</c> query param (S2). When present, the page loads it
    /// directly (an actor link from anywhere — ObjectView, feed, replies — navigates here and loads).
    /// </summary>
    [SupplyParameterFromQuery(Name = "iri")]
    private string? IriParam { get; set; }

    /// <summary>
    /// The actor's preferred username deep-linked via the <c>?handle=</c> query param (S2). When present
    /// (and no <c>?iri=</c>), the page resolves it to this instance's user IRI and loads.
    /// </summary>
    [SupplyParameterFromQuery(Name = "handle")]
    private string? HandleParam { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.IsLoggedIn)
        {
            return;
        }

        // OnParametersSetAsync (not OnInitializedAsync) so a deep-link to a DIFFERENT actor while already
        // on this page (?iri= / ?handle= change) re-loads that actor — navigating to /actor?iri=…/bob from
        // /actor (showing alice) is a query-param change on the already-initialized component, and
        // OnInitializedAsync would not re-fire for it. On first render Blazor still calls this after
        // OnInitialized, so the initial deep-link load is preserved. The _lastLoadedParamKey guard stops a
        // re-render (e.g. after a Mute/Block write) from re-loading when the param is unchanged.
        if (IriParam is { Length: > 0 })
        {
            var key = "iri:" + IriParam;
            if (key != _lastLoadedParamKey)
            {
                _lastLoadedParamKey = key;
                await LoadByIriAsync(new Iri(IriParam));
            }
        }
        else if (HandleParam is { Length: > 0 })
        {
            var key = "handle:" + HandleParam;
            if (key != _lastLoadedParamKey)
            {
                _lastLoadedParamKey = key;
                Handle = HandleParam;
                await LoadAsync();
            }
        }
    }

    /// <summary>
    /// Loads an actor (and its feed + moderation state) from an explicit actor IRI — the deep-link path
    /// (S2). Mirrors <see cref="LoadAsync"/> but takes the IRI directly rather than resolving a handle on
    /// the dial base.
    /// </summary>
    private async Task LoadByIriAsync(Iri actorIri)
    {
        Busy = true;
        Error = null;
            ActorIri = null;
            ActorDoc = null;
            ActiveTab = "outbox";
            Moderation = null;
            MyModeration = null;
            Relays = null;
            RelayResult = null;
            RelayError = null;
        try
        {
            ActorIri = actorIri;

            var client = Session.GetClient();

            // S9: fetch the actor via the typed GetActorAsync (the dedicated typed-actor method, closing
            // the API-coverage gap where it had no UI — the S2 page used the generic GetObjectAsync). It
            // is GetObjectAsync cast to Actor, so a non-actor IRI (a note, an object) yields null and the
            // page surfaces that rather than rendering a non-actor as an actor.
            var actor = await client.GetActorAsync(actorIri);
            if (actor is null)
            {
                Error = $"Not an actor: {actorIri.Value}";
                return;
            }

            ActorDoc = actor;

            // 19.8.5 — cross-instance navigation: record the navigable state (the last-viewed actor) so
            // a UI can offer "continue where you left off" after an instance switch.
            Session.SetNavigableActorIri(actorIri);

            // 19.8.3: followers + following are read-only paged collections rendered by the shared
            // <CollectionBrowser> (it walks {actor}/followers and {actor}/following on demand, 31.7).

            // 22.2 (US-15): the logged-on actor's follow state toward this actor — whether the logged-on
            // actor's `following` collection contains this actor. The authoritative follow-state read
            // (reflects a follow made anywhere, not only this page's session). A read failure leaves the
            // state `false` (the Follow button stays available).
            if (Session.ActorIri is { } followStateIri)
            {
                IsFollowing = await IsInFollowingCollectionAsync(followStateIri, actorIri);
            }

            Moderation = (
                await CountAsync(client.GetMutesAsync(actorIri)),
                await CountAsync(client.GetBlocksAsync(actorIri)),
                await CountAsync(client.GetFlagsAsync(actorIri)));

            // S6: the logged-on actor's OWN moderation state (what they have muted/blocked/flagged), so
            // the write buttons' effect is visible. Only the logged-on actor's own identity is available
            // to the session; the target actor's own state is the `Moderation` above.
            var me = Session.ActorIri;
            if (me is { } selfIri)
            {
                MyModeration = (
                    await CountAsync(client.GetMutesAsync(selfIri)),
                    await CountAsync(client.GetBlocksAsync(selfIri)),
                    await CountAsync(client.GetFlagsAsync(selfIri)));
            }

            // 21.1.2: the target actor's moderation collections (mutes/blocks/flags) are read-only
            // paged collections rendered by the shared <CollectionBrowser> (they walk {actor}/{mutes|
            // blocks|flags} on demand).

            // 21.1.3: the actor's inbox (activities delivered to this actor) is a read-only paged
            // collection rendered by the shared <CollectionBrowser> (it walks {actor}/inbox on demand).

            var relays = new List<string>();
            await foreach (var relay in client.GetRelaysAsync(actorIri))
            {
                var iri = RelayIriOf(relay);
                if (iri is not null)
                {
                    relays.Add(iri);
                }
            }

            Relays = relays;

            // Inbound follows of this actor (actors that follow it), read from its outbox (each inbound
            // follow is stored in the followed actor's outbox on receipt). Shown as the "Inbound follows"
            // list the operator can accept/reject.
            var inbound = new List<(string FollowerIri, Iri FollowIri)>();
            await foreach (var item in client.GetCollectionItemsAsync(actorIri.OutboxOf()))
            {
                if (item is Activity { Id: { } itemId, Type: { } types, Actor: { } actors }
                    && types.Contains("Follow")
                    && actors.FirstOrDefault()?.ResolveObjectIri() is { } follower)
                {
                    inbound.Add((follower.Value, new Iri(itemId)));
                }
            }

            PendingFollows = inbound;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    /// <summary>
    /// The item renderer for object-valued collections (the outbox / liked <c>CollectionBrowser</c>
    /// cards): each item renders via <c>&lt;ObjectView /&gt;</c> (the full navigable object rendering).
    /// </summary>
    private static RenderFragment<IObjectOrLink> ObjectItemTemplate = item => builder =>
    {
        builder.OpenComponent<ObjectView>(0);
        builder.AddAttribute(1, nameof(ObjectView.Item), item);
        builder.CloseComponent();
    };

    /// <summary>
    /// The item renderer for actor-linked collections (the followers/following and "Mutes" / "Blocks" /
    /// "Flags" <c>CollectionBrowser</c> cards): each entry (a link or an object with an <c>id</c>) renders
    /// as a link to that actor's detail page, showing a short handle (<see cref="HandleOf(string)"/>), or
    /// the relay IRI as a <c>&lt;code&gt;</c> when it carries no resolvable IRI. Built as a
    /// <see cref="RenderFragment{TData}"/> field (not an inline lambda attribute — Razor does not
    /// reliably parse multi-statement render-fragment attributes) so <c>CollectionBrowser</c> can render
    /// custom item markup.
    /// </summary>
    private static RenderFragment<IObjectOrLink> ActorLinkTemplate = item => builder =>
    {
        var iri = item is ILink { Href: { } href } ? href.ToString()
            : item is IObject { Id: { Length: > 0 } id } ? id
            : RelayIriOf(item);

        if (iri is not null)
        {
            builder.OpenElement(0, "a");
            builder.AddAttribute(1, "href", $"/actor?iri={Uri.EscapeDataString(iri)}");
            builder.AddAttribute(2, "title", iri);
            builder.AddContent(3, HandleOf(iri));
            builder.CloseElement();
        }
    };

    /// <summary>
    /// The per-item actions for the followers <c>CollectionBrowser</c>: when the logged-on actor owns the
    /// viewed actor (21.1.1), a <c>Block</c> button severs the relationship (the owner can't "unfollow"
    /// a follower in AP — the follower owns the follow edge — but can block them). Closes over the page's
    /// <see cref="IsOwnActor"/> / <see cref="FollowersManagementBusy"/> / <see cref="BlockFollowerAsync"/>.
    /// </summary>
    private RenderFragment<IObjectOrLink> FollowerActionsTemplate => item => builder =>
    {
        if (IsOwnActor
            && RelayIriOf(item) is { Length: > 0 } iri
            && Iri.TryParse(iri, out var blockTarget))
        {
            builder.OpenElement(0, "button");
            builder.AddAttribute(1, "onclick", EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(
                this, () => BlockFollowerAsync(blockTarget)));
            builder.AddAttribute(2, "disabled", FollowersManagementBusy);
            builder.AddContent(3, "Block");
            builder.CloseElement();
        }
    };

    /// <summary>
    /// The header line for the followers <c>CollectionBrowser</c>: the management error (an
    /// <c>&lt;div class="error"&gt;</c>) and the last management result (a muted line), kept visible under
    /// the list. Closes over <see cref="FollowersManagementError"/> / <see cref="FollowersManagementResult"/>.
    /// </summary>
    private RenderFragment? FollowerManagementHeader
    {
        get
        {
            if (FollowersManagementError is null && FollowersManagementResult is null)
            {
                return null;
            }

            return builder =>
            {
                if (FollowersManagementError is { } error)
                {
                    builder.OpenElement(0, "div");
                    builder.AddAttribute(1, "class", "error");
                    builder.AddContent(2, error);
                    builder.CloseElement();
                }

                if (FollowersManagementResult is { } result)
                {
                    builder.OpenElement(3, "p");
                    builder.AddAttribute(4, "class", "muted");
                    builder.AddContent(5, result);
                    builder.CloseElement();
                }
            };
        }
    }

    /// <summary>
    /// The item renderer for the "Inbox" <c>CollectionBrowser</c>: each delivered activity shows its
    /// ActivityStreams <c>type</c> (muted) and its <c>id</c> (as a <c>&lt;code&gt;</c>), or the relay IRI
    /// when the entry is a bare link. Built as a <see cref="RenderFragment{TData}"/> field (not an
    /// inline lambda attribute — Razor does not reliably parse multi-statement render-fragment
    /// attributes) so <c>CollectionBrowser</c> can render custom item markup.
    /// </summary>
    private static RenderFragment<IObjectOrLink> InboxItemTemplate = item => builder =>
    {
        if (item is IObject { Type: { } typeList, Id: { Length: > 0 } id })
        {
            if (typeList.FirstOrDefault() is { Length: > 0 } type)
            {
                builder.OpenElement(0, "span");
                builder.AddAttribute(1, "class", "muted");
                builder.AddContent(2, type);
                builder.CloseElement();
            }

            builder.OpenElement(3, "code");
            builder.AddContent(4, id);
            builder.CloseElement();
            return;
        }

        if (item is ILink { Href: { } href })
        {
            builder.OpenElement(0, "code");
            builder.AddContent(1, href.ToString());
            builder.CloseElement();
        }
    };

    /// <summary>
    /// A short display for an actor IRI string: the path's last segment (the username) when it looks
    /// like an actor IRI (<c>…/u/{username}</c>), else the raw IRI.
    /// </summary>
    private static string HandleOf(string iri)
    {
        var idx = iri.LastIndexOf('/');
        return idx >= 0 && idx < iri.Length - 1 ? iri[(idx + 1)..] : iri;
    }

    private async Task AcceptFollowAsync(Iri followIri)
        => await FollowDecisionAsync(followIri, accept: true);

    private async Task RejectFollowAsync(Iri followIri)
        => await FollowDecisionAsync(followIri, accept: false);

    private async Task FollowDecisionAsync(Iri followIri, bool accept)
    {
        if (!Session.IsLoggedIn || ActorIri is not { } followedIri)
        {
            return;
        }

        FollowDecisionBusy = true;
        FollowDecisionResult = null;
        FollowDecisionError = null;
        try
        {
            // Accept/reject are AP-native: the client authors the deterministic Accept/Reject and publishes
            // it to the followed actor's own outbox (this actor — the operator IS the followed actor). The
            // instance records the edge effect and server-delivers the activity to the follower's inbox.
            FollowDecisionResult = accept
                ? await Session.GetClient().AcceptAsync(followedIri, followIri)
                : await Session.GetClient().RejectAsync(followedIri, followIri);

            // Refresh the inbound-follows list (bypassing the page cache) so the accepted/rejected follow's
            // Accept/Reject activity is visible immediately.
            await RefreshPendingFollowsAsync(bypassCache: true);
        }
        catch (Exception ex)
        {
            FollowDecisionError = ex.Message;
        }
        finally
        {
            FollowDecisionBusy = false;
        }
    }

    private async Task RefreshPendingFollowsAsync(bool bypassCache = false)
    {
        if (ActorIri is not { } actorIri)
        {
            return;
        }

        var client = Session.GetClient();
        var query = bypassCache ? new CollectionQuery(BypassCache: true) : null;
        var inbound = new List<(string FollowerIri, Iri FollowIri)>();
        await foreach (var item in client.GetCollectionItemsAsync(actorIri.OutboxOf(), query))
        {
            if (item is Activity { Id: { } itemId, Type: { } types, Actor: { } actors }
                && types.Contains("Follow")
                && actors.FirstOrDefault()?.ResolveObjectIri() is { } follower)
            {
                inbound.Add((follower.Value, new Iri(itemId)));
            }
        }

        PendingFollows = inbound;
    }

    private async Task LoadAsync()
    {
        if (!Session.IsLoggedIn)
        {
            return;
        }

        var baseUri = Session.DialBaseUri ?? throw new InvalidOperationException("No dial base URI.");
        Iri actorIri;
        try
        {
            actorIri = ResolveActorIri(Handle, baseUri);
        }
        catch (InvalidOperationException ex)
        {
            Error = ex.Message;
            return;
        }

        await LoadByIriAsync(actorIri);
    }

    /// <summary>
    /// Resolves the actor-detail <c>#handle</c> input to an actor IRI (19.8.1 minor UX fix). When the
    /// input is a valid absolute IRI (an <c>http(s)</c> URL), it is used directly — a pasted actor IRI
    /// loads that actor. Otherwise the input is treated as a preferred username on the current instance
    /// and resolved to <c>{dial-base}/ap/v1/u/{username}</c>. Exposed as a static helper so the
    /// resolution logic is testable in isolation.
    /// </summary>
    /// <param name="input">The raw <c>#handle</c> field text (a preferred username or a full IRI).</param>
    /// <param name="dialBase">The current instance's dial base URI (the username is resolved against it).</param>
    /// <returns>The resolved actor IRI.</returns>
    /// <exception cref="InvalidOperationException">The input is empty or whitespace.</exception>
    public static Iri ResolveActorIri(string input, Uri dialBase)
    {
        var trimmed = input.Trim();
        if (trimmed.Length == 0)
        {
            throw new InvalidOperationException("Enter a username or an actor IRI.");
        }

        // A pasted absolute IRI (http/https) is used directly — it names the actor on its own instance.
        if (trimmed.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || trimmed.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            if (!Uri.TryCreate(trimmed, UriKind.Absolute, out _))
            {
                throw new InvalidOperationException($"Not a valid IRI: {trimmed}");
            }

            return new Iri(trimmed);
        }

        // Otherwise: a preferred username on the current instance.
        return new Iri($"{dialBase.GetLeftPart(UriPartial.Authority)}/ap/v1/u/{trimmed}");
    }

    private static async Task<int> CountAsync(IAsyncEnumerable<IObjectOrLink> items)
    {
        var count = 0;
        await foreach (var _ in items)
        {
            count++;
        }

        return count;
    }

    // Decision 055 (learned-id references): the ids the server minted for the follow/block/flag this
    // page made, learned from DeliveryResult.MintedId at creation time. The Undo methods reference the
    // original activity by this learned id (the client never recomputes the server's ids), so a create
    // must have happened (and been captured) before its undo can run.
    private Iri? FollowLearnedId { get; set; }
    private Iri? BlockLearnedId { get; set; }
    private Iri? FlagLearnedId { get; set; }

    private async Task FollowAsync()
        => await FollowUnfollowAsync((actor, target) => Session.GetClient().FollowAsync(actor, target), captureCreatedId: r => FollowLearnedId = r is { } id ? new Iri(id) : null, clearCreatedId: () => FollowLearnedId = null, affectsFollowState: true);

    private async Task UnfollowAsync()
        => await FollowUnfollowAsync((actor, target) => Session.GetClient().UndoFollowAsync(actor, FollowLearnedId!.Value), clearCreatedId: () => FollowLearnedId = null, affectsFollowState: true);

    private async Task MuteAsync()
        => await FollowUnfollowAsync((actor, target) => Session.GetLocalModerationClient().MuteAsync(actor, target));

    private async Task UnmuteAsync()
        => await FollowUnfollowAsync((actor, target) => Session.GetLocalModerationClient().UnmuteAsync(actor, target));

    private async Task BlockAsync()
        => await FollowUnfollowAsync((actor, target) => Session.GetClient().BlockAsync(actor, target), captureCreatedId: r => BlockLearnedId = r is { } id ? new Iri(id) : null, clearCreatedId: () => BlockLearnedId = null);

    private async Task UnblockAsync()
        => await FollowUnfollowAsync((actor, target) => Session.GetClient().UnblockAsync(actor, BlockLearnedId!.Value), clearCreatedId: () => BlockLearnedId = null);

    private async Task FlagAsync()
        => await FollowUnfollowAsync((actor, target) => Session.GetClient().FlagAsync(actor, target), captureCreatedId: r => FlagLearnedId = r is { } id ? new Iri(id) : null, clearCreatedId: () => FlagLearnedId = null);

    private async Task UnflagAsync()
        => await FollowUnfollowAsync((actor, target) => Session.GetClient().UnflagAsync(actor, FlagLearnedId!.Value), clearCreatedId: () => FlagLearnedId = null);

    private async Task FollowUnfollowAsync(
        Func<Iri, Iri, Task<DeliveryResult>> write,
        Action<string?>? captureCreatedId = null,
        Action? clearCreatedId = null,
        bool affectsFollowState = false)
    {
        if (!Session.IsLoggedIn || ActorIri is null)
        {
            return;
        }

        // Decision 055: an undo references the original activity by its learned id. The undo's write
        // lambda closes over that learned id (e.g. `FollowLearnedId!.Value`); if it was never captured
        // (the create happened elsewhere, or was never made), the null dereference throws and is reported
        // in WriteError below — there is nothing to undo.
        var actorIri = Session.ActorIri ?? throw new InvalidOperationException("No actor identity.");
        WriteBusy = true;
        WriteResult = null;
        WriteError = null;
        try
        {
            WriteResult = await write(actorIri, ActorIri.Value);
            // Decision 055: learn the id the server minted for the created activity so a later undo can
            // reference it. On a failed write (no minted id) leave the previous learned id untouched.
            if (captureCreatedId is not null)
            {
                captureCreatedId(WriteResult.MintedId);
            }
            else if (clearCreatedId is not null)
            {
                clearCreatedId();
            }
            // S6: refresh the logged-on actor's own moderation counts (bypassing the page cache) so a
            // mute/block/flag's effect is visible immediately rather than after the 60s fresh window.
            await RefreshMyModerationAsync(bypassCache: true);
            // 22.2 (US-15): a follow/unfollow also changes the follow state — re-read whether the
            // logged-on actor's `following` collection now (no longer) contains this actor so the
            // Follow/Unfollow button reflects the write immediately.
            if (affectsFollowState)
            {
                IsFollowing = await IsInFollowingCollectionAsync(actorIri, ActorIri.Value);
            }
        }
        catch (Exception ex)
        {
            WriteError = ex.Message;
        }
        finally
        {
            WriteBusy = false;
        }
    }

    /// <summary>
    /// Re-reads the logged-on actor's own mutes/blocks/flags counts. After a mute/block/flag write the
    /// collections are served through the local collection-page cache, so a follow-up read bypasses the
    /// cache (refresh) to observe the update.
    /// </summary>
    private async Task RefreshMyModerationAsync(bool bypassCache = false)
    {
        if (Session.ActorIri is not { } selfIri)
        {
            return;
        }

        var client = Session.GetClient();
        var query = bypassCache ? new CollectionQuery(BypassCache: true) : null;
        MyModeration = (
            await CountAsync(client.GetMutesAsync(selfIri, query)),
            await CountAsync(client.GetBlocksAsync(selfIri, query)),
            await CountAsync(client.GetFlagsAsync(selfIri, query)));
    }

    // 21.1.1: block a follower from the followers list (owner only). Blocking a follower severs the
    // relationship (the blocked follower's activities no longer reach the owner). This is a practical
    // management action for the followers list (the owner can't "unfollow" a follower in AP — the
    // follower owns the follow edge — but can block them).
    private async Task BlockFollowerAsync(Iri target)
    {
        if (!Session.IsLoggedIn || !IsOwnActor || FollowersManagementBusy)
        {
            return;
        }

        var actorIri = Session.ActorIri ?? throw new InvalidOperationException("No actor identity.");
        FollowersManagementBusy = true;
        FollowersManagementResult = null;
        FollowersManagementError = null;
        try
        {
            var result = await Session.GetClient().BlockAsync(actorIri, target);
            FollowersManagementResult = result.IsSuccess
                ? $"Blocked (status {result.StatusCode})"
                : $"failed (status {result.StatusCode})";
            // S6: refresh the logged-on actor's own moderation counts (bypassing the page cache) so the
            // new block is visible immediately.
            await RefreshMyModerationAsync(bypassCache: true);
        }
        catch (Exception ex)
        {
            FollowersManagementError = ex.Message;
        }
        finally
        {
            FollowersManagementBusy = false;
        }
    }

    /// <summary>
    /// Resolves a relay collection item to its IRI string (a relay is a link, or an object carrying an
    /// <c>id</c>). Null when the item carries no usable IRI.
    /// </summary>
    private static string? RelayIriOf(IObjectOrLink item)
    {
        if (item is IObject { Id: { } id })
        {
            return id;
        }

        if (item is ILink { Href: { } href })
        {
            return href.ToString();
        }

        return null;
    }

    private async Task SubscribeRelayAsync()
        => await RelayWriteAsync((actor, relay) => Session.GetLocalModerationClient().SubscribeRelayAsync(actor, relay));

    private async Task UnsubscribeRelayAsync()
        => await RelayWriteAsync((actor, relay) => Session.GetLocalModerationClient().UnsubscribeRelayAsync(actor, relay));

    private async Task RelayWriteAsync(Func<Iri, Iri, Task<DeliveryResult>> write)
    {
        if (!Session.IsLoggedIn || ActorIri is null)
        {
            return;
        }

        if (!Iri.TryParse(RelayIriInput.Trim(), out var relay))
        {
            RelayError = "The relay IRI is not a valid absolute URI.";
            return;
        }

        var actorIri = Session.ActorIri ?? throw new InvalidOperationException("No actor identity.");
        RelayBusy = true;
        RelayResult = null;
        RelayError = null;
        try
        {
            RelayResult = await write(actorIri, relay);
            // Refresh the relays list (bypassing the page cache) so the new (or removed) subscription is
            // visible immediately rather than after the cache's 60s fresh window lapses.
            await RefreshRelaysAsync(bypassCache: true);
        }
        catch (Exception ex)
        {
            RelayError = ex.Message;
        }
        finally
        {
            RelayBusy = false;
        }
    }

    private async Task RefreshRelaysAsync(bool bypassCache = false)
    {
        if (ActorIri is not { } actorIri)
        {
            return;
        }

        var relays = new List<string>();
        // After a subscribe/unsubscribe write the relays collection is served through the local
        // collection-page response cache, so a follow-up read bypasses the cache (refresh) to observe
        // the update instead of a stale page.
        var query = bypassCache ? new CollectionQuery(BypassCache: true) : null;
        await foreach (var relay in Session.GetClient().GetRelaysAsync(actorIri, query))
        {
            var iri = RelayIriOf(relay);
            if (iri is not null)
            {
                relays.Add(iri);
            }
        }

        Relays = relays;
    }

    /// <summary>
    /// Whether the logged-on actor's <c>following</c> collection contains <paramref name="targetIri"/>
    /// (the authoritative follow-state read, 22.2 US-15). Mirrors the <c>liked</c> check on the
    /// object page: the read bypasses the client's collection page cache so a re-read after a
    /// follow/unfollow reflects the current store. A failed read is treated as "not following" — the
    /// Follow button stays available.
    /// </summary>
    private async Task<bool> IsInFollowingCollectionAsync(Iri selfIri, Iri targetIri)
    {
        try
        {
            var client = Session.GetClient();
            await foreach (var item in client.GetCollectionItemsAsync(
                selfIri.FollowingOf(), new CollectionQuery { BypassCache = true }))
            {
                var iri = RelayIriOf(item);
                if (iri is { Length: > 0 } && Iri.TryParse(iri, out var parsed) && parsed == targetIri)
                {
                    return true;
                }
            }

            return false;
        }
        catch
        {
            return false;
        }
    }
}
