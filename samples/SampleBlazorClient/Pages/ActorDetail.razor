@page "/actor"
@using Iris.Client
@using CollectionQuery = Iris.Client.Collections.CollectionQuery
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using KristofferStrube.ActivityStreams

<PageTitle>Actor detail · Iris</PageTitle>

<h2>Actor detail</h2>

@if (!Session.IsLoggedIn)
{
    <div class="card">
        <p class="muted">Log on to an instance to view an actor.</p>
    </div>
}
else
{
    <div class="card">
        <label for="handle">Actor (preferredUsername on this instance)</label>
        <input id="handle" type="text" @bind="Handle" placeholder="alice" />
        <button @onclick="LoadAsync" disabled="@(Busy)">Load</button>
        @if (Busy)
        {
            <span class="muted">Loading…</span>
        }
        @if (Error is not null)
        {
            <div class="error">@Error</div>
        }
    </div>

    @if (ActorIri is not null)
    {
        <div class="card">
            <h3>Actor</h3>
            <ObjectView Item="ActorDoc" />
            <p class="muted">IRI: <code>@ActorIri.Value</code></p>
        </div>

        @if (Feed is not null)
        {
            <div class="card">
                <h3>Feed (outbox)</h3>
                @if (Feed.Count == 0)
                {
                    <p class="muted">No items.</p>
                }
                else
                {
                    <p class="muted">@Feed.Count item(s).</p>
                    <ul class="object-list">
                        @foreach (var item in Feed)
                        {
                            <li><ObjectView Item="item" /></li>
                        }
                    </ul>
                }
            </div>
        }

        @if (Moderation is { } mod)
        {
            <div class="card">
                <h3>Moderation (this actor)</h3>
                <p class="muted">
                    The counts below are <em>this actor's own</em> mutes / blocks / flags collections —
                    not your moderation of them.
                </p>
                <table class="kv">
                    <tr><th>Mutes</th><td>@mod.Mutes</td></tr>
                    <tr><th>Blocks</th><td>@mod.Blocks</td></tr>
                    <tr><th>Flags</th><td>@mod.Flags</td></tr>
                </table>
            </div>

            @if (MyModeration is { } mine)
            {
                <div class="card">
                    <h3>My moderation (you)</h3>
                    <p class="muted">
                        Your own mutes / blocks / flags (as <code>@(Session.ActorIri?.Value ?? "…")</code>) —
                        what *you* have muted, blocked, or flagged. The Mute / Block / Flag buttons below
                        change these.
                    </p>
                    <table class="kv">
                        <tr><th>Mutes</th><td>@mine.Mutes</td></tr>
                        <tr><th>Blocks</th><td>@mine.Blocks</td></tr>
                        <tr><th>Flags</th><td>@mine.Flags</td></tr>
                    </table>
                </div>
            }

            <div class="card">
                <h3>Follow / unfollow</h3>
                <p class="muted">As <code>@(Session.ActorIri?.Value ?? "…")</code></p>
                <button @onclick="FollowAsync" disabled="@(WriteBusy)">Follow</button>
                <button @onclick="UnfollowAsync" disabled="@(WriteBusy)">Unfollow</button>
                @if (WriteBusy)
                {
                    <span class="muted">Working…</span>
                }
                @if (WriteResult is not null)
                {
                    <p class="muted">Status: <code>@WriteResult</code></p>
                }
                @if (WriteError is not null)
                {
                    <div class="error">@WriteError</div>
                }
            </div>

            <div class="card">
                <h3>Moderation</h3>
                <p class="muted">As <code>@(Session.ActorIri?.Value ?? "…")</code> → <code>@ActorIri.Value</code></p>
                <button @onclick="MuteAsync" disabled="@(WriteBusy)">Mute</button>
                <button @onclick="UnmuteAsync" disabled="@(WriteBusy)">Unmute</button>
                <button @onclick="BlockAsync" disabled="@(WriteBusy)">Block</button>
                <button @onclick="UnblockAsync" disabled="@(WriteBusy)">Unblock</button>
                <button @onclick="FlagAsync" disabled="@(WriteBusy)">Flag</button>
                <button @onclick="UnflagAsync" disabled="@(WriteBusy)">Unflag</button>
                <p class="muted">
                    Block / flag are signed writes to this actor's own outbox (the instance records the edge
                    and federates to the target's inbox); mute is a local, Basic-authenticated decision
                    (no federation).
                </p>
                @if (WriteBusy)
                {
                    <span class="muted">Working…</span>
                }
                @if (WriteResult is not null)
                {
                    <p class="muted">Status: <code>@WriteResult</code></p>
                }
                @if (WriteError is not null)
                {
                    <div class="error">@WriteError</div>
                }
            </div>

            <div class="card">
                <h3>Relays</h3>
                <p class="muted">
                    The relays (fan-out servers, ActivityPub §5.1.3) this actor's content is fanned out
                    through. Subscribe / unsubscribe are local, Basic-authenticated decisions on this
                    actor's own instance.
                </p>
                @if (Relays is not null)
                {
                    @if (Relays.Count == 0)
                    {
                        <p class="muted">No relays subscribed.</p>
                    }
                    else
                    {
                        <ul class="object-list">
                            @foreach (var relay in Relays)
                            {
                                <li><code>@relay</code></li>
                            }
                        </ul>
                    }
                }
                <label for="relay-iri">Relay IRI</label>
                <input id="relay-iri" type="text" @bind="RelayIriInput"
                       placeholder="https://relay.example/" />
                <button @onclick="SubscribeRelayAsync" disabled="@(RelayBusy)">Subscribe</button>
                <button @onclick="UnsubscribeRelayAsync" disabled="@(RelayBusy)">Unsubscribe</button>
                @if (RelayBusy)
                {
                    <span class="muted">Working…</span>
                }
                @if (RelayResult is not null)
                {
                    <p class="muted">Status: <code>@RelayResult</code></p>
                }
                @if (RelayError is not null)
                {
                    <div class="error">@RelayError</div>
                }
            </div>
        }
    }
}

@code {
    [Inject]
    private ExplorerSession Session { get; set; } = default!;

    private string Handle { get; set; } = "alice";
    private bool Busy { get; set; }
    private string? Error { get; set; }
    private Iri? ActorIri { get; set; }
    private IObject? ActorDoc { get; set; }
    private IReadOnlyList<IObjectOrLink>? Feed { get; set; }

    /// <summary>
    /// The <em>target</em> actor's moderation counts (its <c>mutes</c>/<c>blocks</c>/<c>flags</c> collections).
    /// S6: shown alongside the logged-on actor's own moderation so the user can tell the two apart.
    /// </summary>
    private (int Mutes, int Blocks, int Flags)? Moderation { get; set; }

    /// <summary>
    /// The <em>logged-on</em> actor's own moderation counts (its <c>mutes</c>/<c>blocks</c>/<c>flags</c>
    /// collections — what *they* have muted/blocked/flagged). S6: the write buttons below act as the
    /// logged-on actor, so surfacing their own state makes the buttons' effect visible.
    /// </summary>
    private (int Mutes, int Blocks, int Flags)? MyModeration { get; set; }

    private bool WriteBusy { get; set; }
    private DeliveryResult? WriteResult { get; set; }
    private string? WriteError { get; set; }

    private IReadOnlyList<string>? Relays { get; set; }
    private string RelayIriInput { get; set; } = "";
    private bool RelayBusy { get; set; }
    private DeliveryResult? RelayResult { get; set; }
    private string? RelayError { get; set; }

    /// <summary>
    /// The actor IRI deep-linked via the <c>?iri=</c> query param (S2). When present, the page loads it
    /// directly (an actor link from anywhere — ObjectView, feed, replies — navigates here and loads).
    /// </summary>
    [SupplyParameterFromQuery(Name = "iri")]
    private string? IriParam { get; set; }

    /// <summary>
    /// The actor's preferred username deep-linked via the <c>?handle=</c> query param (S2). When present
    /// (and no <c>?iri=</c>), the page resolves it to this instance's user IRI and loads.
    /// </summary>
    [SupplyParameterFromQuery(Name = "handle")]
    private string? HandleParam { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn)
        {
            return;
        }

        if (IriParam is { Length: > 0 })
        {
            await LoadByIriAsync(new Iri(IriParam));
        }
        else if (HandleParam is { Length: > 0 })
        {
            Handle = HandleParam;
            await LoadAsync();
        }
    }

    /// <summary>
    /// Loads an actor (and its feed + moderation state) from an explicit actor IRI — the deep-link path
    /// (S2). Mirrors <see cref="LoadAsync"/> but takes the IRI directly rather than resolving a handle on
    /// the dial base.
    /// </summary>
    private async Task LoadByIriAsync(Iri actorIri)
    {
        Busy = true;
        Error = null;
        ActorIri = null;
        ActorDoc = null;
        Feed = null;
        Moderation = null;
        MyModeration = null;
        Relays = null;
        RelayResult = null;
        RelayError = null;
        try
        {
            ActorIri = actorIri;

            var client = Session.GetClient();

            // S9: fetch the actor via the typed GetActorAsync (the dedicated typed-actor method, closing
            // the API-coverage gap where it had no UI — the S2 page used the generic GetObjectAsync). It
            // is GetObjectAsync cast to Actor, so a non-actor IRI (a note, an object) yields null and the
            // page surfaces that rather than rendering a non-actor as an actor.
            var actor = await client.GetActorAsync(actorIri);
            if (actor is null)
            {
                Error = $"Not an actor: {actorIri.Value}";
                return;
            }

            ActorDoc = actor;

            var feed = new List<IObjectOrLink>();
            await foreach (var item in client.GetCollectionItemsAsync(actorIri.OutboxOf()))
            {
                feed.Add(item);
            }

            Feed = feed;
            Moderation = (
                await CountAsync(client.GetMutesAsync(actorIri)),
                await CountAsync(client.GetBlocksAsync(actorIri)),
                await CountAsync(client.GetFlagsAsync(actorIri)));

            // S6: the logged-on actor's OWN moderation state (what they have muted/blocked/flagged), so
            // the write buttons' effect is visible. Only the logged-on actor's own identity is available
            // to the session; the target actor's own state is the `Moderation` above.
            var me = Session.ActorIri;
            if (me is { } selfIri)
            {
                MyModeration = (
                    await CountAsync(client.GetMutesAsync(selfIri)),
                    await CountAsync(client.GetBlocksAsync(selfIri)),
                    await CountAsync(client.GetFlagsAsync(selfIri)));
            }

            var relays = new List<string>();
            await foreach (var relay in client.GetRelaysAsync(actorIri))
            {
                var iri = RelayIriOf(relay);
                if (iri is not null)
                {
                    relays.Add(iri);
                }
            }

            Relays = relays;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task LoadAsync()
    {
        if (!Session.IsLoggedIn)
        {
            return;
        }

        var baseUri = Session.DialBaseUri ?? throw new InvalidOperationException("No dial base URI.");
        var actorIri = new Iri($"{baseUri.GetLeftPart(UriPartial.Authority)}/ap/v1/u/{Handle.Trim()}");
        await LoadByIriAsync(actorIri);
    }

    private static async Task<int> CountAsync(IAsyncEnumerable<IObjectOrLink> items)
    {
        var count = 0;
        await foreach (var _ in items)
        {
            count++;
        }

        return count;
    }

    private async Task FollowAsync()
        => await FollowUnfollowAsync((actor, target) => Session.GetClient().FollowAsync(actor, target));

    private async Task UnfollowAsync()
        => await FollowUnfollowAsync((actor, target) => Session.GetClient().UndoFollowAsync(actor, target));

    private async Task MuteAsync()
        => await FollowUnfollowAsync((actor, target) => Session.GetClient().MuteAsync(actor, target));

    private async Task UnmuteAsync()
        => await FollowUnfollowAsync((actor, target) => Session.GetClient().UnmuteAsync(actor, target));

    private async Task BlockAsync()
        => await FollowUnfollowAsync((actor, target) => Session.GetClient().BlockAsync(actor, target));

    private async Task UnblockAsync()
        => await FollowUnfollowAsync((actor, target) => Session.GetClient().UnblockAsync(actor, target));

    private async Task FlagAsync()
        => await FollowUnfollowAsync((actor, target) => Session.GetClient().FlagAsync(actor, target));

    private async Task UnflagAsync()
        => await FollowUnfollowAsync((actor, target) => Session.GetClient().UnflagAsync(actor, target));

    private async Task FollowUnfollowAsync(Func<Iri, Iri, Task<DeliveryResult>> write)
    {
        if (!Session.IsLoggedIn || ActorIri is null)
        {
            return;
        }

        var actorIri = Session.ActorIri ?? throw new InvalidOperationException("No actor identity.");
        WriteBusy = true;
        WriteResult = null;
        WriteError = null;
        try
        {
            WriteResult = await write(actorIri, ActorIri.Value);
            // S6: refresh the logged-on actor's own moderation counts (bypassing the page cache) so a
            // mute/block/flag's effect is visible immediately rather than after the 60s fresh window.
            await RefreshMyModerationAsync(bypassCache: true);
        }
        catch (Exception ex)
        {
            WriteError = ex.Message;
        }
        finally
        {
            WriteBusy = false;
        }
    }

    /// <summary>
    /// Re-reads the logged-on actor's own mutes/blocks/flags counts. After a mute/block/flag write the
    /// collections are served through the local collection-page cache, so a follow-up read bypasses the
    /// cache (refresh) to observe the update.
    /// </summary>
    private async Task RefreshMyModerationAsync(bool bypassCache = false)
    {
        if (Session.ActorIri is not { } selfIri)
        {
            return;
        }

        var client = Session.GetClient();
        var query = bypassCache ? new CollectionQuery(BypassCache: true) : null;
        MyModeration = (
            await CountAsync(client.GetMutesAsync(selfIri, query)),
            await CountAsync(client.GetBlocksAsync(selfIri, query)),
            await CountAsync(client.GetFlagsAsync(selfIri, query)));
    }

    /// <summary>
    /// Resolves a relay collection item to its IRI string (a relay is a link, or an object carrying an
    /// <c>id</c>). Null when the item carries no usable IRI.
    /// </summary>
    private static string? RelayIriOf(IObjectOrLink item)
    {
        if (item is IObject { Id: { } id })
        {
            return id;
        }

        if (item is ILink { Href: { } href })
        {
            return href.ToString();
        }

        return null;
    }

    private async Task SubscribeRelayAsync()
        => await RelayWriteAsync((actor, relay) => Session.GetClient().SubscribeRelayAsync(actor, relay));

    private async Task UnsubscribeRelayAsync()
        => await RelayWriteAsync((actor, relay) => Session.GetClient().UnsubscribeRelayAsync(actor, relay));

    private async Task RelayWriteAsync(Func<Iri, Iri, Task<DeliveryResult>> write)
    {
        if (!Session.IsLoggedIn || ActorIri is null)
        {
            return;
        }

        if (!Iri.TryParse(RelayIriInput.Trim(), out var relay))
        {
            RelayError = "The relay IRI is not a valid absolute URI.";
            return;
        }

        var actorIri = Session.ActorIri ?? throw new InvalidOperationException("No actor identity.");
        RelayBusy = true;
        RelayResult = null;
        RelayError = null;
        try
        {
            RelayResult = await write(actorIri, relay);
            // Refresh the relays list (bypassing the page cache) so the new (or removed) subscription is
            // visible immediately rather than after the cache's 60s fresh window lapses.
            await RefreshRelaysAsync(bypassCache: true);
        }
        catch (Exception ex)
        {
            RelayError = ex.Message;
        }
        finally
        {
            RelayBusy = false;
        }
    }

    private async Task RefreshRelaysAsync(bool bypassCache = false)
    {
        if (ActorIri is not { } actorIri)
        {
            return;
        }

        var relays = new List<string>();
        // After a subscribe/unsubscribe write the relays collection is served through the local
        // collection-page response cache, so a follow-up read bypasses the cache (refresh) to observe
        // the update instead of a stale page.
        var query = bypassCache ? new CollectionQuery(BypassCache: true) : null;
        await foreach (var relay in Session.GetClient().GetRelaysAsync(actorIri, query))
        {
            var iri = RelayIriOf(relay);
            if (iri is not null)
            {
                relays.Add(iri);
            }
        }

        Relays = relays;
    }
}
