@page "/compose"
@using System.Text.Json
@using Iris.Client
@using KristofferStrube.ActivityStreams

<PageTitle>Compose · Iris</PageTitle>

<h2>Compose</h2>

@if (!Session.IsLoggedIn)
{
    <div class="card">
        <p class="muted">Log on to an instance to compose.</p>
    </div>
}
else
{
    <div class="card">
        <p class="muted">Posting as <code>@(Session.ActorIri?.Value ?? "…")</code></p>
        <label for="content">Content</label>
        <textarea id="content" rows="4" @bind="Content" placeholder="What's on your mind?"></textarea>
        <label class="compose-toggle">
            <input id="markdown" type="checkbox" @bind="IsMarkdown" />
            <span>Markdown</span>
        </label>
        <p class="muted">
            When enabled, the content is rendered as Markdown (headings, <code>**bold**</code>,
            <code>*italic*</code>, links, lists, code) before it is posted — so it displays formatted.
            Leave off to post the content exactly as typed.
        </p>

        <label for="audience">Audience (optional — <code>Public</code> or comma-separated actor IRIs)</label>
        <input id="audience" type="text" @bind="Audience" placeholder="Public" />
        <p class="muted">
            Who the note is addressed to (<c>to</c>). <code>Public</code> addresses the public collection;
            leave empty for the default (unaddressed) audience.
        </p>

        <label>Attachment (optional — image; uploaded to the instance and attached)</label>
        <InputFile id="attachment" OnChange="OnAttachmentChosen" accept="image/*" />
        @if (MediaStatus is not null)
        {
            <p class="muted">@MediaStatus</p>
        }

        <label class="compose-toggle">
            <input id="sensitive" type="checkbox" @bind="IsSensitive" />
            <span>Mark as sensitive</span>
        </label>
        <p class="muted">
            Adds the ActivityStreams <c>sensitive</c> flag. Readers see a "may be sensitive" notice
            (with the summary below) and must reveal the content to see it.
        </p>
        <label for="summary">Sensitivity summary (optional — shown in place of the content)</label>
        <input id="summary" type="text" @bind="Summary" placeholder="e.g. Contains spoilers"
               disabled="@(!IsSensitive)" />

        <details>
            <summary>Reply to…</summary>
            <label for="parent">Parent note IRI (leave empty for a new post)</label>
            <input id="parent" type="url" @bind="ParentIri" placeholder="http://localhost/ap/v1/u/alice/notes/1" />
            <label for="mentions">Mentions (comma-separated actor IRIs, optional)</label>
            <input id="mentions" type="text" @bind="Mentions" placeholder="http://localhost/ap/v1/u/bob" />
        </details>

        <button @onclick="PostAsync" disabled="@(Busy)">@(string.IsNullOrWhiteSpace(ParentIri) ? "Post note" : "Post reply")</button>
        @if (Busy)
        {
            <span class="muted">Posting…</span>
        }
        @if (Result is not null)
        {
            <p class="muted">Status: <code>@Result</code></p>
        }
        @if (Error is not null)
        {
            <div class="error">@Error</div>
        }
    </div>
}

@code {
    [Inject]
    private ExplorerSession Session { get; set; } = default!;

    private string Content { get; set; } = string.Empty;
    private string ParentIri { get; set; } = string.Empty;
    private string Mentions { get; set; } = string.Empty;
    private string Audience { get; set; } = string.Empty;
    // 22.3 (US-11): Markdown content (rendered to HTML before posting) and the content-sensitivity
    // flag + summary (the ActivityStreams `sensitive` term + `summary` term).
    private bool IsMarkdown { get; set; }
    private bool IsSensitive { get; set; }
    private string Summary { get; set; } = string.Empty;
    private bool Busy { get; set; }
    private DeliveryResult? Result { get; set; }
    private string? Error { get; set; }

    // Phase 20.4 (a) media: the chosen attachment (a WASM IBrowserFile, held until posted) and the
    // upload result (the same-origin media IRI to set as the Image attachment's url). A null upload means
    // "not yet uploaded".
    private IBrowserFile? Attachment { get; set; }
    private MediaUploadResult? Media { get; set; }
    private string? MediaStatus { get; set; }

    /// <summary>The maximum attachment size accepted (10 MiB — matches the server's upload cap).</summary>
    private const long MaxAttachmentBytes = 10 * 1024 * 1024;

    /// <summary>
    /// Records the chosen attachment (a WASM <see cref="IBrowserFile"/>, read lazily at post time) and
    /// clears any previous upload. A no-op when nothing is chosen.
    /// </summary>
    private void OnAttachmentChosen(InputFileChangeEventArgs e)
    {
        Attachment = e.File;
        Media = null;
        MediaStatus = Attachment is null ? null : $"Selected {Attachment.Name} ({Attachment.Size} bytes) — will upload on post.";
    }

    private async Task PostAsync()
    {
        if (!Session.IsLoggedIn)
        {
            return;
        }

        var actorIri = Session.ActorIri ?? throw new InvalidOperationException("No actor identity.");
        Busy = true;
        Result = null;
        Error = null;
        try
        {
            var client = Session.GetClient();
            var to = ParseAudience();
            if (string.IsNullOrWhiteSpace(ParentIri))
            {
                // A top-level note: when an attachment was chosen, upload it first (a local,
                // Basic-authenticated multipart POST — not a signed inbox delivery) and build the note with
                // an Image attachment whose url is the returned same-origin media IRI (so the browser loads
                // it from the same origin, never a cross-origin media host — Decision 056 (b)).
                Note note;
                if (Attachment is { Size: > 0 } file)
                {
                    Media = await Session.GetMediaClient().UploadAsync(
                        actorIri,
                        await ReadBytesAsync(file),
                        file.ContentType ?? "application/octet-stream",
                        file.Name,
                        CancellationToken.None);
                    MediaStatus = $"Uploaded as {Media.MediaIri}.";

                    note = new Note
                    {
                        Content = [RenderedContent()],
                        AttributedTo = [new Link { Href = actorIri.Uri }],
                        // The Image's url is the same-origin media IRI (and its id mirrors it, so a reader
                        // can resolve the media without the url). mediaType + name come from the upload.
                        Attachment = [new Image
                        {
                            Url = [new Link { Href = Media.MediaIri.Uri }],
                            Id = Media.MediaIri.Value,
                            MediaType = Media.ContentType,
                            Name = [Media.FileName],
                        }],
                    };

                    ApplySensitivity(note);
                }
                else
                {
                    note = new Note
                    {
                        Content = [RenderedContent()],
                        AttributedTo = [new Link { Href = actorIri.Uri }],
                    };

                    ApplySensitivity(note);
                }

                if (to is not null && to.Count > 0)
                {
                    note.To = to.Select(i => new Link { Href = i.Uri }).ToList();
                }

                Result = await client.PostNoteAsync(actorIri, note);
            }
            else
            {
                Result = await client.PostReplyAsync(actorIri, new Iri(ParentIri.Trim()), Content, ParseMentions(), to);
            }

            // A posted note's attachment is consumed (uploaded + referenced); clear the selection.
            Attachment = null;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    /// <summary>
    /// Resolves the note's wire content (22.3 US-11): when the Markdown toggle is on, the typed content is
    /// rendered to safe HTML by the dependency-free <see cref="Markdown"/> renderer (headings, bold, italic,
    /// links, lists, code) and posted as HTML (the object view renders HTML content); otherwise the content
    /// is posted exactly as typed.
    /// </summary>
    private string RenderedContent()
        => IsMarkdown ? Markdown.ToHtml(Content) : Content;

    /// <summary>
    /// Applies the content-sensitivity inputs to <paramref name="note"/> (22.3 US-11): when
    /// <see cref="IsSensitive"/> is set, the ActivityStreams <c>sensitive</c> flag (in ExtensionData, the
    /// representation <c>IriExtensions.IsSensitive</c> reads) and — when a non-blank
    /// <see cref="Summary"/> is entered — the <c>summary</c> term (the preview text a client shows in place
    /// of a sensitive note's content until revealed) are set.
    /// </summary>
    private void ApplySensitivity(Note note)
    {
        if (!IsSensitive)
        {
            return;
        }

        note.ExtensionData ??= new Dictionary<string, JsonElement>();
        note.ExtensionData["sensitive"] = JsonSerializer.SerializeToElement(true);
        if (!string.IsNullOrWhiteSpace(Summary))
        {
            note.Summary = [Summary];
        }
    }

    /// <summary>Reads a WASM browser file's bytes (capped at <see cref="MaxAttachmentBytes"/>).</summary>
    private static async Task<byte[]> ReadBytesAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(MaxAttachmentBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        return ms.ToArray();
    }

    private IReadOnlyList<Iri>? ParseMentions()
    {
        if (string.IsNullOrWhiteSpace(Mentions))
        {
            return null;
        }

        var list = Mentions
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(m => new Iri(m))
            .ToList();
        return list.Count > 0 ? list : null;
    }

    /// <summary>The ActivityStreams public collection address (the conventional <c>to</c> for public notes).</summary>
    private static readonly Iri AsPublic = new("https://www.w3.org/ns/activitystreams#Public");

    /// <summary>
    /// Parses the audience input into the note's <c>to</c> links: <c>Public</c> (case-insensitive) maps to
    /// the <c>as:Public</c> address; otherwise each comma-separated entry is an actor IRI. Null when empty
    /// (the note carries no explicit <c>to</c>).
    /// </summary>
    private IReadOnlyList<Iri>? ParseAudience()
    {
        if (string.IsNullOrWhiteSpace(Audience))
        {
            return null;
        }

        var trimmed = Audience.Trim();
        if (trimmed.Equals("Public", StringComparison.OrdinalIgnoreCase))
        {
            return [AsPublic];
        }

        var list = trimmed
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(a => new Iri(a))
            .ToList();
        return list.Count > 0 ? list : null;
    }
}
