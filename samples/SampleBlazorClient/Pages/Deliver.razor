@page "/deliver"
@using Iris.Client
@using Iris.Core
@using KristofferStrube.ActivityStreams

<PageTitle>Raw delivery · Iris</PageTitle>

<h2>Raw delivery (DeliverAsync)</h2>

@if (!Session.IsLoggedIn)
{
    <div class="card">
        <p class="muted">Log on to an instance to use raw delivery.</p>
    </div>
}
else
{
    <div class="card">
        <p class="muted">
            The <c>DeliverAsync</c> escape hatch: a raw signed activity POSTed directly to an inbox. Every
            high-level write (follow, like, moderation, compose) routes through this method internally —
            this screen drives it directly, showing the exact activity JSON that is signed and sent.
        </p>

        <p>
            <label for="target">Target actor IRI (the follow's recipient)</label>
            <br />
            <input id="target" @bind="TargetIri" placeholder="https://iris-dev1.luit.ink/ap/v1/u/alice"
                   style="min-width: 320px" />
        </p>

        <p>
            <label for="as-actor">Act as (optional — signs as this actor instead of the logged-on one;
            e.g. a community IRI like <code>https://iris-dev1.luit.ink/ap/v1/c/iris</code>)</label>
            <br />
            <input id="as-actor" @bind="AsActorIri"
                   placeholder="https://iris-dev1.luit.ink/ap/v1/c/iris"
                   style="min-width: 320px" />
        </p>

        <p>
            <button @onclick="DeliverAsync" disabled="@(Busy)">Deliver Follow to target's inbox</button>
            @if (Busy)
            {
                <span class="muted">Delivering…</span>
            }
        </p>

        @if (Error is not null)
        {
            <div class="error">@Error</div>
        }

        @if (Result is not null)
        {
            <p>
                Status: <code>@Result.StatusCode</code>
                @if (Result.IsSuccess)
                {
                    <span class="muted">(success)</span>
                }
            </p>
        }

        @if (ActivityBody is not null)
        {
            <details>
                <summary>Activity JSON (signed + sent)</summary>
                <pre class="raw-json">@ActivityBody</pre>
            </details>
        }
    </div>
}

@code {
    [Inject]
    private ExplorerSession Session { get; set; } = default!;

    private string? TargetIri { get; set; }
    private string? AsActorIri { get; set; }
    private bool Busy { get; set; }
    private string? Error { get; set; }
    private DeliveryResult? Result { get; set; }
    private string? ActivityBody { get; set; }

    private Iri? SelfIri => Session.ActorIri;

    private async Task DeliverAsync()
    {
        var self = SelfIri ?? throw new InvalidOperationException("No actor identity.");
        var targetText = TargetIri?.Trim();
        if (string.IsNullOrWhiteSpace(targetText))
        {
            Error = "Enter a target actor IRI.";
            return;
        }

        Iri target;
        try
        {
            target = new Iri(targetText);
        }
        catch (Exception ex)
        {
            Error = $"Invalid target IRI: {ex.Message}";
            return;
        }

        // The 'act as' override: deliver as this actor (e.g. the seeded community) instead of the
        // logged-on actor. The activity carries the 'act as' actor as its actor (the outbox endpoint
        // requires the community as its own outbox's author); the X-Iris-Actor header makes the
        // pipeline's SigningHandler sign with the community's registered key (the client registers it
        // at logon from the instance's seeded key set).
        Iri signer = self;
        var asActorText = AsActorIri?.Trim();
        if (!string.IsNullOrWhiteSpace(asActorText))
        {
            try
            {
                signer = new Iri(asActorText);
            }
            catch (Exception ex)
            {
                Error = $"Invalid 'act as' IRI: {ex.Message}";
                return;
            }
        }

        Busy = true;
        Error = null;
        Result = null;
        try
        {
            // Build the Follow activity exactly as the high-level FollowAsync does, but deliver it
            // directly via the raw escape hatch (DeliverAsync) so the user sees the method exercised
            // standalone. The activity is signed by the pipeline as the logged-on actor and POSTed to
            // the target's inbox (target.InboxOf()).
            var follow = new Follow
            {
                Id = $"{signer.Value}/follows/{target.Value}",
                Actor = [new Link { Href = signer.Uri }],
                Object = [new Link { Href = target.Uri }],
            };

            ActivityBody = ActivityJson.Serialize(follow);

            var inbox = target.InboxOf();
            var request = new HttpRequestMessage(HttpMethod.Post, inbox.Uri)
            {
                Content = new StringContent(ActivityBody, System.Text.Encoding.UTF8, "application/activity+json"),
            };
            // When acting as another actor (e.g. the community) the X-Iris-Actor override makes the
            // pipeline sign with that actor's registered identity; for the logged-on actor it is the
            // client's default, so the header is omitted (the default path is unchanged).
            if (!signer.Equals(self))
            {
                request.Headers.Add("X-Iris-Actor", signer.Value);
            }

            var response = await Session.GetClient().SendAsync(request);
            var responseBody = await response.Content.ReadAsStringAsync();
            Result = new DeliveryResult((int)response.StatusCode, response.IsSuccessStatusCode, responseBody);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }
}
