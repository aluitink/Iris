@page "/community"
@using Iris.Client
@using KristofferStrube.ActivityStreams

<PageTitle>Community · Iris</PageTitle>

<h2>Community</h2>

<BackLink />

@if (!Session.IsLoggedIn)
{
    <div class="card">
        <p class="muted">Log on to an instance to view a community.</p>
    </div>
}
else
{
    <div class="card">
        <label for="name">Community (name on this instance)</label>
        <input id="name" type="text" @bind="Name" placeholder="iris" />
        <button @onclick="LoadAsync" disabled="@(Busy)">Load</button>
        @if (Busy)
        {
            <span class="muted">Loading…</span>
        }
    </div>

    <div class="card">
        <h3>Create a community</h3>
        <p class="muted">
            Publish a <c>Create</c> of a new Group to your outbox (the server materializes the
            community and federates it). After it is created, set the "Community" name above to the
            new name and click <c>Load</c> to review and manage it.
        </p>
        <label for="new-name">Name (handle on this instance)</label>
        <input id="new-name" type="text" @bind="CreateName" placeholder="e.g. mycommunity" />
        <label for="new-display">Display name</label>
        <input id="new-display" type="text" @bind="CreateDisplayName" placeholder="e.g. My Community" />
        <button @onclick="CreateCommunityAsync" disabled="@(CreateBusy)">Create</button>
        @if (CreateBusy)
        {
            <span class="muted">Creating…</span>
        }
        @if (CreateResult is not null)
        {
            <p class="muted">Status: <code>@CreateResult</code></p>
        }
        @if (CreateError is not null)
        {
            <div class="error">@CreateError</div>
        }
    </div>

    @if (LoadError is not null)
    {
        <div class="card">
            <div class="error">@LoadError</div>
        </div>
    }
    else if (CommunityIri is { } communityIri)
    {
        <ActorProfile Actor="CommunityDoc" ActorId="communityIri.Value" />

        <nav class="tabs" aria-label="Community sections">
            @foreach (var tab in Tabs)
            {
                <button class="tab @(tab.Key == ActiveTab ? "active" : null)" @onclick="() => SetActiveTab(tab.Key)" title="@(tab.Title)">
                    @tab.Title
                    @if (tab.Badge is { Length: > 0 } badge)
                    {
                        <span class="tab-badge">@badge</span>
                    }
                </button>
            }
        </nav>

        @if (ActiveTab is "following")
        {
            <CollectionBrowser
                Client="@Session.GetClient()"
                CollectionIri="@communityIri.FollowingOf()"
                Title="Following"
                Description="Actors/communities that this community follows (its following collection), paged with next-link walking. Each item links to the followed actor's detail."
                EmptyMessage="Not following anyone."
                ItemTemplate="@ActorLinkTemplate" />
        }

        @if (ActiveTab is "followers")
        {
            <CollectionBrowser
                Client="@Session.GetClient()"
                CollectionIri="@communityIri.FollowersOf()"
                Title="Followers"
                Description="Actors/communities that follow this community (its followers collection), paged with next-link walking. Each item links to the follower's actor detail."
                EmptyMessage="No followers recorded."
                ItemTemplate="@ActorLinkTemplate" />
        }

        @if (ActiveTab is "members")
        {
            <div class="card">
                <h3>Members</h3>
                <p class="muted">
                    The community's member actors (its <c>members</c> collection), each a clickable link to the
                    member's actor detail.
                </p>
                @if (Members is not null)
                {
                    @if (Members.Count == 0)
                    {
                        <p class="muted">No members.</p>
                    }
                    else
                    {
                        <p class="muted">@Members.Count member(s).</p>
                        <ul class="object-list">
                            @foreach (var item in Members)
                            {
                                <li>
                                    @if (item is ILink { Href: { } href })
                                    {
                                        <a href="/actor?iri=@Uri.EscapeDataString(href.ToString())" title="@href">
                                            @HandleOf(href.ToString())
                                        </a>
                                    }
                                    else if (item is IObject { Id: { Length: > 0 } fid })
                                    {
                                        <a href="/actor?iri=@Uri.EscapeDataString(fid)" title="@fid">
                                            @HandleOf(fid)
                                        </a>
                                    }
                                    else
                                    {
                                        <ObjectView Item="item" />
                                    }
                                    @if (MemberIriOf(item) is { } memberIri)
                                    {
                                        <button class="member-remove" @onclick="() => RemoveMemberFromListAsync(memberIri)"
                                                disabled="@MemberBusy" title="Remove this member">
                                            Remove
                                        </button>
                                    }
                                </li>
                            }
                        </ul>
                    }
                }
            </div>
        }

        @if (ActiveTab is "feed")
        {
            <div class="card">
                <h3>Feed</h3>
                <p class="muted">
                    The community's unified feed (its <c>feed</c> collection). Each item renders via
                    <c>ObjectView</c>; selecting it (the object link) navigates to the full object detail.
                </p>
                <div class="paged-collection-actions">
                    <button @onclick="RefreshFeedAsync" disabled="@(FeedRefreshing || CommunityIri is null)">
                        @(FeedRefreshing ? "Refreshing…" : "Refresh")
                    </button>
                </div>
                @if (Feed is not null)
                {
                    @if (Feed.Count == 0)
                    {
                        <p class="muted">No feed items.</p>
                    }
                    else
                    {
                        <p class="muted">@Feed.Count item(s).</p>
                        <ul class="object-list">
                            @foreach (var item in Feed)
                            {
                                <li>
                                    @if (FeedObjectIri(item) is { } feedIri)
                                    {
                                        <a href="/object?iri=@Uri.EscapeDataString(feedIri)" class="object-feed-link" title="@feedIri">
                                            <ObjectView Item="item" />
                                        </a>
                                    }
                                    else
                                    {
                                        <ObjectView Item="item" />
                                    }
                                </li>
                            }
                        </ul>
                    }
                }
            </div>
        }

        @if (ActiveTab is "manage")
        {
            <div class="card">
                <h3>Follow / unfollow</h3>
                <p class="muted">As <code>@(Session.ActorIri?.Value ?? "…")</code></p>
                <button @onclick="FollowAsync" disabled="@(WriteBusy)">Follow</button>
                <button @onclick="UnfollowAsync" disabled="@(WriteBusy)">Unfollow</button>
                @if (WriteBusy)
                {
                    <span class="muted">Working…</span>
                }
                @if (WriteResult is not null)
                {
                    <p class="muted">Status: <code>@WriteResult</code></p>
                }
                @if (WriteError is not null)
                {
                    <div class="error">@WriteError</div>
                }
            </div>

            <div class="card">
                <h3>Manage membership</h3>
                <p class="muted">Add or remove a member by IRI (self-management: the activity's actor is the
                    community, signed as the community — in the sample deployment the community signs with the
                    primary actor's key).</p>
                <label for="member-iri">Member IRI</label>
                <input id="member-iri" type="text" @bind="MemberIriInput"
                       placeholder="e.g. http://iris-dev1.luit.ink/ap/v1/u/alice" />
                <button @onclick="AddMemberAsync" disabled="@(MemberBusy)">Add member</button>
                <button @onclick="RemoveMemberAsync" disabled="@(MemberBusy)">Remove member</button>
                <button @onclick="RequestJoinAsync" disabled="@(MemberBusy)">Join (as me)</button>
                @if (MemberBusy)
                {
                    <span class="muted">Working…</span>
                }
                @if (MemberResult is not null)
                {
                    <p class="muted">Status: <code>@MemberResult</code></p>
                }
                @if (MemberError is not null)
                {
                    <div class="error">@MemberError</div>
                }
            </div>

            <div class="card">
                <h3>Peer management</h3>
                <p class="muted">The community follows or unfollows a specific actor (19.5.3 gap G-3 — the
                    community's outbound follow, signed as the community; in the sample deployment the
                    community signs with the primary actor's key).</p>
                <label for="peer-iri">Peer actor IRI</label>
                <input id="peer-iri" type="text" @bind="PeerIriInput"
                       placeholder="e.g. http://iris-dev2.luit.ink/ap/v1/u/carla" />
                <button @onclick="PeerFollowAsync" disabled="@(PeerBusy)">Community follows</button>
                <button @onclick="PeerUnfollowAsync" disabled="@(PeerBusy)">Community unfollows</button>
                @if (PeerBusy)
                {
                    <span class="muted">Working…</span>
                }
                @if (PeerResult is not null)
                {
                    <p class="muted">Status: <code>@PeerResult</code></p>
                }
                @if (PeerError is not null)
                {
                    <div class="error">@PeerError</div>
                }
            </div>

            <div class="card">
                <h3>Settings</h3>
                <p class="muted">
                    Community settings (AP-native, change 217): the <c>manuallyApprovesMembers</c> flag
                    controls whether join requests require operator approval (gated) or are auto-granted
                    (open). The flag is read from the community document's <c>ExtensionData</c>; toggling it
                    publishes an <c>Add</c> (enable) or <c>Remove</c> (disable) of the community's own
                    document to the community's outbox.
                </p>
                <p>
                    <strong>Require member approval:</strong>
                    @(IsGated ? "Yes (gated)" : "No (open)")
                </p>
                <button @onclick="EnableGatingAsync" disabled="@(SettingsBusy || IsGated)">Require approval</button>
                <button @onclick="DisableGatingAsync" disabled="@(SettingsBusy || !IsGated)">Open (auto-approve)</button>
                @if (SettingsBusy)
                {
                    <span class="muted">Working…</span>
                }
                @if (SettingsResult is not null)
                {
                    <p class="muted">Status: <code>@SettingsResult</code></p>
                }
                @if (SettingsError is not null)
                {
                    <div class="error">@SettingsError</div>
                }
            </div>

            <div class="card">
                <h3>Search</h3>
                <label for="q">Query</label>
                <input id="q" type="text" @bind="SearchQuery" placeholder="e.g. hello" />
                <button @onclick="SearchAsync" disabled="@(SearchBusy)">Search</button>
                @if (SearchBusy)
                {
                    <span class="muted">Searching…</span>
                }
                @if (SearchError is not null)
                {
                    <div class="error">@SearchError</div>
                }
                else if (SearchResults is not null)
                {
                    @if (SearchResults.Count == 0)
                    {
                        <p class="muted">No matching actors or content.</p>
                    }
                    else
                    {
                        <p class="muted">@SearchResults.Count result(s).</p>
                        <ul class="object-list">
                            @foreach (var item in SearchResults)
                            {
                                <li><ObjectView Item="item" /></li>
                            }
                        </ul>
                    }
                }
            </div>
        }

        @if (ActiveTab is "requests")
        {
            <div class="card">
                <h3>Inbound follows</h3>
                <p class="muted">
                    Follows <em>of</em> <code>@(CommunityIri?.Value ?? string.Empty)</code> (actors/communities that follow this
                    community), read from the community's outbox. Accept / reject are AP-native: the client
                    authors an <c>Accept</c>/<c>Reject</c> and publishes it to the community's outbox; the
                    instance records the edge and delivers the activity to the follower's inbox.
                </p>
                @if (PendingFollows is not null && PendingFollows.Count == 0)
                {
                    <p class="muted">No inbound follows recorded.</p>
                }
                @if (PendingFollows is not null)
                {
                    @foreach (var follow in PendingFollows)
                    {
                        <div class="pending-follow">
                            <code>@follow.FollowerIri</code>
                            <button @onclick="() => AcceptFollowAsync(follow.FollowIri)" disabled="@(FollowDecisionBusy)">Accept</button>
                            <button @onclick="() => RejectFollowAsync(follow.FollowIri)" disabled="@(FollowDecisionBusy)">Reject</button>
                            @if (FollowDecisionResult is not null)
                            {
                                <span class="muted">Status: <code>@FollowDecisionResult</code></span>
                            }
                        </div>
                    }
                }
                @if (FollowDecisionBusy)
                {
                    <span class="muted">Working…</span>
                }
                @if (FollowDecisionError is not null)
                {
                    <div class="error">@FollowDecisionError</div>
                }
            </div>

            <div class="card">
                <h3>Pending join requests</h3>
                <p class="muted">
                    Join requests <em>to</em> <code>@(CommunityIri?.Value ?? string.Empty)</code> (actors that requested to join
                    this community), read from the community's outbox. Accept / reject are AP-native: the
                    client authors an <c>Accept</c>/<c>Reject</c> referencing the Join activity's IRI and
                    publishes it to the community's outbox; the instance records the membership and delivers
                    the activity to the joiner's inbox.
                </p>
                @if (PendingJoins is not null && PendingJoins.Count == 0)
                {
                    <p class="muted">No pending join requests.</p>
                }
                @if (PendingJoins is not null)
                {
                    @foreach (var join in PendingJoins)
                    {
                        <div class="pending-join">
                            <a href="/actor?iri=@Uri.EscapeDataString(join.JoinerIri)" title="@join.JoinerIri">@HandleOf(join.JoinerIri)</a>
                            <button @onclick="() => AcceptJoinAsync(join.JoinIri)" disabled="@(JoinDecisionBusy)">Accept</button>
                            <button @onclick="() => RejectJoinAsync(join.JoinIri)" disabled="@(JoinDecisionBusy)">Reject</button>
                            @if (JoinDecisionResult is not null)
                            {
                                <span class="muted">Status: <code>@JoinDecisionResult</code></span>
                            }
                        </div>
                    }
                }
                @if (JoinDecisionBusy)
                {
                    <span class="muted">Working…</span>
                }
                @if (JoinDecisionError is not null)
                {
                    <div class="error">@JoinDecisionError</div>
                }
            </div>
        }

        @if (ActiveTab is "moderation")
        {
            <div class="card">
                <h3>Moderation</h3>
                <p class="muted">
                    As <code>@(CommunityIri?.Value ?? string.Empty)</code> (the community signs with the primary actor's key in
                    the sample deployment). Mute is a local, Basic-authenticated decision (no federation);
                    block / flag are signed writes to the community's own outbox (the instance records the
                    edge and federates to the target's inbox).
                </p>
                <label for="mod-target">Target actor IRI</label>
                <input id="mod-target" type="text" @bind="ModTargetInput"
                       placeholder="e.g. http://iris-dev1.luit.ink/ap/v1/u/carla" />
                <button @onclick="ModMuteAsync" disabled="@(ModBusy)">Mute</button>
                <button @onclick="ModUnmuteAsync" disabled="@(ModBusy)">Unmute</button>
                <button @onclick="ModBlockAsync" disabled="@(ModBusy)">Block</button>
                <button @onclick="ModUnblockAsync" disabled="@(ModBusy)">Unblock</button>
                <button @onclick="ModFlagAsync" disabled="@(ModBusy)">Flag</button>
                <button @onclick="ModUnflagAsync" disabled="@(ModBusy)">Unflag</button>
                @if (ModBusy)
                {
                    <span class="muted">Working…</span>
                }
                @if (ModResult is not null)
                {
                    <p class="muted">Status: <code>@ModResult</code></p>
                }
                @if (ModError is not null)
                {
                    <div class="error">@ModError</div>
                }
            </div>

            <div class="card">
                <h3>Moderation (this community's collections)</h3>
                <p class="muted">
                    The collections below show who <em>this community</em> has muted, blocked, and flagged
                    (their <c>mutes</c>/<c>blocks</c>/<c>flags</c> collections), paged with <c>next</c>-link
                    walking. Each item links to the moderated actor's detail. No per-item undo buttons: the
                    Decision 055 learned-id model requires the id of the original activity to undo it, which
                    these collections do not carry (they carry actor IRIs, not activity ids). The
                    unmute/unblock/unflag capability is provided by the "Moderation" card above.
                </p>
            </div>

            <CollectionBrowser
                Client="@Session.GetClient()"
                CollectionIri="@communityIri.MutesOf()"
                Title="Mutes"
                Description="Actors this community has muted (its mutes collection), paged with next-link walking. Each item links to the muted actor's detail."
                EmptyMessage="No mutes recorded."
                ItemTemplate="@ActorLinkTemplate" />

            <CollectionBrowser
                Client="@Session.GetClient()"
                CollectionIri="@communityIri.BlocksOf()"
                Title="Blocks"
                Description="Actors this community has blocked (its blocks collection), paged with next-link walking. Each item links to the blocked actor's detail."
                EmptyMessage="No blocks recorded."
                ItemTemplate="@ActorLinkTemplate" />

            <CollectionBrowser
                Client="@Session.GetClient()"
                CollectionIri="@communityIri.FlagsOf()"
                Title="Flags"
                Description="Actors this community has flagged (its flags collection), paged with next-link walking. Each item links to the flagged actor's detail."
                EmptyMessage="No flags recorded."
                ItemTemplate="@ActorLinkTemplate" />
        }

        @if (ActiveTab is "raw")
        {
            <RawInspector Document="CommunityDoc" Title="Raw inspector" />
        }
    }
}

@code {
    [Inject]
    private ExplorerSession Session { get; set; } = default!;

    private string Name { get; set; } = "iris";
    private string SearchQuery { get; set; } = string.Empty;
    private bool Busy { get; set; }
    private bool SearchBusy { get; set; }
    private Iri? CommunityIri { get; set; }
    private IObject? CommunityDoc { get; set; }

    // 31.6: the active detail tab (the one-long community page is organized into tabs, mirroring the
    // 31.5 actor-detail treatment). The key doubles as the @if selector in the markup (a string
    // literal match). The community's sections are grouped into: following/followers/members (the
    // social graph), feed (its unified feed), manage (follow + membership + peer + settings + search),
    // requests (inbound follows + pending joins), moderation (its mutes/blocks/flags), and raw.
    private string ActiveTab { get; set; } = "feed";

    /// <summary>
    /// A community detail tab: its key (the markup's @if selector), its title (the button label), and an
    /// optional badge (a short count shown on the button).
    /// </summary>
    private sealed record Tab(string Key, string Title, string? Badge = null);

    /// <summary>
    /// The community detail tabs, in display order.
    /// </summary>
    private IReadOnlyList<Tab> Tabs =>
    [
        new("feed", "Feed"),
        new("members", "Members"),
        new("followers", "Followers"),
        new("following", "Following"),
        new("manage", "Manage"),
        new("requests", "Requests"),
        new("moderation", "Moderation"),
        new("raw", "Raw"),
    ];

    /// <summary>
    /// Selects a community detail tab.
    /// </summary>
    private void SetActiveTab(string key) => ActiveTab = key;

    private IReadOnlyList<IObjectOrLink>? Feed { get; set; }
    private bool FeedRefreshing { get; set; }
    private IReadOnlyList<IObjectOrLink>? Members { get; set; }
    private IReadOnlyList<IObjectOrLink>? SearchResults { get; set; }
    private bool WriteBusy { get; set; }
    private string? WriteResult { get; set; }
    private string? WriteError { get; set; }
    private Iri? FollowLearnedId { get; set; }
    private string? LoadError { get; set; }
    private string? SearchError { get; set; }

    /// <summary>
    /// Inbound follows of the loaded community (actors/communities that follow this community), read
    /// from the community's outbox — the "pending follows" list the operator accepts/rejects (each is a
    /// (follower IRI, follow IRI) pair).
    /// </summary>
    private IReadOnlyList<(string FollowerIri, Iri FollowIri)>? PendingFollows { get; set; }
    private bool FollowDecisionBusy { get; set; }
    private DeliveryResult? FollowDecisionResult { get; set; }
    private string? FollowDecisionError { get; set; }

    /// <summary>
    /// Pending join requests to the loaded community (actors that requested to join), read from the
    /// community's outbox (the AP-native pattern: the Join activity is stored in the outbox, so its IRI
    /// is available for an Accept/Reject that references the original activity — mirroring inbound
    /// follows). Each is a (joiner IRI, join activity IRI) pair.
    /// </summary>
    private IReadOnlyList<(string JoinerIri, Iri JoinIri)>? PendingJoins { get; set; }
    private bool JoinDecisionBusy { get; set; }
    private DeliveryResult? JoinDecisionResult { get; set; }
    private string? JoinDecisionError { get; set; }

    private string? ModTargetInput { get; set; }
    private bool ModBusy { get; set; }
    private string? ModResult { get; set; }
    private string? ModError { get; set; }
    private Iri? ModBlockLearnedId { get; set; }
    private Iri? ModFlagLearnedId { get; set; }

    private string? MemberIriInput { get; set; }
    private bool MemberBusy { get; set; }
    private string? MemberResult { get; set; }
    private string? MemberError { get; set; }

    private string? PeerIriInput { get; set; }
    private bool PeerBusy { get; set; }
    private string? PeerResult { get; set; }
    private string? PeerError { get; set; }
    private Iri? PeerFollowLearnedId { get; set; }

    // Change 217: AP-native community settings (manuallyApprovesMembers flag).
    private bool SettingsBusy { get; set; }
    private string? SettingsResult { get; set; }
    private string? SettingsError { get; set; }

    /// <summary>
    /// Whether the loaded community requires manual approval of join requests (the
    /// <c>manuallyApprovesMembers</c> flag in the community document's <c>ExtensionData</c>).
    /// </summary>
    private bool IsGated
    {
        get
        {
            if (CommunityDoc is IObject { ExtensionData: { } ext })
            {
                return ext.TryGetValue("manuallyApprovesMembers", out var value)
                    && value.ValueKind == System.Text.Json.JsonValueKind.True;
            }

            return false;
        }
    }

    // 22.2 (US-18): the create-community surface. `CreateName` is the community's handle on this
    // instance (the path segment, e.g. `mycommunity` → `{base}/ap/v1/c/mycommunity`);
    // `CreateDisplayName` is the human-readable Group name. Publishing a `Create` of a Group to the
    // logged-on actor's outbox materializes the community (the server mints the id + collections).
    private string CreateName { get; set; } = "";
    private string CreateDisplayName { get; set; } = "";
    private bool CreateBusy { get; set; }
    private string? CreateResult { get; set; }
    private string? CreateError { get; set; }

    private async Task LoadAsync()
    {
        if (!Session.IsLoggedIn)
        {
            return;
        }

        Busy = true;
        CommunityIri = null;
        CommunityDoc = null;
        Feed = null;
        Members = null;
        LoadError = null;
        ActiveTab = "feed";
        try
        {
            var baseUri = Session.DialBaseUri ?? throw new InvalidOperationException("No dial base URI.");
            var communityIri = new Iri($"{baseUri.GetLeftPart(UriPartial.Authority)}/ap/v1/c/{Name.Trim()}");
            CommunityIri = communityIri;

            var client = Session.GetClient();

            // The community document (a Group, which is an Actor) — rendered for its name/icon/summary/url.
            var doc = await client.GetActorAsync(communityIri);
            if (doc is { } group)
            {
                CommunityDoc = group;
            }

            var feed = new List<IObjectOrLink>();
            await foreach (var item in client.GetCommunityFeedAsync(communityIri))
            {
                feed.Add(item);
            }

            Feed = feed;

            // Members: a community exposes its membership as an OrderedCollection at {community}/members.
            var members = new List<IObjectOrLink>();
            var membersIri = new Iri($"{communityIri.Value.TrimEnd('/')}/members");
            await foreach (var item in client.GetCollectionItemsAsync(membersIri))
            {
                members.Add(item);
            }

            Members = members;

            // Followers + following are read-only paged collections rendered by the shared
            // <CollectionBrowser> (it walks {community}/following and {community}/followers on demand).

            // 21.2.1: the community's moderation collections (mutes/blocks/flags) are read-only paged
            // collections rendered by the shared <CollectionBrowser> (they walk {community}/{mutes|blocks|
            // flags} on demand).

            // Inbound follows of this community (actors/communities that follow it), read from its
            // outbox (each inbound follow is stored in the followed community's outbox on receipt).
            // Shown as the "Inbound follows" list the operator can accept/reject (19.5.3).
            var inbound = new List<(string FollowerIri, Iri FollowIri)>();
            await foreach (var item in client.GetCollectionItemsAsync(communityIri.OutboxOf()))
            {
                if (item is Activity { Id: { } itemId, Type: { } types, Actor: { } actors }
                    && types.Contains("Follow")
                    && actors.FirstOrDefault()?.ResolveObjectIri() is { } follower)
                {
                    inbound.Add((follower.Value, new Iri(itemId)));
                }
            }

            PendingFollows = inbound;

            // Pending join requests to this community (actors that requested to join), read from the
            // same outbox as the inbound follows (the AP-native pattern: the Join activity is stored in
            // the community's outbox when manuallyApprovesMembers is set, so its IRI is available for an
            // Accept/Reject that references the original activity — mirroring inbound follows).
