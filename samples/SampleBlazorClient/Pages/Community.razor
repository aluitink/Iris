    /// <summary>
    /// The item renderer for the community's "Following" / "Followers" and moderation
    /// <c>CollectionBrowser</c> cards: each entry (a link or an object with an <c>id</c>) renders as a
    /// link to that actor's detail page, showing a short handle (<see cref="HandleOf"/>), or the relay
    /// IRI as a <c>&lt;code&gt;</c> when it carries no resolvable IRI. Built as a
    /// <see cref="RenderFragment{TData}"/> field (not an inline lambda attribute — Razor does not
    /// reliably parse multi-statement render-fragment attributes) so <c>CollectionBrowser</c> can render
    /// custom item markup.
    /// </summary>
    private static RenderFragment<IObjectOrLink> ActorLinkTemplate = item => builder =>
    {
        string? iri = item is ILink { Href: { } href } ? href.ToString()
            : item is IObject { Id: { Length: > 0 } id } ? id
            : RelayIriOf(item);

        if (iri is not null)
        {
            builder.OpenElement(0, "a");
            builder.AddAttribute(1, "href", $"/actor?iri={Uri.EscapeDataString(iri)}");
            builder.AddAttribute(2, "title", iri);
            builder.AddContent(3, HandleOf(iri));
            builder.CloseElement();
        }
    };

