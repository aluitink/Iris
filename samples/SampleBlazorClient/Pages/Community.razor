    // --- 19.5.4: community moderation (mute / block / flag) -----------------------------

    private Task ModMuteAsync()
        => ModDecisionAsync(isAdd: true, kind: ModKind.Mute);

    private Task ModUnmuteAsync()
        => ModDecisionAsync(isAdd: false, kind: ModKind.Mute);

    private Task ModBlockAsync()
        => ModDecisionAsync(isAdd: true, kind: ModKind.Block);

    private Task ModUnblockAsync()
        => ModDecisionAsync(isAdd: false, kind: ModKind.Block);

    private Task ModFlagAsync()
        => ModDecisionAsync(isAdd: true, kind: ModKind.Flag);

    private Task ModUnflagAsync()
        => ModDecisionAsync(isAdd: false, kind: ModKind.Flag);

    private enum ModKind { Mute, Block, Flag }

    private async Task ModDecisionAsync(bool isAdd, ModKind kind)
    {
        if (!Session.IsLoggedIn || CommunityIri is not { } communityIri || ModBusy)
        {
            return;
        }

        var targetIri = ModTargetInput?.Trim() ?? "";
        if (!Iri.TryParse(targetIri, out var target))
        {
            ModError = "Enter a valid target actor IRI (e.g. http://host/ap/v1/u/carla).";
            return;
        }

        ModBusy = true;
        ModResult = null;
        ModError = null;
        try
        {
            var client = Session.GetClient();
            var localClient = Session.GetLocalModerationClient();
            DeliveryResult result = kind switch
            {
                ModKind.Mute => isAdd
                    ? await localClient.MuteAsync(communityIri, target)
                    : await localClient.UnmuteAsync(communityIri, target),
                ModKind.Block => isAdd
                    ? await client.BlockAsync(communityIri, target)
                    : await client.UnblockAsync(communityIri, ModBlockLearnedId!.Value),
                ModKind.Flag => isAdd
                    ? await client.FlagAsync(communityIri, target)
                    : await client.UnflagAsync(communityIri, ModFlagLearnedId!.Value),
                _ => throw new InvalidOperationException($"Unknown moderation kind: {kind}"),
            };

            ModResult = result.IsSuccess
                ? $"{(isAdd ? kind.ToString().ToLowerInvariant() : "un" + kind.ToString().ToLowerInvariant())} (status {result.StatusCode})"
                : $"failed (status {result.StatusCode})";

            // Decision 055: learn the id the server minted for a created block/flag so a later undo can
            // reference it. Mute has no learned id (it is a local decision, not a federated activity).
            if (isAdd && result.IsSuccess && result.MintedId is { Length: > 0 } minted && Iri.TryParse(minted, out var learned))
            {
                if (kind == ModKind.Block)
                {
                    ModBlockLearnedId = learned;
                }
                else if (kind == ModKind.Flag)
                {
                    ModFlagLearnedId = learned;
                }
            }
            else if (!isAdd && result.IsSuccess)
            {
                if (kind == ModKind.Block)
                {
                    ModBlockLearnedId = null;
                }
                else if (kind == ModKind.Flag)
                {
                    ModFlagLearnedId = null;
                }
            }
        }
        catch (Exception ex)
        {
            ModError = ex.Message;
        }
        finally
        {
            ModBusy = false;
        }
    }

    // --- 19.8.4: display helpers ------------------------------------------------------

    /// <summary>
    /// A short display for an actor IRI string: the path's last segment (the username) when it looks
    /// like an actor IRI, else the raw IRI.
    /// </summary>
    private static string HandleOf(string iri)
    {
        var idx = iri.LastIndexOf('/');
        return idx >= 0 && idx < iri.Length - 1 ? iri[(idx + 1)..] : iri;
    }

    /// <summary>
    /// The IRI of a collection item for a non-link, non-object fallback display.
    /// </summary>
    private static string? RelayIriOf(IObjectOrLink item)
    {
        if (item is IObject { Id: { } id })
        {
            return id;
        }

        if (item is ILink { Href: { } href })
        {
            return href.ToString();
        }

        return null;
    }

    /// <summary>
    /// The IRI of a feed item (the object the feed entry represents) — the target of the feed item's
    /// clickable link to the object detail page. For an object with an <c>Id</c>, that id; for a link,
    /// its <c>Href</c>; else null (the item is rendered without a deep link).
    /// </summary>
    private static string? FeedObjectIri(IObjectOrLink item)
    {
        if (item is IObject { Id: { Length: > 0 } id })
        {
            return id;
        }

        if (item is ILink { Href: { } href })
        {
            return href.ToString();
        }

        return null;
    }

    /// <summary>
    /// The actor IRI of a member list item (an object's <c>Id</c> or a link's <c>Href</c>) — the target
    /// of the per-member <c>Remove</c> button (21.2.3). <c>null</c> when the item carries no IRI (it is
    /// rendered without a Remove button).
    /// </summary>
    private static Iri? MemberIriOf(IObjectOrLink item)
    {
        if (item is ILink { Href: { } href } && Iri.TryParse(href.ToString(), out var linkIri))
        {
            return linkIri;
        }

        if (item is IObject { Id: { Length: > 0 } fid } && Iri.TryParse(fid, out var iri))
        {
            return iri;
        }

        return null;
    }
