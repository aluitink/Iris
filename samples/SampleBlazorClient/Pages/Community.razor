    private async Task FollowDecisionAsync(Iri followIri, bool accept)
    {
        if (!Session.IsLoggedIn || CommunityIri is not { } communityIri)
        {
            return;
        }

        FollowDecisionBusy = true;
        FollowDecisionResult = null;
        FollowDecisionError = null;
        try
        {
            // Accept/reject are AP-native: the client authors the deterministic Accept/Reject and publishes
            // it to the community's own outbox (this community — the operator IS the followed community). The
            // instance records the edge effect and server-delivers the activity to the follower's inbox.
            FollowDecisionResult = accept
                ? await Session.GetClient().AcceptAsync(communityIri, followIri)
                : await Session.GetClient().RejectAsync(communityIri, followIri);

            // Refresh the inbound-follows list (bypassing the page cache) so the accepted/rejected follow's
            // Accept/Reject activity is visible immediately.
            await RefreshPendingFollowsAsync(bypassCache: true);
        }
        catch (Exception ex)
        {
            FollowDecisionError = ex.Message;
        }
        finally
        {
            FollowDecisionBusy = false;
        }
    }

    private async Task RefreshPendingFollowsAsync(bool bypassCache = false)
    {
        if (CommunityIri is not { } communityIri)
        {
            return;
        }

        var client = Session.GetClient();
        var query = bypassCache ? new CollectionQuery(BypassCache: true) : null;
        var inbound = new List<(string FollowerIri, Iri FollowIri)>();
        await foreach (var item in client.GetCollectionItemsAsync(communityIri.OutboxOf(), query))
        {
            if (item is Activity { Id: { } itemId, Type: { } types, Actor: { } actors }
                && types.Contains("Follow")
                && actors.FirstOrDefault()?.ResolveObjectIri() is { } follower)
            {
                inbound.Add((follower.Value, new Iri(itemId)));
            }
        }

        PendingFollows = inbound;
    }

