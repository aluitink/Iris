@page "/community"
@using Iris.Client
@using KristofferStrube.ActivityStreams

<PageTitle>Community · Iris</PageTitle>

<h2>Community</h2>

@if (!Session.IsLoggedIn)
{
    <div class="card">
        <p class="muted">Log on to an instance to view a community.</p>
    </div>
}
else
{
    <div class="card">
        <label for="name">Community (name on this instance)</label>
        <input id="name" type="text" @bind="Name" placeholder="iris" />
        <button @onclick="LoadAsync" disabled="@(Busy)">Load</button>
        @if (Busy)
        {
            <span class="muted">Loading…</span>
        }
    </div>

    @if (LoadError is not null)
    {
        <div class="card">
            <div class="error">@LoadError</div>
        </div>
    }
    else if (CommunityIri is not null)
    {
        <div class="card">
            <h3>Community</h3>
            <ObjectView Item="CommunityDoc" />
            <p class="muted">IRI: <code>@CommunityIri.Value</code></p>
        </div>

        <div class="card">
            <h3>Following</h3>
            <p class="muted">
                Actors/communities that <code>@CommunityIri.Value</code> follows (their <c>following</c>
                collection), paged with <c>next</c>-link walking. Each item links to the followed actor's
                detail.
            </p>
            @if (FollowingError is not null)
            {
                <div class="error">@FollowingError</div>
            }
            @if (FollowingItems is null)
            {
                <p class="muted">Loading…</p>
            }
            else if (FollowingItems.Count == 0 && !FollowingHasMore)
            {
                <p class="muted">Not following anyone.</p>
            }
            else
            {
                @if (FollowingItems.Count > 0)
                {
                    <ul class="object-list">
                        @foreach (var item in FollowingItems)
                        {
                            <li>
                                @if (item is ILink { Href: { } href })
                                {
                                    <a href="/actor?iri=@Uri.EscapeDataString(href.ToString())" title="@href">
                                        @HandleOf(href.ToString())
                                    </a>
                                }
                                else if (item is IObject { Id: { Length: > 0 } fid })
                                {
                                    <a href="/actor?iri=@Uri.EscapeDataString(fid)" title="@fid">
                                        @HandleOf(fid)
                                    </a>
                                }
                                else
                                {
                                    <code>@RelayIriOf(item)</code>
                                }
                            </li>
                        }
                    </ul>
                }
                @if (FollowingHasMore)
                {
                    <button @onclick="LoadMoreFollowingAsync" disabled="@(FollowingLoadingMore)">Load more</button>
                    @if (FollowingLoadingMore)
                    {
                        <span class="muted">Loading…</span>
                    }
                }
            }
        </div>

        <div class="card">
            <h3>Followers</h3>
            <p class="muted">
                Actors/communities that follow <code>@CommunityIri.Value</code> (their <c>followers</c>
                collection), paged with <c>next</c>-link walking. Each item links to the follower's actor
                detail.
            </p>
            @if (FollowersError is not null)
            {
                <div class="error">@FollowersError</div>
            }
            @if (FollowersItems is null)
            {
                <p class="muted">Loading…</p>
            }
            else if (FollowersItems.Count == 0 && !FollowersHasMore)
            {
                <p class="muted">No followers recorded.</p>
            }
            else
            {
                @if (FollowersItems.Count > 0)
                {
                    <ul class="object-list">
                        @foreach (var item in FollowersItems)
                        {
                            <li>
                                @if (item is ILink { Href: { } href })
                                {
                                    <a href="/actor?iri=@Uri.EscapeDataString(href.ToString())" title="@href">
                                        @HandleOf(href.ToString())
                                    </a>
                                }
                                else if (item is IObject { Id: { Length: > 0 } fid })
                                {
                                    <a href="/actor?iri=@Uri.EscapeDataString(fid)" title="@fid">
                                        @HandleOf(fid)
                                    </a>
                                }
                                else
                                {
                                    <code>@RelayIriOf(item)</code>
                                }
                            </li>
                        }
                    </ul>
                }
                @if (FollowersHasMore)
                {
                    <button @onclick="LoadMoreFollowersAsync" disabled="@(FollowersLoadingMore)">Load more</button>
                    @if (FollowersLoadingMore)
                    {
                        <span class="muted">Loading…</span>
                    }
                }
            }
        </div>

        <div class="card">
            <h3>Inbound follows</h3>
            <p class="muted">
                Follows <em>of</em> <code>@CommunityIri.Value</code> (actors/communities that follow this
                community), read from the community's outbox. Accept / reject are AP-native: the client
                authors an <c>Accept</c>/<c>Reject</c> and publishes it to the community's outbox; the
                instance records the edge and delivers the activity to the follower's inbox.
            </p>
            @if (PendingFollows is not null && PendingFollows.Count == 0)
            {
                <p class="muted">No inbound follows recorded.</p>
            }
            @if (PendingFollows is not null)
            {
                @foreach (var follow in PendingFollows)
                {
                    <div class="pending-follow">
                        <code>@follow.FollowerIri</code>
                        <button @onclick="() => AcceptFollowAsync(follow.FollowIri)" disabled="@(FollowDecisionBusy)">Accept</button>
                        <button @onclick="() => RejectFollowAsync(follow.FollowIri)" disabled="@(FollowDecisionBusy)">Reject</button>
                        @if (FollowDecisionResult is not null)
                        {
                            <span class="muted">Status: <code>@FollowDecisionResult</code></span>
                        }
                    </div>
                }
            }
            @if (FollowDecisionBusy)
            {
                <span class="muted">Working…</span>
            }
            @if (FollowDecisionError is not null)
            {
                <div class="error">@FollowDecisionError</div>
            }
        </div>

        <div class="card">
            <h3>Follow / unfollow</h3>
            <p class="muted">As <code>@(Session.ActorIri?.Value ?? "…")</code></p>
            <button @onclick="FollowAsync" disabled="@(WriteBusy)">Follow</button>
            <button @onclick="UnfollowAsync" disabled="@(WriteBusy)">Unfollow</button>
            @if (WriteBusy)
            {
                <span class="muted">Working…</span>
            }
            @if (WriteResult is not null)
            {
                <p class="muted">Status: <code>@WriteResult</code></p>
            }
            @if (WriteError is not null)
            {
                <div class="error">@WriteError</div>
            }
        </div>

        <div class="card">
            <h3>Manage membership</h3>
            <p class="muted">Add or remove a member by IRI (self-management: the activity's actor is the
                community, signed as the community — in the sample deployment the community signs with the
                primary actor's key).</p>
            <label for="member-iri">Member IRI</label>
            <input id="member-iri" type="text" @bind="MemberIriInput"
                   placeholder="e.g. http://iris-dev1.luit.ink/ap/v1/u/alice" />
            <button @onclick="AddMemberAsync" disabled="@(MemberBusy)">Add member</button>
            <button @onclick="RemoveMemberAsync" disabled="@(MemberBusy)">Remove member</button>
            @if (MemberBusy)
            {
                <span class="muted">Working…</span>
            }
            @if (MemberResult is not null)
            {
                <p class="muted">Status: <code>@MemberResult</code></p>
            }
            @if (MemberError is not null)
            {
                <div class="error">@MemberError</div>
            }
        </div>

        <div class="card">
            <h3>Peer management</h3>
            <p class="muted">The community follows or unfollows a specific actor (19.5.3 gap G-3 — the
                community's outbound follow, signed as the community; in the sample deployment the
                community signs with the primary actor's key).</p>
            <label for="peer-iri">Peer actor IRI</label>
            <input id="peer-iri" type="text" @bind="PeerIriInput"
                   placeholder="e.g. http://iris-dev2.luit.ink/ap/v1/u/carla" />
            <button @onclick="PeerFollowAsync" disabled="@(PeerBusy)">Community follows</button>
            <button @onclick="PeerUnfollowAsync" disabled="@(PeerBusy)">Community unfollows</button>
            @if (PeerBusy)
            {
                <span class="muted">Working…</span>
            }
            @if (PeerResult is not null)
            {
                <p class="muted">Status: <code>@PeerResult</code></p>
            }
            @if (PeerError is not null)
            {
                <div class="error">@PeerError</div>
            }
        </div>

        <div class="card">
            <h3>Feed</h3>
            <p class="muted">
                The community's unified feed (its <c>feed</c> collection). Each item renders via
                <c>ObjectView</c>; selecting it (the object link) navigates to the full object detail.
            </p>
            @if (Feed is not null)
            {
                @if (Feed.Count == 0)
                {
                    <p class="muted">No feed items.</p>
                }
                else
                {
                    <p class="muted">@Feed.Count item(s).</p>
                    <ul class="object-list">
                        @foreach (var item in Feed)
                        {
                            <li>
                                @if (FeedObjectIri(item) is { } feedIri)
                                {
                                    <a href="/object?iri=@Uri.EscapeDataString(feedIri)" class="object-feed-link" title="@feedIri">
                                        <ObjectView Item="item" />
                                    </a>
                                }
                                else
                                {
                                    <ObjectView Item="item" />
                                }
                            </li>
                        }
                    </ul>
                }
            }
        </div>

        <div class="card">
            <h3>Members</h3>
            <p class="muted">
                The community's member actors (its <c>members</c> collection), each a clickable link to the
                member's actor detail.
            </p>
            @if (Members is not null)
            {
                @if (Members.Count == 0)
                {
                    <p class="muted">No members.</p>
                }
                else
                {
                    <p class="muted">@Members.Count member(s).</p>
                    <ul class="object-list">
                        @foreach (var item in Members)
                        {
                            <li>
                                @if (item is ILink { Href: { } href })
                                {
                                    <a href="/actor?iri=@Uri.EscapeDataString(href.ToString())" title="@href">
                                        @HandleOf(href.ToString())
                                    </a>
                                }
                                else if (item is IObject { Id: { Length: > 0 } fid })
                                {
                                    <a href="/actor?iri=@Uri.EscapeDataString(fid)" title="@fid">
                                        @HandleOf(fid)
                                    </a>
                                }
                                else
                                {
                                    <ObjectView Item="item" />
                                }
                            </li>
                        }
                    </ul>
                }
            }
        </div>

        <div class="card">
            <h3>Search</h3>
            <label for="q">Query</label>
            <input id="q" type="text" @bind="SearchQuery" placeholder="e.g. hello" />
            <button @onclick="SearchAsync" disabled="@(SearchBusy)">Search</button>
            @if (SearchBusy)
            {
                <span class="muted">Searching…</span>
            }
            @if (SearchError is not null)
            {
                <div class="error">@SearchError</div>
            }
            else if (SearchResults is not null)
            {
                @if (SearchResults.Count == 0)
                {
                    <p class="muted">No matching actors or content.</p>
                }
                else
                {
                    <p class="muted">@SearchResults.Count result(s).</p>
                    <ul class="object-list">
                        @foreach (var item in SearchResults)
                        {
                            <li><ObjectView Item="item" /></li>
                        }
                    </ul>
                }
            }
        </div>
    }
}

@code {
    [Inject]
    private ExplorerSession Session { get; set; } = default!;

    private string Name { get; set; } = "iris";
    private string SearchQuery { get; set; } = string.Empty;
    private bool Busy { get; set; }
    private bool SearchBusy { get; set; }
    private Iri? CommunityIri { get; set; }
    private IObjectOrLink? CommunityDoc { get; set; }
    private IReadOnlyList<IObjectOrLink>? Feed { get; set; }
    private IReadOnlyList<IObjectOrLink>? Members { get; set; }
    private IReadOnlyList<IObjectOrLink>? SearchResults { get; set; }
    private List<IObjectOrLink>? FollowersItems { get; set; }
    private List<IObjectOrLink>? FollowingItems { get; set; }
    private bool FollowersHasMore { get; set; }
    private bool FollowingHasMore { get; set; }
    private bool FollowersLoadingMore { get; set; }
    private bool FollowingLoadingMore { get; set; }
    private Iri? _followersResumeFrom;
    private Iri? _followingResumeFrom;
    private string? FollowersError { get; set; }
    private string? FollowingError { get; set; }
    private bool WriteBusy { get; set; }
    private string? WriteResult { get; set; }
    private string? WriteError { get; set; }
    private Iri? FollowLearnedId { get; set; }
    private string? LoadError { get; set; }
    private string? SearchError { get; set; }

    /// <summary>
    /// Inbound follows of the loaded community (actors/communities that follow this community), read
    /// from the community's outbox — the "pending follows" list the operator accepts/rejects (each is a
    /// (follower IRI, follow IRI) pair).
    /// </summary>
    private IReadOnlyList<(string FollowerIri, Iri FollowIri)>? PendingFollows { get; set; }
    private bool FollowDecisionBusy { get; set; }
    private DeliveryResult? FollowDecisionResult { get; set; }
    private string? FollowDecisionError { get; set; }

    private string? MemberIriInput { get; set; }
    private bool MemberBusy { get; set; }
    private string? MemberResult { get; set; }
    private string? MemberError { get; set; }

    private string? PeerIriInput { get; set; }
    private bool PeerBusy { get; set; }
    private string? PeerResult { get; set; }
    private string? PeerError { get; set; }
    private Iri? PeerFollowLearnedId { get; set; }

    private async Task LoadAsync()
    {
        if (!Session.IsLoggedIn)
        {
            return;
        }

        Busy = true;
        CommunityIri = null;
        CommunityDoc = null;
        Feed = null;
        Members = null;
        FollowersItems = [];
        FollowingItems = [];
        FollowersHasMore = false;
        FollowingHasMore = false;
        _followersResumeFrom = null;
        _followingResumeFrom = null;
        FollowersError = null;
        FollowingError = null;
        LoadError = null;
        try
        {
            var baseUri = Session.DialBaseUri ?? throw new InvalidOperationException("No dial base URI.");
            var communityIri = new Iri($"{baseUri.GetLeftPart(UriPartial.Authority)}/ap/v1/c/{Name.Trim()}");
            CommunityIri = communityIri;

            var client = Session.GetClient();

            // The community document (a Group, which is an Actor) — rendered for its name/icon/summary/url.
            var doc = await client.GetActorAsync(communityIri);
            if (doc is { } group)
            {
                CommunityDoc = group;
            }

            var feed = new List<IObjectOrLink>();
            await foreach (var item in client.GetCommunityFeedAsync(communityIri))
            {
                feed.Add(item);
            }

            Feed = feed;

            // Members: a community exposes its membership as an OrderedCollection at {community}/members.
            var members = new List<IObjectOrLink>();
            var membersIri = new Iri($"{communityIri.Value.TrimEnd('/')}/members");
            await foreach (var item in client.GetCollectionItemsAsync(membersIri))
            {
                members.Add(item);
            }

            Members = members;

            // Followers + following: paged collections at {community}/followers and {community}/following.
            await LoadInitialFollowersAsync(communityIri);
            await LoadInitialFollowingAsync(communityIri);

            // Inbound follows of this community (actors/communities that follow it), read from its
            // outbox (each inbound follow is stored in the followed community's outbox on receipt).
            // Shown as the "Inbound follows" list the operator can accept/reject (19.5.3).
            var inbound = new List<(string FollowerIri, Iri FollowIri)>();
            await foreach (var item in client.GetCollectionItemsAsync(communityIri.OutboxOf()))
            {
                if (item is Activity { Id: { } itemId, Type: { } types, Actor: { } actors }
                    && types.Contains("Follow")
                    && actors.FirstOrDefault()?.ResolveObjectIri() is { } follower)
                {
                    inbound.Add((follower.Value, new Iri(itemId)));
                }
            }

            PendingFollows = inbound;
        }
        catch (Exception ex)
        {
            LoadError = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task SearchAsync()
    {
        if (!Session.IsLoggedIn)
        {
            return;
        }

        SearchBusy = true;
        SearchResults = null;
        SearchError = null;
        try
        {
            var baseUri = Session.DialBaseUri ?? throw new InvalidOperationException("No dial base URI.");
            var instanceBase = new Iri($"{baseUri.GetLeftPart(UriPartial.Authority)}/ap/v1");
            var results = new List<IObjectOrLink>();
            await foreach (var item in Session.GetClient().SearchAsync(instanceBase, SearchQuery))
            {
                results.Add(item);
            }

            SearchResults = results;
        }
        catch (Exception ex)
        {
            SearchError = ex.Message;
        }
        finally
        {
            SearchBusy = false;
        }
    }

    // --- 19.8.4: followers + following collections (paged, clickable) -----------------

    private async Task LoadInitialFollowersAsync(Iri communityIri)
    {
        FollowersItems = [];
        FollowersHasMore = false;
        FollowersError = null;
        _followersResumeFrom = null;
        try
        {
            await EnumerateOneFollowersPageAsync(communityIri);
        }
        catch (Exception ex)
        {
            FollowersError = ex.Message;
        }
    }

    private async Task LoadMoreFollowersAsync()
    {
        if (FollowersLoadingMore || !FollowersHasMore || CommunityIri is not { } communityIri)
        {
            return;
        }

        FollowersLoadingMore = true;
        FollowersError = null;
        try
        {
            await EnumerateOneFollowersPageAsync(communityIri);
        }
        catch (Exception ex)
        {
            FollowersError = ex.Message;
        }
        finally
        {
            FollowersLoadingMore = false;
        }
    }

    private async Task EnumerateOneFollowersPageAsync(Iri communityIri)
    {
        var client = Session.GetClient();
        if (_followersResumeFrom is { } resume)
        {
            await foreach (var page in client.GetCollectionAsync(resume, null, CancellationToken.None))
            {
                FollowersItems ??= [];
                FollowersItems.AddRange(page.Items);
                FollowersHasMore = !page.IsLastPage;
                _followersResumeFrom = page.NextPage;
                break;
            }

            return;
        }

        await foreach (var page in client.GetCollectionAsync(communityIri.FollowersOf(), null, CancellationToken.None))
        {
            FollowersItems ??= [];
            FollowersItems.AddRange(page.Items);
            FollowersHasMore = !page.IsLastPage;
            _followersResumeFrom = page.NextPage;
            break;
        }
    }

    private async Task LoadInitialFollowingAsync(Iri communityIri)
    {
        FollowingItems = [];
        FollowingHasMore = false;
        FollowingError = null;
        _followingResumeFrom = null;
        try
        {
            await EnumerateOneFollowingPageAsync(communityIri);
        }
        catch (Exception ex)
        {
            FollowingError = ex.Message;
        }
    }

    private async Task LoadMoreFollowingAsync()
    {
        if (FollowingLoadingMore || !FollowingHasMore || CommunityIri is not { } communityIri)
        {
            return;
        }

        FollowingLoadingMore = true;
        FollowingError = null;
        try
        {
            await EnumerateOneFollowingPageAsync(communityIri);
        }
        catch (Exception ex)
        {
            FollowingError = ex.Message;
        }
        finally
        {
            FollowingLoadingMore = false;
        }
    }

    private async Task EnumerateOneFollowingPageAsync(Iri communityIri)
    {
        var client = Session.GetClient();
        if (_followingResumeFrom is { } resume)
        {
            await foreach (var page in client.GetCollectionAsync(resume, null, CancellationToken.None))
            {
                FollowingItems ??= [];
                FollowingItems.AddRange(page.Items);
                FollowingHasMore = !page.IsLastPage;
                _followingResumeFrom = page.NextPage;
                break;
            }

            return;
        }

        await foreach (var page in client.GetCollectionAsync(communityIri.FollowingOf(), null, CancellationToken.None))
        {
            FollowingItems ??= [];
            FollowingItems.AddRange(page.Items);
            FollowingHasMore = !page.IsLastPage;
            _followingResumeFrom = page.NextPage;
            break;
        }
    }

    // --- 19.8.4: community follow / unfollow -----------------------------------------

    private async Task FollowAsync()
    {
        if (!Session.IsLoggedIn || CommunityIri is not { } communityIri || WriteBusy)
        {
            return;
        }

        var actorIri = Session.ActorIri ?? throw new InvalidOperationException("No actor identity.");
        WriteBusy = true;
        WriteResult = null;
        WriteError = null;
        try
        {
            var result = await Session.GetClient().FollowAsync(actorIri, communityIri);
            WriteResult = result.IsSuccess ? $"followed (status {result.StatusCode})" : $"failed (status {result.StatusCode})";
            if (result.IsSuccess && result.MintedId is { } minted && Iri.TryParse(minted, out var learned))
            {
                // Decision 055: learn the id the server minted for the created Follow so a later
                // Unfollow can reference it. On a non-IRI minted id leave the previous learned id untouched.
                FollowLearnedId = learned;
            }
        }
        catch (Exception ex)
        {
            WriteError = ex.Message;
        }
        finally
        {
            WriteBusy = false;
        }
    }

    private async Task UnfollowAsync()
    {
        if (!Session.IsLoggedIn || CommunityIri is not { } communityIri || FollowLearnedId is not { } followIri || WriteBusy)
        {
            return;
        }

        var actorIri = Session.ActorIri ?? throw new InvalidOperationException("No actor identity.");
        WriteBusy = true;
        WriteResult = null;
        WriteError = null;
        try
        {
            var result = await Session.GetClient().UndoFollowAsync(actorIri, followIri);
            WriteResult = result.IsSuccess ? $"unfollowed (status {result.StatusCode})" : $"failed (status {result.StatusCode})";
            if (result.IsSuccess)
            {
                FollowLearnedId = null;
            }
        }
        catch (Exception ex)
        {
            WriteError = ex.Message;
        }
        finally
        {
            WriteBusy = false;
        }
    }

    private async Task AddMemberAsync()
    {
        await ManageMemberAsync(isAdd: true);
    }

    private async Task RemoveMemberAsync()
    {
        await ManageMemberAsync(isAdd: false);
    }

    private async Task ManageMemberAsync(bool isAdd)
    {
        if (!Session.IsLoggedIn || CommunityIri is not { } communityIri || MemberBusy)
        {
            return;
        }

        var memberIri = MemberIriInput?.Trim() ?? "";
        if (Iri.TryParse(memberIri, out var member))
        {
            MemberBusy = true;
            MemberResult = null;
            MemberError = null;
            try
            {
                var result = isAdd
                    ? await Session.GetClient().AddMemberAsync(communityIri, member)
                    : await Session.GetClient().RemoveMemberAsync(communityIri, member);
                MemberResult = result.IsSuccess
                    ? $"{(isAdd ? "added" : "removed")} member (status {result.StatusCode})"
                    : $"failed (status {result.StatusCode})";
            }
            catch (Exception ex)
            {
                MemberError = ex.Message;
            }
            finally
            {
                MemberBusy = false;
            }
        }
        else
        {
            MemberError = "Enter a valid member IRI (e.g. http://host/ap/v1/u/alice).";
        }
    }

    private async Task PeerFollowAsync()
    {
        if (!Session.IsLoggedIn || CommunityIri is not { } communityIri || PeerBusy)
        {
            return;
        }

        var peerIri = PeerIriInput?.Trim() ?? "";
        if (!Iri.TryParse(peerIri, out var target))
        {
            PeerError = "Enter a valid peer actor IRI (e.g. http://host/ap/v1/u/carla).";
            return;
        }

        PeerBusy = true;
        PeerResult = null;
        PeerError = null;
        try
        {
            // The community follows the peer: FollowAsync(communityIri, target) — the activity's actor is
            // the community, published to the community's outbox, signed as the community (the 19.5.3
            // outbound follow, gap G-3). The minted follow id is learned for a later undo.
            var result = await Session.GetClient().FollowAsync(communityIri, target);
            PeerResult = result.IsSuccess ? $"community followed (status {result.StatusCode})" : $"failed (status {result.StatusCode})";
            if (result.IsSuccess && result.MintedId is { Length: > 0 } minted && Iri.TryParse(minted, out var learned))
            {
                PeerFollowLearnedId = learned;
            }
        }
        catch (Exception ex)
        {
            PeerError = ex.Message;
        }
        finally
        {
            PeerBusy = false;
        }
    }

    private async Task PeerUnfollowAsync()
    {
        if (!Session.IsLoggedIn || CommunityIri is not { } communityIri || PeerFollowLearnedId is not { } followIri || PeerBusy)
        {
            PeerError = "Follow a peer first (the undo references the learned follow id).";
            return;
        }

        PeerBusy = true;
        PeerResult = null;
        PeerError = null;
        try
        {
            var result = await Session.GetClient().UndoFollowAsync(communityIri, followIri);
            PeerResult = result.IsSuccess ? $"community unfollowed (status {result.StatusCode})" : $"failed (status {result.StatusCode})";
            if (result.IsSuccess)
            {
                PeerFollowLearnedId = null;
            }
        }
        catch (Exception ex)
        {
            PeerError = ex.Message;
        }
        finally
        {
            PeerBusy = false;
        }
    }

    // --- 19.5.3: community inbound-follow accept/reject --------------------------------

    private Task AcceptFollowAsync(Iri followIri)
        => FollowDecisionAsync(followIri, accept: true);

    private Task RejectFollowAsync(Iri followIri)
        => FollowDecisionAsync(followIri, accept: false);

    private async Task FollowDecisionAsync(Iri followIri, bool accept)
    {
        if (!Session.IsLoggedIn || CommunityIri is not { } communityIri)
        {
            return;
        }

        FollowDecisionBusy = true;
        FollowDecisionResult = null;
        FollowDecisionError = null;
        try
        {
            // Accept/reject are AP-native: the client authors the deterministic Accept/Reject and publishes
            // it to the community's own outbox (this community — the operator IS the followed community). The
            // instance records the edge effect and server-delivers the activity to the follower's inbox.
            FollowDecisionResult = accept
                ? await Session.GetClient().AcceptAsync(communityIri, followIri)
                : await Session.GetClient().RejectAsync(communityIri, followIri);

            // Refresh the inbound-follows list (bypassing the page cache) so the accepted/rejected follow's
            // Accept/Reject activity is visible immediately.
            await RefreshPendingFollowsAsync(bypassCache: true);
        }
        catch (Exception ex)
        {
            FollowDecisionError = ex.Message;
        }
        finally
        {
            FollowDecisionBusy = false;
        }
    }

    private async Task RefreshPendingFollowsAsync(bool bypassCache = false)
    {
        if (CommunityIri is not { } communityIri)
        {
            return;
        }

        var client = Session.GetClient();
        var query = bypassCache ? new CollectionQuery(BypassCache: true) : null;
        var inbound = new List<(string FollowerIri, Iri FollowIri)>();
        await foreach (var item in client.GetCollectionItemsAsync(communityIri.OutboxOf(), query))
        {
            if (item is Activity { Id: { } itemId, Type: { } types, Actor: { } actors }
                && types.Contains("Follow")
                && actors.FirstOrDefault()?.ResolveObjectIri() is { } follower)
            {
                inbound.Add((follower.Value, new Iri(itemId)));
            }
        }

        PendingFollows = inbound;
    }

    // --- 19.8.4: display helpers ------------------------------------------------------

    /// <summary>
    /// A short display for an actor IRI string: the path's last segment (the username) when it looks
    /// like an actor IRI, else the raw IRI.
    /// </summary>
    private static string HandleOf(string iri)
    {
        var idx = iri.LastIndexOf('/');
        return idx >= 0 && idx < iri.Length - 1 ? iri[(idx + 1)..] : iri;
    }

    /// <summary>
    /// The IRI of a collection item for a non-link, non-object fallback display.
    /// </summary>
    private static string? RelayIriOf(IObjectOrLink item)
    {
        if (item is IObject { Id: { } id })
        {
            return id;
        }

        if (item is ILink { Href: { } href })
        {
            return href.ToString();
        }

        return null;
    }

    /// <summary>
    /// The IRI of a feed item (the object the feed entry represents) — the target of the feed item's
    /// clickable link to the object detail page. For an object with an <c>Id</c>, that id; for a link,
    /// its <c>Href</c>; else null (the item is rendered without a deep link).
    /// </summary>
    private static string? FeedObjectIri(IObjectOrLink item)
    {
        if (item is IObject { Id: { Length: > 0 } id })
        {
            return id;
        }

        if (item is ILink { Href: { } href })
        {
            return href.ToString();
        }

        return null;
    }
}
