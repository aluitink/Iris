@page "/instance"
@using Iris.Client

<PageTitle>Instance overview · Iris</PageTitle>

<h2>Instance overview</h2>

@if (!Session.IsLoggedIn)
{
    <div class="card">
        <p class="muted">Log on to an instance to see its overview.</p>
    </div>
}
else
{
    <div class="card">
        @if (Busy)
        {
            <p class="muted">Loading instance metadata…</p>
        }
        else if (Error is not null)
        {
            <div class="error">@Error</div>
        }
        else if (NodeInfo is null)
        {
            <p class="muted">This instance does not serve NodeInfo (or the request failed).</p>
        }
        else
        {
            <table class="kv">
                <tr><th>Instance</th><td>@(NodeInfo.InstanceName ?? "(unnamed)")</td></tr>
                <tr><th>Software</th><td>@(NodeInfo.SoftwareName ?? "unknown")@(NodeInfo.SoftwareVersion is { Length: > 0 } v ? $" {v}" : "")</td></tr>
                <tr><th>Protocols</th><td>@(NodeInfo.Protocols.Count > 0 ? string.Join(", ", NodeInfo.Protocols) : "—")</td></tr>
                <tr><th>Open registrations</th><td>@(NodeInfo.OpenRegistrations ? "yes" : "no")</td></tr>
                <tr><th>NodeInfo</th><td>@NodeInfo.Version</td></tr>
            </table>
            @if (NodeInfo.Description is { Length: > 0 } desc)
            {
                <p class="muted">@desc</p>
            }
            <p class="muted">
                Logged on as <code>@(Session.ResolvedActorIri?.Value ?? Session.ActorIri?.Value)</code>,
                dialing <code>@Session.DialBaseUri</code>.
            </p>
        }
    </div>

    @if (Session.RecentInstances.Count > 0)
    {
        <div class="card">
            <h2>Recent instances</h2>
            <p class="muted">
                Switch instance: re-enter the password and the session logs out of the current
                identity and logs on to the selected instance by its WebFinger address.
            </p>
            <ul class="recents">
                @foreach (var recent in Session.RecentInstances)
                {
                    <li>
                        <code>@recent.Handle</code>@recent.Host
                        @if (recent.DialBaseUri == (Session.DialBaseUri ?? recent.DialBaseUri))
                        {
                            <span class="muted">(current)</span>
                        }
                        else if (SwitchTarget is not null && SwitchTarget == recent)
                        {
                            <input class="inline" type="password" @bind="SwitchPassword" placeholder="password" />
                            <button @onclick="() => SwitchAsync(recent)" disabled="@(SwitchBusy)">Switch</button>
                        }
                        else
                        {
                            <button class="secondary" @onclick="() => SelectSwitchTarget(recent)">Use</button>
                        }
                    </li>
                }
            </ul>
            @if (SwitchBusy)
            {
                <span class="muted">Switching…</span>
            }
            @if (SwitchError is not null)
            {
                <div class="error">@SwitchError</div>
            }
        </div>
    }
}

@code {
    [Inject]
    private ExplorerSession Session { get; set; } = default!;

    private NodeInfo? NodeInfo { get; set; }
    private bool Busy { get; set; }
    private string? Error { get; set; }

    // 19.8.1 gap (b): the Instance page's recent-instances list (one-click instance switching,
    // mirroring the Home page's surface). The current instance (dial base match) is shown with a
    // "(current)" marker instead of a switch button.
    private RecentInstance? SwitchTarget { get; set; }
    private string SwitchPassword { get; set; } = "iris-sample";
    private bool SwitchBusy { get; set; }
    private string? SwitchError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn)
        {
            return;
        }

        Busy = true;
        try
        {
            // The instance base IRI is the dial base + /ap/v1 (the route prefix the server maps its
            // endpoints under). NodeInfo is served at {base}/nodeinfo/2.0.
            var baseUri = Session.DialBaseUri ?? throw new InvalidOperationException("No dial base URI.");
            var instanceBase = new Iri($"{baseUri.GetLeftPart(UriPartial.Authority)}/ap/v1");
            NodeInfo = await Session.GetClient().GetNodeInfoAsync(instanceBase);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private void SelectSwitchTarget(RecentInstance recent)
    {
        SwitchTarget = recent;
        SwitchError = null;
        StateHasChanged();
    }

    private async Task SwitchAsync(RecentInstance recent)
    {
        SwitchBusy = true;
        SwitchError = null;
        try
        {
            var ok = await Session.SwitchInstanceAsync(recent, SwitchPassword);
            if (!ok)
            {
                SwitchError = "Switch failed (wrong password, or the instance is no longer running?).";
                return;
            }

            SwitchTarget = null;
            // Re-load the NodeInfo for the newly switched-to instance.
            NodeInfo = null;
            Error = null;
            Busy = true;
            try
            {
                var baseUri = Session.DialBaseUri ?? throw new InvalidOperationException("No dial base URI.");
                var instanceBase = new Iri($"{baseUri.GetLeftPart(UriPartial.Authority)}/ap/v1");
                NodeInfo = await Session.GetClient().GetNodeInfoAsync(instanceBase);
            }
            catch (Exception ex)
            {
                Error = ex.Message;
            }
            finally
            {
                Busy = false;
            }
        }
        catch (Exception ex)
        {
            SwitchError = ex.Message;
        }
        finally
        {
            SwitchBusy = false;
        }
    }
}
