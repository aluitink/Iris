@page "/instance"
@using Iris.Client

<PageTitle>Instance overview · Iris</PageTitle>

<h2>Instance overview</h2>

@if (!Session.IsLoggedIn)
{
    <div class="card">
        <p class="muted">Log on to an instance to see its overview.</p>
    </div>
}
else
{
    <div class="card">
        @if (Busy)
        {
            <p class="muted">Loading instance metadata…</p>
        }
        else if (Error is not null)
        {
            <div class="error">@Error</div>
        }
        else if (NodeInfo is null)
        {
            <p class="muted">This instance does not serve NodeInfo (or the request failed).</p>
        }
        else
        {
            <table class="kv">
                <tr><th>Instance</th><td>@(NodeInfo.InstanceName ?? "(unnamed)")</td></tr>
                <tr><th>Software</th><td>@(NodeInfo.SoftwareName ?? "unknown")@(NodeInfo.SoftwareVersion is { Length: > 0 } v ? $" {v}" : "")</td></tr>
                <tr><th>Protocols</th><td>@(NodeInfo.Protocols.Count > 0 ? string.Join(", ", NodeInfo.Protocols) : "—")</td></tr>
                <tr><th>Open registrations</th><td>@(NodeInfo.OpenRegistrations ? "yes" : "no")</td></tr>
                <tr><th>NodeInfo</th><td>@NodeInfo.Version</td></tr>
            </table>
            @if (NodeInfo.Description is { Length: > 0 } desc)
            {
                <p class="muted">@desc</p>
            }
            <p class="muted">
                Logged on as <code>@(Session.ResolvedActorIri?.Value ?? Session.ActorIri?.Value)</code>,
                dialing <code>@Session.DialBaseUri</code>.
            </p>
        }
    </div>

    <div class="card">
        <h3>Resolve a handle (WebFinger)</h3>
        <p class="muted">
            Resolve a <c>handle@host</c> address to an actor IRI via this instance's WebFinger
            (the <c>/.well-known/webfinger</c> document), then jump to the actor's detail page. The
            query dials the current instance's base (<code>@DialBaseLabel</code>); for a cross-instance
            handle the host part is what the query carries, but the dial reaches the current instance
            (use the recent-instances switch below to resolve on another host).
        </p>
        <input class="inline" type="text" @bind="LookupHandle" placeholder="e.g. alice@iris-dev1.luit.ink" />
        <button @onclick="LookupAsync" disabled="@(LookupBusy)">Resolve</button>
        @if (LookupBusy)
        {
            <span class="muted">Resolving…</span>
        }
        @if (LookupError is not null)
        {
            <div class="error">@LookupError</div>
        }
        @if (LookupHref is not null)
        {
            <p>
                Resolved <code>@LookupHandleInput</code> →
                <a href="@LookupHref">@LookupIri</a>
            </p>
        }
        else if (LookupAttempted && LookupIri is null)
        {
            <p class="muted">Could not resolve that address on this instance.</p>
        }
    </div>

    @if (Session.RecentInstances.Count > 0)
    {
        <div class="card">
            <h2>Recent instances</h2>
            <p class="muted">
                Switch instance: re-enter the password and the session logs out of the current
                identity and logs on to the selected instance by its WebFinger address.
            </p>
            <ul class="recents">
                @foreach (var recent in Session.RecentInstances)
                {
                    <li>
                        <code>@recent.Handle</code>@recent.Host
                        @if (recent.DialBaseUri == (Session.DialBaseUri ?? recent.DialBaseUri))
                        {
                            <span class="muted">(current)</span>
                        }
                        else if (SwitchTarget is not null && SwitchTarget == recent)
                        {
                            <input class="inline" type="password" @bind="SwitchPassword" placeholder="password" />
                            <button @onclick="() => SwitchAsync(recent)" disabled="@(SwitchBusy)">Switch</button>
                        }
                        else
                        {
                            <button class="secondary" @onclick="() => SelectSwitchTarget(recent)">Use</button>
                        }
                    </li>
                }
            </ul>
            @if (SwitchBusy)
            {
                <span class="muted">Switching…</span>
            }
            @if (SwitchError is not null)
            {
                <div class="error">@SwitchError</div>
            }
        </div>
    }
}

@code {
    [Inject]
    private ExplorerSession Session { get; set; } = default!;

    private NodeInfo? NodeInfo { get; set; }
    private bool Busy { get; set; }
    private string? Error { get; set; }

    // 19.8.1 gap (b): the Instance page's recent-instances list (one-click instance switching,
    // mirroring the Home page's surface). The current instance (dial base match) is shown with a
    // "(current)" marker instead of a switch button.
    private RecentInstance? SwitchTarget { get; set; }
    private string SwitchPassword { get; set; } = "iris-sample";
    private bool SwitchBusy { get; set; }
    private string? SwitchError { get; set; }

    // 22.2 (US-10): the WebFinger handle-lookup card. `LookupHandle` is the bound input; `LookupIri`
    // is the resolved actor IRI (null until a successful resolve). The resolve dials the current
    // instance's base URI (the host-published port for local instances) via the session's discovery
    // service — the same seam the log-on flow uses (see ExplorerSession.LogOnAsync).
    private string LookupHandle { get; set; } = "";
    private string? LookupHandleInput { get; set; }
    private Iri? LookupIri { get; set; }
    private bool LookupAttempted { get; set; }
    private bool LookupBusy { get; set; }
    private string? LookupError { get; set; }

    /// <summary>
    /// The dial base shown in the lookup card's help text (the current instance base the WebFinger
    /// query reaches).
    /// </summary>
    private string DialBaseLabel => Session.DialBaseUri?.ToString() ?? "…";

    /// <summary>
    /// The detail-page URL for the resolved actor IRI (null until a successful resolve). Kept as a
    /// property so the markup's <c>href</c> is a plain expression (no C# interpolation with braces in
    /// markup, which Razor mis-parses).
    /// </summary>
    private string? LookupHref => LookupIri is { } iri ? "/actor?iri=" + Uri.EscapeDataString(iri.ToString()) : null;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn)
        {
            return;
        }

        Busy = true;
        try
        {
            // The instance base IRI is the dial base + /ap/v1 (the route prefix the server maps its
            // endpoints under). NodeInfo is served at {base}/nodeinfo/2.0.
            var baseUri = Session.DialBaseUri ?? throw new InvalidOperationException("No dial base URI.");
            var instanceBase = new Iri($"{baseUri.GetLeftPart(UriPartial.Authority)}/ap/v1");
            NodeInfo = await Session.GetClient().GetNodeInfoAsync(instanceBase);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private void SelectSwitchTarget(RecentInstance recent)
    {
        SwitchTarget = recent;
        SwitchError = null;
        StateHasChanged();
    }

    private async Task SwitchAsync(RecentInstance recent)
    {
        SwitchBusy = true;
        SwitchError = null;
        try
        {
            var ok = await Session.SwitchInstanceAsync(recent, SwitchPassword);
            if (!ok)
            {
                SwitchError = "Switch failed (wrong password, or the instance is no longer running?).";
                return;
            }

            SwitchTarget = null;
            // Re-load the NodeInfo for the newly switched-to instance.
            NodeInfo = null;
            Error = null;
            Busy = true;
            try
            {
                var baseUri = Session.DialBaseUri ?? throw new InvalidOperationException("No dial base URI.");
                var instanceBase = new Iri($"{baseUri.GetLeftPart(UriPartial.Authority)}/ap/v1");
                NodeInfo = await Session.GetClient().GetNodeInfoAsync(instanceBase);
            }
            catch (Exception ex)
            {
                Error = ex.Message;
            }
            finally
            {
                Busy = false;
            }
        }
        catch (Exception ex)
        {
            SwitchError = ex.Message;
        }
        finally
        {
            SwitchBusy = false;
        }
    }

    private async Task LookupAsync()
    {
        var handle = LookupHandle.Trim();
        LookupAttempted = true;
        LookupError = null;
        LookupIri = null;
        if (handle.Length == 0)
        {
            LookupError = "Enter a handle to resolve (e.g. alice@iris-dev1.luit.ink).";
            return;
        }

        // The resolve dials the current instance's base URI (the host-published port for local
        // instances), not the handle's own host — the same authority the session uses to reach the
        // instance (see ExplorerSession.LogOnAsync). The query resource still carries the handle's
        // host so the instance knows which actor to resolve.
        var dialBaseUri = Session.DialBaseUri ?? throw new InvalidOperationException("No dial base URI.");

        LookupBusy = true;
        LookupHandleInput = handle;
        try
        {
            // Fully-qualified (this page has no @using for the Iris.Client.Discovery / Iris.Core
            // namespaces; the rest of the page relies on implicit usings + the @using Iris.Client).
            var discovery = Session.Discovery ?? throw new InvalidOperationException("No discovery service.");
            LookupIri = await discovery.ResolveActorAsync(handle, dialBaseUri);
            if (LookupIri is null)
            {
                LookupError = "The instance did not resolve that address (unknown handle or no WebFinger match).";
            }
        }
        catch (Exception ex)
        {
            LookupError = ex.Message;
        }
        finally
        {
            LookupBusy = false;
        }
    }
}
