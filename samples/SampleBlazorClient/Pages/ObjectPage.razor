@page "/object"
@using Iris.Core
@using Iris.Core.Identity
@using Iris.Client
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using KristofferStrube.ActivityStreams
@using ActivityObject = KristofferStrube.ActivityStreams.Object

<PageTitle>Object · Iris</PageTitle>

<h2>Object</h2>

@if (!Session.IsLoggedIn)
{
    <div class="card">
        <p class="muted">Log on to an instance to view an object.</p>
    </div>
}
else
{
    <div class="card">
        <label for="iri">Object IRI</label>
        <input id="iri" type="url" @bind="IriInput" placeholder="http://localhost/ap/v1/n/…" />
        <button @onclick="LoadAsync" disabled="@(Busy)">Load</button>
        @if (Busy)
        {
            <span class="muted">Loading…</span>
        }
        @if (Error is not null)
        {
            <div class="error">@Error</div>
        }
    </div>

    @if (ObjectDoc is not null)
    {
        <div class="card">
            <h3>Object</h3>
            <ObjectView Item="ObjectDoc" />
            @if (IsObjectRemote && CanonicalPublicUrl is { Length: > 0 } canonicalUrl)
            {
                <p class="muted">
                    This object is from another instance.
                    <a href="@canonicalUrl" class="object-canonical-link" rel="noopener" target="_blank">
                        View on originating instance</a>
                </p>
            }
            <div class="card" style="margin-top: .75rem">
                <button @onclick="ToggleLikeAsync" disabled="@(WriteBusy)">@(HasLiked ? "Unlike" : "Like")</button>
                @if (HasLiked)
                {
                    <span class="muted">You liked this.</span>
                }
                @if (LikeCount is { } likes)
                {
                    <span class="muted">@likes like@(likes == 1 ? "" : "s")</span>
                }
                <button @onclick="ToggleBoostAsync" disabled="@(WriteBusy)">@(HasBoosted ? "Unboost" : "Boost")</button>
                @if (HasBoosted)
                {
                    <span class="muted">You boosted this.</span>
                }
                @if (ShareCount is { } shares)
                {
                    <span class="muted">@shares boost@(shares == 1 ? "" : "s")</span>
                }
                @if (IsAuthor)
                {
                    <button @onclick="DeleteAsync" disabled="@(WriteBusy)" class="danger">Delete</button>
                    <span class="muted">You authored this.</span>
                }
                @if (WriteBusy)
                {
                    <span class="muted">Working…</span>
                }
                @if (WriteResult is not null)
                {
                    <p class="muted">Status: <code>@WriteResult</code></p>
                }
                @if (WriteError is not null)
                {
                    <div class="error">@WriteError</div>
                }
            </div>
        </div>

        @if (Replies is not null)
        {
            <div class="card">
                <h3>Replies</h3>
                @if (Replies.Count == 0)
                {
                    <p class="muted">No replies.</p>
                }
                else
                {
                    <p class="muted">@Replies.Count reply(ies).</p>
                    <ul class="object-list">
                        @foreach (var item in Replies)
                        {
                            <li><ObjectView Item="item" /></li>
                        }
                    </ul>
                }
            </div>
        }
    }
}

@code {
    [Inject]
    private ExplorerSession Session { get; set; } = default!;

    private string IriInput { get; set; } = string.Empty;
    private bool Busy { get; set; }
    private string? Error { get; set; }
    private IObject? ObjectDoc { get; set; }
    private IReadOnlyList<IObjectOrLink>? Replies { get; set; }
    private Iri? LoadedObjectIri { get; set; }
    // Per-object interaction counts (decision 056 (d)): read from the object's `likes` / `shares`
    // extension collections (the bare, non-namespaced ecosystem terms). Nullable because the collection
    // is an extension — an external object that does not expose it 404s, so the count is unavailable
    // (shown as nothing) rather than a misleading 0.
    private int? LikeCount { get; set; }
    private int? ShareCount { get; set; }
    private bool WriteBusy { get; set; }
    private DeliveryResult? WriteResult { get; set; }
    private string? WriteError { get; set; }
    private bool HasLiked { get; set; }
    private bool HasBoosted { get; set; }

    // 19.8.2: the canonical public URL of the object on the originating instance (the object's `url`
    // field when present, else the object's IRI). Shown as a "View on originating instance" link when the
    // object is remote (its IRI's host differs from the current instance's host).
    private string? CanonicalPublicUrl { get; set; }

    // Decision 055 (learned-id references): the ids the server minted for the like/boost this page made,
    // learned from DeliveryResult.MintedId at creation time. The Unlike/Unannounce reference the original
    // activity by this learned id (the client never recomputes the server's ids). A like/boost that existed
    // before this page session (HasLiked/HasBoosted true from the server) has no learned id here, so its
    // undo is reported as "not undone in this session" rather than guessed.
    private Iri? LikeLearnedId { get; set; }
    private Iri? BoostLearnedId { get; set; }
    private bool IsAuthor { get; set; }

    /// <summary>
    /// The object IRI deep-linked via the <c>?iri=</c> query param (S2). When present, the page loads it
    /// on initialize so a click from anywhere (ObjectView, search, feed, replies) navigates + loads.
    /// </summary>
    [SupplyParameterFromQuery(Name = "iri")]
    private string? IriParam { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsLoggedIn && IriParam is { Length: > 0 })
        {
            IriInput = IriParam;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        if (!Session.IsLoggedIn)
        {
            return;
        }

        if (!Uri.TryCreate(IriInput.Trim(), UriKind.Absolute, out var uri))
        {
            Error = "The object IRI is not a valid absolute URI.";
            return;
        }

        Busy = true;
        Error = null;
            ObjectDoc = null;
            Replies = null;
            LikeCount = null;
            ShareCount = null;
            try
            {
            var objectIri = new Iri(uri);
            var client = Session.GetClient();
            LoadedObjectIri = objectIri;
            // 19.8.5 — cross-instance navigation: record the navigable state (the last-viewed object)
            // so a UI can offer "continue where you left off" after an instance switch.
            Session.SetNavigableObjectIri(objectIri);
            ObjectDoc = await client.GetObjectAsync(objectIri);

            // 19.8.7: GetObjectAsync returns null on a 404 (unknown object) — surface a clear error
            // rather than a blank page.
            if (ObjectDoc is null)
            {
                Error = $"Object not found: {objectIri.Value}";
                return;
            }

            // Whether the logged-on actor is the object's author (drives the Delete button — only the
            // author may delete their own content).
            IsAuthor = ObjectDoc is ActivityObject obj
                && obj.AttributedTo?.FirstOrDefault()?.ResolveObjectIri() is { } authorIri
                && Session.ActorIri is { } me
                && authorIri == me;

            // Whether the logged-on actor has already liked this object: read the actor's `liked`
            // collection (actorId.LikedOf()) and check for the object's IRI. Drives the Like/Unlike
            // toggle so a re-loaded object shows the current like state.
            HasLiked = await IsLikedByActorAsync(client, objectIri);

            var replies = new List<IObjectOrLink>();
            await foreach (var item in client.GetRepliesAsync(objectIri))
            {
                replies.Add(item);
            }

            Replies = replies;

            // Per-object interaction counts (decision 056 (d)): read from the object's `likes` /
            // `shares` extension collections. A failed read (the object does not expose the extension,
            // e.g. an external object) leaves the count null — shown as nothing, not a misleading 0.
            LikeCount = await CountCollectionAsync(client, objectIri.LikesOf());
            ShareCount = await CountCollectionAsync(client, objectIri.SharesOf());

            // 19.8.2: the canonical public URL of the object on the originating instance — the object's
            // `url` field (first URL's Href) when present, else the object's IRI. Shown as a "View on
            // originating instance" link when the object is remote (its IRI's host differs from the
            // current instance's host).
            CanonicalPublicUrl = ResolveCanonicalPublicUrl(ObjectDoc, objectIri);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    /// <summary>
    /// Resolves the canonical public URL of an object on its originating instance (19.8.2): the
    /// object's <c>url</c> field (the first URL's Href) when present, else the object's IRI. Exposed
    /// as a static helper so the resolution logic is testable in isolation.
    /// </summary>
    /// <param name="doc">The loaded object (may be null).</param>
    /// <param name="objectIri">The object's IRI (the fallback when no <c>url</c> field is present).</param>
    /// <returns>The canonical public URL, or null when the object is null and no IRI is given.</returns>
    public static string? ResolveCanonicalPublicUrl(IObject? doc, Iri? objectIri)
    {
        if (doc is ActivityObject ao && ao.Url is { } urls)
        {
            var href = urls.FirstOrDefault()?.Href?.ToString();
            if (href is { Length: > 0 })
            {
                return href;
            }
        }

        return objectIri?.Value;
    }

    /// <summary>
    /// Whether the loaded object is remote (its IRI's host differs from the current instance's host) —
    /// 19.8.2: drives the "View on originating instance" canonical public URL link.
    /// </summary>
    private bool IsObjectRemote
    {
        get
        {
            if (LoadedObjectIri is not { } objectIri || Session.DialBaseUri is not { } dialBase)
            {
                return false;
            }

            if (!Uri.TryCreate(objectIri.Value, UriKind.Absolute, out var objectUri))
            {
                return false;
            }

            return !string.Equals(objectUri.Host, dialBase.Host, StringComparison.OrdinalIgnoreCase);
        }
    }

    private async Task ToggleLikeAsync()
    {
        if (!Session.IsLoggedIn || LoadedObjectIri is null)
        {
            return;
        }

        var actorIri = Session.ActorIri ?? throw new InvalidOperationException("No actor identity.");
        var client = Session.GetClient();
        WriteBusy = true;
        WriteResult = null;
        WriteError = null;
        try
        {
            if (HasLiked)
            {
                if (LikeLearnedId is not null)
                {
                    // Decision 055: undo the like by the id the server minted when this page created it.
                    WriteResult = await client.UnlikeAsync(actorIri, LikeLearnedId.Value);
                    HasLiked = false;
                    LikeLearnedId = null;
                }
                else
                {
                    // The like predates this session (learned from the server, not created here) — no
                    // learned id to reference, so it cannot be undone from this page.
                    WriteError = "Unlike requires the like's learned id; this like was not created in this session.";
                }
            }
            else
            {
                WriteResult = await client.LikeAsync(actorIri, LoadedObjectIri.Value);
                HasLiked = true;
                LikeLearnedId = WriteResult.MintedId is { } id ? new Iri(id) : null;
            }
        }
        catch (Exception ex)
        {
            WriteError = ex.Message;
        }
        finally
        {
            WriteBusy = false;
        }
    }

    /// <summary>
    /// Boosts (or un-boosts) the loaded object as the logged-on actor: toggles between
    /// <see cref="IActivityPubClient.AnnounceAsync"/> (a boost — the actor re-shares the object, fanned out
    /// to the actor's followers by the server) and <see cref="IActivityPubClient.UnannounceAsync"/> (an
    /// un-boost — an <c>Undo</c> of the announce). Mirrors the Like/Unlike toggle.
    /// </summary>
    private async Task ToggleBoostAsync()
    {
        if (!Session.IsLoggedIn || LoadedObjectIri is null)
        {
            return;
        }

        var actorIri = Session.ActorIri ?? throw new InvalidOperationException("No actor identity.");
        var client = Session.GetClient();
        WriteBusy = true;
        WriteResult = null;
        WriteError = null;
        try
        {
            if (HasBoosted)
            {
                if (BoostLearnedId is not null)
                {
                    // Decision 055: undo the boost by the id the server minted when this page created it.
                    WriteResult = await client.UnannounceAsync(actorIri, BoostLearnedId.Value);
                    HasBoosted = false;
                    BoostLearnedId = null;
                }
                else
                {
                    // The boost predates this session (learned from the server, not created here) — no
                    // learned id to reference, so it cannot be undone from this page.
                    WriteError = "Unboost requires the announce's learned id; this boost was not created in this session.";
                }
            }
            else
            {
                WriteResult = await client.AnnounceAsync(actorIri, LoadedObjectIri.Value);
                HasBoosted = true;
                BoostLearnedId = WriteResult.MintedId is { } id ? new Iri(id) : null;
            }
        }
        catch (Exception ex)
        {
            WriteError = ex.Message;
        }
        finally
        {
            WriteBusy = false;
        }
    }

    /// <summary>
    /// Deletes the loaded object as the logged-on actor (the object's author): publishes an
    /// <c>Undo(Create)</c> via <see cref="IActivityPubClient.DeleteAsync"/> (the inverse of a post). On
    /// success the object is re-loaded, which now surfaces the server's tombstone ("deleted" marker) in
    /// place of the original content. Only available when the logged-on actor is the author.
    /// </summary>
    private async Task DeleteAsync()
    {
        if (!Session.IsLoggedIn || LoadedObjectIri is null || !IsAuthor)
        {
            return;
        }

        var actorIri = Session.ActorIri ?? throw new InvalidOperationException("No actor identity.");
        var client = Session.GetClient();
        WriteBusy = true;
        WriteResult = null;
        WriteError = null;
        try
        {
            WriteResult = await client.DeleteAsync(actorIri, LoadedObjectIri.Value);
            if (WriteResult.IsSuccess)
            {
                // Re-load: the object now resolves to its tombstone (the "deleted" marker).
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            WriteError = ex.Message;
        }
        finally
        {
            WriteBusy = false;
        }
    }

    /// <summary>
    /// Reads the logged-on actor's <c>liked</c> collection and reports whether it contains
    /// <paramref name="objectIri"/> (the same check the <c>liked</c> screen shows on the actor-detail
    /// page). A failed read is treated as "not liked" — the Like button stays available.
    /// </summary>
    private async Task<bool> IsLikedByActorAsync(IActivityPubClient client, Iri objectIri)
    {
        try
        {
            var actorIri = Session.ActorIri ?? throw new InvalidOperationException("No actor identity.");
            // Bypass the client's collection cache: the `liked` page may be cached from a prior load
            // (e.g. a like on another object), and the like-state read must reflect the current store.
            await foreach (var item in client.GetCollectionItemsAsync(
                actorIri.LikedOf(), new CollectionQuery { BypassCache = true }))
            {
                string? iri = item switch
                {
                    IObject { Id: { } id } => id,
                    ILink { Href: { } href } => href.ToString(),
                    _ => null,
                };
                if (iri == objectIri.Value)
                {
                    return true;
                }
            }

            return false;
        }
        catch
        {
            return false;
        }
    }

    /// <summary>
    /// Counts the items of a collection (the object's <c>likes</c> / <c>shares</c> extension
    /// collections). The read bypasses the client's collection cache so a re-load after a like/boost
    /// reflects the current store (the same reason the like-state read does). A failed read — the object
    /// does not expose the extension collection (e.g. an external object) — returns <see langword="null"/>
    /// so the UI shows no count rather than a misleading 0.
    /// </summary>
    private static async Task<int?> CountCollectionAsync(IActivityPubClient client, Iri collectionIri)
    {
        try
        {
            var count = 0;
            await foreach (var _ in client.GetCollectionItemsAsync(
                collectionIri, new CollectionQuery { BypassCache = true }))
            {
                count++;
            }

            return count;
        }
        catch
        {
            return null;
        }
    }
}
