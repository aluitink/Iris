@page "/"
@using Iris.Client
@using Iris.Client.Collections
@using Iris.Samples.SampleBlazorClient.Explorer
@using KristofferStrube.ActivityStreams
@using Microsoft.AspNetCore.Components

<PageTitle>Iris · server explorer</PageTitle>

<h1>Server explorer</h1>

@if (!Session.IsLoggedIn)
{
    <div class="card">
        <h2>Log on to an instance</h2>
        <p class="muted">
            Enter a WebFinger address (e.g. <code>alice@localhost</code>) and the actor's Basic-auth
            password. The explorer dials the actor's home server by default; use the advanced section
            below only if the instance is reachable at a different endpoint.
        </p>

        <label for="address">WebFinger address</label>
        <input id="address" type="text" @bind="Address" placeholder="alice@localhost" />

        <label for="password">Password</label>
        <input id="password" type="password" @bind="Password" placeholder="iris-sample" />

        <details>
            <summary class="muted">Advanced: talk to a different endpoint</summary>
            <p class="muted">
                By default the explorer dials the actor's home server (the address's host over
                <code>https</code>). Enter a base URL here only when the instance is reachable at a
                different address than its advertised host (e.g. a local Docker instance behind a
                host-published port, or a reverse proxy).
            </p>
            <label for="base">Endpoint override</label>
            <input id="base" type="url" @bind="BaseUrl" placeholder="http://localhost:8081" />
        </details>

        <button @onclick="LogOnAsync" disabled="@(Busy)">Log on</button>
        @if (Busy)
        {
            <span class="muted">Logging on…</span>
        }
        @if (Error is not null)
        {
            <div class="error">@Error</div>
        }

        <hr />

        <h2>Log on with OAuth2</h2>
        <p class="muted">
            Opens the instance's OAuth2 authorization endpoint in the browser. The server auto-approves
            and redirects back to this app's <code>/callback</code> route with a one-time code, which the
            app exchanges for a Bearer token and uses to log on (no password).
        </p>
        <button @onclick="LogOnWithOAuth2Async" disabled="@(Busy)">Log on with OAuth2</button>
    </div>
}
else
{
    <div class="card">
        <h2>Logged on</h2>
        <p>Actor: <code>@(Session.ResolvedActorIri?.Value ?? Session.ActorIri?.Value)</code></p>
        <p class="muted">
            The explorer screens (instance overview, actors, actor detail, object view, community,
            compose, follow/like) build on this session — see <code>ExplorerSession.GetClient()</code>.
        </p>
        <button class="secondary" @onclick="LogOut">Log out</button>
    </div>

    @if (Session.NavigableObjectIri is { } navObject || Session.NavigableActorIri is { } navActor)
    {
        <div class="card">
            <h2>Continue where you left off</h2>
            <p class="muted">
                The last item you viewed (preserved across instance switches — 19.8.5 cross-instance
                navigation). Select it to navigate back to it on the current instance.
            </p>
            @if (Session.NavigableObjectIri is { } navObj)
            {
                <a href="/object?iri=@Uri.EscapeDataString(navObj.Value)" class="btn">
                    Object: <code>@navObj.Value</code>
                </a>
            }
            @if (Session.NavigableActorIri is { } navAct)
            {
                <a href="/actor?iri=@Uri.EscapeDataString(navAct.Value)" class="btn">
                    Actor: <code>@navAct.Value</code>
                </a>
            }
            <button class="secondary" @onclick="ClearNavigable">Clear</button>
        </div>
    }

    @if (Session.RecentInstances.Count > 0)
    {
        <div class="card">
            <h2>Recent instances</h2>
            <p class="muted">
                Switch instance: re-enter the password and the session logs out of the current
                identity and logs on to the selected instance by its WebFinger address.
            </p>
            <ul class="recents">
                @foreach (var recent in Session.RecentInstances)
                {
                    <li>
                        <code>@recent.Handle</code>@recent.Host
                        @if (SwitchTarget is not null && SwitchTarget == recent)
                        {
                            <input class="inline" type="password" @bind="SwitchPassword" placeholder="password" />
                            <button @onclick="() => SwitchAsync(recent)" disabled="@(Busy)">Switch</button>
                        }
                        else
                        {
                            <button class="secondary" @onclick="() => SelectSwitchTarget(recent)">Use</button>
                        }
                    </li>
                }
            </ul>
            @if (Busy)
            {
                <span class="muted">Switching…</span>
            }
        </div>
    }

    @if (FeedItems is not null)
    {
        <div class="card">
            <h2>Community feed</h2>
            @if (FeedItems.Count == 0)
            {
                <p class="muted">No feed items (is the seeded <code>iris</code> community empty?).</p>
            }
            else
            {
                <p class="muted">
                    Recent items from the seeded <code>iris</code> community (newest first, deep-linked).
                </p>
                <ul class="object-list">
                    @foreach (var item in FeedItems)
                    {
                        <li><ObjectView Item="item" /></li>
                    }
                </ul>
            }
        </div>
    }
}

@code {
    [Inject]
    private ExplorerSession Session { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private string Address { get; set; } = "alice@iris.luit.ink";
    private string Password { get; set; } = "iris-sample";
    private string BaseUrl { get; set; } = "";
    private string? Error { get; set; }
    private bool Busy { get; set; }

    /// <summary>
    /// The recent community-feed items to render on the landing page (S5). Null = not yet loaded; an
    /// empty list = the community is empty (or the feed could not be read).
    /// </summary>
    private List<IObjectOrLink>? FeedItems { get; set; }

    private RecentInstance? SwitchTarget { get; set; }
    private string SwitchPassword { get; set; } = "iris-sample";

    /// <summary>
    /// The number of community-feed items rendered on the landing page (a small cap so the landing page
    /// stays light; the full feed is on the <c>Feed</c> page).
    /// </summary>
    private const int FeedPageSize = 5;

    protected override async Task OnInitializedAsync()
    {
        // When the browser lands on the app after the OAuth2 redirect (the /callback route is served by
        // the static host's index.html, so the SPA boots on that URL), the address bar carries
        // ?code=…&amp;state=… (from the server) plus ?dial=…&amp;handle=… (echoed by the app so a full
        // page reload still knows which instance + actor to log on to). Exchange the code for a Bearer
        // token and log on.
        var current = Navigation.ToAbsoluteUri(Navigation.Uri);
        var (code, returnedState) = OAuth2BrowserFlow.ParseCallback(current);
        if (code is not null)
        {
            await CompleteOAuthCallbackAsync(current, code, returnedState);
            return;
        }

        // When already logged on (e.g. after a re-login), surface the community feed so the shell
        // demonstrates a signed read through the session's client.
        if (Session.IsLoggedIn)
        {
            await LoadFeedAsync();
        }
    }

    /// <summary>
    /// Completes the OAuth2 callback: exchanges the code for a Bearer token and logs on. Navigates to
    /// <c>/</c> when done (clearing the callback query string).
    /// </summary>
    /// <remarks>
    /// <para>
    /// The dial base + handle are echoed on the callback URL (<c>?dial=…&amp;handle=…</c>, appended by
    /// <see cref="LogOnWithOAuth2Async"/> to the <c>redirect_uri</c>) so a full page reload on
    /// <c>/callback</c> still knows the target instance + actor.
    /// </para>
    /// <para>
    /// <c>state</c> (CSRF, RFC 6749 §10.12) limitation: the authorization redirect is a full page load
    /// (the static host serves <c>index.html</c>, so the SPA's in-memory statics are wiped), so the
    /// state generated before the redirect is not available to compare against the callback's
    /// <paramref name="returnedState"/>. The state is still generated and sent (the server echoes it),
    /// so the parameter is present and the server's single-use code exchange is the effective
    /// protection; a same-tab state check would require persisting the state (e.g.
    /// <c>localStorage</c> via JS interop), which is a follow-up.
    /// </para>
    /// </remarks>
    private async Task CompleteOAuthCallbackAsync(Uri current, string code, string? returnedState)
    {
        Busy = true;
        Error = null;
        try
        {
            // The dial base + handle are echoed on the callback URL (so a full page reload still knows
            // the target instance + actor). Fall back to the entered base URL when absent.
            var dialBaseStr = CallbackParam(current, "dial");
            Uri dialBase;
            if (dialBaseStr is not null && Uri.TryCreate(dialBaseStr, UriKind.Absolute, out var parsed))
            {
                dialBase = parsed;
            }
            else
            {
                dialBase = Uri.TryCreate(BaseUrl, UriKind.Absolute, out var b) ? b : new Uri("http://localhost:5000");
            }

            var handle = CallbackParam(current, "handle")
                ?? (Address.Contains('@') ? Address[..Address.IndexOf('@')].TrimStart('@') : "alice");

            var token = await OAuth2BrowserFlow.ExchangeCodeAsync(
                new HttpClient(), dialBase, code);
            if (token is null)
            {
                Error = "OAuth2 code exchange failed (invalid or already-used code).";
                Navigation.NavigateTo("/");
                return;
            }

            var ok = await Session.LogOnWithOAuth2Async(handle, token, dialBase);
            if (!ok)
            {
                Error = "OAuth2 logon failed (invalid token, or the instance is not running?).";
                Navigation.NavigateTo("/");
                return;
            }

            Navigation.NavigateTo("/");
            await LoadFeedAsync();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
            Navigation.NavigateTo("/");
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task LogOnWithOAuth2Async()
    {
        var dialBase = ResolveDialBase(BaseUrl);
        if (dialBase is null)
        {
            Error = "Enter a valid base URL (or a WebFinger address whose host can be reached).";
            return;
        }

        Busy = true;
        Error = null;
        try
        {
            // The OAuth2 client_id is the actor handle (the v1 model has no separate client
            // registration). Parse it from the WebFinger address the user entered (or default to
            // "alice").
            var handle = Address.Contains('@') ? Address[..Address.IndexOf('@')].TrimStart('@') : "alice";
            if (string.IsNullOrEmpty(handle))
            {
                handle = "alice";
            }

            var instanceBase = dialBase;

            // The redirect_uri is the WASM app's callback route. The app's base URI (the static host)
            // is what the browser reaches; the callback path is /callback. The dial base + handle are
            // appended so a full page reload on /callback still knows the target instance + actor.
            var appBase = new Uri(Navigation.BaseUri);
            var redirectUri = OAuth2BrowserFlow.BuildRedirectUri(appBase, "/callback");

            // The state (CSRF, RFC 6749 §10.12) is generated and sent with the authorize request; the
            // server echoes it back on the callback. (A same-tab compare against it is not possible here
            // — the authorization redirect is a full page load that wipes the SPA's in-memory state — see
            // CompleteOAuthCallbackAsync.)
            var state = OAuth2BrowserFlow.NewState();

            // Echo the dial base + handle on the redirect_uri so the callback (after the server's 302)
            // can read them. The server appends ?code=…&state=…; the app's extra params come first.
            var redirectWithParams =
                $"{redirectUri}?dial={Uri.EscapeDataString(instanceBase.ToString())}" +
                $"&handle={Uri.EscapeDataString(handle)}";

            var authorizeUrl = OAuth2BrowserFlow.BuildAuthorizeUrl(
                instanceBase, handle, new Uri(redirectWithParams), state);

            // A full browser navigation to the authorize URL (the server 302s back to /callback).
            await JS.InvokeVoidAsync("eval", $"window.location.href = {JsonEscape(authorizeUrl.ToString())}");
        }
        catch (Exception ex)
        {
            Error = ex.Message;
            Busy = false;
        }
    }

    private static string? CallbackParam(Uri uri, string name)
    {
        var query = uri.Query.TrimStart('?');
        if (query.Length == 0)
        {
            return null;
        }

        foreach (var pair in query.Split('&'))
        {
            var eq = pair.IndexOf('=', StringComparison.Ordinal);
            if (eq < 0 || pair[..eq] != name)
            {
                continue;
            }

            return Uri.UnescapeDataString(pair[(eq + 1)..]);
        }

        return null;
    }

    private static string JsonEscape(string s)
        => "\"" + s.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"";

    /// <summary>
    /// Resolves the dial base for log-on: when the user entered an endpoint override it is used as-is
    /// (the user's explicit input always wins); when the field is empty the dial base is the actor's
    /// home server (the address's host over <c>https</c>) — the production assumption that the IRI host
    /// is browser-reachable.
    /// </summary>
    /// <param name="enteredBase">The user-entered endpoint override (may be empty).</param>
    /// <returns>The resolved dial base, or <see langword="null"/> when it cannot be resolved.</returns>
    private Uri? ResolveDialBase(string enteredBase)
    {
        if (Uri.TryCreate(enteredBase, UriKind.Absolute, out var explicitBase))
        {
            return explicitBase;
        }

        var host = Address.Contains('@') ? Address[(Address.LastIndexOf('@') + 1)..].Trim() : string.Empty;
        if (string.IsNullOrEmpty(host))
        {
            return null;
        }

        return new Uri($"https://{host}");
    }

    private async Task LogOnAsync()
    {
        var dialBase = ResolveDialBase(BaseUrl);
        if (dialBase is null)
        {
            Error = "Enter a valid base URL (or a WebFinger address whose host can be reached).";
            return;
        }

        Busy = true;
        Error = null;
        try
        {
            var ok = await Session.LogOnAsync(Address, Password, dialBase);
            if (!ok)
            {
                Error = "Login failed (wrong address, password, or the instance is not running?).";
                return;
            }

            await LoadFeedAsync();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private void LogOut()
    {
        Session.LogOut();
        FeedItems = null;
        SwitchTarget = null;
        StateHasChanged();
    }

    // 19.8.5 — cross-instance navigation: clear the navigable state (the "continue where you left off"
    // last-viewed item) so the Home page's affordance disappears.
    private void ClearNavigable()
    {
        Session.ClearNavigableState();
        StateHasChanged();
    }

    private void SelectSwitchTarget(RecentInstance recent)
    {
        SwitchTarget = recent;
        Error = null;
        StateHasChanged();
    }

    private async Task SwitchAsync(RecentInstance recent)
    {
        Busy = true;
        Error = null;
        try
        {
            var ok = await Session.SwitchInstanceAsync(recent, SwitchPassword);
            if (!ok)
            {
                Error = "Switch failed (wrong password, or the instance is no longer running?).";
                return;
            }

            SwitchTarget = null;
            await LoadFeedAsync();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task LoadFeedAsync()
    {
        try
        {
            var baseUri = Session.DialBaseUri ?? throw new InvalidOperationException("No dial base URI.");
            var communityIri = new Iri($"{baseUri.GetLeftPart(UriPartial.Authority)}/ap/v1/c/iris");
            var items = new List<IObjectOrLink>();
            // Cap the landing page at FeedPageSize items (the full feed is on the /feed page).
            await foreach (var item in Session.GetClient().GetCommunityFeedAsync(
                communityIri, new CollectionQuery(Limit: FeedPageSize)))
            {
                items.Add(item);
            }

            FeedItems = items;
        }
        catch
        {
            FeedItems = [];
        }
    }
}
