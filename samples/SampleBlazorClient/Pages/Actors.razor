@page "/actors"
@using Iris.Client
@using KristofferStrube.ActivityStreams

<PageTitle>Directory · Iris</PageTitle>

<h2>Directory</h2>

@if (!Session.IsLoggedIn)
{
    <div class="card">
        <p class="muted">Log on to an instance to browse its directory.</p>
    </div>
}
else
{
    <div class="card">
        <label for="query">Search the directory (empty = all actors)</label>
        <input id="query" type="text" @bind="Query" placeholder="e.g. alice" />
        <button @onclick="SearchAsync" disabled="@(Busy)">Search</button>
        @if (Busy)
        {
            <span class="muted">Searching…</span>
        }
    </div>

    @if (Error is not null)
    {
        <div class="card">
            <div class="error">@Error</div>
        </div>
    }
    else if (Results is not null)
    {
        <div class="card">
            <h3>@(Query.Trim().Length > 0 ? $"Actors matching “{Query.Trim()}”" : "All actors")</h3>
            <p class="muted">Searched the directory at <code>@SearchEndpoint</code></p>
            @if (Results.Count == 0)
            {
                <p class="muted">No matching actors.</p>
            }
            else
            {
                <p class="muted">@Results.Count actor(s).</p>
                <ul class="object-list">
                    @foreach (var item in Results)
                    {
                        <li><ObjectView Item="item" /></li>
                    }
                </ul>
            }
        </div>
    }
}

@code {
    [Inject]
    private ExplorerSession Session { get; set; } = default!;

    private string Query { get; set; } = string.Empty;
    private bool Busy { get; set; }
    private IReadOnlyList<IObjectOrLink>? Results { get; set; }
    private string SearchEndpoint { get; set; } = string.Empty;
    private string? Error { get; set; }

    private async Task SearchAsync()
    {
        if (!Session.IsLoggedIn)
        {
            return;
        }

        Busy = true;
        Results = null;
        Error = null;
        try
        {
            var baseUri = Session.DialBaseUri ?? throw new InvalidOperationException("No dial base URI.");
            var instanceBase = new Iri($"{baseUri.GetLeftPart(UriPartial.Authority)}/ap/v1");
            SearchEndpoint = instanceBase.SearchOf().Value;
            var results = new List<IObjectOrLink>();
            // The directory searches actors only (not content): pass the type filter so the server
            // restricts the result to `Actor` items (persons, communities, …) and skips the content pass.
            await foreach (var item in Session.GetClient().SearchAsync(instanceBase, Query, new SearchOptions { Type = "Actor" }))
            {
                results.Add(item);
            }

            Results = results;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }
}
