@page "/actors"
@using Iris.Client
@using KristofferStrube.ActivityStreams

<PageTitle>Actors · Iris</PageTitle>

<h2>Actors</h2>

@if (!Session.IsLoggedIn)
{
    <div class="card">
        <p class="muted">Log on to an instance to browse its actors.</p>
    </div>
}
else
{
    <div class="card">
        <label for="query">Search (empty = whole directory)</label>
        <input id="query" type="text" @bind="Query" placeholder="e.g. alice" />
        <button @onclick="SearchAsync" disabled="Busy">Search</button>
        @if (Busy)
        {
            <span class="muted">Searching…</span>
        }
    </div>

    @if (Results is not null)
    {
        <div class="card">
            <h3>@(Query.Trim().Length > 0 ? $"Results for “{Query.Trim()}”" : "Directory")</h3>
            @if (Results.Count == 0)
            {
                <p class="muted">No matching actors or content.</p>
            }
            else
            {
                <p class="muted">@Results.Count item(s).</p>
                <ul class="object-list">
                    @foreach (var item in Results)
                    {
                        <li><ObjectView Item="item" /></li>
                    }
                </ul>
            }
        </div>
    }
}

@code {
    [Inject]
    private ExplorerSession Session { get; set; } = default!;

    private string Query { get; set; } = string.Empty;
    private bool Busy { get; set; }
    private IReadOnlyList<IObjectOrLink>? Results { get; set; }

    private async Task SearchAsync()
    {
        if (!Session.IsLoggedIn)
        {
            return;
        }

        Busy = true;
        Results = null;
        try
        {
            var baseUri = Session.DialBaseUri ?? throw new InvalidOperationException("No dial base URI.");
            var instanceBase = new Iri($"{baseUri.GetLeftPart(UriPartial.Authority)}/ap/v1");
            var results = new List<IObjectOrLink>();
            await foreach (var item in Session.GetClient().SearchAsync(instanceBase, Query))
            {
                results.Add(item);
            }

            Results = results;
        }
        finally
        {
            Busy = false;
        }
    }
}
