@page "/feed"
@using Iris.Client
@using Iris.Client.Collections
@using Iris.Core.Collections
@using KristofferStrube.ActivityStreams

<PageTitle>Feed · Iris</PageTitle>

<h2>Home timeline (followed feed)</h2>

@if (!Session.IsLoggedIn)
{
    <div class="card">
        <p class="muted">Log on to an instance to view your followed feed.</p>
    </div>
}
else
{
    <PagedCollection
        Client="@FeedClient"
        CollectionIri="@FeedIri"
        Title="Home timeline (followed feed)"
        Description="The union of the followed actors' outboxes, newest first, de-duplicated — paged with next-link walking."
        PageSize="5"
        ShowRefreshButton="true"
        EmptyMessage="No followed items yet. Follow an actor (Actor detail → Follow) to populate your timeline." />
}

@code {
    [Inject]
    private ExplorerSession Session { get; set; } = default!;

    /// <summary>
    /// The client to dial (the logged-on session's client), or null when not logged in.
    /// </summary>
    private IActivityPubClient? FeedClient => Session.IsLoggedIn ? Session.GetClient() : null;

    /// <summary>
    /// The followed-feed collection IRI (the actor's <c>{actor}/feed</c>), or null when not logged in.
    /// </summary>
    private Iri? FeedIri
    {
        get
        {
            var actorIri = Session.ResolvedActorIri ?? Session.ActorIri;
            return actorIri is { } a ? new Iri($"{a.Value.TrimEnd('/')}/feed") : null;
        }
    }
}
