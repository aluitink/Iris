# Production Iris.Web — configuration template (docs/plans/production-app-deployment-env-reference.md).
#
# Copy to a real `.env` next to this file (apps/Iris.Web/.env) and fill in the values; the real `.env`
# is git-ignored (it holds the DB password + admin password). Every variable has a default in
# docker-compose.yml, so a bare `docker compose up` works with the defaults except POSTGRES_PASSWORD
# (required — no safe default for a secret).

# ---- Instance identity ----
# The advertised public base URI: what the app tells the fediverse + browsers it is reachable at.
# The reverse proxy for this value already forwards to this host's port 8088 (WEB_PORT), so the default
# is the real public FQDN. It must be the URL users actually type / that WebFinger resolves to.
IRIS_ADVERTISE_BASE=https://iris.luit.ink

# ---- Database (Postgres) ----
POSTGRES_DB=iris
POSTGRES_USER=iris
# Required (docker-compose.yml uses ${POSTGRES_PASSWORD:?}). No default — it is a secret.
POSTGRES_PASSWORD=change-me

# ---- Admin bootstrap (docs/plans/production-app-authentication.md §6) ----
# If both are set, the first admin account is provisioned idempotently at boot (no-op on later boots).
# Leave blank to not create an admin. The admin can then manage the instance from the UI.
IRIS_ADMIN_USERNAME=
IRIS_ADMIN_PASSWORD=

# ---- Inbound request-body cap (slice 33.4) ----
# Bounds the memory an unauthenticated inbound federation POST can force the app to buffer (a
# denial-of-service vector for a public instance). Leave blank for the app's default (1 MiB, generous
# for an ActivityPub activity JSON document). Set to a larger byte count only if a legitimate use case
# (e.g. very large embedded media on an activity) requires it. Maps to Iris:MaxRequestBodySize.
IRIS_MAX_REQUEST_BODY_SIZE=

# ---- Ports published to the host ----
# 8088 is not arbitrary: the public https://iris.luit.ink reverse proxy already forwards to this host's
# port 8088 (previously the sample stack's iris-ui). Publishing iris-web on 8088 means no reverse-proxy
# reconfiguration is needed to bring the production app live at the public FQDN.
WEB_PORT=8088
