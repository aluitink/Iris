@using Iris.Client
@using Iris.Core.Identity
@using Iris.Web.Accounts
@using KristofferStrube.ActivityStreams

@if (Item is Follow follow && follow.Actor is { } actorLinks && actorLinks.FirstOrDefault() is Link actorLink && actorLink.Href is { } actorHref)
{
    var actorIri = new Iri(actorHref.ToString());
    <div class="follow-request-row">
        <div class="follow-request-info">
            <a href="@($"/actor/{actorIri.Value.Split('/').Last()}")" class="follow-request-actor">@HandleOf(actorHref.ToString())</a>
            <span class="muted">wants to follow you</span>
        </div>
        <div class="follow-request-actions">
            <button class="btn btn-primary btn-sm" disabled="@(_busy)" @onclick="() => AcceptAsync(actorIri)">Accept</button>
            <button class="btn btn-sm" disabled="@(_busy)" @onclick="() => RejectAsync(actorIri)">Reject</button>
        </div>
    </div>
}

@code {
    [Inject]
    private IActorSessionAccessor Session { get; set; } = default!;

    [Parameter]
    public IObjectOrLink Item { get; set; } = default!;

    private bool _busy;

    private async Task AcceptAsync(Iri followerIri)
    {
        if (Session.ActorId is not { } me || Session.Client is not { } client)
        {
            return;
        }

        if (Item is not Activity act || act.Id is not { } id)
        {
            return;
        }

        var followIri = new Iri(id);
        _busy = true;
        try
        {
            await client.AcceptAsync(me, followIri);
            StateHasChanged();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RejectAsync(Iri followerIri)
    {
        if (Session.ActorId is not { } me || Session.Client is not { } client)
        {
            return;
        }

        if (Item is not Activity act || act.Id is not { } id)
        {
            return;
        }

        var followIri = new Iri(id);

        _busy = true;
        try
        {
            await client.RejectAsync(me, followIri);
            StateHasChanged();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string HandleOf(string iri)
        => iri.Split('/').Last();
}
