@using Iris.Client
@using Iris.Core
@using Iris.Core.Identity
@using Iris.Web.Accounts
@using Iris.Web.Ui
@using KristofferStrube.ActivityStreams

@if (Client is null || TargetActor is null)
{
    return;
}

@* Don't render a follow button for your own actor. *@
@if (IsSelf)
{
    return;
}

<button class="button @(IsFollowing ? "button--secondary" : "") follow-button"
        @onclick="ToggleFollowAsync"
        disabled="@Busy">
    @if (Busy)
    {
        <span class="follow-button-busy">…</span>
    }
    else
    {
        @if (IsFollowing)
        {
            <span>Unfollow</span>
        }
        else
        {
            <span>Follow</span>
        }
    }
</button>

@code {
    [Inject]
    private IActorSessionAccessor Session { get; set; } = default!;

    [Inject]
    private UiContext Ui { get; set; } = default!;

    [Parameter]
    public IObjectOrLink? TargetActor { get; set; }

    private IActivityPubClient? Client => Session.Client;

    private bool Busy { get; set; }
    private bool IsFollowing { get; set; }
    private string? _followActivityIri;
    private string? _lastTargetIri;

    private bool IsSelf
    {
        get
        {
            if (Session.ActorId is not { } me || TargetActor is not IObject { Id: { Length: > 0 } targetId })
            {
                return false;
            }

            return string.Equals(me.Value, targetId, StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (TargetActor is not IObject { Id: { Length: > 0 } targetId })
        {
            return;
        }

        if (_lastTargetIri == targetId)
        {
            return;
        }

        _lastTargetIri = targetId;
        _followActivityIri = null;
        IsFollowing = await Ui.IsFollowingAsync(new Iri(targetId));
    }

    private async Task ToggleFollowAsync()
    {
        if (Client is not { } client || Session.ActorId is not { } me)
        {
            return;
        }

        if (TargetActor is not IObject { Id: { Length: > 0 } targetId })
        {
            return;
        }

        Busy = true;
        try
        {
            if (IsFollowing)
            {
                var followIri = _followActivityIri ?? await Ui.GetFollowActivityIriAsync(new Iri(targetId));
                if (followIri is { Length: > 0 })
                {
                    await client.UndoFollowAsync(me, new Iri(followIri));
                    IsFollowing = false;
                    _followActivityIri = null;
                    Ui.InvalidateFollowing();
                }
            }
            else
            {
                var result = await client.FollowAsync(me, new Iri(targetId));
                _followActivityIri = result.MintedId;
                IsFollowing = true;
                Ui.InvalidateFollowing();
            }
        }
        catch
        {
            // Leave state unchanged on error.
        }
        finally
        {
            Busy = false;
        }
    }
}
