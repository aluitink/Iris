@page "/object"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Iris.Client
@using Iris.Core.Identity
@using Iris.Web.Accounts
@using KristofferStrube.ActivityStreams
@using Microsoft.AspNetCore.Components.Web
@using ActivityObject = KristofferStrube.ActivityStreams.Object

<PageTitle>@PageHeading · Iris</PageTitle>

<h2>@PageHeading</h2>

@if (Client is null)
{
    <div class="card"><p class="muted">Sign in to view objects.</p></div>
}
else if (string.IsNullOrEmpty(IriParam))
{
    <div class="card"><p class="muted">No object specified.</p></div>
}
else if (LoadError is not null)
{
    <div class="card"><div class="error">@LoadError</div></div>
}
else if (ObjectDoc is null)
{
    <div class="card profile-loading">
        <svg class="loading-spinner" viewBox="25 25 50 50" aria-hidden="true">
            <circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" />
        </svg>
        <span class="muted">Loading object…</span>
    </div>
}
    else
{
    @if (ParentDoc is not null && ParentHref is not null)
    {
        <div class="card object-parent-context">
            <div class="object-parent-label">
                In reply to <a href="@ParentHref">@ParentAuthor</a>
            </div>
            <div class="object-parent-content">@ParentPreview</div>
        </div>
    }

    <div class="card object-detail">
        <ObjectView Item="ObjectDoc" />
        @if (EngagementText is not null)
        {
            <div class="object-detail-engagement">@EngagementText</div>
        }
        @if (ReplyHref is not null)
        {
            <div class="object-detail-actions">
                <a class="button button--secondary" href="@ReplyHref">Reply</a>
            </div>
        }
    </div>

    @if (ShowRepliesSection)
    {
        <div class="card replies-section">
            <h3>Replies</h3>
            @if (RepliesLoading)
            {
                <div class="card-loading">
                    <svg class="loading-spinner" viewBox="25 25 50 50" aria-hidden="true">
                        <circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" />
                    </svg>
                    <span class="muted">Loading replies…</span>
                </div>
            }
            else if (Replies is { Count: > 0 })
            {
                <ul class="object-list">
                    @foreach (var reply in Replies)
                    {
                        <li><ObjectView Item="reply" /></li>
                    }
                </ul>
            }
            else
            {
                <p class="muted">No replies yet.</p>
            }
        </div>
    }
}

@code {
    [Inject]
    private IActorSessionAccessor Session { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "iri")]
    public string? IriParam { get; set; }

    private IActivityPubClient? Client => Session.Client;

    private IObject? ObjectDoc { get; set; }
    private IObject? ParentDoc { get; set; }
    private string? LoadError { get; set; }
    private bool RepliesLoading { get; set; }
    private List<IObject?> Replies { get; set; } = [];
    private int LikeCount { get; set; }
    private int BoostCount { get; set; }

    private string? EngagementText
    {
        get
        {
            if (LikeCount == 0 && BoostCount == 0)
            {
                return null;
            }

            var parts = new List<string>();
            if (LikeCount > 0)
            {
                parts.Add($"{LikeCount} like{(LikeCount == 1 ? "" : "s")}");
            }

            if (BoostCount > 0)
            {
                parts.Add($"{BoostCount} boost{(BoostCount == 1 ? "" : "s")}");
            }

            return string.Join(" · ", parts);
        }
    }

    private string PageHeading
    {
        get
        {
            if (ObjectDoc is Actor { PreferredUsername: { Length: > 0 } px })
            {
                return px;
            }

            var type = (ObjectDoc as ActivityObject)?.Type?.FirstOrDefault();
            if (string.IsNullOrEmpty(type))
            {
                type = ObjectDoc?.GetType().Name;
            }

            return string.IsNullOrEmpty(type) ? "Object" : type;
        }
    }

    private Iri? ObjectIri
    {
        get
        {
            if (string.IsNullOrEmpty(IriParam) || !Iri.TryParse(IriParam, out var parsed))
            {
                return null;
            }

            return parsed;
        }
    }

    /// <summary>
    /// The href for the "Reply" button, or null when the object is not a replyable content type
    /// (a Note, or any non-actor content object).
    /// </summary>
    private string? ReplyHref
    {
        get
        {
            if (ObjectDoc is Actor)
            {
                return null;
            }

            if (ObjectIri is not { } iri)
            {
                return null;
            }

            return $"/compose?replyTo={Uri.EscapeDataString(iri.Value)}";
        }
    }

    /// <summary>
    /// Whether the replies section should be rendered (the object is a content object, not an actor).
    /// </summary>
    private bool ShowRepliesSection => ObjectDoc is not null && ObjectDoc is not Actor;

    private string? ParentHref
    {
        get
        {
            if (ParentDoc?.Id is not { } id)
            {
                return null;
            }

            return $"/object?iri={Uri.EscapeDataString(id)}";
        }
    }

    private string ParentAuthor
    {
        get
        {
            if (ParentDoc is null)
            {
                return "unknown";
            }

            if (ParentDoc is Actor { PreferredUsername: { Length: > 0 } px })
            {
                return "@" + px;
            }

            if (ParentDoc is ActivityObject { AttributedTo: { } attr } && attr.FirstOrDefault() is { } first)
            {
                if (first is Actor { PreferredUsername: { Length: > 0 } apx })
                {
                    return "@" + apx;
                }

                string? actorIriStr = first is ILink { Href: { } href } ? href.ToString() : first.Id;
                if (actorIriStr is not null && Iri.TryParse(actorIriStr, out var attrIri))
                {
                    var segments = attrIri.Value.Split('/');
                    return segments.Length > 1 ? segments[^1] : "unknown";
                }
            }

            return "unknown";
        }
    }

    private string ParentPreview
    {
        get
        {
            var content = (ParentDoc as ActivityObject)?.Content?.FirstOrDefault();
            if (string.IsNullOrEmpty(content))
            {
                return "(no content)";
            }

            var text = new System.Text.RegularExpressions.Regex("<[^>]+>").Replace(content, " ").Trim();
            return text.Length > 200 ? text[..200] + "…" : text;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Client is not { } client || ObjectIri is not { } iri || LoadError is not null)
        {
            return;
        }

        if (ObjectDoc is not null && ObjectDoc.Id == iri.Value)
        {
            return;
        }

        try
        {
            var obj = await client.GetObjectAsync(iri, CancellationToken.None);
            if (obj is not null)
            {
                ObjectDoc = obj;
            }
            else
            {
                LoadError = "Object not found.";
            }
        }
        catch (Exception ex)
        {
            LoadError = ex.Message;
        }

        if (ObjectDoc is not null && ObjectDoc is not Actor)
        {
            await LoadParentAsync(client);
            await LoadRepliesAsync(client, iri);
            await LoadEngagementAsync(client, iri);
        }
    }

    private async Task LoadRepliesAsync(IActivityPubClient client, Iri iri)
    {
        RepliesLoading = true;
        try
        {
            var resolved = new List<IObject?>();
            await foreach (var item in client.GetRepliesAsync(iri, new CollectionQuery { Limit = 20 }, CancellationToken.None))
            {
                var replyIri = item.ResolveObjectIri();
                if (replyIri is not { } ri)
                {
                    continue;
                }

                try
                {
                    var replyObj = await client.GetObjectAsync(ri, CancellationToken.None);
                    if (replyObj is not null)
                    {
                        resolved.Add(replyObj);
                    }
                }
                catch
                {
                    // Skip unresolvable replies (404, network error, etc.).
                }
            }

            Replies = resolved;
        }
        catch
        {
            // Non-fatal: the object still renders; replies simply won't show.
        }
        finally
        {
            RepliesLoading = false;
        }

        StateHasChanged();
    }

    private async Task LoadParentAsync(IActivityPubClient client)
    {
        if (ObjectDoc.GetParentIri() is not { } parentIri)
        {
            return;
        }

        try
        {
            var parent = await client.GetObjectAsync(parentIri, CancellationToken.None);
            ParentDoc = parent;
        }
        catch
        {
            // Non-fatal: parent context simply won't show.
        }
    }

    private async Task LoadEngagementAsync(IActivityPubClient client, Iri iri)
    {
        try
        {
            int likes = 0;
            await foreach (var _ in client.GetLikesAsync(iri, new CollectionQuery { Limit = 100 }, CancellationToken.None))
            {
                likes++;
            }

            int boosts = 0;
            await foreach (var _ in client.GetSharesAsync(iri, new CollectionQuery { Limit = 100 }, CancellationToken.None))
            {
                boosts++;
            }

            LikeCount = likes;
            BoostCount = boosts;
        }
        catch
        {
            // Non-fatal: engagement counts simply won't show.
        }
    }
}
