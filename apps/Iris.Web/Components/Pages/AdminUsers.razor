@page "/admin/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Admin")]
@using Iris.Core.Identity
@using Iris.Server.Data.Accounts

<PageTitle>Admin · Users · Iris</PageTitle>

<h2>Instance users</h2>

@if (LoadError is not null)
{
    <div class="error">@LoadError</div>
}
else if (Users is null)
{
    <div class="card profile-loading">
        <svg class="loading-spinner" viewBox="25 25 50 50" aria-hidden="true">
            <circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" />
        </svg>
        <span class="muted">Loading users…</span>
    </div>
}
else
{
    <div class="card">
        <p class="muted">@Users.Count local account(s)</p>
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Handle</th>
                    <th>Role</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Users)
                {
                    <tr>
                        <td>@user.Username</td>
                        <td><span class="badge @RoleBadgeClass(user.Role)">@user.Role</span></td>
                        <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private readonly IUserAccountStore _accounts;
    private IReadOnlyList<UserAccount>? Users { get; set; }
    private string? LoadError { get; set; }

    public AdminUsers(IUserAccountStore accounts)
    {
        _accounts = accounts;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await _accounts.GetAllAsync();
            Users = all.OrderBy(u => u.Username, StringComparer.OrdinalIgnoreCase).ToList();
        }
        catch (Exception ex)
        {
            LoadError = ex.Message;
        }
    }

    private static string RoleBadgeClass(UserRole role)
        => role == UserRole.Admin ? "badge--admin" : "badge--user";
}
