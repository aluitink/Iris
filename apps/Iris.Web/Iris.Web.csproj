<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Iris.Web</RootNamespace>
    <IsPackable>false</IsPackable>
    <Description>
      The Iris production server: ASP.NET Core host that serves the ActivityPub API
      (Iris.Server), local auth (cookie), notification + session + admin endpoints.
      The Blazor WebAssembly client (Iris.Web.Client) has been removed from the active
      build (operator direction: the WASM app is not the project under development);
      this host now serves the API surface only.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Iris.Server.Data\Iris.Server.Data.csproj" />
    <ProjectReference Include="..\..\src\Iris.Server.InMemory\Iris.Server.InMemory.csproj" />
    <ProjectReference Include="..\..\src\Iris.Server\Iris.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <!-- The Blazor WebAssembly client (Iris.Web.Client) is no longer part of the active build.
       The BuildAndCopyClient / PatchWasmConfig targets that published + copied the client's
       _framework output into this host's wwwroot were removed (operator direction: the WASM
       app is not the project under development). The host now serves the API surface only. -->







</Project>
