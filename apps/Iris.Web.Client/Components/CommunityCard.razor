@using Iris.Core.Identity
@using Iris.Web.Client.Components
@using Microsoft.AspNetCore.Components
@using KristofferStrube.ActivityStreams

@if (Community is { } group)
{
    <div class="community-card">
        <ActorCard Actor="@group" ActorId="@group.Id" ShowModeration="false" ShowStats="true" ShowSummary="true">
            <FollowButton TargetActor="@group" IsCommunity="true" FollowChanged="@FollowChanged" />
        </ActorCard>
    </div>
}

@code {
    /// <summary>
    /// The community (<c>Group</c>) to present. Rendered as the unified actor card — the same
    /// control the directory and the actor page's followers/following tabs use — so a community's
    /// card looks identical whether you reach it from /communities or /directory. The <c>FollowButton</c>
    /// in the actions column <em>is</em> the Join/Leave action: a community's members are its followers
    /// (change 221), so following a community is joining it (labeled "Join"/"Leave" via
    /// <c>IsCommunity</c>).
    /// </summary>
    [Parameter]
    public Group? Community { get; set; }

    /// <summary>
    /// Optional callback forwarded to the <c>FollowButton</c>, invoked after a follow/unfollow
    /// toggle. The /communities page uses it to re-read the following collection so the Following
    /// tab updates immediately.
    /// </summary>
    [Parameter]
    public EventCallback FollowChanged { get; set; }
}
