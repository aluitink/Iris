@using System.Linq
@using Iris.Core.Identity

@if (Author is { } author)
{
    <div class="card-moderate">
        <button type="button" class="card-moderate-btn" title="Block @HandleOf(author)" aria-label="Block @HandleOf(author)"
                disabled="@Busy" @onclick="OnBlock">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M5.6 5.6l12.8 12.8" />
            </svg>
        </button>
        <button type="button" class="card-moderate-btn" title="Mute @HandleOf(author)" aria-label="Mute @HandleOf(author)"
                disabled="@Busy" @onclick="OnMute">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M11 5 6 9H2v6h4l5 4V5z" />
                <path d="M23 9l-6 6" />
                <path d="M17 9l6 6" />
            </svg>
        </button>
        <button type="button" class="card-moderate-btn" title="@(IsReported ? "Reported" : $"Report {HandleOf(author)}")" aria-label="@(IsReported ? "Reported" : $"Report {HandleOf(author)}")"
                disabled="@(Busy || IsReported)" @onclick="OnReport">
            @if (IsReported)
            {
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M20 6L9 17l-5-5" />
                </svg>
            }
            else
            {
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z" />
                    <line x1="4" y1="22" x2="4" y2="15" />
                </svg>
            }
        </button>
    </div>
}

@code {
    /// <summary>
    /// The author actor's IRI (the moderation target). The buttons reveal a tooltip naming the handle.
    /// </summary>
    [Parameter]
    public Iri? Author { get; set; }

    /// <summary>
    /// When true, all three buttons are disabled (a moderation action is in flight).
    /// </summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>
    /// S9: when true, the Report button shows a "Reported" checkmark and is disabled (dedup).
    /// </summary>
    [Parameter]
    public bool IsReported { get; set; }

    /// <summary>Fires when the Block button is clicked.</summary>
    [Parameter]
    public EventCallback OnBlock { get; set; }

    /// <summary>Fires when the Mute button is clicked.</summary>
    [Parameter]
    public EventCallback OnMute { get; set; }

    /// <summary>Fires when the Report button is clicked.</summary>
    [Parameter]
    public EventCallback OnReport { get; set; }

    private static string HandleOf(Iri iri)
    {
        var path = Uri.UnescapeDataString(new Uri(iri.Value).AbsolutePath).TrimEnd('/');
        var last = path.Split('/').LastOrDefault();
        return string.IsNullOrWhiteSpace(last) ? iri.Value : last;
    }
}
