@using Iris.Client
@using Iris.Core.Identity
@using Iris.Web.Client.Accounts
@using KristofferStrube.ActivityStreams

@if (ObjectIri is { } iri)
{
    <div class="engagement-bar">
        <button type="button"
                class="engagement-btn @(_liked ? "engagement-btn--active" : "")"
                title="Like"
                aria-label="Like"
                aria-pressed="@(_liked ? "true" : "false")"
                disabled="@_busy"
                @onclick="() => ToggleLikeAsync(iri)">
            <svg viewBox="0 0 24 24" fill="@(_liked ? "currentColor" : "none")" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
            </svg>
            <span class="engagement-count">@_likeCount</span>
        </button>
        <button type="button"
                class="engagement-btn @(_boosted ? "engagement-btn--active" : "")"
                title="Boost"
                aria-label="Boost"
                aria-pressed="@(_boosted ? "true" : "false")"
                disabled="@_busy"
                @onclick="() => ToggleBoostAsync(iri)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M17 1l4 4-4 4" />
                <path d="M3 11V9a4 4 0 0 1 4-4h14" />
                <path d="M7 23l-4-4 4-4" />
                <path d="M21 13v2a4 4 0 0 1-4 4H3" />
            </svg>
            <span class="engagement-count">@_boostCount</span>
        </button>
        <a class="engagement-btn"
           href="/compose?replyTo=@Uri.EscapeDataString(iri.Value)"
           title="Reply"
           aria-label="Reply">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            </svg>
        </a>
        @if (CanModerate)
        {
            <div class="engagement-more" role="button" tabindex="0" aria-label="More options" aria-expanded="_showModeration"
                 @onclick="() => _showModeration = !_showModeration"
                 @onkeydown="OnMoreKeyDown">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <circle cx="12" cy="5" r="1.5" />
                    <circle cx="12" cy="12" r="1.5" />
                    <circle cx="12" cy="19" r="1.5" />
                </svg>
                @if (_showModeration)
                {
                    <div class="engagement-menu" @onclick:stopPropagation>
                        <button type="button" class="engagement-menu-item" disabled="@_busy" @onclick="() => BlockAsync()">Block</button>
                        <button type="button" class="engagement-menu-item" disabled="@_busy" @onclick="() => MuteAsync()">Mute</button>
                        <button type="button" class="engagement-menu-item" disabled="@_busy" @onclick="() => FlagAsync()">Report</button>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Inject]
    private IActorSessionAccessor Session { get; set; } = default!;

    /// <summary>
    /// The IRI of the object to engage with (like, boost, reply).
    /// </summary>
    [Parameter]
    public Iri? ObjectIri { get; set; }

    /// <summary>
    /// The IRI of the post's author (the moderation target). When null or equal to the
    /// signed-in user's actor, the moderation menu is hidden.
    /// </summary>
    [Parameter]
    public Iri? AuthorIri { get; set; }

    /// <summary>
    /// The content object this bar is rendered for (a <see cref="Note"/>/<see cref="Article"/>), when the
    /// caller has it in hand (a collection item or an object document). When the object carries the
    /// server-rendered <c>iris:likedCount</c> / <c>iris:sharedCount</c> / <c>iris:isLiked</c> /
    /// <c>iris:isShared</c> extensions, the bar seeds its counts and the signed-in user's like/boost state
    /// from them and skips the per-object <c>/likes</c> / <c>/shares</c> collection walk (54.8) — issuing
    /// at most a single walk (only the collection the user engaged) to recover the minted activity id an
    /// unlike / un-boost (an <c>Undo</c>) references. When the extensions are absent (a non-Iris instance,
    /// or a read the server did not enrich) the bar falls back to the full walk for both collections, as
    /// before.
    /// </summary>
    [Parameter]
    public IObject? Object { get; set; }

    private int _likeCount;
    private int _boostCount;
    private bool _liked;
    private bool _boosted;
    private bool _busy;
    private bool _countsLoaded;
    private bool _showModeration;
    private Iri? _likeIri;
    private Iri? _announceIri;

    /// <summary>
    /// Keyboard handler for the "More options" toggle (Enter/Space activates).
    /// </summary>
    private void OnMoreKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
        {
            _showModeration = !_showModeration;
        }
    }

    /// <summary>
    /// Whether the activity's actor/attributedTo is the given user (tolerating trailing-slash IRI variants).
    /// </summary>
    private bool CanModerate
        => AuthorIri is { } author && Session.ActorId is { } me && author != me;

    protected override async Task OnParametersSetAsync()
    {
        // Seed the like/boost counts AND the signed-in user's own like/boost state from the server.
        //
        // Fast path (54.8): the server renders the per-object counters (iris:likedCount /
        // iris:sharedCount) and — for an authenticated (signed) read — the requester's net like/boost
        // state (iris:isLiked / iris:isShared) directly onto the content object (a collection item in a
        // feed, or the object document). When the object carries BOTH counters, they are authoritative
        // (the server derives them live from the reverse index), so the bar seeds _likeCount /
        // _boostCount from them and does NOT re-walk the /likes and /shares collections just to count
        // items (the two per-object fetches that used to fire for every rendered object). The viewer's
        // like/boost state is read from isLiked / isShared. The ONLY thing a walk still recovers is the
        // minted Like/Announce activity id an unlike/un-boost (an Undo) references — and that is only
        // needed when the user HAS engaged, so at most ONE collection is walked (the one engaged), never
        // both. When the counters are absent (a non-Iris instance, a cached outbox item the server did not
        // enrich with per-requester state, or an unsigned read) the bar falls back to the full walk for
        // both collections, exactly as before.
        if (ObjectIri is not { } iri || Session.Client is not { } client)
        {
            return;
        }

        var ns = Session.IrisNamespaceBase?.Value;
        if (ns is not null
            && Object is { } obj
            && obj.GetLikedCount(ns) is { } likedCount
            && obj.GetSharedCount(ns) is { } sharedCount)
        {
            try
            {
                _likeCount = likedCount;
                _boostCount = sharedCount;
                _liked = obj.GetIsLiked(ns) is true;
                _boosted = obj.GetIsShared(ns) is true;
                _countsLoaded = true;

                var me = Session.ActorId;
                if (_liked && me is { } meIri)
                {
                    // Recover the minted Like id for the unlike (Undo) reference — the single walk that
                    // remains, and only because the user has liked this object.
                    await foreach (var item in client.GetLikesAsync(
                        iri, new CollectionQuery { Limit = 100, BypassCache = true }, CancellationToken.None))
                    {
                        if (LikeActorIri(item) is { } liker && IriEquals(liker, meIri))
                        {
                            _likeIri = ItemIri(item);
                            break;
                        }
                    }
                }

                if (_boosted && me is { } meIri2)
                {
                    await foreach (var item in client.GetSharesAsync(
                        iri, new CollectionQuery { Limit = 100, BypassCache = true }, CancellationToken.None))
                    {
                        if (AnnounceActorIri(item) is { } booster && IriEquals(booster, meIri2))
                        {
                            _announceIri = ItemIri(item);
                            break;
                        }
                    }
                }
            }
            catch
            {
                // Non-fatal: the counts are already seeded from the extensions; only the (optional) id
                // recovery fails, so an unlike/un-boost would simply re-fetch on the next interaction.
            }
            return;
        }

        // Fallback: no server-rendered counters (non-Iris / un-enriched / unsigned). Walk both
        // collections to derive the counts AND the viewer's own like/boost state (and the minted ids).
        // Both reads bypass the client collection-page cache: a like/boost the user just made must not be
        // masked by a stale pre-engagement page (the server derives the count live from the reverse index,
        // so a fresh read is authoritative and cheap).
        try
        {
            var me = Session.ActorId;
            int likes = 0;
            int boosts = 0;
            bool iLiked = false;
            bool iBoosted = false;

            await foreach (var item in client.GetLikesAsync(
                iri, new CollectionQuery { Limit = 100, BypassCache = true }, CancellationToken.None))
            {
                likes++;
                if (!iLiked && me is { } meIri && LikeActorIri(item) is { } liker && IriEquals(liker, meIri))
                {
                    iLiked = true;
                    _likeIri = ItemIri(item); // the minted Like id, for the unlike (Undo) reference.
                }
            }

            await foreach (var item in client.GetSharesAsync(
                iri, new CollectionQuery { Limit = 100, BypassCache = true }, CancellationToken.None))
            {
                boosts++;
                if (!iBoosted && me is { } meIri && AnnounceActorIri(item) is { } booster && IriEquals(booster, meIri))
                {
                    iBoosted = true;
                    _announceIri = ItemIri(item); // the minted Announce id, for the un-boost (Undo) reference.
                }
            }

            _likeCount = likes;
            _boostCount = boosts;
            _liked = iLiked;
            _boosted = iBoosted;
            _countsLoaded = true;
        }
        catch
        {
            // Non-fatal: counts simply won't show until a later render re-fetches.
        }
    }

    /// <summary>
    /// Resolves the IRI an <see cref="IObjectOrLink"/> collection item points at (a <c>Link</c>'s
    /// <c>href</c>, or an embedded object's <c>id</c>) — null when neither is present.
    /// </summary>
    private static Iri? ItemIri(IObjectOrLink item)
        => item switch
        {
            ILink { Href: { } href } => new Iri(href),
            IObject { Id: { Length: > 0 } id } => new Iri(id),
            _ => null,
        };

    /// <summary>
    /// Resolves the IRI of the actor who issued a <see cref="Like"/> collection item (the liker) — the
    /// <c>actor</c> of a <c>Like</c> activity. Null when the item is not a <c>Like</c> (or the <c>Like</c>
    /// carries no resolvable <c>actor</c>, e.g. a degraded Link-to-liker fallback).
    /// </summary>
    private static Iri? LikeActorIri(IObjectOrLink item)
        => item is Like like && like.Actor is { } actors
            ? ResolveActorIri(actors)
            : null;

    /// <summary>
    /// Resolves the IRI of the actor who issued an <see cref="Announce"/> (boost) collection item (the
    /// booster) — the <c>actor</c> of an <c>Announce</c> activity. Null when the item is not an
    /// <c>Announce</c> (or the <c>Announce</c> carries no resolvable <c>actor</c>, e.g. a degraded
    /// Link-to-announcer fallback).
    /// </summary>
    private static Iri? AnnounceActorIri(IObjectOrLink item)
        => item is Announce announce && announce.Actor is { } actors
            ? ResolveActorIri(actors)
            : null;

    /// <summary>
    /// Resolves the first resolvable IRI from an ActivityStreams actor/object reference collection
    /// (handles both <c>Link</c> and embedded-object references).
    /// </summary>
    private static Iri? ResolveActorIri(IEnumerable<IObjectOrLink> refs)
    {
        foreach (var reference in refs)
        {
            if (reference is ILink { Href: { } href })
            {
                return new Iri(href);
            }

            if (reference is IObject { Id: { Length: > 0 } id })
            {
                return new Iri(id);
            }
        }

        return null;
    }

    /// <summary>
    /// Compares two IRIs for the same resource, tolerating trailing-slash differences (the same IRI can be
    /// written with or without a trailing slash across producers/consumers).
    /// </summary>
    private static bool IriEquals(Iri a, Iri b)
        => a == b || a.Value.TrimEnd('/') == b.Value.TrimEnd('/');

    private async Task ToggleLikeAsync(Iri iri)
    {
        if (_busy || Session.ActorId is not { } me || Session.Client is not { } client)
        {
            return;
        }

        _busy = true;
        try
        {
            if (_liked && _likeIri is { } likeId)
            {
                await client.UnlikeAsync(me, likeId);
                _liked = false;
                _likeIri = null;
                // Adjust from the seeded total only once it's known (a pre-load click is a no-op delta).
                if (_countsLoaded)
                {
                    _likeCount = Math.Max(0, _likeCount - 1);
                }
            }
            else
            {
                var result = await client.LikeAsync(me, iri);
                if (result.IsSuccess && result.MintedId is { } minted)
                {
                    _liked = true;
                    _likeIri = new Iri(minted);
                    if (_countsLoaded)
                    {
                        _likeCount++;
                    }
                }
            }
        }
        catch
        {
            // Revert on failure (optimistic update rollback is implicit: state only changes on success).
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleBoostAsync(Iri iri)
    {
        if (_busy || Session.ActorId is not { } me || Session.Client is not { } client)
        {
            return;
        }

        _busy = true;
        try
        {
            if (_boosted && _announceIri is { } announceId)
            {
                await client.UnannounceAsync(me, announceId);
                _boosted = false;
                _announceIri = null;
                if (_countsLoaded)
                {
                    _boostCount = Math.Max(0, _boostCount - 1);
                }
            }
            else
            {
                var result = await client.AnnounceAsync(me, iri);
                if (result.IsSuccess && result.MintedId is { } minted)
                {
                    _boosted = true;
                    _announceIri = new Iri(minted);
                    if (_countsLoaded)
                    {
                        _boostCount++;
                    }
                }
            }
        }
        catch
        {
            // Revert on failure.
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task BlockAsync()
    {
        if (_busy || Session.ActorId is not { } me || Session.Client is not { } client || AuthorIri is not { } target)
        {
            return;
        }

        _busy = true;
        try
        {
            await client.BlockAsync(me, target);
            _showModeration = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MuteAsync()
    {
        if (_busy || Session.ActorId is not { } me || Session.LocalModeration is not { } mod || AuthorIri is not { } target)
        {
            return;
        }

        _busy = true;
        try
        {
            await mod.MuteAsync(me, target);
            _showModeration = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task FlagAsync()
    {
        if (_busy || Session.ActorId is not { } me || Session.Client is not { } client || AuthorIri is not { } target)
        {
            return;
        }

        _busy = true;
        try
        {
            await client.FlagAsync(me, target);
            _showModeration = false;
        }
        finally
        {
            _busy = false;
        }
    }
}
