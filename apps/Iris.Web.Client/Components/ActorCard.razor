@using Iris.Core.Identity
@using Iris.Web.Client.Ui
@using KristofferStrube.ActivityStreams

@inject UiContext Ui

@if (Actor is { } actor)
{
    <div class="actor-card @(ShowBanner ? "actor-card--bannered" : string.Empty)">
        @if (ShowBanner)
        {
            <div class="actor-card-banner" role="img" aria-label="Profile banner">
                <img src="@ActorIdentityHelper.RewriteMediaToSameOrigin(BannerIri!)" alt="" loading="lazy" />
            </div>
        }
        <div class="actor-card-main">
            <ActorAvatar ActorIri="@ActorIri" DisplayName="@Name" IconIriOverride="@IconIri" CssClass="actor-card-avatar" />
            <div class="actor-card-body">
                <div class="actor-card-identity">
                    @if (PreferredUsername is { Length: > 0 } username)
                    {
                        <a href="@Href" title="@(ActorIdValue)" class="actor-card-handle">@username</a>
                    }
                    else
                    {
                        <span class="actor-card-handle">@actor.Id</span>
                    }
                    @if (Name is { Length: > 0 } name && !Redundant)
                    {
                        <span class="actor-card-name">@name</span>
                    }
                    @if (IsCommunity)
                    {
                        <span class="actor-card-badge actor-card-badge--community">Community</span>
                    }
                    @if (IsApplication)
                    {
                        <span class="actor-card-badge actor-card-badge--app">Bot</span>
                    }
                </div>
                @if (Summary is { Length: > 0 })
                {
                    <div class="actor-card-summary">@RenderedSummary</div>
                }
            </div>
        </div>
        <div class="actor-card-actions">
            @ChildContent
            @if (ShowModeration)
            {
                <ModerationActions TargetActor="Actor" />
            }
        </div>
    </div>
}
else
{
    <span class="muted">No actor document.</span>
}

@code {
    /// <summary>
    /// The actor document to present (an <see cref="Actor"/>: a person, community, application, …).
    /// Pattern-matched per the 3rd-Party ActivityStreams rules — never a concrete type. A non-actor
    /// document or null renders a muted placeholder.
    /// </summary>
    [Parameter]
    public IObject? Actor { get; set; }

    /// <summary>
    /// The actor's IRI, for the handle link's href + tooltip. Defaults to the document's own <c>id</c>.
    /// </summary>
    [Parameter]
    public string? ActorId { get; set; }

    /// <summary>
    /// Optional child content rendered in the actions column (e.g. a follow button).
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// When <c>true</c> (the default), the card renders the moderation menu (Block / Mute / Report)
    /// when the signed-in user is not the target actor. Set to <c>false</c> in contexts where the
    /// host already provides its own moderation controls.
    /// </summary>
    [Parameter]
    public bool ShowModeration { get; set; } = true;

    private string ActorIdValue => ActorId ?? Actor?.Id ?? string.Empty;

    private string Href => ActorIdValue.Length > 0
        ? ActorIdentityHelper.ActorHref(new Iri(ActorIdValue), Actor)
        : "/directory";

    private string? PreferredUsername => (Actor as Actor)?.PreferredUsername;

    private string? Name => (Actor as Actor)?.Name?.FirstOrDefault();

    private string? Summary => (Actor as Actor)?.Summary?.FirstOrDefault();

    // The summary is untrusted HTML from a remote instance — sanitize it before emitting as markup
    // (see HtmlSanitizer). Rendered via @RenderedSummary in the template.
    private MarkupString RenderedSummary
        => ActorIdentityHelper.RenderedSummary(Summary);

    private bool Redundant => ActorIdentityHelper.NameIsRedundant(Name, PreferredUsername);

    private string? IconIri => ActorIdentityHelper.IconIri(Actor);

    private string? BannerIri => ActorIdentityHelper.BannerIri(Actor);

    private bool ShowBanner => BannerIri is { Length: > 0 };

    private bool IsCommunity => ActorIdentityHelper.IsCommunity(Actor);

    private bool IsApplication => Actor is Application;

    private Iri? ActorIri => ActorIdValue.Length > 0 ? new Iri(ActorIdValue) : null;
}
