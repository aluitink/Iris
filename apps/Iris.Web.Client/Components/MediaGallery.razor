@using KristofferStrube.ActivityStreams

@if (Attachments.Count == 0)
{
    return;
}

@{
    var images = Attachments.Where(a => IsImage(a)).ToList();
    var videos = Attachments.Where(a => IsVideo(a)).ToList();
    var audios = Attachments.Where(a => IsAudio(a)).ToList();
    var documents = Attachments.Where(a => !IsImage(a) && !IsVideo(a) && !IsAudio(a)).ToList();
}

<div class="media-gallery-wrap @(Blurred ? "object-content--blurred" : "")">
@if (images.Count > 0)
{
    <div class="media-gallery media-gallery--@MediaGridClass(images.Count)">
        @for (var i = 0; i < images.Count; i++)
        {
            var att = images[i];
            var idx = i;
            if (_failedImages.Contains(i))
            {
                <div class="media-gallery-item media-gallery-item--unavailable" title="@(att.Name ?? att.Url.Value)">
                    <a href="@Rewrite(att.Url.Value)" target="_blank" rel="noopener" class="media-unavailable-link">
                        <span class="media-unavailable-icon" aria-hidden="true">⚠️</span>
                        <span class="media-unavailable-label">media unavailable</span>
                    </a>
                </div>
            }
            else
            {
                <div class="media-gallery-item" @onclick="() => OpenLightbox(idx)">
                    <img src="@Rewrite(att.Url.Value)" alt="@ImageAlt(att)" title="@ImageAlt(att)" loading="lazy" @onerror="() => ImageFailed(idx)" />
                </div>
            }
        }
    </div>
}

@foreach (var vid in videos)
{
    <div class="media-player">
        <video controls preload="metadata" class="media-player-video" poster="@(MediaPoster(vid))">
            <source src="@Rewrite(vid.Url.Value)" type="@(MediaMime(vid))" />
            Your browser does not support the video tag.
        </video>
        @if (vid.Name is { Length: > 0 } vname)
        {
            <div class="media-player-label">@vname</div>
        }
    </div>
}

@foreach (var aud in audios)
{
    <div class="media-player">
        <audio controls preload="metadata" class="media-player-audio">
            <source src="@Rewrite(aud.Url.Value)" type="@(MediaMime(aud))" />
            Your browser does not support the audio tag.
        </audio>
        @if (aud.Name is { Length: > 0 } aname)
        {
            <div class="media-player-label">@aname</div>
        }
    </div>
}

@if (documents.Count > 0)
{
    <div class="doc-gallery doc-gallery--@MediaGridClass(documents.Count)">
        @foreach (var doc in documents)
        {
            <div class="doc-gallery-item">
                @if (doc.Preview is { } p && IsImagePreview(p.Value))
                {
                    <img class="doc-gallery-preview" src="@Rewrite(p.Value)" alt="" loading="lazy" />
                }
                else if (IsPdf(doc))
                {
                    <iframe class="doc-gallery-pdf" src="@Rewrite(doc.Url.Value)" title="@(doc.Name ?? doc.Url.Value)" loading="lazy"></iframe>
                }
                else
                {
                    <div class="doc-gallery-placeholder">@IconFor(doc.Type)</div>
                }
                <div class="doc-gallery-label">
                    @{
                        var isLink = IsPlainWebLink(doc);
                        var href = isLink ? (RewriteDirect(doc.Url.Value) ?? Rewrite(doc.Url.Value)) : Rewrite(doc.Url.Value);
                        var label = doc.Name ?? doc.Url.Value;
                    }
                    <a href="@href" target="_blank" rel="noopener" class="doc-gallery-link" download="@(isLink ? "" : label)">@label</a>
                    @if (doc.Type is { } dt)
                    {
                        <span class="doc-gallery-type">@dt</span>
                    }
                </div>
            </div>
        }
    </div>
}
</div>

@if (_lightboxIndex is { } li)
{
    var cur = li;
    <div class="lightbox-overlay" @onclick="CloseLightbox">
        <div class="lightbox-content" @onclick:stopPropagation="true">
            <button class="lightbox-close" @onclick="CloseLightbox" aria-label="Close">&times;</button>
            @if (cur > 0)
            {
                <button class="lightbox-nav lightbox-nav--prev" @onclick="PrevImage" aria-label="Previous">&#8249;</button>
            }
            @if (_failedImages.Contains(cur))
            {
                <div class="lightbox-img lightbox-img--unavailable">
                    <a href="@Rewrite(_images[cur].Url.Value)" target="_blank" rel="noopener" class="media-unavailable-link">
                        <span class="media-unavailable-icon" aria-hidden="true">⚠️</span>
                        <span class="media-unavailable-label">media unavailable — open original</span>
                    </a>
                </div>
            }
            else
            {
                <img class="lightbox-img" src="@Rewrite(_images[cur].Url.Value)" alt="@ImageAlt(_images[cur])" title="@ImageAlt(_images[cur])" @onerror="() => ImageFailed(cur)" />
            }
            @if (cur < _images.Count - 1)
            {
                <button class="lightbox-nav lightbox-nav--next" @onclick="NextImage" aria-label="Next">&#8250;</button>
            }
            @if (cur + 1 < _images.Count)
            {
                <div class="lightbox-counter">@(cur + 1) / @_images.Count</div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<RichAttachment> Attachments { get; set; } = [];

    /// <summary>When true, applies a blur filter to all media (used for sensitive content before reveal).</summary>
    [Parameter]
    public bool Blurred { get; set; }

    private List<RichAttachment> _images = [];
    private int? _lightboxIndex;

    /// <summary>
    /// Image indices whose <c>&lt;img&gt;</c> failed to load (a 502 from the media proxy when the
    /// source URL is dead and the blob was never fetched, or a missing local blob). A failed image is
    /// re-rendered as a link-out placeholder (the original URL + an "unavailable" caption) instead of
    /// the browser's broken-image icon — 139.3 scenario 8: "a dead source URL degrades to a 502, not a
    /// broken image icon forever."
    /// </summary>
    private readonly HashSet<int> _failedImages = [];

    protected override void OnParametersSet()
    {
        _images = Attachments.Where(a => IsImage(a)).ToList();
        // The set is keyed by index into _images; when the attachment list changes (e.g. a new post
        // renders in the same component slot), stale indices are harmless (they simply don't match).
        _failedImages.Clear();
    }

    /// <summary>
    /// Marks image <paramref name="index"/> as failed to load (wired to the <c>&lt;img&gt;</c>
    /// <c>@onerror</c>) so it re-renders as a link-out placeholder instead of a broken-image icon.
    /// </summary>
    /// <param name="index">The index of the failed image in <see cref="_images"/>.</param>
    private void ImageFailed(int index)
    {
        // Setting state in an @onerror handler is enough: Blazor runs the handler inside the
        // renderer's dispatch, so the resulting state change is picked up by the next render pass.
        _failedImages.Add(index);
    }

    private string MediaGridClass(int count) => count switch
    {
        1 => "single",
        2 => "two",
        3 => "three",
        _ => "four",
    };

    private void OpenLightbox(int index) => _lightboxIndex = index;

    private void CloseLightbox() => _lightboxIndex = null;

    private void PrevImage()
    {
        if (_lightboxIndex is { } idx && idx > 0)
        {
            _lightboxIndex = idx - 1;
        }
    }

    private void NextImage()
    {
        if (_lightboxIndex is { } idx && idx < _images.Count - 1)
        {
            _lightboxIndex = idx + 1;
        }
    }

    private static bool IsImage(RichAttachment att)
        => att.Type is null or "Image" && att.Preview is null
            || att.Type is "Document" && IsImageUrl(att.Url.Value);

    private static bool IsImageUrl(string url)
    {
        var lower = url.ToLowerInvariant();
        // Strip query string + fragment for the extension check.
        var q = lower.IndexOfAny(['?', '#']);
        if (q >= 0)
        {
            lower = lower[..q];
        }
        return lower is { Length: > 0 }
            && (lower.EndsWith(".jpg") || lower.EndsWith(".jpeg") || lower.EndsWith(".png")
                || lower.EndsWith(".gif") || lower.EndsWith(".webp") || lower.EndsWith(".svg")
                || lower.EndsWith(".avif") || lower.EndsWith(".bmp"));
    }

    // A video attachment is one whose AS type says Video, or whose mediaType/URL points at a video —
    // the latter catches uploaded video files, which Iris stores as a `Document`-typed attachment
    // (see ComposeNote.BuildMediaAttachment) and that carry `mediaType = "video/*"`.
    private static bool IsVideo(RichAttachment att)
        => (att.Type is not null && att.Type.Contains("Video", StringComparison.OrdinalIgnoreCase))
            || IsVideoMedia(att.MediaType)
            || IsVideoUrl(att.Url.Value);

    private static bool IsAudio(RichAttachment att)
        => (att.Type is not null && att.Type.Contains("Audio", StringComparison.OrdinalIgnoreCase))
            || IsAudioMedia(att.MediaType)
            || IsAudioUrl(att.Url.Value);

    private static bool IsVideoMedia(string? mediaType)
        => mediaType is { Length: > 0 }
            && (mediaType.StartsWith("video/", StringComparison.OrdinalIgnoreCase)
                || mediaType.Contains("mp4") || mediaType.Contains("webm") || mediaType.Contains("ogg")
                || mediaType.Contains("ogv") || mediaType.Contains("mov") || mediaType.Contains("quicktime")
                || mediaType.Contains("matroska") || mediaType.Contains("x-matroska"));

    private static bool IsAudioMedia(string? mediaType)
        => mediaType is { Length: > 0 }
            && (mediaType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase)
                || mediaType.Contains("mp3") || mediaType.Contains("mpeg") || mediaType.Contains("wav")
                || mediaType.Contains("wave") || mediaType.Contains("aiff") || mediaType.Contains("midi")
                || mediaType.Contains("midi") || mediaType.Contains("aac") || mediaType.Contains("m4a")
                || mediaType.Contains("opus") || mediaType.Contains("flac") || mediaType.Contains("amr"));

    private static string? MediaMime(RichAttachment att)
        => att.MediaType is { Length: > 0 } mt ? mt : null;

    private static string? MediaPoster(RichAttachment att)
        => att.Preview is { } p ? Rewrite(p.Value) : null;

    /// <summary>
    /// The <c>&lt;img alt&gt;</c> for an image attachment: the author-supplied alternative text
    /// (<c>RichAttachment.Alt</c>, the ActivityStreams <c>alt</c> term) when present, falling back to the
    /// attachment name and then the media URL (the historical behavior) so every image has a non-empty
    /// accessible name.
    /// </summary>
    private static string ImageAlt(RichAttachment att)
        => att.Alt is { Length: > 0 } ? att.Alt : att.Name is { Length: > 0 } ? att.Name : att.Url.Value;

    private static string IconFor(string? type) => type?.ToLowerInvariant() switch
    {
        "document" => "📄",
        "audio" => "🎵",
        "video" => "🎬",
        _ => "📎",
    };

    private static bool IsPdf(RichAttachment att)
    {
        var lower = att.Url.Value.ToLowerInvariant();
        var q = lower.IndexOfAny(['?', '#']);
        if (q >= 0)
        {
            lower = lower[..q];
        }
        return lower.EndsWith(".pdf");
    }

    private static bool IsVideoUrl(string url)
    {
        var lower = UrlPathLower(url);
        return lower is { Length: > 0 }
            && (lower.EndsWith(".mp4") || lower.EndsWith(".webm") || lower.EndsWith(".ogv")
                || lower.EndsWith(".mov") || lower.EndsWith(".m4v") || lower.EndsWith(".mkv")
                || lower.EndsWith(".avi"));
    }

    private static bool IsAudioUrl(string url)
    {
        var lower = UrlPathLower(url);
        return lower is { Length: > 0 }
            && (lower.EndsWith(".mp3") || lower.EndsWith(".ogg") || lower.EndsWith(".oga")
                || lower.EndsWith(".wav") || lower.EndsWith(".m4a") || lower.EndsWith(".aac")
                || lower.EndsWith(".flac") || lower.EndsWith(".opus") || lower.EndsWith(".wma"));
    }

    private static string UrlPathLower(string url)
    {
        var lower = url.ToLowerInvariant();
        var q = lower.IndexOfAny(['?', '#']);
        return q >= 0 ? lower[..q] : lower;
    }

    private static bool IsImagePreview(string url) => IsImageUrl(url);

    // A plain web link (a `Link` attachment pointing at a page, not a media file): no media MIME,
    // no media-file URL extension, and no image preview. These open the original URL directly in a
    // new tab (not through the media proxy, which is for media bytes); everything else in the
    // documents bucket (downloads, PDFs, files with a preview) keeps the proxied/download link.
    //
    // The type check requires `doc.Type == "Link"` (not `null or "Link"`): the ActivityStreams
    // library deserializes a `type:"Link"` attachment to the `Link` class, which `GetRichAttachments`
    // does NOT read for its type/name (those are read only off `IObject`), so a `Link` attachment and
    // a bare image both surface `Type == null`. Requiring the explicit "Link" type lets the model
    // distinguish a genuine web link (rendered as a new-tab link card) from a bare image (rendered in
    // the image gallery); a null-typed, non-media URL that is not a declared `Link` stays an image.
    private static bool IsPlainWebLink(RichAttachment doc)
    {
        if (doc.Type != "Link")
        {
            return false;
        }

        if (IsPdf(doc) || IsVideoUrl(doc.Url.Value) || IsAudioUrl(doc.Url.Value) || IsImageUrl(doc.Url.Value))
        {
            return false;
        }

        if (doc.Preview is { } p && IsImagePreview(p.Value))
        {
            return false;
        }

        var mt = doc.MediaType;
        if (!string.IsNullOrEmpty(mt))
        {
            if (mt.StartsWith("image/", StringComparison.OrdinalIgnoreCase)
                || mt.StartsWith("video/", StringComparison.OrdinalIgnoreCase)
                || mt.StartsWith("audio/", StringComparison.OrdinalIgnoreCase)
                || mt.Contains("pdf") || mt.Contains("octet-stream"))
            {
                return false;
            }
        }

        return true;
    }

    private static string Rewrite(string url)
        => ObjectView.RewriteMediaToSameOrigin(url);

    private static string? RewriteDirect(string url)
        => Uri.TryCreate(url, UriKind.Absolute, out var u)
            && (u.Scheme == Uri.UriSchemeHttp || u.Scheme == Uri.UriSchemeHttps) ? url : null;
}
