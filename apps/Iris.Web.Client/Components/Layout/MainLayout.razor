@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Iris.Web.Client.Components

<div class="page">
    <header class="main-header">
        <a class="brand" href="/">
            <svg class="brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
            <span class="brand-text">Iris</span>
        </a>
        <button class="nav-toggle" @onclick="ToggleMenu" aria-label="Menu" aria-expanded="_menuOpen">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <AuthorizeView>
            <Authorized>
                <nav class="main-nav @(_menuOpen ? "nav-open" : "")">
                    <a href="/home">Home</a>
                    <a href="/compose" class="nav-compose">New post</a>
                    <a href="/notifications">Notifications<NotificationBadge /></a>
                    <a href="/directory">Directory</a>
                    <a href="/communities">Communities</a>
                    <a href="/profile">Profile</a>
                    <a href="/settings">Settings</a>
                    <a href="/search">Search</a>
                    <a href="/logout">Log out</a>
                </nav>
            </Authorized>
            <NotAuthorized>
                <nav class="main-nav @(_menuOpen ? "nav-open" : "")">
                    <a href="/login">Log in</a>
                    <a href="/register">Register</a>
                </nav>
            </NotAuthorized>
        </AuthorizeView>
    </header>

    <main class="main-content">
        @Body
    </main>

    <footer class="main-footer">
        <div class="content">
            <span>Iris — an ActivityPub social platform.</span>
            <span class="footer-links">
                <a href="/ap/v1/nodeinfo/2.0">NodeInfo</a>
                <a href="/ap/v1/webfinger?resource=acct%3Aadmin%40iris.luit.ink">WebFinger</a>
                <a href="/ap/v1/health">Status</a>
                <a href="/admin/instance">Admin</a>
                <a href="/admin/moderation">Moderation</a>
                <a href="/admin/dashboard">Dashboard</a>
            </span>
        </div>
    </footer>
</div>

@code {
    private bool _menuOpen;

    private void ToggleMenu() => _menuOpen = !_menuOpen;
}
