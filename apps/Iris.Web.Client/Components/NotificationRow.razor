@using Iris.Core
@using Iris.Core.Identity
@using Iris.Web.Client.Ui
@using KristofferStrube.ActivityStreams
@using ActivityObject = KristofferStrube.ActivityStreams.Object

@inject UiContext Ui

<div class="notification-row">
    @if (Item is Activity activity)
    {
        var actorIri = activity.Actor?.FirstOrDefault()?.ResolveObjectIri();
        var objectFirst = activity.Object?.FirstOrDefault();
        var objectIri = objectFirst?.ResolveObjectIri();
        var targetIri = activity.Target?.FirstOrDefault()?.ResolveObjectIri();
        var targetPreview = TargetPreview(objectFirst);
        var actorDoc = actorIri is { } a ? _actorDocs.TryGetValue(a.Value, out var d) ? d : null : null;
        var displayName = actorDoc is { } ad && ad is Actor actorObj && actorObj.Name is { } names
            ? names.FirstOrDefault()
            : null;
        var iconIri = ActorIconIri(actorDoc);

        <div class="notification-body">
            <div class="notification-avatar">
                @if (iconIri is { } icon)
                {
                    <img src="@RewriteMediaToSameOrigin(icon)" alt="" loading="lazy" />
                }
                else
                {
                    <span class="notification-avatar-fallback">@AvatarInitial(actorIri, displayName)</span>
                }
            </div>
            <div class="notification-content">
                <div class="notification-head">
                    @if (actorIri is { } performer)
                    {
                        <a href="@ActorHref(performer)" title="@performer" class="notification-name">
                            @(displayName ?? HandleOf(performer))
                        </a>
                    }
                    @NotificationIcon(activity)
                    <span class="notification-verb">@VerbFor(activity)</span>
                    @if (Published is { } published)
                    {
                        <span class="notification-time" title="@published.ToString("o")">@RelativeTime(published)</span>
                    }
                </div>
                <div class="notification-target">
                    @if (objectIri is { } target)
                    {
                        <a href="@ObjectHref(target)" title="@target" class="notification-target-link">
                            @(targetPreview ?? ShortLabel(target))
                        </a>
                    }
                    else if (targetIri is { } t)
                    {
                        <a href="@ActorHref(t)" title="@t" class="object-actor">@HandleOf(t)</a>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="notification-row unknown"><span class="object-type">Unknown</span></div>
    }
</div>

@code {
    /// <summary>
    /// The inbox activity (or link) to classify. Pattern-matched into <see cref="IObject"/> per the
    /// 3rd-Party ActivityStreams rules — never a concrete type.
    /// </summary>
    [Parameter]
    public IObjectOrLink? Item { get; set; }

    /// <summary>
    /// The signed-in actor's own IRI (to recognize self-referential items such as one's own follow
    /// confirmations), or null.
    /// </summary>
    [Parameter]
    public Iri? SelfId { get; set; }

    private Activity? Activity => Item as Activity;

    /// <summary>
    /// The activity's <c>published</c> timestamp, when present.
    /// </summary>
    private DateTime? Published => Activity?.Published;

    /// <summary>
    /// Per-row cache of the actor document (keyed by actor IRI value), populated on init. The row
    /// fetches the actor's document once so it can render the avatar + display name; the
    /// <see cref="UiContext"/> already caches actor documents per-circuit (5-minute TTL), so repeated
    /// rows for the same actor do not re-fetch.
    /// </summary>
    private readonly Dictionary<string, IObject?> _actorDocs = new();

    /// <summary>
    /// Fetches the actor's document (via the <see cref="UiContext"/>'s per-circuit cache) so the row
    /// can render the avatar + display name. Runs after the <c>Item</c> parameter is set.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        if (Item is not Activity { Actor: { } actors } activity)
        {
            return;
        }

        var actorIri = actors.FirstOrDefault()?.ResolveObjectIri();
        if (actorIri is not { } iri)
        {
            return;
        }

        var doc = await Ui.GetActorAsync(iri);
        _actorDocs[iri.Value] = doc;
        StateHasChanged();
    }

    /// <summary>
    /// The actor document's first <c>icon</c> as a same-origin IRI (an <see cref="IObject"/> icon by
    /// its <c>id</c>, an <see cref="ILink"/> icon by its <c>href</c>), or null when the actor has no
    /// icon. Mirrors <c>Profile.razor</c>'s <c>GetIconIri</c>.
    /// </summary>
    private static string? ActorIconIri(IObject? actorDoc)
    {
        if (actorDoc is not { Icon: { } icons })
        {
            return null;
        }

        foreach (var icon in icons)
        {
            var iri = icon is IObject { Id: { Length: > 0 } id } ? id
                : icon is ILink { Href: { } href } ? href.ToString()
                : null;
            if (iri is { Length: > 0 })
            {
                return iri;
            }
        }

        return null;
    }

    /// <summary>
    /// Rewrites a media IRI to a same-origin path (so the browser's cookie auth applies), mirroring
    /// <c>ObjectView.RewriteMediaToSameOrigin</c>. Returns the IRI unchanged when it is not an
    /// absolute https URL.
    /// </summary>
    private static string RewriteMediaToSameOrigin(string mediaIri)
    {
        if (!Uri.TryCreate(mediaIri, UriKind.Absolute, out var uri) || uri.Scheme != "https")
        {
            return mediaIri;
        }

        return uri.AbsolutePath + uri.Query;
    }

    /// <summary>
    /// A short display initial for the avatar fallback: the first character of the display name or
    /// handle, uppercased. Mirrors <c>ObjectView.AvatarInitial</c>.
    /// </summary>
    private static string AvatarInitial(Iri? actorIri, string? displayName)
    {
        var source = !string.IsNullOrWhiteSpace(displayName) ? displayName
            : actorIri is { } a ? HandleOf(a)
            : "?";
        var first = source.Trim().FirstOrDefault(c => char.IsLetterOrDigit(c));
        return first != default ? char.ToUpperInvariant(first).ToString() : "?";
    }

    /// <summary>
    /// The human-readable verb for the activity type: a follow request, an accepted follow, a like, a
    /// boost, a reply, a mention, or a generic “posted” for other activity types (e.g. a plain
    /// <c>Create</c> of a note that was not a reply/mention). The classification is a client-side
    /// projection over the inbox read (the MVP model — see docs/plans/production-app-feature-set.md
    /// §Notifications).
    /// </summary>
    private string VerbFor(Activity activity)
    {
        var type = activity.Type?.FirstOrDefault() ?? string.Empty;
        switch (type)
        {
            case "Follow":
                // A Follow is either an accepted follow (the actor now follows you) or, for a local
                // follow you initiated, its own record. The MVP renders it as “follows you”.
                return "follows you";
            case "Accept":
                // An Accept whose object is a Follow is the confirmation of a follow request.
                return IsFollowConfirmation(activity) ? "accepted your follow request" : "accepted";
            case "Like":
                return "liked your post";
            case "Announce":
                return "boosted your post";
            case "Mention":
                return "mentioned you";
            case "Create":
                // A Create in the inbox is a reply to one of your posts (the note's inReplyTo is your
                // object) or a new note addressed to you.
                return "replied to you";
            case "Undo":
                return "undid";
            case "Flag":
                return "flagged you";
            case "Block":
                return "blocked you";
            case "Mute":
                return "muted you";
            case "Reject":
                return IsFollowConfirmation(activity) ? "declined your follow request" : "declined";
            case "Add":
                return "added you";
            case "Remove":
                return "removed you";
            default:
                // A final, capitalised, plain verb for any other activity type — avoids misspellings
                // from naïve "ed" suffixing (e.g. "Flag" → "flaged") and keeps the copy readable.
                return type.Length > 0 ? char.ToUpperInvariant(type[0]) + type[1..] : "notified";
        }
    }

    /// <summary>
    /// Whether an <c>Accept</c> is confirming a <c>Follow</c> (its <c>object</c> is a Follow activity),
    /// as opposed to a plain accept of some other object.
    /// </summary>
    private static bool IsFollowConfirmation(Activity activity)
    {
        var nested = activity.Object?.FirstOrDefault() as Activity;
        return nested?.Type?.FirstOrDefault() == "Follow";
    }

    /// <summary>
    /// A short human-readable preview of the activity's target object (the note that was liked,
    /// boosted, or replied to). Strips HTML and truncates to 120 characters. Returns null when the
    /// target is not a content object or has no text content (e.g. a Follow activity whose object is
    /// another activity, not a note).
    /// </summary>
    private static string? TargetPreview(IObjectOrLink? item)
    {
        if (item is not ActivityObject obj || obj.Content is not { } content)
        {
            return null;
        }

        var text = string.Join(" ", content);
        text = new System.Text.RegularExpressions.Regex("<[^>]+>").Replace(text, " ").Trim();
        if (string.IsNullOrEmpty(text))
        {
            return null;
        }

        return text.Length > 120 ? text[..120] + "…" : text;
    }

    /// <summary>
    /// A short label for a target IRI when no content preview is available: the last two path
    /// segments (e.g. "notes/06G7ZE…") truncated for display, so the user sees something meaningful
    /// rather than the full raw IRI.
    /// </summary>
    private static string ShortLabel(Iri iri)
    {
        var path = Uri.UnescapeDataString(new Uri(iri.Value).AbsolutePath).TrimEnd('/');
        var segments = path.Split('/');
        var label = segments.Length >= 2 ? string.Join(" ", segments[^2..]) : iri.Value;
        return label.Length > 40 ? label[..37] + "…" : label;
    }

    private static string ObjectHref(Iri iri) => $"/object?iri={Uri.EscapeDataString(iri.Value)}";

    private static string ActorHref(Iri iri) => $"/actor?iri={Uri.EscapeDataString(iri.Value)}";

    /// <summary>
    /// A short display for an actor IRI: the path's last segment (the username) when it looks like a
    /// user IRI (<c>/ap/v1/u/{user}</c>), else the full IRI. Mirrors <c>ObjectView.HandleOf</c>.
    /// </summary>
    private static string HandleOf(Iri iri)
    {
        var path = Uri.UnescapeDataString(new Uri(iri.Value).AbsolutePath).TrimEnd('/');
        var last = path.Split('/').LastOrDefault();
        return string.IsNullOrWhiteSpace(last) ? iri.Value : last;
    }

    private static string RelativeTime(DateTime utc) => TimeFormatting.Relative(utc);

    /// <summary>
    /// Renders a small inline SVG icon for the notification type, displayed before the verb.
    /// </summary>
    private MarkupString NotificationIcon(Activity activity)
    {
        var type = activity.Type?.FirstOrDefault() ?? string.Empty;
        return type switch
        {
            "Like" => SvgIcon("M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z", "var(--accent)"),
            "Announce" => SvgIcon("M17 8l4 4-4 4M3 12l4-4 4 4M7 8h10v8H7z", "var(--accent-warm)"),
            "Follow" => SvgIcon("M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM19 8v6M22 11h-6", "var(--accent)"),
            "Accept" => SvgIcon("M20 6L9 17l-5-5", "var(--success, #4caf50)"),
            "Reject" => SvgIcon("M18 6L6 18M6 6l12 12", "var(--danger, #f44336)"),
            "Create" => SvgIcon("M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z", "var(--text-muted, #888)"),
            "Undo" => SvgIcon("M1 4v6h6M3.51 15a9 9 0 1 0 2.13-9.36L1 10", "var(--text-muted, #888)"),
            _ => SvgIcon("M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 0 1-3.46 0", "var(--muted)"),
        };
    }

    private static MarkupString SvgIcon(string path, string color)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append("<svg class=\"notification-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"")
          .Append(color)
          .Append("\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">")
          .Append("<path d=\"")
          .Append(path)
          .Append("\"/>")
          .Append("</svg>");
        return new MarkupString(sb.ToString());
    }
}
