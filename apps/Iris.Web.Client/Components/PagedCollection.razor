@using Iris.Client
@using Iris.Client.Collections
@using Iris.Core.Collections
@using KristofferStrube.ActivityStreams

@if (HasAnyClient && CollectionIri is not null)
{
    <div class="card paged-collection">
        @if (!string.IsNullOrEmpty(Title))
        {
            <h2>@Title</h2>
        }
        @if (!string.IsNullOrEmpty(Description))
        {
            <p class="muted">@Description</p>
        }
        @if (HeaderContent is not null)
        {
            @HeaderContent
        }
        @if (ShowRefreshButton)
        {
            <div class="paged-collection-actions">
                <button class="button--ghost" @onclick="RefreshAsync" disabled="@Refreshing">
                    @(Refreshing ? "Refreshing…" : "Refresh")
                </button>
            </div>
        }
        @if (LoadError is not null)
        {
            <div class="error" role="alert">@LoadError</div>
        }
        @if (Items is null)
        {
            @if (LoadError is null)
            {
                <div class="card-loading">
                    <svg class="loading-spinner" viewBox="25 25 50 50" aria-hidden="true">
                        <circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" />
                    </svg>
                    <span class="muted">Loading…</span>
                </div>
            }
        }
        else
        {
            @if (RenderedItems.Count == 0 && !HasMore)
            {
                @if (EmptyContent is not null)
                {
                    <div class="empty-state">@EmptyContent</div>
                }
                else
                {
                    <div class="empty-state empty-state--compact">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                        </svg>
                        <p>@(string.IsNullOrEmpty(EmptyMessage) ? "No items." : EmptyMessage)</p>
                    </div>
                }
            }
            @if (RenderedItems.Count > 0)
            {
                <ul class="object-list">
                    @foreach (var item in RenderedItems)
                    {
                        <li>
                            @if (ItemTemplate is not null)
                            {
                                @ItemTemplate(item)
                            }
                            else
                            {
                                <ObjectView Item="item" />
                            }
                        </li>
                    }
                </ul>
            }
            @if (HasMore)
            {
                <div class="paged-collection-sentinel" @onclick="LoadMoreAsync"></div>
                @if (LoadingMore)
                {
                    <div class="card-loading card-loading-inline">
                        <svg class="loading-spinner" viewBox="25 25 50 50" aria-hidden="true">
                            <circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" />
                        </svg>
                        <span class="muted">Loading…</span>
                    </div>
                }
                else
                {
                    <button class="button button--ghost paged-collection-loadmore-fallback" @onclick="LoadMoreAsync" disabled="@LoadingMore">Load more</button>
                }
            }
        }
    </div>
}

@code {
    /// <summary>
    /// The client to dial. When <c>null</c> the component renders nothing and loads nothing (the parent
    /// gates on a signed-in session). When <c>null</c> and <see cref="AnonymousHttpClient"/> is set,
    /// the component uses plain HTTP (no ActivityPub signing) to read the collection — used for
    /// public feeds when signed out (54.27).
    /// </summary>
    [Parameter]
    public IActivityPubClient? Client { get; set; }

    /// <summary>
    /// A plain <see cref="HttpClient"/> for anonymous (unsigned) collection reads. Used when
    /// <see cref="Client"/> is null (signed out) to read public collections like the public feed
    /// (54.27). When both <see cref="Client"/> and this are null, the component renders nothing.
    /// </summary>
    [Parameter]
    public HttpClient? AnonymousHttpClient { get; set; }

    /// <summary>
    /// The IRI of the collection (or of its <c>first</c> page) to enumerate. When <c>null</c> the
    /// component renders nothing.
    /// </summary>
    [Parameter]
    public Iri? CollectionIri { get; set; }

    /// <summary>
    /// Optional card title (an <c>&lt;h3&gt;</c>).
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>
    /// Optional muted intro paragraph under the title.
    /// </summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>
    /// Optional extra markup rendered under the title/description.
    /// </summary>
    [Parameter]
    public RenderFragment? HeaderContent { get; set; }

    /// <summary>
    /// Items fetched per page (<c>CollectionQuery.Limit</c>). When <c>null</c> the server's natural page
    /// size is used.
    /// </summary>
    [Parameter]
    public int? PageSize { get; set; }

    /// <summary>
    /// When <c>true</c>, page reads bypass the client's page cache (<c>CollectionQuery.BypassCache</c> —
    /// the <c>?refresh=true</c> path).
    /// </summary>
    [Parameter]
    public bool BypassCache { get; set; }

    /// <summary>
    /// Renders a single item. Defaults to <c>&lt;ObjectView Item="…" /&gt;</c>; a page may override it to
    /// render, e.g., a follower/actor link.
    /// </summary>
    [Parameter]
    public RenderFragment<IObjectOrLink>? ItemTemplate { get; set; }

    /// <summary>
    /// The "no items" message (the empty state).
    /// </summary>
    [Parameter]
    public string? EmptyMessage { get; set; }

    /// <summary>
    /// Optional rich empty-state content (icon + message + action link). When provided, replaces
    /// the plain <see cref="EmptyMessage"/> text.
    /// </summary>
    [Parameter]
    public RenderFragment? EmptyContent { get; set; }

    /// <summary>
    /// When <c>true</c>, renders a <c>Refresh</c> button that re-fetches the collection's first page
    /// with the page cache bypassed (the <c>?refresh=true</c> path) — a one-shot bypass that does not
    /// change <see cref="BypassCache"/>. Used by the feed cards so a manual refresh re-reads the server
    /// even within the cache TTL.
    /// </summary>
    [Parameter]
    public bool ShowRefreshButton { get; set; } = true;

    /// <summary>
    /// Optional filter applied to fetched items before rendering. Items that do not pass the predicate
    /// are excluded from the rendered list (but still consumed from the page, so pagination is unaffected).
    /// When <c>null</c>, all items are rendered (default behavior).
    /// </summary>
    [Parameter]
    public Func<IObjectOrLink, bool>? ItemFilter { get; set; }

    private List<IObjectOrLink>? Items { get; set; }
    private bool HasMore { get; set; }
    private bool LoadingMore { get; set; }
    private bool Refreshing { get; set; }
    private string? LoadError { get; set; }

    /// <summary>
    /// The items after applying <see cref="ItemFilter"/> (when set). When no filter is set, this is
    /// the raw <see cref="Items"/> list.
    /// </summary>
    private List<IObjectOrLink> RenderedItems
        => ItemFilter is { } filter && Items is { } items
            ? items.Where(filter).ToList()
            : Items ?? [];

    /// <summary>
    /// When <c>true</c>, the next fetch bypasses the page cache (the one-shot <c>?refresh=true</c> from
    /// <see cref="RefreshAsync"/>). Reset after the first page of the refresh.
    /// </summary>
    private bool _bypassNext;

    /// <summary>
    /// The enumeration position: the page IRI to resume from (<c>null</c> = start at the collection's
    /// first page).
    /// </summary>
    private Iri? _resumeFrom;

    /// <summary>
    /// The <see cref="CollectionIri"/> value this card last loaded for, so a new collection (a new
    /// actor/community) triggers a fresh first-page load.
    /// </summary>
    private Iri? _loadedFor;

    /// <summary>
    /// Resolves the "iris" <c>HttpClient</c> (base address = the home instance) for the S2/S14
    /// anonymous proxy seam: a signed-out visitor's browser cannot reach a cross-origin remote
    /// instance directly (a direct <c>GET</c> is CORS-/CSP-blocked — the signed-out remote
    /// actor-detail's "Posts" tab was broken by exactly this), so a remote collection read goes
    /// through the SAME-ORIGIN proxy (<c>GET /ap/v1/proxy/{target}</c>) instead. A LOCAL collection
    /// (same origin as the home instance) dials directly.
    /// </summary>
    [Inject]
    private IHttpClientFactory HttpClientFactory { get; set; } = default!;

    /// <summary>
    /// The home instance's origin (the "iris" client's <c>BaseAddress</c>), cached for
    /// <see cref="IsRemoteCollectionIri"/>. Null when the base address is unavailable (the IRI is then
    /// treated as remote — the safe default: route through the proxy).
    /// </summary>
    private Uri? _homeOrigin;

    private bool HasAnyClient => Client is not null || AnonymousHttpClient is not null;

    protected override void OnParametersSet()
    {
        if (!HasAnyClient)
        {
            // No client available (signed out with no anonymous client, or the session's signing
            // key is still loading). Reset the loaded-for tracker so that when a client becomes
            // available on the next render, the initial load fires.
            _loadedFor = null;
            return;
        }

        if (CollectionIri is { } iri && !iri.Equals(_loadedFor))
        {
            _loadedFor = iri;
            _ = LoadInitialAsync();
        }
    }

    private async Task LoadInitialAsync()
    {
        // Items stays null for the duration of the first fetch so the "Loading…" spinner renders
        // (Items is null) rather than the empty "No items" state: the empty message is only correct
        // once a page has actually been read. EnumerateOnePageAsync initializes Items on first page
        // arrival (Items ??= []); when the fetch yields no page (an empty collection), Items stays null
        // and would spin forever — so initialize it here to the empty state in that case.
        Items = null;
        HasMore = false;
        LoadError = null;
        _resumeFrom = null;
        try
        {
            await EnumerateOnePageAsync();
            // A filtered view (an ItemFilter is set) may see a first page that is entirely
            // non-matching — e.g. an actor's outbox is a mixed collection (the user's own posts
            // interleaved with mirrored remote content), newest-first, so page 1 can hold only
            // foreign items and the user's own content sits many pages deep. Without this, the
            // filtered tab renders its "no items" state even though matching items exist further
            // back, and the user must click "Load more" repeatedly to reach them (93.2/93.3). When
            // a filter is active and the rendered count is below the page size, keep pulling pages
            // (capped) until enough matching items have been collected or the collection is
            // exhausted, so the first screenful is actually relevant.
            await TopUpFilteredPagesAsync();
        }
        catch (System.Threading.Tasks.TaskCanceledException)
        {
            // A bounded-timeout (137.3) or connection-level failure: the community's host is
            // unreachable (a stale IRI whose reverse proxy no longer routes it, or a network
            // partition). Distinguish from a transient failure so the user knows the community
            // is not reachable rather than that something transient went wrong.
            LoadError = "This community could not be reached. Its host may be unreachable or the community may have been removed.";
        }
        catch (Exception)
        {
            LoadError = "Failed to load. Please try again.";
        }

        if (Items is null && LoadError is null)
        {
            Items = [];
        }

        // This load was fired fire-and-forget from OnParametersSet (not an @onclick handler, not
        // awaited), so Blazor never re-renders after Items is populated — the "Loading…" spinner
        // (Items == null) stays on screen until the user clicks Refresh (an @onclick handler, which
        // Blazor auto-re-renders). Mirror that auto-re-render here so the initial navigate renders the
        // loaded items without a manual Refresh. StateHasChanged throws InvalidOperationException if
        // the component was disposed between the await and this call (e.g. the user navigated away
        // mid-fetch) — that would be an unobserved exception on this fire-and-forget task, which
        // trips the global Blazor error UI, so it must be swallowed.
        try
        {
            StateHasChanged();
        }
        catch (InvalidOperationException)
        {
            // Component disposed mid-fetch; nothing to render.
        }
    }

    /// <summary>
    /// The cap on how many *extra* pages <see cref="TopUpFilteredPagesAsync"/> will pull beyond the
    /// first page during the initial load. Bounds the worst-case round-trips when a filter matches
    /// few items (a very active user's outbox can be deep) while still reaching the user's own
    /// content in the common case. S17: reduced from 12 to 3 — the old cap caused a 13-page fan-out
    /// on every profile tab switch (3 tabs × 13 pages = 39 outbox requests for a single visit).
    /// 3 extra pages (4 total) is enough to find matching items in the common case while bounding
    /// the worst-case to 4 requests per tab load.
    /// </summary>
    private const int FilteredTopUpMaxPages = 3;

    /// <summary>
    /// For a filtered view, keeps pulling additional pages (up to <see cref="FilteredTopUpMaxPages"/>)
    /// after the initial first page until the rendered (post-filter) count reaches the page size or the
    /// collection is exhausted. No-op when no <see cref="ItemFilter"/> is set (an unfiltered view is
    /// already "relevant" on page 1) or when the rendered count already fills the page size.
    /// </summary>
    private async Task TopUpFilteredPagesAsync()
    {
        if (ItemFilter is null)
        {
            return;
        }

        var target = PageSize ?? 10;
        var pulled = 0;
        while (RenderedItems.Count < target
            && HasMore
            && pulled < FilteredTopUpMaxPages)
        {
            await EnumerateOnePageAsync();
            pulled++;
        }
    }

    private async Task LoadMoreAsync()
    {
        if (LoadingMore || !HasMore)
        {
            return;
        }

        LoadingMore = true;
        LoadError = null;
        try
        {
            await EnumerateOnePageAsync();
            // A filtered view: keep pulling (capped) so the "Load more" click surfaces a full
            // screenful of matching items rather than a single (possibly all-foreign) page.
            await TopUpFilteredPagesAsync();
        }
        catch (System.Threading.Tasks.TaskCanceledException)
        {
            LoadError = "This community could not be reached. Its host may be unreachable or the community may have been removed.";
        }
        catch (Exception)
        {
            LoadError = "Failed to load more items. Please try again.";
        }
        finally
        {
            LoadingMore = false;
        }
    }

    /// <summary>
    /// Re-fetches the collection's first page with the page cache bypassed (the <c>?refresh=true</c>
    /// path), replacing the current items — a manual refresh that re-reads the server even within the
    /// cache TTL. An <c>@onclick</c> handler: Blazor auto-re-renders after it completes.
    /// </summary>
    private async Task RefreshAsync()
    {
        if (Refreshing)
        {
            return;
        }

        Refreshing = true;
        _bypassNext = true;
        LoadError = null;
        try
        {
            Items = [];
            HasMore = false;
            _resumeFrom = null;
            await EnumerateOnePageAsync();
        }
        catch (System.Threading.Tasks.TaskCanceledException)
        {
            LoadError = "This community could not be reached. Its host may be unreachable or the community may have been removed.";
        }
        catch (Exception)
        {
            LoadError = "Failed to refresh. Please try again.";
        }
        finally
        {
            Refreshing = false;
            _bypassNext = false;
        }
    }

    /// <summary>
    /// Fetches one page (resuming from <see cref="_resumeFrom"/> when set, else from the collection's
    /// first page) and appends its items — one server page per "Load more" click.
    /// </summary>
    private async Task EnumerateOnePageAsync()
    {
        if (_resumeFrom is not { } resumeIri)
        {
            if (CollectionIri is not { } firstIri)
            {
                return;
            }

            resumeIri = firstIri;
        }

        if (Client is { } client)
        {
            var query = new CollectionQuery(Limit: PageSize, BypassCache: BypassCache || _bypassNext);

            await foreach (var page in client.GetCollectionAsync(resumeIri, query, CancellationToken.None))
            {
                Items ??= [];
                Items.AddRange(page.Items);
                HasMore = !page.IsLastPage;
                _resumeFrom = page.NextPage;
                break;
            }
            return;
        }

        // Anonymous read (signed out, public collection like the public feed — 54.27). A REMOTE
        // (cross-origin) collection is read through the SAME-ORIGIN anonymous proxy seam (GET
        // /ap/v1/proxy/{target}, S2/S14) — a direct cross-origin GET is CORS-/CSP-blocked in the
        // browser (the signed-out remote actor-detail's "Posts" tab was broken by exactly this). A
        // LOCAL (same-origin) collection dials directly.
        if (AnonymousHttpClient is { } anonClient)
        {
            await FetchAnonymousPageAsync(anonClient, resumeIri);
        }
    }

    /// <summary>
    /// True when <paramref name="iri"/> is a remote (cross-origin) collection — its host differs from
    /// the home instance's origin (the "iris" <c>HttpClient</c>'s <c>BaseAddress</c>). A local
    /// collection (same origin) is not remote. When the home origin cannot be determined, the IRI is
    /// treated as remote (route through the proxy — the safe default).
    /// </summary>
    private bool IsRemoteCollectionIri(Iri iri)
    {
        if (!Uri.TryCreate(iri.Value, UriKind.Absolute, out var uri)
            || uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps)
        {
            return false;
        }

        _homeOrigin ??= HttpClientFactory?.CreateClient("iris").BaseAddress;
        if (_homeOrigin is null)
        {
            return true;
        }

        return !string.Equals(uri.Host, _homeOrigin.Host, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Fetches a single collection page anonymously (no ActivityPub signing) and parses it. Used
    /// for public reads when signed out (54.27). The page IRI is routed through the SAME-ORIGIN
    /// anonymous proxy seam (<c>GET /ap/v1/proxy/{target}</c>, S2/S14) when it is REMOTE
    /// (cross-origin — a direct <c>GET</c> is CORS-/CSP-blocked in the browser), or fetched
    /// directly when it is LOCAL (same-origin).
    /// </summary>
    private async Task FetchAnonymousPageAsync(HttpClient http, Iri pageIri)
    {
        var json = await FetchPageJsonAsync(http, pageIri);
        if (json is not null)
        {
            ApplyPageJson(json);
        }
    }

    /// <summary>
    /// Fetches the page at <paramref name="pageIri"/> as raw JSON through the same-origin seam the
    /// anonymous read uses: REMOTE (cross-origin) pages ride the anonymous proxy seam
    /// (<c>GET /ap/v1/proxy/{target}</c>, S2/S14 — a direct cross-origin GET is CORS-/CSP-blocked in
    /// the browser), LOCAL (same-origin) pages are fetched directly. The <see cref="PageSize"/>
    /// query rides the request's own query string either way (the proxy's catch-all <c>{**target}</c>
    /// route value captures only the path). Returns <see langword="null"/> (and sets
    /// <see cref="LoadError"/>) on a failed fetch.
    /// </summary>
    private async Task<string?> FetchPageJsonAsync(HttpClient http, Iri pageIri)
    {
        var target = pageIri.Value;
        if (PageSize is { } size)
        {
            target += (target.Contains('?') ? '&' : '?') + $"limit={size}";
        }

        var url = IsRemoteCollectionIri(pageIri)
            ? $"/ap/v1/proxy/{Uri.EscapeDataString(target)}"
            : target;

        using var response = await http.GetAsync(url);
        if (!response.IsSuccessStatusCode)
        {
            LoadError = "Failed to load. Please try again.";
            return null;
        }

        return await response.Content.ReadAsStringAsync();
    }

    /// <summary>
    /// Fetches a page document's raw JSON for the initial-load <c>first</c>-link follow-up (S56):
    /// the collection's own IRI was fetched and came back as an envelope, so the first-page IRI is
    /// refetched through the same-origin seam. Routes through the proxy for a remote collection —
    /// the first page of a remote collection is cross-origin (CORS-/CSP-blocked in the browser).
    /// </summary>
    private async Task<string?> FetchPageJsonAsync(Iri fetchedIri, Iri pageIri)
    {
        if (AnonymousHttpClient is not { } http)
        {
            return null;
        }

        var remote = IsRemoteCollectionIri(fetchedIri) || IsRemoteCollectionIri(pageIri);
        var target = pageIri.Value;
        if (PageSize is { } size)
        {
            target += (target.Contains('?') ? '&' : '?') + $"limit={size}";
        }

        var url = remote
            ? $"/ap/v1/proxy/{Uri.EscapeDataString(target)}"
            : target;

        using var response = await http.GetAsync(url);
        if (!response.IsSuccessStatusCode)
        {
            LoadError = "Failed to load. Please try again.";
            return null;
        }

        return await response.Content.ReadAsStringAsync();
    }

    /// <summary>
    /// Parses a fetched collection page (OrderedCollection / OrderedCollectionPage JSON) and appends
    /// its items, next-page link, and last-page flag. Shared by the local (direct) and the
    /// SAME-ORIGIN anonymous proxy (S2/S14) anonymous read paths.
    /// </summary>
    private void ApplyPageJson(string json)
    {
        var doc = System.Text.Json.JsonDocument.Parse(json);
        var root = doc.RootElement;

        // A collection ENVELOPE (an OrderedCollection carrying a `first` link and no items of its
        // own — the canonical Mastodon shape) is not a page: the signed-in path (the client's
        // GetCollectionAsync) follows the `first` link to reach the first page (the collection
        // document served at {collection}?page=true), while this anonymous path previously parsed
        // the envelope as an empty page and rendered the empty state — the signed-out remote
        // actor's "Posts" tab showed "No posts yet." though the actor's posts appeared in the
        // public timeline (S56). Mirror the signed-in rule via the shared
        // CollectionPageFactory.ResolveFirstPageIri: when the fetched document resolves to a
        // different first-page IRI, refetch that page and parse it instead.
        if (_resumeFrom is { } resumeIri &&
            CollectionPageFactory.ResolveFirstPageIri(
                ActivityJson.Deserialize<IObjectOrLink>(json) is IObject obj ? obj : null,
                resumeIri) is { } firstIri &&
            !firstIri.Equals(resumeIri))
        {
            // Bounded to one hop: the first-page document is a real page, so the recursive call
            // parses it directly.
            var pageJson = FetchPageJsonAsync(resumeIri, firstIri).GetAwaiter().GetResult();
            if (pageJson is not null)
            {
                ApplyPageJson(pageJson);
            }
            return;
        }

        Items ??= [];

        // Extract items from the page.
        System.Text.Json.JsonElement? itemsElement = null;
        if (root.TryGetProperty("orderedItems", out var oi) && oi.ValueKind == System.Text.Json.JsonValueKind.Array)
        {
            itemsElement = oi;
        }
        else if (root.TryGetProperty("items", out var it) && it.ValueKind == System.Text.Json.JsonValueKind.Array)
        {
            itemsElement = it;
        }
        if (itemsElement is { } items)
        {
            foreach (var itemElement in items.EnumerateArray())
            {
                var itemJson = itemElement.GetRawText();
                try
                {
                    var item = ActivityJson.Deserialize<IObjectOrLink>(itemJson);
                    if (item is not null)
                    {
                        Items.Add(item);
                    }
                }
                catch
                {
                    // Skip items that fail to deserialize.
                }
            }
        }

        // Determine if there is a next page.
        var hasMore = false;
        var nextPageIri = (Iri?)null;

        if (root.TryGetProperty("next", out var nextElement))
        {
            var nextValue = nextElement.ValueKind == System.Text.Json.JsonValueKind.String
                ? nextElement.GetString()
                : nextElement.TryGetProperty("id", out var nextId) ? nextId.GetString() : null;

            if (nextValue is not null && nextValue.Length > 0)
            {
                hasMore = true;
                if (Iri.TryParse(nextValue, out var nextIri))
                {
                    nextPageIri = nextIri;
                }
            }
        }
        else if (root.TryGetProperty("partOf", out var partOfElement))
        {
            // No "next" means this is the last page.
            hasMore = false;
        }

        HasMore = hasMore;
        _resumeFrom = nextPageIri;
    }
}
