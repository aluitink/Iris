@using Iris.Client
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<div class="card edit-profile-form">
    <h2>Edit profile</h2>

    @if (SaveError is not null)
    {
        <div class="error" role="alert">@SaveError</div>
    }

    <form @onsubmit="HandleSubmitAsync">
        <div class="form-group edit-profile-avatar-group">
            <span class="form-label">Avatar</span>
            <div class="edit-profile-avatar-preview">
                @if (_iconPreviewIri is { Length: > 0 } previewIri)
                {
                    <img src="@previewIri" alt="avatar preview" class="object-avatar edit-profile-avatar-img" loading="lazy" />
                }
                else
                {
                    <span class="actor-profile-avatar-fallback edit-profile-avatar-fallback" aria-hidden="true">
                        @(_name.Length > 0 ? _name[0].ToString() : "?")
                    </span>
                }
            </div>
            <div class="edit-profile-avatar-actions">
                <label for="edit-icon" class="btn" @(IconBusy || Saving ? "disabled" : "")>
                    @(IconBusy ? "Uploading…" : (_iconIri is null ? "Choose avatar" : "Change avatar"))
                    <InputFile id="edit-icon" OnChange="OnIconChosen" OnFileRemoved="OnIconRemoved"
                               Accept="image/*" hidden />
                </label>
                @if (_iconIri is not null)
                {
                    <button type="button" class="btn" @onclick="ResetIcon" disabled="@(IconBusy || Saving)">
                        Remove avatar
                    </button>
                }
            </div>
            @if (_iconUploadError is not null)
            {
                <div class="error" role="alert">@_iconUploadError</div>
            }
        </div>

        <div class="form-group">
            <label for="edit-name">Display name</label>
            <input id="edit-name" type="text" @bind="_name" maxlength="100"
                   placeholder="Your name" />
        </div>

        <div class="form-group">
            <label for="edit-summary">Bio</label>
            <textarea id="edit-summary" @bind="_summary" rows="3" maxlength="500"
                      placeholder="Tell the world about yourself…"></textarea>
        </div>

        <div class="form-group form-group--checkbox">
            <label for="edit-approve-followers">
                <input id="edit-approve-followers" type="checkbox" @bind="_approveFollowers" />
                Require approval for follow requests
            </label>
            <p class="muted">When enabled, new followers must be explicitly approved.</p>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary" disabled="@Saving">
                @if (Saving) { <span>Saving…</span> } else { <span>Save</span> }
            </button>
            <button type="button" class="btn" @onclick="OnCancel" disabled="@Saving">Cancel</button>
        </div>
    </form>
</div>

@code {
    /// <summary>
    /// The actor's current avatar IRI (the first <c>icon</c>), or null when the actor has no icon.
    /// Shown as the initial preview and submitted back unchanged when the user does not pick a new one.
    /// </summary>
    [Parameter]
    public string? InitialIconIri { get; set; }

    /// <summary>
    /// The actor's current display name (first character) for the avatar fallback glyph when there is no
    /// icon.
    /// </summary>
    [Parameter]
    public string InitialName { get; set; } = string.Empty;

    [Parameter]
    public string InitialSummary { get; set; } = string.Empty;

    [Parameter]
    public bool InitialApproveFollowers { get; set; }

    [Parameter]
    public bool Saving { get; set; }

    [Parameter]
    public string? SaveError { get; set; }

    [Parameter]
    public EventCallback<string> OnNameChange { get; set; }

    [Parameter]
    public EventCallback<string> OnSummaryChange { get; set; }

    /// <summary>
    /// Uploads a chosen avatar file and returns the upload result (the same-origin media IRI to set as the
    /// actor's <c>icon</c>). Invoked when the user picks a file; the resulting IRI is shown as the preview
    /// and submitted with the profile. Returns null when the upload fails (the form shows an error).
    /// </summary>
    [Parameter]
    public Func<IBrowserFile, Task<MediaUploadResult?>> OnIconUpload { get; set; } = default!;

    /// <summary>
    /// Submits the form. The <c>iconIri</c> is the IRI to set as the actor's <c>icon</c> (the uploaded
    /// avatar, or the existing one when unchanged), or null when the user removed the avatar.
    /// </summary>
    [Parameter]
    public Func<string, string, bool, string?, Task> OnSubmit { get; set; } = default!;

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string _name = string.Empty;
    private string _summary = string.Empty;
    private bool _approveFollowers;
    private string? _iconIri;
    private string? _iconPreviewIri;
    private string? _iconUploadError;
    private bool _iconUploading;

    /// <summary>True while an avatar upload is in flight (disables the Save/Cancel buttons + the file input).</summary>
    private bool IconBusy => _iconUploading || Saving;

    protected override void OnParametersSet()
    {
        _name = InitialName;
        _summary = InitialSummary;
        _approveFollowers = InitialApproveFollowers;
        if (_iconIri is null)
        {
            _iconIri = InitialIconIri;
        }

        if (_iconPreviewIri is null)
        {
            _iconPreviewIri = InitialIconIri;
        }
    }

    /// <summary>
    /// Uploads the chosen avatar file (via the <see cref="OnIconUpload"/> callback) and, on success, sets
    /// the returned media IRI as the icon-to-submit + the preview. On failure, shows an error and leaves
    /// the existing icon unchanged.
    /// </summary>
    private async Task OnIconChosen(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            return;
        }

        _iconUploadError = null;
        _iconUploading = true;
        StateHasChanged();

        try
        {
            var result = await OnIconUpload(file);
            if (result is not null)
            {
                _iconIri = result.MediaIri.Value;
                _iconPreviewIri = result.MediaIri.Value;
            }
            else
            {
                _iconUploadError = "The avatar could not be uploaded. Please try again.";
            }
        }
        catch
        {
            _iconUploadError = "The avatar could not be uploaded. Please try again.";
        }
        finally
        {
            _iconUploading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Clears the chosen file (the browser's built-in "remove" affordance) — resets the icon to the
    /// existing one (or none) so the next submission keeps the current avatar.
    /// </summary>
    private void OnIconRemoved(InputFileChangeEventArgs e)
    {
        _iconIri = InitialIconIri;
        _iconPreviewIri = InitialIconIri;
        _iconUploadError = null;
        StateHasChanged();
    }

    /// <summary>
    /// Removes the avatar (the "Remove avatar" button) — sets the icon-to-submit to null so the next
    /// submission clears the actor's icon.
    /// </summary>
    private void ResetIcon()
    {
        _iconIri = null;
        _iconPreviewIri = null;
        _iconUploadError = null;
        StateHasChanged();
    }

    private async Task HandleSubmitAsync()
    {
        await OnSubmit(_name, _summary, _approveFollowers, _iconIri);
    }
}
