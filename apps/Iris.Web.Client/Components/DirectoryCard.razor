@using Iris.Core.Identity
@using Iris.Web.Client.Components
@using KristofferStrube.ActivityStreams
@using ActivityObject = KristofferStrube.ActivityStreams.Object

<div class="directory-card">
    <button type="button" class="directory-card-header" aria-expanded="@(IsExpanded)" aria-label="@(IsExpanded ? "Hide" : "Show") posts by @Actor.Name" @onclick="ToggleAsync">
        <ActorCard Actor="Actor" ActorId="@Actor.Id">
            <span class="directory-card-expand" aria-hidden="true">
                @(IsExpanded ? "−" : "+")
            </span>
            <FollowButton TargetActor="Actor" />
        </ActorCard>
    </button>
    @if (IsExpanded && Posts is not null)
    {
        <div class="directory-card-posts">
            @if (Posts.Count == 0)
            {
                <p class="muted" style="font-size: 0.85rem;">No recent posts.</p>
            }
            else
            {
                @foreach (var post in Posts)
                {
                    <div class="directory-card-post">
                        <ObjectView Item="post" />
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public Actor Actor { get; set; } = default!;

    [Parameter]
    public Func<Actor, Task> OnExpandPosts { get; set; } = default!;

    [Parameter]
    public Dictionary<string, List<IObjectOrLink>>? ExpandedPosts { get; set; }

    [Parameter]
    public HashSet<string>? ExpandedLoading { get; set; }

    private bool IsExpanded => ExpandedPosts is { } map && map.ContainsKey(Actor.Id ?? string.Empty);
    private List<IObjectOrLink>? Posts => ExpandedPosts is { } map && map.TryGetValue(Actor.Id ?? string.Empty, out var p) ? p : null;
    private bool IsLoading => ExpandedLoading is { } set && set.Contains(Actor.Id ?? string.Empty);

    private async Task ToggleAsync()
    {
        if (IsLoading || IsExpanded)
        {
            return;
        }

        if (OnExpandPosts is { } expand)
        {
            await expand(Actor);
        }
    }
}
