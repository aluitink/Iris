@page "/home"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Iris.Client
@using Iris.Core
@using Iris.Core.Identity
@using Iris.Web.Client.Accounts
@using Iris.Web.Client.Components
@using KristofferStrube.ActivityStreams
@implements IDisposable

<PageTitle>Home · Iris</PageTitle>

@if (_state.Tab == "messages")
{
    <MessagesPanel FilterBar="true" />
}
else
{
    <PagedCollection
        @key="@FeedKey"
        Client="@FeedClient"
        CollectionIri="@FeedIri"
        PageSize="20"
        ShowRefreshButton="true"
        ItemFilter="IsContentItem">
        <EmptyContent>
            @if (_state.Tab == "communities")
            {
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                    <p>No community posts yet.</p>
                    <p>Follow communities to see their posts here.</p>
                    <a href="/communities">My communities →</a>
                </div>
            }
            else if (_state.Tab == "local")
            {
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M2 12h20" />
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                    </svg>
                    <p>No local posts yet.</p>
                    <p>Be the first to share something!</p>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                    </svg>
                    <p>Your timeline is empty.</p>
                    <p>Follow people to see their posts here.</p>
                    <a href="/directory">Browse the directory →</a>
                </div>
            }
        </EmptyContent>
    </PagedCollection>
}

@code {
    [Inject]
    private IActorSessionAccessor Session { get; set; } = default!;

    [Inject]
    private HomeTabState _state { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureReadyAsync();
        _state.TabChangedExternal += OnTabChanged;
        StateHasChanged();
    }

    private void OnTabChanged() => InvokeAsync(StateHasChanged);

    private string FeedKey => $"home-feed-{_state.Tab}";

    private IActivityPubClient? FeedClient => Session.Client;

    private Iri? FeedIri
    {
        get
        {
            if (_state.Tab == "local")
            {
                return Session.PublicFeedIri;
            }

            if (Session.ActorId is not { } actor)
            {
                return null;
            }

            var baseIri = actor.FeedOf();
            var source = _state.Tab == "communities" ? "communities" : "people";
            return new Iri($"{baseIri.Value}?source={source}");
        }
    }

    private static bool IsContentItem(IObjectOrLink item)
        => ContentItems.IsContentPost(item);

    public void Dispose()
    {
        _state.TabChangedExternal -= OnTabChanged;
    }
}
