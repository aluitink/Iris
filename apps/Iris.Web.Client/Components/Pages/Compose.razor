@page "/compose"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Iris.Client
@using Iris.Core.Compose
@using Iris.Core.Identity
@using Iris.Web.Client.Accounts
@using Microsoft.AspNetCore.Components.Web
@using KristofferStrube.ActivityStreams

<PageTitle>@PageTitle · Iris</PageTitle>

<h1>@PageTitle</h1>

<p class="muted">
    Posting as <a href="/profile">@ActorHandle</a>
</p>

    <div class="card compose-card">
    @if (ReplyToIri is not null)
    {
        <div class="compose-reply-context">
            <p class="compose-reply-to">
                Replying to <a href="@ReplyToHref">@ReplyToAuthor</a>
            </p>
            @if (ReplyToPreview is { Length: > 0 })
            {
                <blockquote class="compose-reply-preview">@ReplyToPreview</blockquote>
            }
            @if (ThreadRootAuthor is { Length: > 0 })
            {
                <div class="compose-thread-root">
                    <span class="compose-thread-root-label">Thread started by</span>
                    <span class="compose-thread-root-author">@ThreadRootAuthor</span>
                    @if (ThreadRootPreview is { Length: > 0 })
                    {
                        <blockquote class="compose-reply-preview">@ThreadRootPreview</blockquote>
                    }
                </div>
            }
        </div>
    }
    @if (CommunityIri is { } cIri)
    {
        <div class="compose-community-context">
            <p class="compose-community-to">
                Posting to <a href="@($"/community?iri={Uri.EscapeDataString(cIri.Value)}")">@CommunityName ?? "community"</a>
            </p>
        </div>
    }
    <label for="compose-content">Content</label>
    <div class="compose-autocomplete-wrap">
        <textarea id="compose-content" class="compose-content" rows="4" @bind="Content"
                  @onkeyup="OnContentInput"
                  placeholder="What's on your mind?"></textarea>
        @if (Autocomplete is { Visible: true } ac)
        {
            <div class="compose-autocomplete" role="listbox" aria-label="Suggestions">
                @foreach (var candidate in ac.Candidates)
                {
                    <button type="button" class="compose-autocomplete-item" role="option"
                            @onclick="() => AcceptAutocomplete(candidate)">
                        @if (ac.Mode == AutocompleteMode.Mention && candidate.Handle is { Length: > 0 } h)
                        {
                            <span class="compose-autocomplete-handle">@h</span>
                            @if (candidate.Name is { Length: > 0 } name && name != h)
                            {
                                <span class="compose-autocomplete-name">@name</span>
                            }
                        }
                        else
                        {
                            <span class="compose-autocomplete-hashtag">@candidate.InsertText</span>
                        }
                    </button>
                }
            </div>
        }
    </div>
    @if (ReplyToIri is null)
    {
        <label for="compose-attachment" class="compose-attach-label">Attachment (optional — image)</label>
        <div class="compose-attach">
            <InputFile id="compose-attachment" OnChange="OnAttachmentChosen" OnFileRemoved="OnAttachmentRemoved"
                       accept="image/*" disabled="@Busy" />
            @if (Attachment is not null)
            {
                <span class="compose-attach-name">@Attachment.Name</span>
                <button type="button" class="compose-attach-remove" aria-label="Remove attachment" @onclick="ClearAttachment" disabled="@Busy">✕</button>
            }
        </div>
    }
    <div class="compose-meta">
        <span class="compose-char-count @(Content.Length > MaxChars ? "compose-char-count--over" : "")">
            @Content.Length/@MaxChars
        </span>
        @if (ReplyToIri is null)
        {
            <select class="compose-type-select" @bind="ContentType" disabled="@Busy">
                <option value="Note">Note</option>
                <option value="Article">Article (long-form)</option>
            </select>
        }
        @if (ReplyToIri is null && CommunityIri is null)
        {
            <label class="compose-sensitive-toggle">
                <input type="checkbox" @bind="IsSensitive" disabled="@Busy" />
                Content warning
            </label>
            @if (IsSensitive)
            {
                <input class="compose-sensitive-summary" type="text" @bind="SensitiveSummary"
                       placeholder="Warning summary (shown before revealing)" maxlength="200" disabled="@Busy" />
            }
        }
    </div>
    <p class="muted compose-hint">
        @(ReplyToIri is not null
            ? "This reply is threaded under the parent note and visible in its replies."
            : CommunityIri is not null
                ? "This post is attributed to the community and visible to its members."
                : "A note addressed to the public — it lands in your outbox and appears in your followers' timelines.")
    </p>

    <div class="compose-actions">
        <button @onclick="PostAsync" disabled="@Busy">
            @(Busy ? "Posting…" : (ReplyToIri is not null ? "Post reply" : CommunityIri is not null ? "Post to community" : "Post"))
        </button>
        @if (Posted)
        {
            @if (CommunityIri is { } postCommunity)
            {
                <a class="button button--secondary" href="@($"/community?iri={Uri.EscapeDataString(postCommunity.Value)}")">View community feed →</a>
            }
            else
            {
                <a class="button button--secondary" href="/profile">View your posts →</a>
            }
        }
    </div>

    @if (Result is not null)
    {
        <p class="muted compose-result" role="status">
            @Result
            @if (PostedIri is not null)
            {
                <code class="compose-result-iri">@PostedIri</code>
            }
        </p>
    }
    @if (Error is not null)
    {
        <div class="error" role="alert">@Error</div>
    }
</div>

<div class="compose-tips card">
    <h2>Formatting tips</h2>
    <ul class="compose-tips-list">
        <li>Use <strong>@@handle</strong> to mention someone (e.g. @@alice).</li>
        <li>Use <strong>#hashtag</strong> to tag a topic.</li>
        <li>Notes are short-form; Articles are for long-form content.</li>
        <li>Content warning hides your post behind a "Show" button.</li>
    </ul>
</div>

@code {
    [Inject]
    private IActorSessionAccessor Session { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "replyTo")]
    private string? ReplyToParam { get; set; }

    [SupplyParameterFromQuery(Name = "community")]
    private string? CommunityParam { get; set; }

    /// <summary>
    /// The community IRI the post targets (from the <c>community</c> query parameter), when set.
    /// When present, the post is attributed to both the author and the community, and addressed
    /// to the community's followers collection + the public.
    /// </summary>
    private Iri? CommunityIri
    {
        get
        {
            if (string.IsNullOrEmpty(CommunityParam) || !Iri.TryParse(CommunityParam, out var parsed))
            {
                return null;
            }

            return parsed;
        }
    }

    /// <summary>
    /// The community's display name (fetched asynchronously), shown in the compose header when
    /// posting to a community.
    /// </summary>
    private string? CommunityName { get; set; }

    private Iri? ReplyToIri
    {
        get
        {
            if (string.IsNullOrEmpty(ReplyToParam) || !Iri.TryParse(ReplyToParam, out var parsed))
            {
                return null;
            }

            return parsed;
        }
    }

    /// <summary>
    /// The author handle of the parent note (fetched asynchronously), or "…" while loading.
    /// </summary>
    private string ReplyToAuthor { get; set; } = "…";

    /// <summary>
    /// A truncated preview of the parent note's content (for context while composing a reply).
    /// </summary>
    private string? ReplyToPreview { get; set; }

    /// <summary>
    /// The author handle of the thread root (the parent's parent), when the parent is itself a reply.
    /// </summary>
    private string? ThreadRootAuthor { get; set; }

    /// <summary>
    /// A truncated preview of the thread root's content, when the parent is itself a reply.
    /// </summary>
    private string? ThreadRootPreview { get; set; }

    private string? _fetchedIri;

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureReadyAsync();
        if (ReplyToIri is { } iri && _fetchedIri != iri.Value)
        {
            await LoadReplyContextAsync(iri);
        }

        if (CommunityIri is { } cIri && CommunityName is null)
        {
            await LoadCommunityNameAsync(cIri);
        }
    }

    private async Task LoadCommunityNameAsync(Iri communityIri)
    {
        try
        {
            if (Session.Client is not { } client)
            {
                return;
            }

            var obj = await client.GetObjectAsync(communityIri);
            if (obj is Group group)
            {
                CommunityName = group.Name?.FirstOrDefault() ?? group.PreferredUsername;
            }
            else if (obj is Actor actor)
            {
                CommunityName = actor.Name?.FirstOrDefault() ?? actor.PreferredUsername;
            }
        }
        catch
        {
            // Non-fatal: no community name shown.
        }
    }

    private async Task LoadReplyContextAsync(Iri iri)
    {
        _fetchedIri = iri.Value;
        ReplyToAuthor = "…";
        ReplyToPreview = null;
        ThreadRootAuthor = null;
        ThreadRootPreview = null;

        try
        {
            if (Session.Client is not { } client)
            {
                return;
            }

            var note = await client.GetObjectAsync(iri);
            if (note is KristofferStrube.ActivityStreams.Object obj)
            {
                if (obj.Content is { } content)
                {
                    var text = string.Join(" ", content);
                    if (text.Length > 0)
                    {
                        ReplyToPreview = Truncate(text, 200);
                    }
                }

                if (obj.AttributedTo is { } attributed)
                {
                    var authorIri = attributed.FirstOrDefault()?.ResolveObjectIri();
                    if (authorIri is { } author)
                    {
                        var uri = new Uri(author.Value);
                        var segments = uri.AbsolutePath.TrimEnd('/').Split('/');
                        ReplyToAuthor = segments.Length > 0 ? segments[^1] : author.Value;
                    }
                }

                if (obj.InReplyTo is { } replyTo)
                {
                    var parentIri = replyTo.FirstOrDefault()?.ResolveObjectIri();
                    if (parentIri is { } grandparent)
                    {
                        await LoadThreadRootAsync(client, grandparent);
                    }
                }
            }
        }
        catch
        {
            // Non-fatal: show the default "…" author and no preview.
        }
    }

    private async Task LoadThreadRootAsync(IActivityPubClient client, Iri iri)
    {
        try
        {
            var root = await client.GetObjectAsync(iri);
            if (root is KristofferStrube.ActivityStreams.Object rootObj)
            {
                if (rootObj.Content is { } content)
                {
                    var text = string.Join(" ", content);
                    if (text.Length > 0)
                    {
                        ThreadRootPreview = Truncate(text, 150);
                    }
                }

                if (rootObj.AttributedTo is { } attributed)
                {
                    var authorIri = attributed.FirstOrDefault()?.ResolveObjectIri();
                    if (authorIri is { } author)
                    {
                        var uri = new Uri(author.Value);
                        var segments = uri.AbsolutePath.TrimEnd('/').Split('/');
                        ThreadRootAuthor = segments.Length > 0 ? segments[^1] : author.Value;
                    }
                }
            }
        }
        catch
        {
            // Non-fatal: no thread root context shown.
        }
    }

    private static string Truncate(string value, int max)
        => value.Length <= max ? value : value[..max] + "…";

    /// <summary>
    /// Detects <c>@handle</c> mentions in the composed text. A mention is an <c>@</c> followed by a
    /// handle (alphanumerics + underscores) at the start of the text or after whitespace. The handle is
    /// resolved to an actor IRI using the signed-in actor's origin (same-instance mentions only —
    /// cross-instance mentions would require a WebFinger lookup, which is deferred).
    /// Returns an empty list when no mentions are found or the client is unavailable.
    /// </summary>
    private async Task<List<Iri>> DetectMentionsAsync(string text, Iri actorId)
    {
        var mentions = new List<Iri>();
        var matches = System.Text.RegularExpressions.Regex.Matches(text, @"(?<=^|\s)@([a-zA-Z0-9_]+)");
        if (matches.Count == 0)
        {
            return mentions;
        }

        var uri = new Uri(actorId.Value);
        var baseOrigin = uri.GetLeftPart(System.UriPartial.Authority);

        foreach (System.Text.RegularExpressions.Match match in matches)
        {
            var handle = match.Groups[1].Value;
            var actorIri = new Iri($"{baseOrigin}/ap/v1/u/{handle}");
            if (!mentions.Contains(actorIri))
            {
                mentions.Add(actorIri);
            }
        }

        return mentions;
    }

    /// <summary>
    /// Detects <c>#hashtag</c> tokens in the composed text. A hashtag is a <c>#</c> followed by word
    /// characters (alphanumerics + underscores) at the start of the text or after whitespace (so
    /// <c>100%#off</c> or a markdown anchor is not mistaken for one). Returns the <c>#tag</c> names
    /// (including the leading <c>#</c>, the form the ActivityStreams <c>Hashtag</c> tag's <c>name</c>
    /// carries), de-duplicated in first-seen order. Returns an empty list when no hashtags are found.
    /// </summary>
    private static List<string> DetectHashtags(string text)
    {
        var hashtags = new List<string>();
        var matches = System.Text.RegularExpressions.Regex.Matches(text, @"(?<=^|\s)#([a-zA-Z0-9_]+)");
        foreach (System.Text.RegularExpressions.Match match in matches)
        {
            var tag = "#" + match.Groups[1].Value;
            if (!hashtags.Contains(tag, StringComparer.OrdinalIgnoreCase))
            {
                hashtags.Add(tag);
            }
        }

        return hashtags;
    }

    /// <summary>
    /// Builds the combined <c>tag</c> array (mentions first, then hashtags) for an authored note or
    /// article — the single place the client assembles the ActivityStreams <c>mention</c>/<c>hashtag</c>
    /// tags for the inline post paths (reply / community / article), mirroring what
    /// <c>ComposeNote.Build</c> does for the Note path. A hashtag tag is an
    /// ActivityStreams object of type <c>Hashtag</c> whose <c>name</c> is the <c>#tag</c> text and whose
    /// <c>href</c> is this instance's hashtag search URL (so a reader's tap on the hashtag lands on the
    /// instance's hashtag search). Returns null when there are no mentions and no hashtags.
    /// </summary>
    private List<KristofferStrube.ActivityStreams.IObjectOrLink>? BuildTagList(List<Iri>? mentions, List<string> hashtags, Iri actorId)
    {
        var tags = new List<KristofferStrube.ActivityStreams.IObjectOrLink>();

        if (mentions is { Count: > 0 })
        {
            tags.AddRange(mentions.Select(m => (KristofferStrube.ActivityStreams.IObjectOrLink)new KristofferStrube.ActivityStreams.Mention { Href = m.Uri }));
        }

        if (hashtags.Count > 0)
        {
            var baseOrigin = new Uri(actorId.Value).GetLeftPart(System.UriPartial.Authority);
            foreach (var tag in hashtags)
            {
                // A Hashtag tag is a generic ActivityStreams object of type Hashtag (the library has no
                // concrete Hashtag class). The optional href (this instance's hashtag search) goes in
                // ExtensionData because the Object base does not model href as a property — only Link
                // does — exactly the shape IriExtensions.GetHashtagTags reads back.
                var hashtag = new KristofferStrube.ActivityStreams.Object
                {
                    Type = ["Hashtag"],
                    Name = [tag]
                };
                var href = $"{baseOrigin}/search?q={Uri.EscapeDataString(tag)}";
                hashtag.ExtensionData ??= new Dictionary<string, System.Text.Json.JsonElement>();
                hashtag.ExtensionData["href"] = System.Text.Json.JsonSerializer.SerializeToElement(href);
                tags.Add(hashtag);
            }
        }

        return tags.Count > 0 ? tags : null;
    }

    // --- @mention / #hashtag autocomplete popover (54.14) ---
    //
    // A popover that triggers while typing `@` or `#` in the compose box: it queries matching actors
    // (for `@`, via the instance's global search restricted to the Actor type) or offers the typed
    // hashtag (for `#`, which has no directory), and lets the user confirm a choice before it is
    // inserted — reducing mis-mentions and confirming the resolved actor IRI up front.

    private enum AutocompleteMode
    {
        None,
        Mention,
        Hashtag
    }

    private sealed record AutocompleteCandidate(string InsertText, string? Handle, string? Name);

    private sealed class AutocompleteState
    {
        public required bool Visible { get; init; }
        public required AutocompleteMode Mode { get; init; }
        public required IReadOnlyList<AutocompleteCandidate> Candidates { get; init; }
        // The start offset (in the compose text) of the active token (the `@`/`#` and the characters
        // typed after it) — used to replace the token with the confirmed choice on accept.
        public required int TokenStart { get; init; }
        // The text as it was when the popover was opened (the replacement is computed against this so a
        // concurrent keystroke cannot desync the splice).
        public required string SourceText { get; init; }
    }

    private AutocompleteState? Autocomplete { get; set; }
    private CancellationTokenSource? _autocompleteSearchCts;
    private Timer? _autocompleteDebounce;

    /// <summary>
    /// The textarea's input handler: detects an in-progress <c>@handle</c> or <c>#hashtag</c> token at
    /// the end of the text and (debounced) populates the popover with candidates. Hides the popover when
    /// no token is active (the user typed something else, or deleted the token).
    /// </summary>
    private void OnContentInput()
    {
        _autocompleteDebounce?.Dispose();
        var text = Content;
        var (mode, tokenStart, _) = DetectActiveToken(text);

        if (mode is AutocompleteMode.None)
        {
            // No active @/# token at the end (the user typed something else, or deleted the token) —
            // hide the popover.
            HideAutocomplete();
            return;
        }

        // An active token (even an empty one — the user just typed the symbol) populates the popover,
        // debounced so rapid typing fires one search, not one per keystroke.
        _autocompleteDebounce = new Timer(
            async _ => await RunAutocompleteAsync(mode, tokenStart, text),
            null,
            180,
            Timeout.Infinite);
    }

    /// <summary>
    /// Detects the active <c>@</c>/<c>#</c> token at the end of the compose text. Returns the mode
    /// (Mention for <c>@</c>, Hashtag for <c>#</c>, None otherwise), the token's start offset (the
    /// position of the <c>@</c>/<c>#</c>), and the token text typed after the symbol (possibly empty —
    /// the user just typed the symbol). A token is "active" only when it is the last thing in the text
    /// and is at the start or preceded by whitespace (so a trailing period, or an email-ish
    /// <c>a@b</c> mid-word, is not mistaken for a mention).
    /// </summary>
    private static (AutocompleteMode Mode, int Start, string Token) DetectActiveToken(string text)
    {
        if (string.IsNullOrEmpty(text))
        {
            return (AutocompleteMode.None, 0, string.Empty);
        }

        // The active token is a run of word characters (or empty) immediately before the end, preceded
        // by an @ or # that is at the start of the text or after whitespace.
        var match = System.Text.RegularExpressions.Regex.Match(
            text, @"(?<=^|\s)([@#])([a-zA-Z0-9_]*)$");
        if (match is { Success: false })
        {
            return (AutocompleteMode.None, 0, string.Empty);
        }

        var symbol = match.Groups[1].Value;
        var token = match.Groups[2].Value;
        var start = text.Length - symbol.Length - token.Length;
        var mode = symbol == "@" ? AutocompleteMode.Mention : AutocompleteMode.Hashtag;
        return (mode, start, token);
    }

    private async Task RunAutocompleteAsync(AutocompleteMode mode, int tokenStart, string sourceText)
    {
        _autocompleteSearchCts?.Cancel();
        var cts = new CancellationTokenSource();
        _autocompleteSearchCts = cts;

        try
        {
            // The token text is everything from the @/# symbol to the end (symbol + the characters
            // typed); the handle/tag portion is the token minus its leading symbol.
            var fullToken = sourceText[tokenStart..];
            var tokenText = fullToken.Length > 0 ? fullToken[1..] : string.Empty;

            List<AutocompleteCandidate> candidates;
            if (mode is AutocompleteMode.Mention)
            {
                candidates = await SearchMentionCandidatesAsync(tokenText, cts.Token);
            }
            else
            {
                // No hashtag directory — offer the typed hashtag as-is (the user confirms to insert a
                // canonical #tag token). A trailing partial token is offered as its own candidate.
                var hashtag = "#" + tokenText;
                candidates = [new AutocompleteCandidate(hashtag, null, null)];
            }

            if (cts.IsCancellationRequested)
            {
                return;
            }

            Autocomplete = candidates.Count > 0
                ? new AutocompleteState
                {
                    Visible = true,
                    Mode = mode,
                    Candidates = candidates,
                    TokenStart = tokenStart,
                    SourceText = sourceText
                }
                : null;
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer keystroke — ignore.
        }
        catch
        {
            // A search failure should not block composing — just no popover.
        }
    }

    private async Task<List<AutocompleteCandidate>> SearchMentionCandidatesAsync(string query, CancellationToken ct)
    {
        var list = new List<AutocompleteCandidate>();
        if (Session.ActorId is not { } actorId || Session.Client is not { } client)
        {
            return list;
        }

        // The instance base for SearchAsync is the actor IRI minus the /u/{handle} suffix (the
        // {origin}/ap/v1 base the search endpoint hangs off).
        var baseUri = new Uri(actorId.Value);
        var path = baseUri.AbsolutePath;
        var uIndex = path.LastIndexOf("/u/", StringComparison.Ordinal);
        var basePath = uIndex >= 0 ? path[..uIndex] : path;
        if (string.IsNullOrEmpty(basePath))
        {
            return list;
        }

        var instanceBase = new Iri(new UriBuilder(baseUri) { Path = basePath }.Uri.GetLeftPart(UriPartial.Path));

        await foreach (var item in client.SearchAsync(
            instanceBase,
            string.IsNullOrWhiteSpace(query) ? null : query,
            new SearchOptions { Type = "Actor", Limit = 5 },
            ct))
        {
            if (item is Actor actor && actor.Id is { Length: > 0 } id)
            {
                var handle = actor.PreferredUsername
                    ?? new Uri(id).AbsolutePath.Trim('/').Split('/').LastOrDefault();
                var name = actor.Name?.FirstOrDefault();
                list.Add(new AutocompleteCandidate("@" + (handle ?? ""), handle, name));
            }
        }

        return list;
    }

    /// <summary>
    /// Accepts a popover candidate: splices the confirmed choice into the compose text in place of the
    /// active token (the <c>@</c>/<c>#</c> + the characters typed), appending a trailing space for
    /// mentions (so the next word is separate) and closing the popover.
    /// </summary>
    private void AcceptAutocomplete(AutocompleteCandidate candidate)
    {
        if (Autocomplete is not { } ac)
        {
            return;
        }

        var before = ac.SourceText[..ac.TokenStart];
        var insert = candidate.InsertText + (ac.Mode is AutocompleteMode.Mention ? " " : string.Empty);
        Content = before + insert;
        HideAutocomplete();
        StateHasChanged();
    }

    private void HideAutocomplete()
    {
        if (Autocomplete is not null)
        {
            Autocomplete = null;
            StateHasChanged();
        }
    }

    private string? ReplyToHref
    {
        get
        {
            if (ReplyToIri is not { } iri)
            {
                return null;
            }

            return $"/object?iri={Uri.EscapeDataString(iri.Value)}";
        }
    }

    private string PageTitle
    {
        get
        {
            if (ReplyToIri is not null)
            {
                return "Reply";
            }

            if (CommunityIri is not null && CommunityName is { Length: > 0 } name)
            {
                return $"Post to {name}";
            }

            return "Compose";
        }
    }

    /// <summary>
    /// The note text the user is composing. Cleared on a successful post.
    /// </summary>
    private string Content { get; set; } = string.Empty;

    /// <summary>
    /// The content type for new posts (Note or Article). Ignored for replies.
    /// </summary>
    private string ContentType { get; set; } = "Note";

    /// <summary>
    /// Whether the composed note is flagged content-sensitive (the ActivityStreams <c>sensitive</c> term).
    /// The feed renders such notes behind a notice + reveal toggle. Applies to Note posts only (the
    /// Article/reply/community paths don't set it).
    /// </summary>
    private bool IsSensitive { get; set; }

    /// <summary>
    /// The sensitivity summary (the ActivityStreams <c>summary</c> term) — the short warning text the feed
    /// shows in place of the note's content until the viewer reveals it. Read only when
    /// <see cref="IsSensitive"/> is set.
    /// </summary>
    private string SensitiveSummary { get; set; } = string.Empty;

    private const int MaxChars = 500;

    /// <summary>
    /// The chosen image attachment (a browser <see cref="IBrowserFile"/>), held until the post uploads it.
    /// Null when nothing is selected. Applies to Note and Article posts only (replies carry no attachment).
    /// </summary>
    private IBrowserFile? Attachment { get; set; }

    /// <summary>
    /// The maximum attachment size accepted (10 MiB — matches the server's upload cap); an oversized file
    /// is rejected by the server with <c>413</c>.
    /// </summary>
    private const long MaxAttachmentBytes = 10 * 1024 * 1024;

    /// <summary>
    /// Records the chosen attachment (a browser <see cref="IBrowserFile"/>, read lazily at post time) and
    /// clears any previous selection. A no-op when nothing is chosen.
    /// </summary>
    private void OnAttachmentChosen(InputFileChangeEventArgs e)
        => Attachment = e.File;

    /// <summary>
    /// Clears the attachment when the browser's file input is emptied (the built-in "remove" affordance).
    /// </summary>
    private void OnAttachmentRemoved(InputFileChangeEventArgs e)
        => Attachment = null;

    /// <summary>
    /// Removes the selected attachment (the "✕" affordance next to the file name).
    /// </summary>
    private void ClearAttachment()
        => Attachment = null;

    /// <summary>
    /// Whether a post is in flight — disables the button and shows the "Posting…" state.
    /// </summary>
    private bool Busy { get; set; }

    /// <summary>
    /// Whether the last post succeeded — when true the "View your posts" link is shown (a quick path
    /// to the profile's outbox, where the just-posted note now lives).
    /// </summary>
    private bool Posted { get; set; }

    /// <summary>
    /// The IRI the server minted for the posted <c>Create</c> (from <see cref="DeliveryResult.MintedId"/>),
    /// shown after a successful post so the user can see what was created.
    /// </summary>
    private string? PostedIri { get; set; }

    /// <summary>
    /// A human-readable status line for the last post (e.g. the HTTP status), when present.
    /// </summary>
    private string? Result { get; set; }

    /// <summary>
    /// The error message from the last post, when present.
    /// </summary>
    private string? Error { get; set; }

    /// <summary>
    /// The signed-in actor's handle (e.g. "pwtest2"), derived from the last segment of the actor IRI.
    /// </summary>
    private string ActorHandle
    {
        get
        {
            if (Session.ActorId is not { } actorId)
            {
                return "…";
            }

            var uri = new Uri(actorId.Value);
            var segments = uri.AbsolutePath.TrimEnd('/').Split('/');
            return segments.Length > 0 ? segments[^1] : actorId.Value;
        }
    }

    /// <summary>
    /// The ActivityStreams public collection address (the conventional <c>to</c> for public notes) —
    /// a note addressed to the public is delivered to the actor's followers' timelines (F-14).
    /// </summary>
    private static readonly Iri AsPublic = new("https://www.w3.org/ns/activitystreams#Public");

    /// <summary>
    /// Posts the composed note (or reply, when <see cref="ReplyToIri"/> is set) as the signed-in actor.
    /// The write goes through the session's <see cref="IActivityPubClient"/> — the one sanctioned path
    /// from the UI into ActivityPub state.
    /// </summary>
    private async Task PostAsync()
    {
        if (Session.ActorId is not { } actorId
            || Session.Client is not { } client
            || string.IsNullOrWhiteSpace(Content)
            || Busy)
        {
            return;
        }

        Busy = true;
        Posted = false;
        PostedIri = null;
        Result = null;
        Error = null;
        try
        {
            // Upload the chosen attachment first (a local, Basic-authenticated multipart POST — not a
            // signed inbox delivery) to get the same-origin media IRI, so the post can carry an Image
            // attachment whose url is that IRI (the browser loads it same-origin, never a cross-origin
            // media host — Decision 056 (b)). Replies and community posts carry no attachment.
            MediaUploadResult? media = null;
            if (Attachment is { Size: > 0 } file)
            {
                media = await UploadAttachmentAsync(actorId, file);
            }

            var mentions = await DetectMentionsAsync(Content.Trim(), actorId);
            var hashtags = DetectHashtags(Content.Trim());
            var mentionArg = mentions.Count > 0 ? mentions : null;
            var hashtagArg = hashtags.Count > 0 ? hashtags : null;
            // A hashtag tag's href points at this instance's hashtag search (so a reader's tap on the
            // hashtag lands on the instance's search results for that tag).
            Func<string, string?> hashtagHref = name => $"{new Uri(actorId.Value).GetLeftPart(UriPartial.Authority)}/search?q={Uri.EscapeDataString(name)}";

            DeliveryResult result;
            if (ReplyToIri is { } parent)
            {
                result = await client.PostReplyAsync(actorId, parent, Content.Trim(), mentions: mentionArg, to: [AsPublic], hashtags: hashtagArg);
            }
            else if (CommunityIri is { } community)
            {
                result = await PostToCommunityAsync(client, actorId, community, mentionArg, hashtagArg);
            }
            else if (ContentType == "Article")
            {
                result = await PostArticleAsync(client, actorId, media, mentionArg, hashtagArg);
            }
            else
            {
                var note = ComposeNote.Build(
                    actorId,
                    Content.Trim(),
                    sensitive: IsSensitive,
                    summary: SensitiveSummary,
                    to: [AsPublic],
                    mediaIri: media?.MediaIri,
                    mediaType: media?.ContentType,
                    mediaName: media?.FileName,
                    mentions: mentionArg,
                    hashtags: hashtagArg,
                    hashtagHrefFactory: hashtagHref);
                result = await client.PostNoteAsync(actorId, note);
            }

            if (result.IsSuccess)
            {
                Posted = true;
                Result = $"Posted (HTTP {result.StatusCode}).";
                PostedIri = result.MintedId;
                Content = string.Empty;
                IsSensitive = false;
                SensitiveSummary = string.Empty;
                Attachment = null;
            }
            else
            {
                Result = $"Post failed (HTTP {result.StatusCode}).";
            }
        }
        catch (Exception)
        {
            Error = "Your post couldn't be sent right now. Please check your connection and try again.";
        }
        finally
        {
            Busy = false;
        }
    }

    /// <summary>
    /// Posts a note to a community: the note's <c>attributedTo</c> carries both the author and the
    /// community, and its <c>to</c> is the community's followers collection + the public. The
    /// receiving server's <c>Create</c> handler records the post in the community's members' outboxes
    /// (the "followed content" half of the community feed). When <paramref name="mentions"/> is
    /// non-empty, each mentioned actor becomes a <c>Mention</c> <c>tag</c> entry.
    /// </summary>
    private async Task<DeliveryResult> PostToCommunityAsync(IActivityPubClient client, Iri actorId, Iri communityIri, List<Iri>? mentions = null, List<string>? hashtags = null)
    {
        var followersIri = communityIri.FollowersOf();
        var note = new KristofferStrube.ActivityStreams.Note
        {
            AttributedTo =
            [
                new Link { Href = new Uri(actorId.Value) },
                new Link { Href = new Uri(communityIri.Value) }
            ],
            To =
            [
                new Link { Href = new Uri(followersIri.Value) },
                new Link { Href = new Uri(AsPublic.Value) }
            ],
            Content = [Content.Trim()],
            Published = DateTime.UtcNow
        };

        var tags = BuildTagList(mentions, hashtags ?? [], actorId);
        if (tags is { Count: > 0 })
        {
            note.Tag = tags;
        }

        return await client.PostNoteAsync(actorId, note);
    }

    private async Task<DeliveryResult> PostArticleAsync(IActivityPubClient client, Iri actorId, MediaUploadResult? media, List<Iri>? mentions = null, List<string>? hashtags = null)
    {
        var article = new Article
        {
            AttributedTo = [new Link { Href = new Uri(actorId.Value) }],
            To = [new Link { Href = new Uri(AsPublic.Value) }],
            Content = [Content.Trim()],
            Published = DateTime.UtcNow
        };

        if (media is { } m)
        {
            // The Image attachment's url is the same-origin media IRI (its id mirrors it, so a reader can
            // resolve the media without the url); mediaType + name come from the upload.
            var image = new Image
            {
                Url = [new Link { Href = m.MediaIri.Uri }],
                Id = m.MediaIri.Value,
                MediaType = m.ContentType,
            };
            if (m.FileName is { } fileName && !string.IsNullOrWhiteSpace(fileName))
            {
                image.Name = [fileName];
            }
            article.Attachment = [image];
        }

        var tags = BuildTagList(mentions, hashtags ?? [], actorId);
        if (tags is { Count: > 0 })
        {
            article.Tag = tags;
        }

        var create = new Create
        {
            Actor = [new Link { Href = new Uri(actorId.Value) }],
            Object = [article]
        };

        return await client.DeliverAsync(actorId.OutboxOf(), create);
    }

    /// <summary>
    /// Uploads the chosen image attachment (a local, Basic-authenticated multipart POST to the actor's
    /// own home instance — Phase 20.4 (a), not a signed inbox delivery) and returns the same-origin media
    /// IRI + content-type + file name (set as the note's <c>Image</c> attachment). Throws on failure
    /// (surfaced as the post's error line).
    /// </summary>
    private async Task<MediaUploadResult> UploadAttachmentAsync(Iri actorId, IBrowserFile file)
    {
        var bytes = await ReadBytesAsync(file);
        var result = await Session.UploadMediaAsync(
            actorId,
            bytes,
            file.ContentType ?? "application/octet-stream",
            file.Name,
            CancellationToken.None);
        return result
            ?? throw new InvalidOperationException("Media upload failed.");
    }

    /// <summary>
    /// Reads a browser file's bytes (capped at <see cref="MaxAttachmentBytes"/>).
    /// </summary>
    private static async Task<byte[]> ReadBytesAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(MaxAttachmentBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        return ms.ToArray();
    }
}
