@page "/compose"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Iris.Client
@using Iris.Core.Compose
@using Iris.Core.Identity
@using Iris.Core.Rendering
@using Iris.Web.Client.Accounts
@using Iris.Web.Client.Ui
@using Microsoft.AspNetCore.Components.Web
@using KristofferStrube.ActivityStreams
@using System.Net

<PageTitle>@PageTitle · Iris</PageTitle>

<p class="muted">
    Posting as <a href="/profile">@ActorHandle</a>
</p>

    <div class="card compose-card">
    @if (ReplyToIri is not null)
    {
        <div class="compose-reply-context">
            <p class="compose-reply-to">
                Replying to <a href="@ReplyToHref">@ReplyToAuthor</a>
            </p>
            @if (ReplyToPreview is { Length: > 0 })
            {
                <blockquote class="compose-reply-preview">@ReplyToPreview</blockquote>
            }
            @if (ThreadRootAuthor is { Length: > 0 })
            {
                <div class="compose-thread-root">
                    <span class="compose-thread-root-label">Thread started by</span>
                    <span class="compose-thread-root-author">@ThreadRootAuthor</span>
                    @if (ThreadRootPreview is { Length: > 0 })
                    {
                        <blockquote class="compose-reply-preview">@ThreadRootPreview</blockquote>
                    }
                </div>
            }
        </div>
    }
    @if (CommunityIri is { } cIri)
    {
        <div class="compose-community-context">
            <p class="compose-community-to">
                Posting to <a href="@($"/community?iri={Uri.EscapeDataString(cIri.Value)}")">@(CommunityName ?? "community")</a>
            </p>
        </div>
    }
    @if (DmToIri is { } dIri)
    {
        <div class="compose-dm-context">
            <p class="compose-dm-to">
                Messaging <a href="@($"/actor?iri={Uri.EscapeDataString(dIri.Value)}")">@(DmToHandle ?? "…")</a> — direct, only they can see it
            </p>
        </div>
    }
    <label for="compose-content">Content</label>
    <div class="compose-autocomplete-wrap">
        <textarea id="compose-content" class="compose-content" rows="4"
                  value="@(Content)"
                  @oninput="OnContentInputEvent"
                  placeholder="What's on your mind?"></textarea>
        @if (Autocomplete is { Visible: true } ac)
        {
            <div class="compose-autocomplete" role="listbox" aria-label="Suggestions">
                @foreach (var candidate in ac.Candidates)
                {
                    <button type="button" class="compose-autocomplete-item" role="option"
                            @onclick="() => AcceptAutocomplete(candidate)">
                        @if (ac.Mode == AutocompleteMode.Mention && candidate.Handle is { Length: > 0 } h)
                        {
                            <span class="compose-autocomplete-handle">@h</span>
                            @if (candidate.Name is { Length: > 0 } name && name != h)
                            {
                                <span class="compose-autocomplete-name">@name</span>
                            }
                        }
                        else
                        {
                            <span class="compose-autocomplete-hashtag">@candidate.InsertText</span>
                        }
                    </button>
                }
            </div>
        }
    </div>
    @if (ReplyToIri is null)
    {
        <label for="compose-attachment" class="compose-attach-label">Attachments (optional — images, video, audio, PDF)</label>
        <div class="compose-attach">
            <InputFile id="compose-attachment" multiple OnChange="OnAttachmentsChosen"
                       accept="image/*,video/*,audio/*,.pdf" disabled="@Busy" />
            @for (var i = 0; i < Attachments.Count; i++)
            {
                var index = i;
                <div class="compose-attach-item">
                    <div class="compose-attach-row">
                        <span class="compose-attach-name">@Attachments[index].Name</span>
                        <button type="button" class="compose-attach-remove" aria-label="Remove attachment" @onclick="() => RemoveAttachment(index)" disabled="@Busy">✕</button>
                    </div>
                    @if (IsImageAttachment(index))
                    {
                        <label class="compose-attach-alt">
                            <span class="compose-attach-alt-label">Alt text</span>
                            <input class="compose-attach-alt-input" type="text"
                                   value="@(index < AttachmentAltText.Count ? AttachmentAltText[index] : string.Empty)"
                                   @oninput="e => OnAltTextInput(index, e)"
                                   placeholder="Describe this image for screen readers"
                                   maxlength="500" disabled="@Busy" />
                        </label>
                    }
                </div>
            }
        </div>
    }
    <div class="compose-meta">
        <span class="compose-char-count @(Content.Length > MaxChars ? "compose-char-count--over" : "")">
            @Content.Length/@MaxChars
        </span>
        @if (ReplyToIri is null)
        {
            <select class="compose-type-select" @bind="ContentType" disabled="@Busy">
                <option value="Note">Note</option>
                <option value="Article">Article</option>
                <option value="Poll">Poll</option>
            </select>
            @if (CommunityIri is null)
            {
                <select class="compose-visibility-select" @bind="Visibility" disabled="@(Busy || DmToIri is not null)"
                        title="@(DmToIri is not null ? "Direct messages are always private to the recipient" : null)">
                    <option value="public">Public</option>
                    <option value="followers">Followers</option>
                    <option value="direct">Direct</option>
                </select>
            }
            <select class="compose-language-select" @bind="Language" disabled="@Busy" title="Language of this post">
                <option value="">Auto</option>
                @foreach (var (langCode, label) in SupportedLanguages)
                {
                    <option value="@langCode">@label</option>
                }
            </select>
        }
        @if (ReplyToIri is null)
        {
            <label class="compose-sensitive-toggle">
                <input type="checkbox" @bind="IsSensitive" disabled="@Busy" />
                Content warning
            </label>
            @if (IsSensitive)
            {
                <input class="compose-sensitive-summary" type="text" @bind="SensitiveSummary"
                       placeholder="Warning summary (shown before revealing)" maxlength="200" disabled="@Busy" />
            }
        }
    </div>
    @if (ReplyToIri is null && ContentType == "Poll")
    {
        <div class="compose-poll">
            <label for="compose-poll-question">Question</label>
            <input id="compose-poll-question" class="compose-poll-question" type="text" @bind="PollQuestion" @bind:event="oninput"
                   placeholder="Ask a question…" maxlength="500" disabled="@Busy" />
            <div class="compose-poll-options">
                @for (var i = 0; i < PollOptions.Count; i++)
                {
                    var index = i;
                    <div class="compose-poll-option-row">
                        <input class="compose-poll-option-input" type="text" @bind="PollOptions[index]"
                               @bind:event="oninput" placeholder="@($"Option {index + 1}")" disabled="@Busy" />
                        @if (PollOptions.Count > 2)
                        {
                            <button type="button" class="compose-poll-option-remove" aria-label="Remove option" @onclick="() => RemovePollOption(index)" disabled="@Busy">✕</button>
                        }
                    </div>
                }
            </div>
            @if (PollOptions.Count < 4)
            {
                <button type="button" class="button button--secondary compose-poll-add" @onclick="AddPollOption" disabled="@Busy">+ Add option</button>
            }
            <div class="compose-poll-meta">
                <label class="compose-poll-duration">
                    Duration
                    <select @bind="PollDurationMinutes" disabled="@Busy">
                        <option value="30">30 minutes</option>
                        <option value="60">1 hour</option>
                        <option value="360">6 hours</option>
                        <option value="1440">1 day</option>
                        <option value="10080">1 week</option>
                    </select>
                </label>
                <label class="compose-poll-multiple">
                    <input type="checkbox" @bind="PollMultiple" disabled="@Busy" />
                    Allow multiple choices
                </label>
            </div>
            @if (PollError is { Length: > 0 } pErr)
            {
                <p class="error compose-poll-error" role="alert">@pErr</p>
            }
        </div>
    }
    <p class="muted compose-hint">
        @(ReplyToIri is not null
            ? "This reply is threaded under the parent note and visible in its replies."
            : CommunityIri is not null
                ? "This post is attributed to the community and visible to its members."
                : ComposeHint)
    </p>

    <div class="compose-actions">
        <button @onclick="PostAsync" disabled="@Busy">
            @(Busy ? "Posting…" : (ReplyToIri is not null ? "Post reply" : CommunityIri is not null ? "Post to community" : "Post"))
        </button>
        @if (Posted)
        {
            @if (CommunityIri is { } postCommunity)
            {
                <a class="button button--secondary" href="@($"/community?iri={Uri.EscapeDataString(postCommunity.Value)}")">View community feed →</a>
            }
            else
            {
                <a class="button button--secondary" href="/profile">View your posts →</a>
            }
        }
    </div>

    @if (Result is not null)
    {
        <p class="muted compose-result" role="status">
            @Result
            @if (PostedIri is not null)
            {
                <code class="compose-result-iri">@PostedIri</code>
            }
        </p>
    }
    @if (Error is not null)
    {
        <div class="error" role="alert">@Error</div>
    }
</div>

<div class="compose-tips card">
    <h2>Formatting tips</h2>
    <ul class="compose-tips-list">
        <li>Use <strong>@@handle</strong> to mention someone (e.g. @@alice).</li>
        <li>Use <strong>#hashtag</strong> to tag a topic.</li>
        <li>Notes and Articles share the same character limit; Articles are stored as long-form objects.</li>
        <li>Content warning hides your post behind a "Show" button.</li>
    </ul>
</div>

@code {
    [Inject]
    private IActorSessionAccessor Session { get; set; } = default!;

    [Inject]
    private UiContext Ui { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "replyTo")]
    private string? ReplyToParam { get; set; }

    [SupplyParameterFromQuery(Name = "community")]
    private string? CommunityParam { get; set; }

    [SupplyParameterFromQuery(Name = "dmTo")]
    private string? DmToParam { get; set; }

    /// <summary>
    /// The recipient actor IRI for a direct message (from the <c>dmTo</c> query parameter), when set.
    /// When present the compose is pre-addressed as a Direct DM to that actor: visibility is forced to
    /// <c>direct</c> and the content is seeded with <c>@handle </c> so the recipient is included in the
    /// post's <c>to</c> audience (see <see cref="BuildAudience"/>). Mirrors the "Message" button on a
    /// profile.
    /// </summary>
    private Iri? DmToIri
    {
        get
        {
            if (string.IsNullOrEmpty(DmToParam) || !Iri.TryParse(DmToParam, out var parsed))
            {
                return null;
            }

            return parsed;
        }
    }

    /// <summary>
    /// The DM recipient's preferred username (fetched asynchronously), shown in the "Messaging …"
    /// header. Null until resolved.
    /// </summary>
    private string? DmToHandle { get; set; }

    /// <summary>
    /// The community IRI the post targets (from the <c>community</c> query parameter), when set.
    /// When present, the post is attributed to both the author and the community, and addressed
    /// to the community's followers collection + the public.
    /// </summary>
    private Iri? CommunityIri
    {
        get
        {
            if (string.IsNullOrEmpty(CommunityParam) || !Iri.TryParse(CommunityParam, out var parsed))
            {
                return null;
            }

            return parsed;
        }
    }

    /// <summary>
    /// The community's display name (fetched asynchronously), shown in the compose header when
    /// posting to a community.
    /// </summary>
    private string? CommunityName { get; set; }

    /// <summary>
    /// Whether the targeted community lives on a different host than the signed-in actor (i.e. a
    /// remote community such as a Lemmy one). When true, <see cref="PostToCommunityAsync"/> posts a
    /// Lemmy-compatible <c>Page</c> (rather than a <c>Note</c>) and delivers it directly to the
    /// community's inbox, because a remote server only sees content it is addressed to — it will never
    /// see an activity delivered to the author's own outbox.
    /// </summary>
    private bool IsRemoteCommunity
    {
        get
        {
            if (CommunityIri is not { } community || Session.ActorId is not { } actor)
            {
                return false;
            }

            try
            {
                var communityHost = new Uri(community.Value).Host;
                var actorHost = new Uri(actor.Value).Host;
                return !string.Equals(communityHost, actorHost, StringComparison.OrdinalIgnoreCase);
            }
            catch
            {
                return false;
            }
        }
    }

    private Iri? ReplyToIri
    {
        get
        {
            if (string.IsNullOrEmpty(ReplyToParam) || !Iri.TryParse(ReplyToParam, out var parsed))
            {
                return null;
            }

            return parsed;
        }
    }

    /// <summary>
    /// The author handle of the parent note (fetched asynchronously), or "…" while loading.
    /// </summary>
    private string ReplyToAuthor { get; set; } = "…";

    /// <summary>
    /// A truncated preview of the parent note's content (for context while composing a reply).
    /// </summary>
    private string? ReplyToPreview { get; set; }

    /// <summary>
    /// The author handle of the thread root (the parent's parent), when the parent is itself a reply.
    /// </summary>
    private string? ThreadRootAuthor { get; set; }

    /// <summary>
    /// A truncated preview of the thread root's content, when the parent is itself a reply.
    /// </summary>
    private string? ThreadRootPreview { get; set; }

    private string? _fetchedIri;

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureReadyAsync();
        if (ReplyToIri is { } iri && _fetchedIri != iri.Value)
        {
            await LoadReplyContextAsync(iri);
        }

        if (CommunityIri is { } cIri && CommunityName is null)
        {
            await LoadCommunityNameAsync(cIri);
        }

        if (DmToIri is { } dIri && DmToHandle is null)
        {
            await LoadDmRecipientAsync(dIri);
        }
    }

    /// <summary>
    /// Resolves the <c>dmTo</c> recipient: fetches the actor's preferred username, forces the
    /// visibility to <c>direct</c>, and seeds the content with <c>@handle </c> (when empty) so the
    /// recipient lands in the post's <c>to</c> audience. Non-fatal: if the actor cannot be resolved the
    /// compose still posts as a normal Direct note (the user can add the mention manually).
    /// </summary>
    private async Task LoadDmRecipientAsync(Iri iri)
    {
        Visibility = "direct";

        try
        {
            if (Session.Client is not { } client)
            {
                return;
            }

            var obj = await client.GetObjectAsync(iri);
            if (obj is Actor actor)
            {
                var handle = !string.IsNullOrWhiteSpace(actor.PreferredUsername)
                    ? actor.PreferredUsername
                    : LastPathSegment(iri.Value);
                DmToHandle = handle;

                if (string.IsNullOrWhiteSpace(Content) && !string.IsNullOrWhiteSpace(handle))
                {
                    Content = $"@{handle} ";
                }
            }
        }
        catch
        {
            // Non-fatal: fall back to the raw last path segment for the header + seed.
            var fallback = LastPathSegment(iri.Value);
            if (!string.IsNullOrWhiteSpace(fallback))
            {
                DmToHandle = fallback;
                if (string.IsNullOrWhiteSpace(Content))
                {
                    Content = $"@{fallback} ";
                }
            }
        }
    }

    private static string LastPathSegment(string iri)
    {
        try
        {
            var segments = new Uri(iri).AbsolutePath.TrimEnd('/').Split('/');
            return segments.Length > 0 ? segments[^1] : iri;
        }
        catch
        {
            return iri;
        }
    }

    private async Task LoadCommunityNameAsync(Iri communityIri)
    {
        try
        {
            if (Session.Client is not { } client)
            {
                return;
            }

            var obj = await client.GetObjectAsync(communityIri);
            if (obj is Group group)
            {
                CommunityName = group.Name?.FirstOrDefault() ?? group.PreferredUsername;
            }
            else if (obj is Actor actor)
            {
                CommunityName = actor.Name?.FirstOrDefault() ?? actor.PreferredUsername;
            }
        }
        catch
        {
            // Non-fatal: no community name shown.
        }
    }

    private async Task LoadReplyContextAsync(Iri iri)
    {
        _fetchedIri = iri.Value;
        ReplyToAuthor = "…";
        ReplyToPreview = null;
        ThreadRootAuthor = null;
        ThreadRootPreview = null;

        try
        {
            if (Session.Client is not { } client)
            {
                return;
            }

            var note = await client.GetObjectAsync(iri);
            if (note is KristofferStrube.ActivityStreams.Object obj)
            {
                if (obj.Content is { } content)
                {
                    var text = string.Join(" ", content);
                    if (text.Length > 0)
                    {
                        ReplyToPreview = Truncate(text, 200);
                    }
                }

                if (obj.AttributedTo is { } attributed)
                {
                    var authorIri = attributed.FirstOrDefault()?.ResolveObjectIri();
                    if (authorIri is { } author)
                    {
                        var uri = new Uri(author.Value);
                        var segments = uri.AbsolutePath.TrimEnd('/').Split('/');
                        ReplyToAuthor = segments.Length > 0 ? segments[^1] : author.Value;
                    }
                }

                if (obj.InReplyTo is { } replyTo)
                {
                    var parentIri = replyTo.FirstOrDefault()?.ResolveObjectIri();
                    if (parentIri is { } grandparent)
                    {
                        await LoadThreadRootAsync(client, grandparent);
                    }
                }
            }
        }
        catch
        {
            // Non-fatal: show the default "…" author and no preview.
        }
    }

    private async Task LoadThreadRootAsync(IActivityPubClient client, Iri iri)
    {
        try
        {
            var root = await client.GetObjectAsync(iri);
            if (root is KristofferStrube.ActivityStreams.Object rootObj)
            {
                if (rootObj.Content is { } content)
                {
                    var text = string.Join(" ", content);
                    if (text.Length > 0)
                    {
                        ThreadRootPreview = Truncate(text, 150);
                    }
                }

                if (rootObj.AttributedTo is { } attributed)
                {
                    var authorIri = attributed.FirstOrDefault()?.ResolveObjectIri();
                    if (authorIri is { } author)
                    {
                        var uri = new Uri(author.Value);
                        var segments = uri.AbsolutePath.TrimEnd('/').Split('/');
                        ThreadRootAuthor = segments.Length > 0 ? segments[^1] : author.Value;
                    }
                }
            }
        }
        catch
        {
            // Non-fatal: no thread root context shown.
        }
    }

    private static string Truncate(string value, int max)
        => value.Length <= max ? value : value[..max] + "…";

    /// <summary>
    /// Detects <c>@handle</c> and <c>@user@domain</c> mentions in the composed text, returning each
    /// mention's resolved actor IRI paired with its display token (the <c>@handle</c> /
    /// <c>@user@domain</c> text exactly as typed). A mention is an <c>@</c> followed by a handle
    /// (alphanumerics + underscores), optionally followed by <c>@domain</c> (a remote instance host), at
    /// the start of the text or after whitespace. Same-instance mentions (<c>@handle</c>, no domain) are
    /// resolved to the signed-in actor's origin. Cross-instance mentions (<c>@user@domain</c>) are
    /// resolved via WebFinger (RFC 8410) through the home instance's proxy endpoint (the browser cannot
    /// reach a remote instance directly — CORS). An unresolvable cross-instance mention (WebFinger 404,
    /// network failure, or no <c>self</c> link) is silently dropped. De-duplicated by resolved IRI in
    /// first-seen order. Returns an empty list when no mentions are found or the session is unavailable.
    /// </summary>
    private async Task<List<(Iri Iri, string Display)>> DetectMentionsWithDisplayAsync(string text, Iri actorId)
    {
        var mentions = new List<(Iri Iri, string Display)>();
        // Matches @handle (same-instance) and @user@domain (cross-instance). The domain part is
        // optional: @user@domain has the domain after the second @; @handle has no second @.
        // The domain is alphanumerics + hyphens + dots (a valid host, possibly with a port).
        var matches = System.Text.RegularExpressions.Regex.Matches(text, @"(?<=^|\s)@([a-zA-Z0-9_-]+)(?:@([a-zA-Z0-9.\-]+(?::\d+)?))?");
        if (matches.Count == 0)
        {
            return mentions;
        }

        var uri = new Uri(actorId.Value);
        var baseOrigin = uri.GetLeftPart(System.UriPartial.Authority);

        foreach (System.Text.RegularExpressions.Match match in matches)
        {
            var handle = match.Groups[1].Value;
            var domain = match.Groups[2].Success ? match.Groups[2].Value : null;

            Iri? resolved;
            if (domain is null)
            {
                // Same-instance mention: resolve against the signed-in actor's origin.
                resolved = new Iri($"{baseOrigin}/ap/v1/u/{handle}");
            }
            else
            {
                // Cross-instance mention: resolve via WebFinger through the proxy.
                resolved = await ResolveRemoteMentionAsync(handle, domain);
            }

            if (resolved is { } iri
                && !mentions.Any(m => m.Iri == iri))
            {
                // The display token is the full match as typed (the leading '@' plus the handle and,
                // for a cross-instance mention, the '@domain'). This is the text the linkify pass looks
                // for in the body, so it must be the raw typed form, not the resolved IRI.
                mentions.Add((iri, match.Value));
            }
        }

        return mentions;
    }

    /// <summary>
    /// Detects <c>@handle</c> and <c>@user@domain</c> mentions in the composed text, returning only their
    /// resolved actor IRIs (the audience / <c>tag</c> half of the mention convention). Delegates to
    /// <see cref="DetectMentionsWithDisplayAsync"/> and discards the display tokens.
    /// </summary>
    private Task<List<Iri>> DetectMentionsAsync(string text, Iri actorId)
        => DetectMentionsWithDisplayAsync(text, actorId)
            .ContinueWith(t => t.Result.Select(m => m.Iri).ToList(), TaskScheduler.Default);

    /// <summary>
    /// Resolves a cross-instance mention (<c>@user@domain</c>) to an actor IRI via WebFinger
    /// (RFC 8410), routing the request through the home instance's proxy endpoint (the browser
    /// cannot reach a remote instance directly — CORS). Returns null when the WebFinger lookup
    /// fails (404, network error, or no <c>self</c> link in the response).
    /// </summary>
    private async Task<Iri?> ResolveRemoteMentionAsync(string handle, string domain)
    {
        if (Session is null)
        {
            return null;
        }

        var resource = $"acct:{handle}@{domain}";
        var webFingerUrl = $"https://{domain}/.well-known/webfinger?resource={Uri.EscapeDataString(resource)}";
        var proxyResult = await Session.ProxyGetAsync(webFingerUrl, "application/jrd+json");
        if (!proxyResult.Succeeded || proxyResult.Body is not { } body)
        {
            // Any failure (404 not-found, unreachable host, rejection) just means the mention does not
            // resolve — the composer surfaces no error for an unresolvable remote mention.
            return null;
        }

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            var root = doc.RootElement;
            if (!root.TryGetProperty("links", out var links) || links.ValueKind != System.Text.Json.JsonValueKind.Array)
            {
                return null;
            }

            foreach (var link in links.EnumerateArray())
            {
                if (link.TryGetProperty("rel", out var rel)
                    && rel.ValueKind == System.Text.Json.JsonValueKind.String
                    && string.Equals(rel.GetString(), "self", StringComparison.Ordinal)
                    && link.TryGetProperty("type", out var type)
                    && type.ValueKind == System.Text.Json.JsonValueKind.String
                    && (string.Equals(type.GetString(), "application/activity+json", StringComparison.Ordinal)
                        || string.Equals(type.GetString(), "application/ld+json", StringComparison.Ordinal)
                        || string.Equals(type.GetString(), "application/json", StringComparison.Ordinal))
                    && link.TryGetProperty("href", out var href)
                    && href.ValueKind == System.Text.Json.JsonValueKind.String
                    && Iri.TryParse(href.GetString()!, out var iri))
                {
                    return iri;
                }
            }

            return null;
        }
        catch
        {
            return null;
        }
    }

    /// <summary>
    /// Detects <c>#hashtag</c> tokens in the composed text. A hashtag is a <c>#</c> followed by word
    /// characters (alphanumerics + underscores) at the start of the text or after whitespace (so
    /// <c>100%#off</c> or a markdown anchor is not mistaken for one). Returns the <c>#tag</c> names
    /// (including the leading <c>#</c>, the form the ActivityStreams <c>Hashtag</c> tag's <c>name</c>
    /// carries), de-duplicated in first-seen order. Returns an empty list when no hashtags are found.
    /// </summary>
    private static List<string> DetectHashtags(string text)
    {
        var hashtags = new List<string>();
        var matches = System.Text.RegularExpressions.Regex.Matches(text, @"(?<=^|\s)#([a-zA-Z0-9_]+)");
        foreach (System.Text.RegularExpressions.Match match in matches)
        {
            var tag = "#" + match.Groups[1].Value;
            if (!hashtags.Contains(tag, StringComparer.OrdinalIgnoreCase))
            {
                hashtags.Add(tag);
            }
        }

        return hashtags;
    }

    /// <summary>
    /// Builds the combined <c>tag</c> array (mentions first, then hashtags) for an authored note or
    /// article — the single place the client assembles the ActivityStreams <c>mention</c>/<c>hashtag</c>
    /// tags for the inline post paths (reply / community / article), mirroring what
    /// <c>ComposeNote.Build</c> does for the Note path. A hashtag tag is an
    /// ActivityStreams object of type <c>Hashtag</c> whose <c>name</c> is the <c>#tag</c> text and whose
    /// <c>href</c> is this instance's hashtag search URL (so a reader's tap on the hashtag lands on the
    /// instance's hashtag search). Returns null when there are no mentions and no hashtags.
    /// </summary>
    private List<KristofferStrube.ActivityStreams.IObjectOrLink>? BuildTagList(List<Iri>? mentions, List<string> hashtags, Iri actorId)
    {
        var tags = new List<KristofferStrube.ActivityStreams.IObjectOrLink>();

        if (mentions is { Count: > 0 })
        {
            tags.AddRange(mentions.Select(m => (KristofferStrube.ActivityStreams.IObjectOrLink)new KristofferStrube.ActivityStreams.Mention { Href = m.Uri }));
        }

        if (hashtags.Count > 0)
        {
            var baseOrigin = new Uri(actorId.Value).GetLeftPart(System.UriPartial.Authority);
            foreach (var tag in hashtags)
            {
                // A Hashtag tag is a generic ActivityStreams object of type Hashtag (the library has no
                // concrete Hashtag class). The optional href (this instance's hashtag search) goes in
                // ExtensionData because the Object base does not model href as a property — only Link
                // does — exactly the shape IriExtensions.GetHashtagTags reads back.
                var hashtag = new KristofferStrube.ActivityStreams.Object
                {
                    Type = ["Hashtag"],
                    Name = [tag]
                };
                var href = $"{baseOrigin}/search?q={Uri.EscapeDataString(tag)}";
                hashtag.ExtensionData ??= new Dictionary<string, System.Text.Json.JsonElement>();
                hashtag.ExtensionData["href"] = System.Text.Json.JsonSerializer.SerializeToElement(href);
                tags.Add(hashtag);
            }
        }

        return tags.Count > 0 ? tags : null;
    }

    // --- @mention / #hashtag autocomplete popover (54.14) ---
    //
    // A popover that triggers while typing `@` or `#` in the compose box: it queries matching actors
    // (for `@`, via the instance's global search restricted to the Actor type) or offers the typed
    // hashtag (for `#`, which has no directory), and lets the user confirm a choice before it is
    // inserted — reducing mis-mentions and confirming the resolved actor IRI up front.

    private enum AutocompleteMode
    {
        None,
        Mention,
        Hashtag
    }

    private sealed record AutocompleteCandidate(string InsertText, string? Handle, string? Name);

    private sealed class AutocompleteState
    {
        public required bool Visible { get; init; }
        public required AutocompleteMode Mode { get; init; }
        public required IReadOnlyList<AutocompleteCandidate> Candidates { get; init; }
        // The start offset (in the compose text) of the active token (the `@`/`#` and the characters
        // typed after it) — used to replace the token with the confirmed choice on accept.
        public required int TokenStart { get; init; }
        // The text as it was when the popover was opened (the replacement is computed against this so a
        // concurrent keystroke cannot desync the splice).
        public required string SourceText { get; init; }
    }

    private AutocompleteState? Autocomplete { get; set; }
    private CancellationTokenSource? _autocompleteSearchCts;
    private Timer? _autocompleteDebounce;
    private List<AutocompleteCandidate>? _knownActors;

    // The signed-in actor's previously-used hashtags (118.3), surfaced as the compose `#`
    // autocomplete's default list — the topics the user already tags, loaded lazily and cached for the
    // page's lifetime (a compose session), mirroring `_knownActors`.
    private HashSet<string>? _knownHashtags;

    /// <summary>
    /// The textarea's input event handler (118.3): reads the freshly-typed value into <see
    /// cref="Content"/> (replacing the former two-way <c>@bind</c>, whose generated input handler
    /// suppressed the explicit autocomplete trigger — the popover never opened) and then runs the
    /// mention/hashtag token detection.
    /// </summary>
    private void OnContentInputEvent(ChangeEventArgs e)
    {
        Content = e.Value?.ToString() ?? string.Empty;
        OnContentInput();
    }

    /// <summary>
    /// The textarea's input handler: detects an in-progress <c>@handle</c> or <c>#hashtag</c> token at
    /// the end of the text and (debounced) populates the popover with candidates. Hides the popover when
    /// no token is active (the user typed something else, or deleted the token).
    /// </summary>
    private void OnContentInput()
    {
        _autocompleteDebounce?.Dispose();
        var text = Content;
        var (mode, tokenStart, _) = DetectActiveToken(text);

        if (mode is AutocompleteMode.None)
        {
            // No active @/# token at the end (the user typed something else, or deleted the token) —
            // hide the popover.
            HideAutocomplete();
            return;
        }

        // An active token (even an empty one — the user just typed the symbol) populates the popover,
        // debounced so rapid typing fires one search, not one per keystroke.
        _autocompleteDebounce = new Timer(
            async _ => await RunAutocompleteAsync(mode, tokenStart, text),
            null,
            180,
            Timeout.Infinite);
    }

    /// <summary>
    /// Detects the active <c>@</c>/<c>#</c> token at the end of the compose text. Returns the mode
    /// (Mention for <c>@</c>, Hashtag for <c>#</c>, None otherwise), the token's start offset (the
    /// position of the <c>@</c>/<c>#</c>), and the token text typed after the symbol (possibly empty —
    /// the user just typed the symbol). A token is "active" only when it is the last thing in the text
    /// and is at the start or preceded by whitespace (so a trailing period, or an email-ish
    /// <c>a@b</c> mid-word, is not mistaken for a mention).
    /// </summary>
    private static (AutocompleteMode Mode, int Start, string Token) DetectActiveToken(string text)
    {
        if (string.IsNullOrEmpty(text))
        {
            return (AutocompleteMode.None, 0, string.Empty);
        }

        // The active token is a run of word characters (or empty) immediately before the end, preceded
        // by an @ or # that is at the start of the text or after whitespace.
        var match = System.Text.RegularExpressions.Regex.Match(
            text, @"(?<=^|\s)([@#])([a-zA-Z0-9_]*)$");
        if (match is { Success: false })
        {
            return (AutocompleteMode.None, 0, string.Empty);
        }

        var symbol = match.Groups[1].Value;
        var token = match.Groups[2].Value;
        var start = text.Length - symbol.Length - token.Length;
        var mode = symbol == "@" ? AutocompleteMode.Mention : AutocompleteMode.Hashtag;
        return (mode, start, token);
    }

    private async Task RunAutocompleteAsync(AutocompleteMode mode, int tokenStart, string sourceText)
    {
        _autocompleteSearchCts?.Cancel();
        var cts = new CancellationTokenSource();
        _autocompleteSearchCts = cts;

        try
        {
            // The token text is everything from the @/# symbol to the end (symbol + the characters
            // typed); the handle/tag portion is the token minus its leading symbol.
            var fullToken = sourceText[tokenStart..];
            var tokenText = fullToken.Length > 0 ? fullToken[1..] : string.Empty;

            List<AutocompleteCandidate> candidates;
            if (mode is AutocompleteMode.Mention)
            {
                candidates = await GetMentionCandidatesAsync(tokenText, cts.Token);
            }
            else
            {
                candidates = await GetHashtagCandidatesAsync(tokenText, cts.Token);
            }

            if (cts.IsCancellationRequested)
            {
                return;
            }

            Autocomplete = candidates.Count > 0
                ? new AutocompleteState
                {
                    Visible = true,
                    Mode = mode,
                    Candidates = candidates,
                    TokenStart = tokenStart,
                    SourceText = sourceText
                }
                : null;
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer keystroke — ignore.
        }
        catch
        {
            // A search failure should not block composing — just no popover.
        }
    }

    /// <summary>
    /// Resolves mention candidates for the compose <c>@handle</c> autocomplete (71.5): the
    /// signed-in actor's known actors (their follows) as the default list, merged with live
    /// instance-search results as the user types. An empty query (the user just typed <c>@</c>)
    /// returns the follows; a non-empty query filters the follows and supplements with search
    /// results (de-duplicated by handle, known actors first).
    /// </summary>
    private async Task<List<AutocompleteCandidate>> GetMentionCandidatesAsync(string query, CancellationToken ct)
    {
        var list = new List<AutocompleteCandidate>();
        if (Session.ActorId is not { } actorId || Session.Client is not { } client)
        {
            return list;
        }

        if (string.IsNullOrWhiteSpace(query))
        {
            // Empty token: show the signed-in actor's known actors (their follows) as the
            // default list — the accounts the user actually knows.
            _knownActors ??= await LoadKnownActorsAsync(ct);
            list.AddRange(_knownActors);
            return list;
        }

        // Non-empty query: filter the known actors, then supplement with live search results.
        if (_knownActors is null)
        {
            _knownActors = await LoadKnownActorsAsync(ct);
        }

        var lowerQuery = query.ToLowerInvariant();
        var seenHandles = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var candidate in _knownActors)
        {
            if (candidate.Handle is { } h && h.Contains(lowerQuery, StringComparison.OrdinalIgnoreCase))
            {
                list.Add(candidate);
                seenHandles.Add(h);
            }
        }

        // Supplement with live instance-search results not already in the known-actor list.
        try
        {
            var baseUri = new Uri(actorId.Value);
            var path = baseUri.AbsolutePath;
            var uIndex = path.LastIndexOf("/u/", StringComparison.Ordinal);
            var basePath = uIndex >= 0 ? path[..uIndex] : path;
            if (string.IsNullOrEmpty(basePath))
            {
                return list;
            }

            var instanceBase = new Iri(new UriBuilder(baseUri) { Path = basePath }.Uri.GetLeftPart(UriPartial.Path));

            await foreach (var item in client.SearchAsync(
                instanceBase,
                query,
                new SearchOptions { Type = "Actor", Limit = 5 },
                ct))
            {
                if (item is Actor actor && actor.Id is { Length: > 0 } id)
                {
                    var handle = actor.PreferredUsername
                        ?? new Uri(id).AbsolutePath.Trim('/').Split('/').LastOrDefault();
                    if (handle is { Length: > 0 } && seenHandles.Add(handle))
                    {
                        var name = actor.Name?.FirstOrDefault();
                        list.Add(new AutocompleteCandidate("@" + handle, handle, name));
                    }
                }
            }
        }
        catch
        {
            // Non-fatal: the known-actor list is still shown.
        }

        return list;
    }

    /// <summary>
    /// Loads the signed-in actor's known actors (their follows) as autocomplete candidates,
    /// fetching each followed actor's document (name + handle) via the UI context's coalesced
    /// actor cache. Non-actor follows (communities, etc.) are skipped.
    /// </summary>
    private async Task<List<AutocompleteCandidate>> LoadKnownActorsAsync(CancellationToken ct)
    {
        var list = new List<AutocompleteCandidate>();
        if (Session.ActorId is not { } actorId)
        {
            return list;
        }

        var followingIris = await Ui.GetFollowingActorIrisAsync();
        foreach (var iri in followingIris)
        {
            if (ct.IsCancellationRequested)
            {
                break;
            }

            var doc = await Ui.GetActorAsync(iri);
            if (doc is Actor actor && actor.Id is { Length: > 0 } id)
            {
                var handle = actor.PreferredUsername
                    ?? new Uri(id).AbsolutePath.Trim('/').Split('/').LastOrDefault();
                if (handle is { Length: > 0 })
                {
                    var name = actor.Name?.FirstOrDefault();
                    list.Add(new AutocompleteCandidate("@" + handle, handle, name));
                }
            }
        }

        return list;
    }

    /// <summary>
    /// Resolves hashtag candidates for the compose <c>#hashtag</c> autocomplete (118.3): the signed-in
    /// actor's previously-used hashtags as the default list, filtered by the typed token. An empty token
    /// (the user just typed <c>#</c>) returns the known hashtags; a non-empty token filters them. When
    /// the typed token matches no known hashtag, the typed <c>#tag</c> itself is offered as the sole
    /// candidate (so a brand-new tag can still be confirmed and inserted as a canonical token).
    /// </summary>
    private async Task<List<AutocompleteCandidate>> GetHashtagCandidatesAsync(string query, CancellationToken ct)
    {
        if (_knownHashtags is null)
        {
            _knownHashtags = await LoadKnownHashtagsAsync(ct);
        }

        var list = new List<AutocompleteCandidate>();
        var lowerQuery = query.TrimStart('#').ToLowerInvariant();

        foreach (var tag in _knownHashtags)
        {
            if (lowerQuery.Length is 0 || tag.Contains(lowerQuery, StringComparison.OrdinalIgnoreCase))
            {
                list.Add(new AutocompleteCandidate("#" + tag, null, null));
            }
        }

        // The typed token (canonical #tag) is always confirmable — even when it matches no known hashtag.
        if (lowerQuery.Length > 0)
        {
            var typed = "#" + lowerQuery;
            if (!list.Any(c => c.InsertText.Equals(typed, StringComparison.OrdinalIgnoreCase)))
            {
                list.Add(new AutocompleteCandidate(typed, null, null));
            }
        }

        return list;
    }

    /// <summary>
    /// Loads the signed-in actor's previously-used hashtags (118.3): the <c>tag</c> array of the most
    /// recent of the actor's own outbox objects (a bounded read — the first outbox page, up to
    /// <see cref="HashtagSourceLimit"/> items), de-duplicated by tag name. Non-fatal on failure — an
    /// empty set simply means the <c>#</c> autocomplete falls back to offering the typed token only.
    /// </summary>
    private async Task<HashSet<string>> LoadKnownHashtagsAsync(CancellationToken ct)
    {
        var tags = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (Session.ActorId is not { } actorId || Session.Client is not { } client)
        {
            return tags;
        }

        try
        {
            await foreach (var item in client.GetCollectionItemsAsync(
                                   actorId.OutboxOf(),
                                   new CollectionQuery(Limit: HashtagSourceLimit),
                                   ct))
            {
                if (ct.IsCancellationRequested)
                {
                    break;
                }

                // An outbox item is a Create/Update activity wrapping the authored object (or, less
                // commonly, the object itself). Read hashtags from whichever is the authored object.
                var authored = item is Activity { Object: { } objs }
                    ? objs.FirstOrDefault()
                    : item;
                if (authored is IObject obj)
                {
                    foreach (var (name, _) in obj.GetHashtagTags())
                    {
                        // Normalize: strip any leading '#', drop whitespace, keep it non-empty.
                        var clean = name.TrimStart('#').Trim();
                        if (clean.Length > 0)
                        {
                            tags.Add(clean);
                        }
                    }
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer keystroke — ignore.
        }
        catch
        {
            // Non-fatal: no known hashtags simply means the typed token is the only candidate.
        }

        return tags;
    }

    /// <summary>
    /// Accepts a popover candidate: splices the confirmed choice into the compose text in place of the
    /// active token (the <c>@</c>/<c>#</c> + the characters typed), appending a trailing space for
    /// mentions (so the next word is separate) and closing the popover.
    /// </summary>
    private void AcceptAutocomplete(AutocompleteCandidate candidate)
    {
        if (Autocomplete is not { } ac)
        {
            return;
        }

        var before = ac.SourceText[..ac.TokenStart];
        var insert = candidate.InsertText + (ac.Mode is AutocompleteMode.Mention ? " " : string.Empty);
        Content = before + insert;
        HideAutocomplete();
        StateHasChanged();
    }

    private void HideAutocomplete()
    {
        if (Autocomplete is not null)
        {
            Autocomplete = null;
            StateHasChanged();
        }
    }

    private string? ReplyToHref
    {
        get
        {
            if (ReplyToIri is not { } iri)
            {
                return null;
            }

            return $"/object?iri={Uri.EscapeDataString(iri.Value)}";
        }
    }

    private string PageTitle
    {
        get
        {
            if (ReplyToIri is not null)
            {
                return "Reply";
            }

            if (CommunityIri is not null && CommunityName is { Length: > 0 } name)
            {
                return $"Post to {name}";
            }

            return "Compose";
        }
    }

    /// <summary>
    /// The note text the user is composing. Cleared on a successful post.
    /// </summary>
    private string Content { get; set; } = string.Empty;

    /// <summary>
    /// The content type for new posts (Note or Article). Ignored for replies.
    /// </summary>
    private string ContentType { get; set; } = "Note";

    /// <summary>
    /// Whether the composed note is flagged content-sensitive (the ActivityStreams <c>sensitive</c> term).
    /// The feed renders such notes behind a notice + reveal toggle. Applies to Note posts only (the
    /// Article/reply/community paths don't set it).
    /// </summary>
    private bool IsSensitive { get; set; }

    /// <summary>
    /// The sensitivity summary (the ActivityStreams <c>summary</c> term) — the short warning text the feed
    /// shows in place of the note's content until the viewer reveals it. Read only when
    /// <see cref="IsSensitive"/> is set.
    /// </summary>
    private string SensitiveSummary { get; set; } = string.Empty;

    /// <summary>
    /// The chosen audience / visibility for new posts (73.3) — <c>"public"</c> (the public timeline),
    /// <c>"followers"</c> (the actor's followers only), or <c>"direct"</c> (the actor's followers + the
    /// mentioned actors, a private message). Ignored for replies (which stay public) and community posts
    /// (whose audience is the community's own, set by the community path).
    /// </summary>
    private string Visibility { get; set; } = "public";

