    /// <summary>
    /// The compose visibility hint (S15): reflects the selected content type and visibility level so
    /// the user is not told a Direct message is "addressed to the public."
    /// </summary>
    private string ComposeHint
    {
        get
        {
            var type = ContentType switch
            {
                "Poll" => "A poll",
                "Article" => "An article",
                _ => "A note",
            };

            return Visibility switch
            {
                "followers" => $"{type} visible to followers only — it lands in your outbox and appears in your followers' timelines.",
                "direct" => $"{type} sent as a direct message — not visible in public or follower timelines.",
                _ => $"{type} addressed to the public — it lands in your outbox and appears in your followers' timelines.",
            };
        }
    }

    /// <summary>
    /// The cap on the number of the actor's recent outbox objects scanned to build the <c>#</c>
    /// autocomplete's known-hashtag list (118.3). A bounded read — the most recent posts carry the
    /// hashtags a user is likely to re-use, and it keeps the first outbox-page fetch small.
    /// </summary>
    private const int HashtagSourceLimit = 40;

    // --- Poll authoring (73.1) ---

    /// <summary>
    /// The poll's question text (the <c>Question</c> object's <c>content</c>). When empty at post time
    /// the compose body is used as the question.
    /// </summary>
    private string PollQuestion { get; set; } = string.Empty;

    /// <summary>
    /// The poll options (the choice texts). Always at least two (a poll requires two or more choices);
    /// at most four (Mastodon's limit).
    /// </summary>
    private List<string> PollOptions { get; set; } = ["", ""];

    /// <summary>
    /// The poll's duration in minutes (the <c>endTime</c> is now + this). Defaults to one day.
    /// </summary>
    private int PollDurationMinutes { get; set; } = 1440;

    /// <summary>
    /// Whether the poll allows multiple choices (the <c>multiple</c> term).
    /// </summary>
    private bool PollMultiple { get; set; }

    /// <summary>
    /// A poll-specific validation message (e.g. "At least two options are required."), when present.
    /// </summary>
    private string? PollError { get; set; }

    /// <summary>
    /// Adds a poll option (up to four). A no-op when at the limit.
    /// </summary>
    private void AddPollOption()
    {
        if (PollOptions.Count < 4)
        {
            PollOptions.Add(string.Empty);
        }
    }

    /// <summary>
    /// Removes a poll option at <paramref name="index"/> (down to a minimum of two).
    /// </summary>
    private void RemovePollOption(int index)
    {
        if (index >= 0 && index < PollOptions.Count && PollOptions.Count > 2)
        {
            PollOptions.RemoveAt(index);
        }
    }

    /// <summary>
    /// Validates the poll inputs and returns the non-empty option texts (trimmed), or null when the
    /// poll is invalid (in which case <see cref="PollError"/> is set). A poll requires at least two
    /// non-empty, non-duplicate options.
    /// </summary>
    private List<string>? GetValidPollOptions()
    {
        PollError = null;
        var options = PollOptions
            .Where(o => !string.IsNullOrWhiteSpace(o))
            .Select(o => o.Trim())
            .ToList();
        if (options.Count < 2)
        {
            PollError = "A poll requires at least two options.";
            return null;
        }

        var distinct = options.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        if (distinct.Count < 2)
        {
            PollError = "Poll options must be distinct.";
            return null;
        }

        return distinct;
    }

    /// <summary>
    /// The chosen media attachments (browser <see cref="IBrowserFile"/>s, read lazily at post time), held
    /// until the post uploads them. Empty when nothing is selected. Applies to Note and Article posts
    /// only (replies carry no attachment). Multiple files of mixed types (image / video / audio /
    /// PDF) are supported (73.2).
    /// </summary>
    private List<IBrowserFile> Attachments { get; set; } = [];

    /// <summary>
    /// The per-attachment alternative text (the accessibility <c>alt</c> for images), held parallel to
    /// <see cref="Attachments"/> by index. Only image attachments expose an input; non-image entries stay
    /// null/empty. Cleared in lockstep with <see cref="Attachments"/> on add, remove, and post.
    /// </summary>
    private List<string> AttachmentAltText { get; set; } = [];

    /// <summary>
    /// The maximum attachment size accepted per file (10 MiB — matches the server's upload cap); an
    /// oversized file is rejected by the server with <c>413</c>.
    /// </summary>
    private const long MaxAttachmentBytes = 10 * 1024 * 1024;

    /// <summary>
    /// The hard cap on the number of attachments per post (guards against an unbounded upload fan-out on
    /// post). Files beyond the cap are ignored when chosen.
    /// </summary>
    private const int MaxAttachments = 4;

    /// <summary>
    /// Records the chosen attachments (a batch of browser <see cref="IBrowserFile"/>s from the
    /// <c>multiple</c> file input, read lazily at post time), appending them to the existing selection up
    /// to <see cref="MaxAttachments"/>. The full selection is read via the change event args'
    /// <c>GetMultipleFiles</c> (the event also exposes a single <c>File</c> for the common one-file case).
    /// A no-op when nothing is chosen.
    /// </summary>
    private void OnAttachmentsChosen(InputFileChangeEventArgs e)
    {
        if (e.FileCount == 0)
        {
            return;
        }

        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = e.GetMultipleFiles(e.FileCount);
        }
        catch
        {
            return;
        }

        foreach (var file in files)
        {
            if (file is null || Attachments.Count >= MaxAttachments)
            {
                continue;
            }

            if (Attachments.Any(a => a.Name == file.Name && a.Size == file.Size))
            {
                continue;
            }

            Attachments.Add(file);
            AttachmentAltText.Add(string.Empty);
        }
    }

    /// <summary>
    /// Removes the attachment at <paramref name="index"/> (the "✕" affordance next to the file name).
    /// </summary>
    private void RemoveAttachment(int index)
    {
        if (index >= 0 && index < Attachments.Count)
        {
            Attachments.RemoveAt(index);
            if (index < AttachmentAltText.Count)
            {
                AttachmentAltText.RemoveAt(index);
            }
        }
    }

    /// <summary>
    /// Whether the attachment at <paramref name="index"/> is an image (its <c>type</c> starts with
    /// <c>image/</c>) — only images expose an alt-text input (alt text is an image-accessibility
    /// convention; video/audio/document carry no alt).
    /// </summary>
    private bool IsImageAttachment(int index)
        => index >= 0 && index < Attachments.Count
           && Attachments[index].ContentType is { Length: > 0 } t
           && t.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Records the alt text typed for the attachment at <paramref name="index"/> (the accessibility
    /// <c>alt</c> serialized onto the image attachment at post time).
    /// </summary>
    private void OnAltTextInput(int index, Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (index < 0 || index >= AttachmentAltText.Count)
        {
            return;
        }

        AttachmentAltText[index] = e.Value?.ToString() ?? string.Empty;
    }

    /// <summary>
    /// Whether a post is in flight — disables the button and shows the "Posting…" state.
    /// </summary>
    private bool Busy { get; set; }

    /// <summary>
    /// Whether the last post succeeded — when true the "View your posts" link is shown (a quick path
    /// to the profile's outbox, where the just-posted note now lives).
    /// </summary>
    private bool Posted { get; set; }

    /// <summary>
    /// The IRI the server minted for the posted <c>Create</c> (from <see cref="DeliveryResult.MintedId"/>),
    /// shown after a successful post so the user can see what was created.
    /// </summary>
    private string? PostedIri { get; set; }

    /// <summary>
    /// A human-readable status line for the last post (e.g. the HTTP status), when present.
    /// </summary>
    private string? Result { get; set; }

    /// <summary>
    /// The error message from the last post, when present.
    /// </summary>
    private string? Error { get; set; }

    /// <summary>
    /// The signed-in actor's handle (e.g. "pwtest2"), derived from the last segment of the actor IRI.
    /// </summary>
    private string ActorHandle
    {
        get
        {
            if (Session.ActorId is not { } actorId)
            {
                return "…";
            }

            var uri = new Uri(actorId.Value);
            var segments = uri.AbsolutePath.TrimEnd('/').Split('/');
            return segments.Length > 0 ? segments[^1] : actorId.Value;
        }
    }

    /// <summary>
    /// The ActivityStreams public collection address (the conventional <c>to</c> for public notes) —
    /// a note addressed to the public is delivered to the actor's followers' timelines (F-14).
    /// </summary>
    private static readonly Iri AsPublic = new("https://www.w3.org/ns/activitystreams#Public");

    /// <summary>
    /// Posts the composed note (or reply, when <see cref="ReplyToIri"/> is set) as the signed-in actor.
    /// The write goes through the session's <see cref="IActivityPubClient"/> — the one sanctioned path
    /// from the UI into ActivityPub state.
    /// </summary>
    private async Task PostAsync()
    {
        // S11a: a poll's question lives in PollQuestion (or falls back to Content), so the
        // empty-Content guard must not silently discard a valid body-less poll.
        var isPoll = ContentType == "Poll";
        var hasContent = string.IsNullOrWhiteSpace(Content)
            ? (isPoll && !string.IsNullOrWhiteSpace(PollQuestion))
            : true;

        if (Session.ActorId is not { } actorId
            || Session.Client is not { } client
            || !hasContent
            || Busy)
        {
            return;
        }

        Busy = true;
        Posted = false;
        PostedIri = null;
        Result = null;
        Error = null;
        try
        {
            // Upload the chosen attachments first (local, cookie-authenticated multipart POSTs — not
            // signed inbox deliveries) to get the same-origin media IRIs, so the post can carry a media
            // attachment per file whose url is that IRI (the browser loads each same-origin, never a
            // cross-origin media host — Decision 056 (b)). Replies and community posts carry no
            // attachment. An upload that fails (null result) is skipped — the remaining files still
            // attach (a single flaky upload does not drop the whole post's media).
            var media = new List<MediaAttachment>();
            for (var i = 0; i < Attachments.Count; i++)
            {
                var file = Attachments[i];
                if (file.Size <= 0)
                {
                    continue;
                }

                var uploaded = await UploadAttachmentAsync(actorId, file);
                if (uploaded is not null)
                {
                    var altText = i < AttachmentAltText.Count ? AttachmentAltText[i] : null;
                    media.Add(new MediaAttachment(uploaded.MediaIri, uploaded.ContentType, uploaded.FileName, altText));
                }
            }

            var rawContent = Content.Trim();
            var mentionPairs = await DetectMentionsWithDisplayAsync(rawContent, actorId);
            var mentions = mentionPairs.Select(m => m.Iri).ToList();
            var hashtags = DetectHashtags(rawContent);
            var mentionArg = mentions.Count > 0 ? mentions : null;
            var hashtagArg = hashtags.Count > 0 ? hashtags : null;
            // A hashtag tag's href points at this instance's hashtag timeline (the relative /tag/{name}
            // Blazor route), so a reader's tap on the hashtag lands on the dedicated page that lists this
            // instance's posts carrying that tag. The name keeps its leading '#' (the route param
            // normalizes it back), and is URI-escaped so a tag with unusual characters round-trips cleanly.
            Func<string, string?> hashtagHref = name => $"/tag/{Uri.EscapeDataString(name)}";

            // 73.3: the audience the chosen visibility maps to (public / followers / direct). Replies and
            // community posts ignore this (a reply stays public; a community post's audience is the
            // community's own, set by the community path below).
            var audience = BuildAudience(actorId, mentionArg);

            // 156: the note's body HTML with @mention / #hashtag tokens wrapped in links (the
            // Mastodon/Pleroma convention — the content carries <a class="mention">/<a class="hashtag">
            // alongside the structured `tag` array). The raw text is rendered through Markdown (so any
            // Markdown the author typed is formatted) and then linkified; the result starts with a block
            // tag, so the object view renders it verbatim (as live links) rather than re-escaping it.
            // When there are no mentions/hashtags the text is left raw (the prior behavior — rendered as
            // Markdown on display).
            var linkifyMentions = mentionPairs
                .Select(m => new MentionLinkify.Mention(m.Display, m.Iri))
                .ToList();
            var linkifyHashtags = hashtags
                .Select(h => new MentionLinkify.Hashtag(h, hashtagHref(h) ?? string.Empty))
                .Where(h => !string.IsNullOrEmpty(h.Href))
                .ToList();
            var bodyHtml = BuildLinkedBody(rawContent, linkifyMentions, linkifyHashtags);

            DeliveryResult result;
            if (ReplyToIri is { } parent)
            {
                result = await client.PostReplyAsync(actorId, parent, bodyHtml, mentions: mentionArg, to: [AsPublic], hashtags: hashtagArg);
            }
            else if (CommunityIri is { } community)
            {
                result = await PostToCommunityAsync(client, actorId, community, media, mentionArg, hashtagArg, IsSensitive, SensitiveSummary, ContentType, hashtagHref);
            }
            else if (ContentType == "Poll")
            {
                result = await PostPollAsync(client, actorId, mentionArg, hashtagArg, hashtagHref, audience);
            }
            else if (ContentType == "Article")
            {
                result = await PostArticleAsync(client, actorId, media, mentionArg, hashtagArg, audience);
            }
            else
            {
                var note = ComposeNote.Build(
                    actorId,
                    bodyHtml,
                    sensitive: IsSensitive,
                    summary: SensitiveSummary,
                    to: audience.To,
                    cc: audience.Cc,
                    media: media.Count > 0 ? media : null,
                    mentions: mentionArg,
                    hashtags: hashtagArg,
                    hashtagHrefFactory: hashtagHref,
                    language: Language);
                result = await client.PostNoteAsync(actorId, note);
            }

            if (result.IsSuccess)
            {
                Posted = true;
                Result = $"Posted (HTTP {result.StatusCode}).";
                PostedIri = result.MintedId;
                Content = string.Empty;
                IsSensitive = false;
                SensitiveSummary = string.Empty;
                Language = string.Empty;
                Attachments = [];
                AttachmentAltText = [];
                PollQuestion = string.Empty;
                PollOptions = ["", ""];
                PollDurationMinutes = 1440;
                PollMultiple = false;
                PollError = null;
            }
            else
            {
                Result = $"Post failed (HTTP {result.StatusCode}).";
            }
        }
        catch (Exception)
        {
            Error = "Your post couldn't be sent right now. Please check your connection and try again.";
        }
        finally
        {
            Busy = false;
        }
    }

    /// <summary>
    /// Builds the authored note's body HTML with @mention / #hashtag tokens wrapped in links (156). The
    /// raw text is first rendered through <see cref="Markdown.ToHtml"/> (so any Markdown the author typed
    /// is formatted — headings, lists, bold, links), then the resolved mention and hashtag tokens are
    /// wrapped in <c>&lt;a class="mention"&gt;</c> / <c>&lt;a class="hashtag"&gt;</c> links by
    /// <see cref="MentionLinkify.Linkify"/>. When there are no mentions and no hashtags the raw text is
    /// returned unchanged (the prior behavior — the object view renders it as Markdown on display), so a
    /// plain post's stored content is untouched.
    /// </summary>
    private static string BuildLinkedBody(string rawContent, IReadOnlyList<MentionLinkify.Mention> mentions, IReadOnlyList<MentionLinkify.Hashtag> hashtags)
    {
        if (mentions.Count == 0 && hashtags.Count == 0)
        {
            return rawContent;
        }

        var html = Markdown.ToHtml(rawContent);
        return MentionLinkify.Linkify(html, mentions, hashtags);
    }

    /// <summary>
    /// Sets the chosen <see cref="Language"/> tag as the object's ActivityStreams <c>inLanguage</c> term
    /// (written to <c>ExtensionData</c> — Rule 6, the same representation <see cref="IriExtensions.GetInLanguage"/>
    /// reads back so the post card + feed can surface it). A no-op when no language is chosen (the post
    /// stays untagged, matching the "Auto" default).
    /// </summary>
    private void SetInLanguage(KristofferStrube.ActivityStreams.IObject obj)
    {
        if (obj is null || string.IsNullOrWhiteSpace(Language))
        {
            return;
        }

        obj.ExtensionData ??= new Dictionary<string, System.Text.Json.JsonElement>();
        obj.ExtensionData["inLanguage"] = System.Text.Json.JsonSerializer.SerializeToElement(Language.Trim());
    }

    /// <summary>
    /// The audience (73.3) a chosen visibility maps to: the note's <c>to</c> link(s) and its <c>cc</c>
    /// link(s). The remote-visibility convention (ActivityPub §5.1.2, Mastodon's public-in-cc test):
    /// public posts put the public address in <c>cc</c> (so they appear on the public timeline),
    /// followers-only posts put only the author's followers in <c>cc</c> (no public), and direct posts
    /// put the author's followers + the mentioned actors in <c>to</c> (a private message, no public).
    /// </summary>
    private sealed record PostAudience(IReadOnlyList<Iri> To, IReadOnlyList<Iri> Cc)
    {
        /// <summary>
        /// The <c>to</c> links for the note (empty for public / followers posts; the mentioned actors for
        /// direct posts).
        /// </summary>
        public IReadOnlyList<Link> ToLinks => To.Select(i => (Link)new Link { Href = i.Uri }).ToList();

        /// <summary>
        /// The <c>cc</c> links for the note (public → the public address; followers → the author's
        /// followers; direct → the author's followers; empty is never produced).
        /// </summary>
        public IReadOnlyList<Link> CcLinks => Cc.Select(i => (Link)new Link { Href = i.Uri }).ToList();
    }

    /// <summary>
    /// Maps the chosen <see cref="Visibility"/> (73.3) to its <see cref="PostAudience"/>. Public:
    /// <c>to</c> = public, <c>cc</c> = the author's followers. Followers: <c>to</c> = the author's
    /// followers, <c>cc</c> = the author's followers (the public is NOT cc'd, so the post is not public).
    /// Direct: <c>to</c> = the mentioned actors (the named recipients), <c>cc</c> = the author's
    /// followers. A blank/unknown visibility falls back to public (the historical behavior).
    /// </summary>
    private PostAudience BuildAudience(Iri actorId, List<Iri>? mentions)
    {
        var followers = actorId.FollowersOf();
        return Visibility switch
        {
            "followers" => new PostAudience([followers], [followers]),
            "direct" => new PostAudience(
                mentions is { Count: > 0 } ? mentions : [],
                [followers]),
            _ => new PostAudience([AsPublic], [followers]),
        };
    }

    /// <summary>
    /// Posts content to a community. For a <em>local</em> community (same host as the actor) the post is
    /// a <c>Note</c> published to the author's own outbox (the standard path); the receiving server's
    /// <c>Create</c> handler records it in the community's members' outboxes. For a <em>remote</em>
    /// community (a different host — e.g. a Lemmy community) the post is a Lemmy-compatible
    /// <c>Page</c> delivered directly to the community's inbox: a remote server only sees content it is
    /// addressed to, so it would never observe an activity delivered to the author's own outbox. The
    /// post's <c>attributedTo</c> carries both the author and the community in either case.
    /// </summary>
    private async Task<DeliveryResult> PostToCommunityAsync(IActivityPubClient client, Iri actorId, Iri communityIri, List<MediaAttachment> media, List<Iri>? mentions = null, List<string>? hashtags = null, bool sensitive = false, string? summary = null, string contentType = "Note", Func<string, string?>? hashtagHrefFactory = null)
    {
        return IsRemoteCommunity
            ? await PostToRemoteCommunityAsync(client, actorId, communityIri, media, mentions, hashtags, sensitive, summary, contentType)
            : await PostToLocalCommunityAsync(client, actorId, communityIri, media, mentions, hashtags, sensitive, summary, contentType, hashtagHrefFactory);
    }

    /// <summary>
    /// Posts to a <em>remote</em> (different-host) community as a Lemmy-compatible <c>Page</c>, published
    /// to the <em>author's own outbox</em> (the standard post path — the server's outbox-publish handler
    /// detects the remote community in the <c>to</c> audience and cross-posts it server-side, transforming
    /// a Note to a Page for Lemmy per 138.11). The object is addressed <c>to</c> the community + the
    /// public and <c>cc</c>'d to the community's followers collection (the Lemmy cross-check order),
    /// carries <c>content</c> as Markdown-rendered HTML plus a <c>source</c> of the original Markdown,
    /// and is <c>attributedTo</c> both the author and the community.
    /// </summary>
    /// <remarks>
    /// 139.1 F-5 — this used to deliver <em>directly</em> to the remote community's inbox
    /// (<c>communityIri.InboxOf()</c>), a cross-origin fetch the browser's CSP (<c>connect-src 'self'</c>)
    /// blocks, so posting to a remote community from the Web UI failed. Publishing to the author's own
    /// outbox instead keeps all posts on the same-origin path; the server (not bound by the browser's
    /// CSP) performs the cross-instance cross-post delivery.
    /// </remarks>
    private async Task<DeliveryResult> PostToRemoteCommunityAsync(IActivityPubClient client, Iri actorId, Iri communityIri, List<MediaAttachment> media, List<Iri>? mentions, List<string>? hashtags, bool sensitive, string? summary, string contentType = "Note")
    {
        var content = Content.Trim();
        var html = Markdown.ToHtml(content);
        var followersIri = communityIri.FollowersOf();

        var page = new KristofferStrube.ActivityStreams.Page
        {
            AttributedTo =
            [
                new Link { Href = new Uri(actorId.Value) },
                new Link { Href = new Uri(communityIri.Value) }
            ],
            To =
            [
                new Link { Href = new Uri(communityIri.Value) },
                new Link { Href = new Uri(AsPublic.Value) }
            ],
            Content = [string.IsNullOrEmpty(html) ? content : html],
            Published = DateTime.UtcNow
        };

        // Lemmy reads the Markdown source from the object's `source` field (the library does not model
        // it, so it is written into ExtensionData — Rule 6) so a remote client can re-render it.
        page.ExtensionData ??= new Dictionary<string, System.Text.Json.JsonElement>();
        page.ExtensionData["cc"] = System.Text.Json.JsonSerializer.SerializeToElement(new List<string> { followersIri.Value });
        page.ExtensionData["source"] = System.Text.Json.JsonSerializer.SerializeToElement(new
        {
            content,
            mediaType = "text/markdown"
        });

        if (sensitive)
        {
            page.ExtensionData["sensitive"] = System.Text.Json.JsonSerializer.SerializeToElement(true);
            if (summary is { Length: > 0 } s)
            {
                page.Summary = [s];
            }
        }

        SetInLanguage(page);

        if (media.Count > 0)
        {
            page.Attachment = BuildCommunityAttachments(media);
        }

        var tags = BuildCommunityTags(mentions, hashtags ?? [], actorId);
        if (tags is { Count: > 0 })
        {
            page.Tag = tags;
        }

        var create = new Create
        {
            Id = $"{actorId.Value.TrimEnd('/')}/creates/{Guid.NewGuid():N}",
            Actor = [new Link { Href = new Uri(actorId.Value) }],
            Object = [page],
            To =
            [
                new Link { Href = new Uri(communityIri.Value) },
                new Link { Href = new Uri(AsPublic.Value) }
            ]
        };

        // 139.1 F-5 — publish to the author's own outbox (same-origin), not the remote community's
        // inbox (a cross-origin fetch the browser's CSP blocks). The server's outbox-publish handler
        // reads the remote community from the `to` audience and cross-posts it server-side (138.11).
        return await client.DeliverAsync(actorId.OutboxOf(), create);
    }

    /// <summary>
    /// Posts to a <em>local</em> (same-host) community as a <c>Note</c> published to the author's own
    /// outbox (the standard community-post path; the server's <c>Create</c> handler routes it into the
    /// community's members' outboxes).
    /// </summary>
    private async Task<DeliveryResult> PostToLocalCommunityAsync(IActivityPubClient client, Iri actorId, Iri communityIri, List<MediaAttachment> media, List<Iri>? mentions, List<string>? hashtags, bool sensitive, string? summary, string contentType = "Note", Func<string, string?>? hashtagHrefFactory = null)
    {
        var followersIri = communityIri.FollowersOf();
        var attributedTo = new List<KristofferStrube.ActivityStreams.IObjectOrLink>
        {
            new Link { Href = new Uri(actorId.Value) },
            new Link { Href = new Uri(communityIri.Value) }
        };
        var to = new List<KristofferStrube.ActivityStreams.IObjectOrLink>
        {
            new Link { Href = new Uri(followersIri.Value) },
            new Link { Href = new Uri(AsPublic.Value) }
        };

        if (contentType == "Poll")
        {
            var options = GetValidPollOptions();
            if (options is null)
            {
                return new DeliveryResult((int)HttpStatusCode.BadRequest, false, string.Empty);
            }

            var question = string.IsNullOrWhiteSpace(PollQuestion) ? Content.Trim() : PollQuestion.Trim();
            var pollMentions = await DetectMentionsAsync(question, actorId);
            var pollHashtags = DetectHashtags(question);
            var endsAt = DateTime.UtcNow.AddMinutes(PollDurationMinutes);

            return await client.PostQuestionAsync(
                actorId,
                question,
                options,
                endsAt: endsAt,
                multiple: PollMultiple,
                to: to.Where(l => l is KristofferStrube.ActivityStreams.Link).Select(l => new Iri(((KristofferStrube.ActivityStreams.Link)l).Href?.AbsoluteUri ?? string.Empty)).ToList(),
                cc: null,
                mentions: pollMentions.Count > 0 ? pollMentions : null,
                hashtags: pollHashtags.Count > 0 ? pollHashtags : null,
                hashtagHrefFactory: hashtagHrefFactory);
        }
        else if (contentType == "Article")
        {
            var article = new Article
            {
                AttributedTo = attributedTo,
                To = to,
                Content = [Content.Trim()],
                Published = DateTime.UtcNow
            };

            if (sensitive)
            {
                article.ExtensionData ??= new Dictionary<string, System.Text.Json.JsonElement>();
                article.ExtensionData["sensitive"] = System.Text.Json.JsonSerializer.SerializeToElement(true);
                if (summary is { Length: > 0 } s)
                {
                    article.Summary = [s];
                }
            }

            SetInLanguage(article);

            if (media.Count > 0)
            {
                article.Attachment = BuildCommunityAttachments(media);
            }

            var tags = BuildCommunityTags(mentions, hashtags ?? [], actorId);
            if (tags is { Count: > 0 })
            {
                article.Tag = tags;
            }

            var create = new Create
            {
                Id = $"{actorId.Value.TrimEnd('/')}/creates/{Guid.NewGuid():N}",
                Actor = [new Link { Href = new Uri(actorId.Value) }],
                Object = [article],
                To = to
            };

            return await client.DeliverAsync(actorId.OutboxOf(), create);
        }
        else
        {
            var note = new KristofferStrube.ActivityStreams.Note
            {
                AttributedTo = attributedTo,
                To = to,
                Content = [Content.Trim()],
                Published = DateTime.UtcNow
            };

            if (sensitive)
            {
                note.ExtensionData ??= new Dictionary<string, System.Text.Json.JsonElement>();
                note.ExtensionData["sensitive"] = System.Text.Json.JsonSerializer.SerializeToElement(true);
                if (summary is { Length: > 0 } s)
                {
                    note.Summary = [s];
                }
            }

            SetInLanguage(note);

            if (media.Count > 0)
            {
                note.Attachment = BuildCommunityAttachments(media);
            }

            var tags = BuildCommunityTags(mentions, hashtags ?? [], actorId);
            if (tags is { Count: > 0 })
            {
                note.Tag = tags;
            }

            return await client.PostNoteAsync(actorId, note);
        }
    }

    /// <summary>
    /// Builds the attachment list (Image for <c>image/*</c>, Document otherwise) shared by the local
    /// (<c>Note</c>) and remote (<c>Page</c>) community-post paths.
    /// </summary>
    private static List<KristofferStrube.ActivityStreams.IObjectOrLink> BuildCommunityAttachments(List<MediaAttachment> media)
    {
        var attachments = new List<KristofferStrube.ActivityStreams.IObjectOrLink>();
        foreach (var m in media)
        {
            var isImage = string.Equals(m.ContentType, "image", StringComparison.Ordinal)
                || m.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
            if (isImage)
            {
                var image = new Image
                {
                    Url = [new Link { Href = m.MediaIri.Uri }],
                    Id = m.MediaIri.Value,
                    MediaType = m.ContentType,
                };
                if (m.FileName is { Length: > 0 } && !string.IsNullOrWhiteSpace(m.FileName))
                {
                    image.Name = [m.FileName];
                }
                if (m.AltText is { Length: > 0 } && !string.IsNullOrWhiteSpace(m.AltText))
                {
                    image.ExtensionData ??= new Dictionary<string, System.Text.Json.JsonElement>();
                    image.ExtensionData["alt"] = System.Text.Json.JsonSerializer.SerializeToElement(m.AltText);
                }
                attachments.Add(image);
            }
            else
            {
                var document = new Document
                {
                    Url = [new Link { Href = m.MediaIri.Uri }],
                    MediaType = m.ContentType,
                };
                if (m.FileName is { Length: > 0 } && !string.IsNullOrWhiteSpace(m.FileName))
                {
                    document.Name = [m.FileName];
                }
                attachments.Add(document);
            }
        }

        return attachments;
    }

    /// <summary>
    /// Builds the mention/hashtag <c>tag</c> list shared by the local (<c>Note</c>) and remote
    /// (<c>Page</c>) community-post paths (mirrors <see cref="BuildTagList"/>).
    /// </summary>
    private List<KristofferStrube.ActivityStreams.IObjectOrLink>? BuildCommunityTags(List<Iri>? mentions, List<string> hashtags, Iri actorId)
        => BuildTagList(mentions, hashtags, actorId);

    private async Task<DeliveryResult> PostArticleAsync(IActivityPubClient client, Iri actorId, List<MediaAttachment> media, List<Iri>? mentions = null, List<string>? hashtags = null, PostAudience? audience = null)
    {
        var article = new Article
        {
            AttributedTo = [new Link { Href = new Uri(actorId.Value) }],
            To = audience?.ToLinks ?? [new Link { Href = new Uri(AsPublic.Value) }],
            Content = [Content.Trim()],
            Published = DateTime.UtcNow
        };

        if (audience is { CcLinks.Count: > 0 })
        {
            article.ExtensionData ??= new Dictionary<string, System.Text.Json.JsonElement>();
            article.ExtensionData["cc"] = System.Text.Json.JsonSerializer.SerializeToElement(audience.CcLinks.Select(l => l.Href?.AbsoluteUri ?? string.Empty).ToList());
        }

        SetInLanguage(article);

        if (media.Count > 0)
        {
            // One attachment per uploaded file (73.2 — multiple, mixed media): the url is the
            // same-origin media IRI (its id mirrors it for images, so a reader can resolve the media
            // without the url); mediaType + name come from the upload. An image/* upload is an Image
            // (media-gallery render); anything else is a Document (rich-attachment render).
            var attachments = new List<KristofferStrube.ActivityStreams.IObjectOrLink>();
            foreach (var m in media)
            {
                var isImage = string.Equals(m.ContentType, "image", StringComparison.Ordinal)
                    || m.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

                KristofferStrube.ActivityStreams.IObjectOrLink attachment;
                if (isImage)
                {
                    var image = new Image
                    {
                        Url = [new Link { Href = m.MediaIri.Uri }],
                        Id = m.MediaIri.Value,
                        MediaType = m.ContentType,
                    };
                    if (m.FileName is { Length: > 0 } && !string.IsNullOrWhiteSpace(m.FileName))
                    {
                        image.Name = [m.FileName];
                    }
                    attachment = image;
                }
                else
                {
                    var document = new Document
                    {
                        Url = [new Link { Href = m.MediaIri.Uri }],
                        MediaType = m.ContentType,
                    };
                    if (m.FileName is { Length: > 0 } && !string.IsNullOrWhiteSpace(m.FileName))
                    {
                        document.Name = [m.FileName];
                    }
                    attachment = document;
                }

                attachments.Add(attachment);
            }

            article.Attachment = attachments;
        }

        var tags = BuildTagList(mentions, hashtags ?? [], actorId);
        if (tags is { Count: > 0 })
        {
            article.Tag = tags;
        }

        var create = new Create
        {
            Actor = [new Link { Href = new Uri(actorId.Value) }],
            Object = [article]
        };

        return await client.DeliverAsync(actorId.OutboxOf(), create);
    }

    /// <summary>
    /// Posts a poll as the signed-in actor: the <c>Question</c>'s content is the poll question (or the
    /// compose body when the question is left blank), and its options, end time (now + the chosen
    /// duration), and multiple-answer flag come from the poll editor. Validation (at least two
    /// non-empty, distinct options) happens here — when invalid, <see cref="PollError"/> is set and a
    /// failed <see cref="DeliveryResult"/> is returned without hitting the network. Mentions and
    /// hashtags are detected from the question text.
    /// </summary>
    private async Task<DeliveryResult> PostPollAsync(
        IActivityPubClient client,
        Iri actorId,
        List<Iri>? mentions,
        List<string>? hashtags,
        Func<string, string?> hashtagHref,
        PostAudience? audience = null)
    {
        var options = GetValidPollOptions();
        if (options is null)
        {
            return new DeliveryResult((int)HttpStatusCode.BadRequest, false, string.Empty);
        }

        // The question is the poll question when set; otherwise fall back to the compose body (which
        // the caller has already validated is non-empty).
        var question = string.IsNullOrWhiteSpace(PollQuestion) ? Content.Trim() : PollQuestion.Trim();
        var pollMentions = await DetectMentionsAsync(question, actorId);
        var pollHashtags = DetectHashtags(question);
        var endsAt = DateTime.UtcNow.AddMinutes(PollDurationMinutes);

        return await client.PostQuestionAsync(
            actorId,
            question,
            options,
            endsAt: endsAt,
            multiple: PollMultiple,
            to: audience?.To,
            cc: audience?.Cc,
            mentions: pollMentions.Count > 0 ? pollMentions : null,
            hashtags: pollHashtags.Count > 0 ? pollHashtags : null,
            hashtagHrefFactory: hashtagHref);
    }

    /// <summary>
    /// Uploads one chosen media attachment (a local, cookie-authenticated multipart POST to the actor's
    /// own home instance — Phase 20.4 (a), not a signed inbox delivery) and returns the same-origin media
    /// IRI + content-type + file name (set as the post's media attachment). Returns null when the upload
    /// fails (the caller skips that file — one flaky upload does not drop the whole post's media).
    /// </summary>
    private async Task<MediaUploadResult?> UploadAttachmentAsync(Iri actorId, IBrowserFile file)
    {
        try
        {
            var bytes = await ReadBytesAsync(file);
            return await Session.UploadMediaAsync(
                actorId,
                bytes,
                file.ContentType ?? "application/octet-stream",
                file.Name,
                CancellationToken.None);
        }
        catch
        {
            return null;
        }
    }

    /// <summary>
    /// Reads a browser file's bytes (capped at <see cref="MaxAttachmentBytes"/>).
    /// </summary>
    private static async Task<byte[]> ReadBytesAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(MaxAttachmentBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        return ms.ToArray();
    }
}
