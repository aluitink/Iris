@page "/admin/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Admin")]
@using System.Net.Http.Json
@using Microsoft.Extensions.DependencyInjection

<PageTitle>Admin · Users · Iris</PageTitle>

<h2>Instance users</h2>

@if (LoadError is not null)
{
    <div class="error">@LoadError</div>
}
else if (Users is null)
{
    <div class="card profile-loading">
        <svg class="loading-spinner" viewBox="25 25 50 50" aria-hidden="true">
            <circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" />
        </svg>
        <span class="muted">Loading users…</span>
    </div>
}
else
{
    <div class="card">
        <p class="muted">@Users.Count local account(s)</p>
        @if (ResetError is not null)
        {
            <div class="error">@ResetError</div>
        }
        @if (ResetSuccess is not null)
        {
            <div class="success">@ResetSuccess</div>
        }
        @if (DeleteError is not null)
        {
            <div class="error">@DeleteError</div>
        }
        @if (DeleteSuccess is not null)
        {
            <div class="success">@DeleteSuccess</div>
        }
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Handle</th>
                    <th>Role</th>
                    <th>Created</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Users)
                {
                    <tr>
                        <td>@user.Username</td>
                        <td><span class="badge @RoleBadgeClass(user.RoleLabel)">@user.RoleLabel</span></td>
                        <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td>
                            <button class="btn btn--small" @onclick="() => ResetPasswordPrompt(user)" disabled="@ResetBusy">
                                Reset password
                            </button>
                            <button class="btn btn--small btn--danger" @onclick="() => DeleteUserPrompt(user)" disabled="@DeleteBusy" style="margin-left: 0.25rem;">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (ResetTarget is not null)
        {
            <div style="margin-top: 1rem; display: flex; gap: 0.5rem; align-items: center;">
                <span>New password for <strong>@ResetTarget.Username</strong>:</span>
                <input type="password" class="input" style="max-width: 16rem;" value="@ResetPasswordInput"
                       @onchange="e => ResetPasswordInput = e.Value?.ToString() ?? string.Empty" />
                <button class="button" disabled="@ResetBusy" @onclick="ResetPasswordConfirm">Set</button>
                <button class="button button--ghost" @onclick="() => ResetTarget = null">Cancel</button>
            </div>
        }

        @if (DeleteTarget is not null)
        {
            <div style="margin-top: 1rem; display: flex; gap: 0.5rem; align-items: center; color: var(--color-danger, #c0392b);">
                <span>Permanently delete <strong>@DeleteTarget.Username</strong>? This cannot be undone.</span>
                <button class="button button--danger" disabled="@DeleteBusy" @onclick="DeleteUserConfirm">Delete</button>
                <button class="button button--ghost" @onclick="() => DeleteTarget = null">Cancel</button>
            </div>
        }
    </div>
}

@code {
    private readonly IHttpClientFactory _factory;
    private HttpClient? _http;
    private IReadOnlyList<AdminUserDto>? Users { get; set; }
    private string? LoadError { get; set; }
    private AdminUserDto? ResetTarget { get; set; }
    private string ResetPasswordInput { get; set; } = string.Empty;
    private bool ResetBusy { get; set; }
    private string? ResetError { get; set; }
    private string? ResetSuccess { get; set; }
    private AdminUserDto? DeleteTarget { get; set; }
    private bool DeleteBusy { get; set; }
    private string? DeleteError { get; set; }
    private string? DeleteSuccess { get; set; }

    public AdminUsers(IHttpClientFactory factory)
    {
        _factory = factory;
    }

    protected override void OnInitialized()
    {
        _http = _factory.CreateClient("iris");
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task<List<AdminUserDto>?> LoadUsersAsync()
    {
        try
        {
            var response = await _http!.GetAsync("/local/v1/admin/users");
            if (!response.IsSuccessStatusCode)
            {
                LoadError = $"Failed to load users (HTTP {(int)response.StatusCode})";
                return null;
            }
            var list = System.Text.Json.JsonSerializer.Deserialize<List<AdminUserDto>>(
                await response.Content.ReadAsStringAsync(),
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            return list?.OrderBy(u => u.Username, StringComparer.OrdinalIgnoreCase).ToList();
        }
        catch (Exception ex)
        {
            LoadError = ex.Message;
            return null;
        }
    }

    private void ResetPasswordPrompt(AdminUserDto user)
    {
        ResetTarget = user;
        ResetPasswordInput = string.Empty;
        ResetError = null;
        ResetSuccess = null;
        StateHasChanged();
    }

    private async Task ResetPasswordConfirm()
    {
        if (ResetTarget is null)
        {
            return;
        }

        if (ResetPasswordInput.Length < 8)
        {
            ResetError = "Password must be at least 8 characters.";
            StateHasChanged();
            return;
        }

        ResetBusy = true;
        ResetError = null;

        try
        {
            var payload = System.Text.Json.JsonSerializer.Serialize(new { Password = ResetPasswordInput });
            var content = new StringContent(payload, System.Text.Encoding.UTF8, "application/json");
            var response = await _http!.PostAsync($"/local/v1/admin/users/{ResetTarget.Id}/password-reset", content);
            if (response.IsSuccessStatusCode)
            {
                ResetSuccess = $"Password reset for @{ResetTarget.Username}.";
                ResetTarget = null;
                ResetPasswordInput = string.Empty;
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                using var doc = System.Text.Json.JsonDocument.Parse(body);
                ResetError = doc.RootElement.TryGetProperty("error", out var err) ? err.GetString() : "Reset failed.";
            }
        }
        catch (Exception ex)
        {
            ResetError = ex.Message;
        }
        finally
        {
            ResetBusy = false;
        }

        StateHasChanged();
    }

    private void DeleteUserPrompt(AdminUserDto user)
    {
        DeleteTarget = user;
        DeleteError = null;
        StateHasChanged();
    }

    private async Task DeleteUserConfirm()
    {
        if (DeleteTarget is null)
        {
            return;
        }

        DeleteBusy = true;
        DeleteError = null;

        try
        {
            var response = await _http!.DeleteAsync($"/local/v1/admin/users/{DeleteTarget.Id}");
            if (response.IsSuccessStatusCode)
            {
                DeleteSuccess = $"Account @{DeleteTarget.Username} deleted.";
                DeleteTarget = null;
                // Reload the user list.
                var list = await LoadUsersAsync();
                Users = list;
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                using var doc = System.Text.Json.JsonDocument.Parse(body);
                DeleteError = doc.RootElement.TryGetProperty("error", out var err) ? err.GetString() : "Deletion failed.";
            }
        }
        catch (Exception ex)
        {
            DeleteError = ex.Message;
        }
        finally
        {
            DeleteBusy = false;
        }

        StateHasChanged();
    }

    private static string RoleBadgeClass(string role)
        => role == "Admin" ? "badge--admin" : "badge--user";

    private sealed record AdminUserDto(Guid Id, string Username, string? DisplayName, string ActorIri, int Role, DateTimeOffset CreatedAt)
    {
        public string RoleLabel => Role == 1 ? "Admin" : "User";
    }
}
