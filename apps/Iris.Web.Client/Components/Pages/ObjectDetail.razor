@page "/object"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Iris.Client
@using Iris.Core.Identity
@using Iris.Web.Client.Accounts
@using KristofferStrube.ActivityStreams
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using ActivityObject = KristofferStrube.ActivityStreams.Object

<PageTitle>@PageHeading · Iris</PageTitle>

@if (Client is null)
{
    <div class="card"><p class="muted">Sign in to view objects.</p></div>
}
else if (string.IsNullOrEmpty(IriParam))
{
    <div class="card"><p class="muted">No object specified.</p></div>
}
else if (LoadError is not null)
{
    <div class="card"><div class="error" role="alert">@LoadError</div></div>
}
else if (ObjectDoc is null)
{
    <div class="card profile-loading">
        <svg class="loading-spinner" viewBox="25 25 50 50" aria-hidden="true">
            <circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" />
        </svg>
        <span class="muted">Loading object…</span>
    </div>
}
    else
{
    @if (IsTombstone && ObjectDoc is KristofferStrube.ActivityStreams.Tombstone objTombstone)
    {
        <div class="card object-detail">
            <div class="object-tombstone object-tombstone--detail">
                <div class="object-tombstone-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                    </svg>
                </div>
                <div class="object-tombstone-body">
                    <div class="object-tombstone-label">
                        @if (ObjectView.TombstoneFormerType(objTombstone) is { Length: > 0 } formerType)
                        {
                            <span>@formerType post</span>
                        }
                        else
                        {
                            <span>Post</span>
                        }
                        <span class="object-tombstone-state">deleted</span>
                    </div>
                    @if (objTombstone.Deleted is { } deletedAt)
                    {
                        <div class="object-tombstone-time" title="@deletedAt.ToString("o")">deleted @deletedAt.ToLocalTime().ToString("g")</div>
                    }
                    <p class="muted object-tombstone-hint">This object was removed. Its content, replies, and interactions are no longer available.</p>
                </div>
            </div>
        </div>
    }
    else
    {
    @if (ThreadContext is { Count: > 0 })
    {
        <div class="card object-parent-context">
            @for (var i = 0; i < ThreadContext.Count; i++)
            {
                var ancestor = ThreadContext[i];
                @if (i > 0)
                {
                    <div class="object-parent-separator" aria-hidden="true"></div>
                }
                <div class="object-parent-label">
                    In reply to <a href="/object?iri=@Uri.EscapeDataString(ancestor.Id ?? string.Empty)">@AncestorAuthor(ancestor)</a>
                </div>
                <div class="object-parent-content">@RenderAncestorContent(ancestor)</div>
            }
        </div>
    }

    <div class="card object-detail">
        @if (IsEdit)
        {
            <div class="object-edit">
                <label for="edit-content">Edit post</label>
                <textarea id="edit-content" class="compose-content" rows="4" @bind="EditContent"
                          disabled="@Editing"></textarea>
                <div class="object-edit-actions">
                    <button type="button" class="button" disabled="@Editing" @onclick="SaveEditAsync">
                        @(Editing ? "Saving…" : "Save")
                    </button>
                    <button type="button" class="button button--secondary" disabled="@Editing" @onclick="() => IsEdit = false">Cancel</button>
                </div>
                @if (EditError is not null)
                {
                    <div class="error" role="alert">@EditError</div>
                }
            </div>
        }
        else
        {
            <ObjectView Item="ObjectDoc" SuppressParentContext="true" ShowModeration="true" />
            @if (EngagementText is not null)
            {
                <div class="object-detail-engagement">@EngagementText</div>
            }
        }
        <div class="object-detail-actions">
            @if (IsLocked)
            {
                <span class="object-locked-indicator" title="Replies are disabled (post is locked)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <rect x="5" y="11" width="14" height="10" rx="2" />
                        <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                    </svg>
                    Replies disabled (post is locked)
                </span>
            }
            else if (ReplyHref is not null)
            {
                <a class="button button--secondary" href="@ReplyHref">Reply</a>
            }
            @if (IsOwnPost)
            {
                @if (!IsEdit)
                {
                    <button type="button" class="button button--secondary" @onclick="() => BeginEditAsync()">Edit</button>
                }
                @if (!ConfirmingDelete)
                {
                    <button type="button" class="button button--danger" @onclick="() => ConfirmingDelete = true">Delete</button>
                }
                else
                {
                    <span class="delete-confirm">
                        <span class="muted">Delete this post?</span>
                        <button type="button" class="button button--danger" disabled="@Deleting" @onclick="DeleteAsync">
                            @(Deleting ? "Deleting…" : "Confirm")
                        </button>
                        <button type="button" class="button button--secondary" disabled="@Deleting" @onclick="() => ConfirmingDelete = false">Cancel</button>
                    </span>
                }
            }
        </div>
        @if (DeleteError is not null)
        {
            <div class="error" role="alert">@DeleteError</div>
        }
    </div>

    @if (ShowRepliesSection)
    {
        <div class="tab-bar" role="tablist" aria-label="Object sections">
            <a href="#replies" id="tab-replies" role="tab" aria-selected="@(ActiveTab == "replies")" aria-controls="panel-replies" class="tab @(ActiveTab == "replies" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("replies")'>Replies@(ReplyCount is { } rc && rc > 0 ? $" ({rc})" : string.Empty)</a>
            <a href="#likes" id="tab-likes" role="tab" aria-selected="@(ActiveTab == "likes")" aria-controls="panel-likes" class="tab @(ActiveTab == "likes" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("likes")'>Likes@(LikeCount > 0 ? $" ({LikeCount})" : string.Empty)</a>
            <a href="#shares" id="tab-shares" role="tab" aria-selected="@(ActiveTab == "shares")" aria-controls="panel-shares" class="tab @(ActiveTab == "shares" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("shares")'>Shares@(BoostCount > 0 ? $" ({BoostCount})" : string.Empty)</a>
        </div>

        @if (ActiveTab == "replies")
        {
            <div role="tabpanel" id="panel-replies" aria-labelledby="tab-replies">
                <div class="card replies-section">
                    @if (RepliesLoading)
                    {
                        <div class="card-loading">
                            <svg class="loading-spinner" viewBox="25 25 50 50" aria-hidden="true">
                                <circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" />
                            </svg>
                            <span class="muted">Loading replies…</span>
                        </div>
                    }
                    else if (ReplyTree is { Count: > 0 })
                    {
                        <div class="reply-thread">
                            @foreach (var root in ReplyTree)
                            {
                                <ReplyNode Node="root" />
                            }
                        </div>
                        @if (HasMoreReplies)
                        {
                            <div class="replies-more">
                                <button type="button" class="button button--secondary" disabled="@LoadingMoreReplies" @onclick="LoadMoreRepliesAsync">
                                    @(LoadingMoreReplies ? "Loading…" : "Show more replies")
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="muted">No replies yet.</p>
                    }
                </div>
            </div>
        }
        else if (ActiveTab == "likes")
        {
            <div role="tabpanel" id="panel-likes" aria-labelledby="tab-likes">
                <InteractionActorsPanel
                    Client="Client"
                    CollectionIri="LikesCollectionIri"
                    Title="Likes"
                    EmptyMessage="No likes yet." />
            </div>
        }
        else if (ActiveTab == "shares")
        {
            <div role="tabpanel" id="panel-shares" aria-labelledby="tab-shares">
                <InteractionActorsPanel
                    Client="Client"
                    CollectionIri="SharesCollectionIri"
                    Title="Shares"
                    EmptyMessage="No boosts yet." />
            </div>
        }
    }
    }
}

@code {
    [Inject]
    private IActorSessionAccessor Session { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "iri")]
    public string? IriParam { get; set; }

    private IActivityPubClient? Client => Session.Client;

    private IObject? ObjectDoc { get; set; }
    private List<IObject> ThreadContext { get; } = [];
    private string? LoadError { get; set; }
    private bool RepliesLoading { get; set; }
    private List<IObject?> Replies { get; set; } = [];
    private int RepliesLoaded { get; set; }
    private bool HasMoreReplies { get; set; }
    private bool LoadingMoreReplies { get; set; }
    private Iri? RepliesObjectIri { get; set; }
    private List<ReplyThreadNode> ReplyTree { get; set; } = [];

    /// <summary>
    /// The maximum depth of the reply-thread walk (Phase 132.3). The root's direct replies are depth 1;
    /// their replies are depth 2; and so on. Bounding the depth keeps the (bounded) number of collection
    /// walks from exploding on long, deep threads — a reply at the depth limit renders with its own
    /// replies un-walked (it shows no "N replies" affordance for replies this instance never fetched).
    /// </summary>
    private const int MaxReplyDepth = 3;
    private int LikeCount { get; set; }
    private int BoostCount { get; set; }
    private int? ReplyCount { get; set; }
    private string ActiveTab { get; set; } = "replies";
    private bool ConfirmingDelete { get; set; }
    private bool Deleting { get; set; }
    private string? DeleteError { get; set; }

    private bool IsEdit { get; set; }
    private bool Editing { get; set; }
    private string EditContent { get; set; } = string.Empty;
    private string? EditError { get; set; }

    private string? EngagementText
    {
        get
        {
            if (LikeCount == 0 && BoostCount == 0)
            {
                return null;
            }

            var parts = new List<string>();
            if (LikeCount > 0)
            {
                parts.Add($"{LikeCount} like{(LikeCount == 1 ? "" : "s")}");
            }

            if (BoostCount > 0)
            {
                parts.Add($"{BoostCount} boost{(BoostCount == 1 ? "" : "s")}");
            }

            return string.Join(" · ", parts);
        }
    }

    /// <summary>
    /// Whether the resolved document is an AS2.0 <see cref="Tombstone"/> (a deleted object). The detail
    /// page renders a "deleted" placeholder for these and skips the reply / engagement / edit surface
    /// (a deleted object has no content, replies, or interactions to show).
    /// </summary>
    private bool IsTombstone => ObjectDoc is KristofferStrube.ActivityStreams.Tombstone;

    private string PageHeading
    {
        get
        {
            if (IsTombstone)
            {
                return "Deleted post";
            }

            if (ObjectDoc is Actor { PreferredUsername: { Length: > 0 } px })
            {
                return px;
            }

            var subject = SubjectObject;
            if (subject?.AttributedTo is { } attr)
            {
                var first = attr.FirstOrDefault();
                if (first is Actor { PreferredUsername: { Length: > 0 } apx })
                {
                    return apx;
                }

                var iri = first?.ResolveObjectIri();
                if (iri is { } i)
                {
                    var path = Uri.UnescapeDataString(new Uri(i.Value).AbsolutePath).TrimEnd('/');
                    var last = path.Split('/').LastOrDefault();
                    if (!string.IsNullOrWhiteSpace(last))
                    {
                        return last;
                    }
                }
            }

            var type = subject?.Type?.FirstOrDefault() ?? ObjectDoc?.GetType().Name;
            return string.IsNullOrEmpty(type) ? "Object" : type;
        }
    }

    private Iri? ObjectIri
    {
        get
        {
            if (string.IsNullOrEmpty(IriParam) || !Iri.TryParse(IriParam, out var parsed))
            {
                return null;
            }

            return parsed;
        }
    }

    /// <summary>
    /// The IRI of the content object the page is about. For a Create/Update activity, this is the
    /// embedded object's IRI (the Note/Article); for a direct object, it is the object's own IRI.
    /// Collection walks (<c>/replies</c>, <c>/likes</c>, <c>/shares</c>) must use this IRI — the
    /// server serves those collections only for the stored object, not the activity (S3).
    /// </summary>
    private Iri? ContentIri
    {
        get
        {
            var subjectId = SubjectObject?.Id;
            if (subjectId is { Length: > 0 } && Iri.TryParse(subjectId, out var subjectIri))
            {
                return subjectIri;
            }

            return ObjectIri;
        }
    }

    /// <summary>
    /// The href for the "Reply" button, or null when the object is not a replyable content type
    /// (a Note, or any non-actor content object) or when the post is locked (<c>iris:locked: true</c>,
    /// 138.25 follow-up).
    /// </summary>
    private string? ReplyHref
    {
        get
        {
            if (ObjectDoc is Actor)
            {
                return null;
            }

            if (IsLocked)
            {
                return null;
            }

            if (ContentIri is not { } iri)
            {
                return null;
            }

            return $"/compose?replyTo={Uri.EscapeDataString(iri.Value)}";
        }
    }

    /// <summary>
    /// Whether the object is locked (<c>iris:locked: true</c>) — replies are disabled. Read from the
    /// <c>iris:</c> extension terms the server renders (138.25).
    /// </summary>
    private bool IsLocked
    {
        get
        {
            var ns = Session.IrisNamespaceBase?.Value;
            return ns is not null && SubjectObject?.GetLocked(ns) == true;
        }
    }

    /// <summary>
    /// Whether the replies section should be rendered (the object is a content object, not an actor or
    /// a tombstone — a deleted object has no replies to show).
    /// </summary>
    private bool ShowRepliesSection => ObjectDoc is not null && ObjectDoc is not Actor && !IsTombstone;

    /// <summary>
    /// The object's <c>/likes</c> collection IRI (the per-object likers surface the Likes tab walks).
    /// Derived from the content object's IRI; null when the object is not yet resolved.
    /// </summary>
    private Iri? LikesCollectionIri => ContentIri is { } iri ? iri.LikesOf() : null;

    /// <summary>
    /// The object's <c>/shares</c> collection IRI (the per-object boosters surface the Shares tab walks).
    /// Derived from the content object's IRI; null when the object is not yet resolved.
    /// </summary>
    private Iri? SharesCollectionIri => ContentIri is { } iri ? iri.SharesOf() : null;

    /// <summary>
    /// Switches the active tab (Replies / Likes / Shares). The Likes / Shares panels lazy-load their
    /// collections on first activation (the <see cref="InteractionActorsPanel"/> loads in
    /// <c>OnParametersSet</c>, which runs when the panel is first rendered into the tab panel).
    /// </summary>
    private void SwitchTab(string tab)
    {
        if (ActiveTab != tab)
        {
            ActiveTab = tab;
            StateHasChanged();
        }
    }

    private string AncestorAuthor(IObject ancestor)
    {
        if (ancestor is Actor { PreferredUsername: { Length: > 0 } px })
        {
            return "@" + px;
        }

        if (ancestor is ActivityObject { AttributedTo: { } attr } && attr.FirstOrDefault() is { } first)
        {
            if (first is Actor { PreferredUsername: { Length: > 0 } apx })
            {
                return "@" + apx;
            }

            string? actorIriStr = first is ILink { Href: { } href } ? href.ToString() : first.Id;
            if (actorIriStr is not null && Iri.TryParse(actorIriStr, out var attrIri))
            {
                var segments = attrIri.Value.Split('/');
                return segments.Length > 1 ? segments[^1] : "unknown";
            }
        }

        return "unknown";
    }

    private MarkupString RenderAncestorContent(IObject ancestor)
    {
        var obj = ancestor as ActivityObject;
        var content = obj?.Content?.FirstOrDefault();
        if (string.IsNullOrWhiteSpace(content))
        {
            return new MarkupString("(no content)");
        }

        return new MarkupString(
            obj.IsPreRenderedHtmlContent() ? content : global::Iris.Core.Rendering.Markdown.ToHtml(content));
    }

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureReadyAsync();
        if (Client is not { } client || ObjectIri is not { } iri || LoadError is not null)
        {
            return;
        }

        if (ObjectDoc is not null && ObjectDoc.Id == iri.Value)
        {
            return;
        }

        try
        {
            var obj = await client.GetObjectAsync(iri, CancellationToken.None);
            if (obj is not null)
            {
                ObjectDoc = obj;
            }
            else
            {
                LoadError = "Object not found.";
            }
        }
        catch (Exception)
        {
            LoadError = "Failed to load object. It may not exist or the server is unreachable.";
        }

        if (ObjectDoc is not null && ObjectDoc is not Actor && !IsTombstone)
        {
            await LoadParentAsync(client);
            // S3: derive collection walks from the content object's IRI (the Note), not the raw
            // activity IRI — the server serves /replies, /likes, /shares only for the stored object.
            var contentIri = ContentIri ?? iri;
            await LoadRepliesAsync(client, contentIri);
            await LoadEngagementAsync(client, contentIri);
        }
    }

    private async Task LoadRepliesAsync(IActivityPubClient client, Iri iri)
    {
        RepliesLoading = true;
        RepliesObjectIri = iri;
        try
        {
            var resolved = new List<IObject?>();
            var count = 0;
            await foreach (var item in client.GetRepliesAsync(iri, new CollectionQuery { Limit = 20 }, CancellationToken.None))
            {
                var replyIri = item.ResolveObjectIri();
                if (replyIri is not { } ri)
                {
                    continue;
                }

                try
                {
                    var replyObj = await client.GetObjectAsync(ri, CancellationToken.None);
                    if (replyObj is not null)
                    {
                        resolved.Add(replyObj);
                        count++;
                    }
                }
                catch
                {
                    // Skip unresolvable replies (404, network error, etc.).
                }
            }

            Replies = resolved;
            RepliesLoaded = count;
            HasMoreReplies = count >= 20;
        }
        catch
        {
            // Non-fatal: the object still renders; replies simply won't show.
        }
        finally
        {
            RepliesLoading = false;
        }

        await BuildReplyTreeAsync();
        StateHasChanged();
    }

    private async Task LoadMoreRepliesAsync()
    {
        if (RepliesObjectIri is not { } iri || LoadingMoreReplies)
        {
            return;
        }

        LoadingMoreReplies = true;
        try
        {
            var newLimit = RepliesLoaded + 20;
            var allItems = new List<IObject?>();
            var count = 0;
            await foreach (var item in Client!.GetRepliesAsync(iri, new CollectionQuery { Limit = newLimit }, CancellationToken.None))
            {
                var replyIri = item.ResolveObjectIri();
                if (replyIri is not { } ri)
                {
                    continue;
                }

                try
                {
                    var replyObj = await Client!.GetObjectAsync(ri, CancellationToken.None);
                    if (replyObj is not null)
                    {
                        allItems.Add(replyObj);
                        count++;
                    }
                }
                catch
                {
                    // Skip unresolvable replies.
                }
            }

            Replies = allItems;
            RepliesLoaded = count;
            HasMoreReplies = count >= newLimit;
        }
        catch
        {
            // Non-fatal: keep the existing replies.
        }
        finally
        {
            LoadingMoreReplies = false;
        }

        await BuildReplyTreeAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Builds the reply thread tree (Phase 132.3) from the loaded flat <see cref="Replies"/> (the
    /// object's direct replies). For each direct reply, walks that reply's own <c>/replies</c>
    /// collection (its direct replies-to-replies), and recurses to <see cref="MaxReplyDepth"/> so the
    /// thread renders nested (a reply's replies beneath it, collapsed by default in
    /// <see cref="ReplyNode"/>). Each node's document is resolved via <c>GetObjectAsync</c>;
    /// unresolvable nodes are dropped. The walk is bounded in both depth (<see cref="MaxReplyDepth"/>)
    /// and per-node breadth (20 items) so a long thread does not explode into an unbounded number of
    /// collection fetches.
    /// </summary>
    private async Task BuildReplyTreeAsync()
    {
        if (Replies.Count == 0)
        {
            ReplyTree = [];
            return;
        }

        ReplyTree = await BuildSubtreeAsync(Replies, depth: 1);
    }

    /// <summary>
    /// Recursively builds the thread nodes for a set of a parent's direct replies
    /// (<paramref name="replies"/>), walking each reply's own <c>/replies</c> one level down and
    /// recursing until <see cref="MaxReplyDepth"/> (a reply at the depth limit renders with no children —
    /// its replies were not walked). <paramref name="depth"/> is the depth of <paramref name="replies"/>
    /// (the root's direct replies are depth 1).
    /// </summary>
    private async Task<List<ReplyThreadNode>> BuildSubtreeAsync(List<IObject?> replies, int depth)
    {
        var nodes = new List<ReplyThreadNode>(replies.Count);

        foreach (var reply in replies)
        {
            var iri = reply.ResolveObjectIri();
            if (iri is not { } ri)
            {
                continue;
            }

            // This reply's direct replies (one level down), walked only while we have depth to spare.
            var children = depth < MaxReplyDepth ? await BuildSubtreeAsync(await LoadResolvedRepliesAsync(ri), depth + 1) : [];

            nodes.Add(new ReplyThreadNode(ri, reply, children));
        }

        return nodes;
    }

    /// <summary>
    /// Loads and resolves one object's direct replies (its <c>/replies</c> collection, bounded to 20
    /// items) as a flat list of documents — the input to <see cref="BuildSubtreeAsync"/>'s next level.
    /// Unresolvable replies are skipped.
    /// </summary>
    private async Task<List<IObject?>> LoadResolvedRepliesAsync(Iri objectIri)
    {
        var resolved = new List<IObject?>();
        if (Client is not { } client)
        {
            return resolved;
        }

        try
        {
            await foreach (var item in client.GetRepliesAsync(objectIri, new CollectionQuery { Limit = 20 }, CancellationToken.None))
            {
                var replyIri = item.ResolveObjectIri();
                if (replyIri is not { } ri)
                {
                    continue;
                }

                try
                {
                    var obj = await client.GetObjectAsync(ri, CancellationToken.None);
                    if (obj is not null)
                    {
                        resolved.Add(obj);
                    }
                }
                catch
                {
                    // Skip unresolvable replies (404, network error, etc.).
                }
            }
        }
        catch
        {
            // Non-fatal: the node renders with the replies we could fetch (possibly none).
        }

        return resolved;
    }

    /// <summary>
    /// Loads one object's direct replies (its <c>/replies</c> collection, bounded to 20 items), resolves
    /// each to its document, and returns them as <see cref="ReplyThreadNode"/> leaves (their own children
    /// are walked one level deeper by the caller's recursion). Unresolvable replies are skipped.
    /// </summary>
    private async Task<List<ReplyThreadNode>> LoadDirectRepliesAsync(Iri objectIri)
    {
        var leaves = new List<ReplyThreadNode>();
        if (Client is not { } client)
        {
            return leaves;
        }

        try
        {
            await foreach (var item in client.GetRepliesAsync(objectIri, new CollectionQuery { Limit = 20 }, CancellationToken.None))
            {
                var replyIri = item.ResolveObjectIri();
                if (replyIri is not { } ri)
                {
                    continue;
                }

                IObject? obj = null;
                try
                {
                    obj = await client.GetObjectAsync(ri, CancellationToken.None);
                }
                catch
                {
                    // Skip unresolvable replies (404, network error, etc.).
                }

                leaves.Add(new ReplyThreadNode(ri, obj, []));
            }
        }
        catch
        {
            // Non-fatal: the node renders with the replies we could fetch (possibly none).
        }

        return leaves;
    }

    private async Task LoadParentAsync(IActivityPubClient client)
    {
        if (ObjectDoc.GetParentIri() is not { } firstIri)
        {
            return;
        }

        try
        {
            var current = await client.GetObjectAsync(firstIri, CancellationToken.None);
            if (current is null)
            {
                return;
            }

            ThreadContext.Add(current);

            // Fetch one more level up (grandparent) for deeper thread context.
            if (current.GetParentIri() is { } secondIri)
            {
                var grandparent = await client.GetObjectAsync(secondIri, CancellationToken.None);
                if (grandparent is not null && grandparent.Id != current.Id)
                {
                    ThreadContext.Add(grandparent);
                }
            }
        }
        catch
        {
            // Non-fatal: parent context simply won't show.
        }
    }

    private async Task LoadEngagementAsync(IActivityPubClient client, Iri iri)
    {
        // Fast path (54.8): the object document this page already fetched (GetObjectAsync) carries the
        // server-rendered iris:likedCount / iris:sharedCount counters, so read the header counts from it
        // instead of re-walking the /likes and /shares collections (two extra per-object fetches). When
        // the counters are absent (a non-Iris instance, or a read the server did not enrich) fall back to
        // the walk, as before.
        var ns = Session.IrisNamespaceBase?.Value;
        if (ns is not null && ObjectDoc is { } doc
            && doc.GetLikedCount(ns) is { } liked
            && doc.GetSharedCount(ns) is { } shared)
        {
            LikeCount = liked;
            BoostCount = shared;
            // 132.1: the object document also carries iris:repliedCount (rendered by the
            // object-document endpoint), so read the reply count off it too (the Replies tab's count).
            ReplyCount = doc.GetRepliedCount(ns);
            return;
        }

        try
        {
            // Bypass the client collection-page cache: the count must reflect likes/boosts made moments
            // ago (the server derives it live from the reverse index, so a fresh read is authoritative).
            int likes = 0;
            await foreach (var _ in client.GetLikesAsync(iri, new CollectionQuery { Limit = 100, BypassCache = true }, CancellationToken.None))
            {
                likes++;
            }

            int boosts = 0;
            await foreach (var _ in client.GetSharesAsync(iri, new CollectionQuery { Limit = 100, BypassCache = true }, CancellationToken.None))
            {
                boosts++;
            }

            LikeCount = likes;
            BoostCount = boosts;
        }
        catch
        {
            // Non-fatal: engagement counts simply won't show.
        }
    }

    /// <summary>
    /// The object the page is actually about: for a Create/Update/Delete activity, the embedded object
    /// (the Note); otherwise the object itself. The activity's own <c>Id</c>/<c>Content</c>/
    /// <c>AttributedTo</c>/<c>To</c> are null (they live on the embedded Note), so every read that
    /// depends on those fields must go through this unwrap.
    /// </summary>
    private ActivityObject? SubjectObject
        => ObjectDoc switch
        {
            KristofferStrube.ActivityStreams.Create c => c.Object?.FirstOrDefault() as ActivityObject,
            KristofferStrube.ActivityStreams.Update u => u.Object?.FirstOrDefault() as ActivityObject,
            _ => ObjectDoc as ActivityObject,
        };

    private bool IsOwnPost
    {
        get
        {
            if (SubjectObject is not { AttributedTo: { } attr } || Session.ActorId is not { } me)
            {
                return false;
            }

            return attr.Any(a =>
            {
                var iri = a.ResolveObjectIri();
                return iri is not null && iri!.ToString() == me.ToString();
            });
        }
    }

    /// <summary>
    /// Enters edit mode for the object's own post, pre-filling the editor with the note's current
    /// content (HTML stripped, so the user edits plain text).
    /// </summary>
    private void BeginEditAsync()
    {
        if (SubjectObject is not { Content: { } content })
        {
            return;
        }

        var text = string.Join(" ", content);
        text = new System.Text.RegularExpressions.Regex("<[^>]+>").Replace(text, " ").Trim();
        EditContent = text;
        EditError = null;
        IsEdit = true;
    }

    /// <summary>
    /// Saves the edited note as the signed-in actor: builds an updated <see cref="Note"/> (same IRI,
    /// author, and audience — only the content changes) and posts it via <c>UpdateNoteAsync</c>. The
    /// server's <c>UpdateActivityHandler</c> refreshes the stored object in place and federates the
    /// change to remote followers (F-02).
    /// </summary>
    private async Task SaveEditAsync()
    {
        if (Editing
            || Session.Client is not { } client
            || Session.ActorId is not { } me
            || SubjectObject is not { Id: { Length: > 0 } id, AttributedTo: { } attributed }
            || string.IsNullOrWhiteSpace(EditContent))
        {
            return;
        }

        Editing = true;
        EditError = null;
        try
        {
            var updated = new Note
            {
                Id = id,
                Content = [EditContent.Trim()],
                AttributedTo = attributed,
            };

            if (SubjectObject is { To: { } to })
            {
                updated.To = to;
            }

            var result = await client.UpdateNoteAsync(me, updated);
            if (result.IsSuccess)
            {
                // Re-fetch to render the server's refreshed copy (the stored object is now updated).
                var iri = new Iri(id);
                ObjectDoc = await client.GetObjectAsync(iri, CancellationToken.None);
                IsEdit = false;
            }
            else
            {
                EditError = $"Edit failed (HTTP {result.StatusCode}).";
            }
        }
        catch (Exception)
        {
            EditError = "Your edit couldn't be saved. Please try again.";
        }
        finally
        {
            Editing = false;
        }
    }

    private async Task DeleteAsync()
    {
        // Delete the SUBJECT object (the embedded Note), not the Create activity: the server's
        // DeleteActivityHandler tombstones by the object's IRI (the note), and the object store keys by
        // the note's IRI — deleting the Create IRI would be a no-op (no object is stored under it).
        var subjectIri = SubjectObject?.Id is { Length: > 0 } sId ? new Iri(sId) : ObjectIri;
        if (Session.Client is not { } client || Session.ActorId is not { } me || subjectIri is not { } iri)
        {
            return;
        }

        Deleting = true;
        DeleteError = null;
        try
        {
            var result = await client.DeleteAsync(me, iri);
            if (result.IsSuccess)
            {
                Navigation.NavigateTo("/home");
            }
            else
            {
                DeleteError = $"Delete failed (HTTP {result.StatusCode}).";
            }
        }
        catch (Exception)
        {
            DeleteError = "The post couldn't be deleted. Please try again.";
        }
        finally
        {
            Deleting = false;
        }
    }
}
