@page "/communities"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Iris.Client
@using Iris.Core.Identity
@using Iris.Web.Client.Accounts
@using KristofferStrube.ActivityStreams

<PageTitle>Communities · Iris</PageTitle>

<h2>Communities</h2>

<p class="muted">
    Local communities on this instance — join one to post to its feed and connect with members.
</p>

@if (Client is null)
{
    <div class="card"><p class="muted">Sign in to browse communities.</p></div>
}
else
{
    <div class="card create-community-card">
        <h3>Create a community</h3>
        <div class="form-group">
            <label for="community-name">Name</label>
            <input id="community-name" type="text" @bind="NewName" placeholder="My Community" maxlength="100" />
        </div>
        <div class="form-group">
            <label for="community-handle">Handle</label>
            <input id="community-handle" type="text" @bind="NewHandle" placeholder="my-community" maxlength="63" pattern="[a-z0-9\-]*" />
            <span class="muted" style="font-size: 0.8rem;">Lowercase letters, digits, and hyphens.</span>
        </div>
        <div class="form-group">
            <label for="community-description">Description <span class="muted">(optional)</span></label>
            <textarea id="community-description" @bind="NewDescription" placeholder="What is this community about?" rows="3" maxlength="500"></textarea>
        </div>
        <button class="button button--primary" @onclick="CreateAsync" disabled="@(CreateBusy || string.IsNullOrWhiteSpace(NewName) || string.IsNullOrWhiteSpace(NewHandle))">
            @(CreateBusy ? "Creating…" : "Create community")
        </button>
        @if (CreateError is not null)
        {
            <div class="error" style="margin-top: 0.5rem;">@CreateError</div>
        }
        @if (CreateSuccess)
        {
            <div class="success" style="margin-top: 0.5rem;">Community created!</div>
        }
    </div>

    @if (Busy)
    {
        <div class="card-loading">
            <svg class="loading-spinner" viewBox="25 25 50 50" aria-hidden="true">
                <circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" />
            </svg>
            <span class="muted">Loading communities…</span>
        </div>
    }
    else if (Error is not null)
    {
        <div class="card"><div class="error">@Error</div></div>
    }
    else if (Items is not null)
    {
        @if (Items.Count == 0)
        {
            <div class="card">
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                    <p>No communities yet.</p>
                    <p>Create one above to get started.</p>
                </div>
            </div>
        }
        else
        {
            <div class="directory-list">
                @foreach (var community in Items)
                {
                    var name = community.Name?.FirstOrDefault() ?? "Unnamed";
                    var summary = community.Summary?.FirstOrDefault();
                    var handle = HandleOf(community);
                    var iri = community.Id;

                    <div class="directory-item">
                        <div class="directory-item-body">
                            <a href="@CommunityHref(iri)" class="directory-item-name">@name</a>
                            @if (handle is { Length: > 0 })
                            {
                                <span class="directory-item-handle">@handle</span>
                            }
                            @if (summary is { Length: > 0 })
                            {
                                <p class="directory-item-summary">@Truncate(summary, 150)</p>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
}

@code {
    [Inject]
    private IActorSessionAccessor Session { get; set; } = default!;

    private IActivityPubClient? Client => Session.Client;
    private List<Group>? Items { get; set; }
    private bool Busy { get; set; }
    private string? Error { get; set; }

    private Iri? InstanceBase
    {
        get
        {
            if (Session.ActorId is not { } actor)
            {
                return null;
            }

            const string marker = "/ap/v1";
            var value = actor.Value;
            var index = value.IndexOf(marker, StringComparison.Ordinal);
            return index >= 0 ? new Iri(value[..(index + marker.Length)]) : null;
        }
    }

    private string NewName { get; set; } = string.Empty;
    private string NewHandle { get; set; } = string.Empty;
    private string NewDescription { get; set; } = string.Empty;
    private bool CreateBusy { get; set; }
    private string? CreateError { get; set; }
    private bool CreateSuccess { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureReadyAsync();
        if (Client is { } client && InstanceBase is { } baseIri)
        {
            Busy = true;
            try
            {
                var results = new List<IObjectOrLink>();
                await foreach (var item in client.SearchAsync(
                                    baseIri,
                                    string.Empty,
                                    new SearchOptions { Type = "Actor" }))
                {
                    results.Add(item);
                }

                Items = results
                    .OfType<KristofferStrube.ActivityStreams.Object>()
                    .Where(o => o is Group)
                    .Cast<Group>()
                    .OrderBy(g => g.Id ?? string.Empty, StringComparer.Ordinal)
                    .ToList();
            }
            catch (Exception ex)
            {
                Error = ex.Message;
            }
            finally
            {
                Busy = false;
            }
        }
    }

    private async Task CreateAsync()
    {
        if (Client is not { } client || Session.ActorId is not { } actorId)
        {
            return;
        }

        CreateBusy = true;
        CreateError = null;
        CreateSuccess = false;

        try
        {
            var result = await client.CreateCommunityAsync(actorId, NewHandle.Trim(), NewName.Trim(), NewDescription.Trim());
            if (result.IsSuccess)
            {
                CreateSuccess = true;
                NewName = string.Empty;
                NewHandle = string.Empty;
                NewDescription = string.Empty;
                await LoadCommunitiesAsync();
            }
            else
            {
                CreateError = $"Failed to create community (HTTP {result.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            CreateError = ex.Message;
        }
        finally
        {
            CreateBusy = false;
        }
    }

    private async Task LoadCommunitiesAsync()
    {
        if (Client is not { } client || InstanceBase is not { } baseIri)
        {
            return;
        }

        Busy = true;
        Error = null;
        try
        {
            var results = new List<IObjectOrLink>();
            await foreach (var item in client.SearchAsync(
                                baseIri,
                                string.Empty,
                                new SearchOptions { Type = "Actor" }))
            {
                results.Add(item);
            }

            Items = results
                .OfType<KristofferStrube.ActivityStreams.Object>()
                .Where(o => o is Group)
                .Cast<Group>()
                .OrderBy(g => g.Id ?? string.Empty, StringComparer.Ordinal)
                .ToList();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private static string? HandleOf(Actor actor)
    {
        if (actor.Id is not { Length: > 0 } id)
        {
            return null;
        }

        try
        {
            var uri = new Uri(id);
            var segments = uri.AbsolutePath.TrimEnd('/').Split('/');
            return segments.Length > 0 ? segments[^1] : null;
        }
        catch
        {
            return null;
        }
    }

    private static string? CommunityHref(string? iri)
        => iri is not null ? $"/community?iri={Uri.EscapeDataString(iri)}" : null;

    private static string Truncate(string value, int max)
        => value.Length <= max ? value : value[..max] + "…";
}
