@page "/communities"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Iris.Client
@using Iris.Core.Identity
@using Iris.Web.Client.Accounts
@using Iris.Web.Client.Components
@using Iris.Web.Client.Ui
@using KristofferStrube.ActivityStreams

@inject UiContext Ui
@inject NavigationManager Nav

<PageTitle>Communities · Iris</PageTitle>

<p class="muted">
    Communities you follow, and communities on this instance. Follow a community to see its posts in your home feed.
</p>

@if (Client is null)
{
    <div class="card"><p class="muted">Sign in to browse communities.</p></div>
}
else
{
    <div class="card create-community-card">
        @if (ShowCreateForm)
        {
            <h2>Create a community</h2>
            <div class="form-group">
                <label for="community-name">Name</label>
                <input id="community-name" type="text" @bind="NewName" @bind:event="oninput" placeholder="My Community" maxlength="100" />
            </div>
            <div class="form-group">
                <label for="community-handle">Handle</label>
                <input id="community-handle" type="text" @bind="NewHandle" @bind:event="oninput" placeholder="my-community" maxlength="63" pattern="[a-z0-9\-]*" />
                <span class="muted text-sm">Lowercase letters, digits, and hyphens.</span>
            </div>
            <div class="form-group">
                <label for="community-description">Description <span class="muted">(optional)</span></label>
                <textarea id="community-description" @bind="NewDescription" placeholder="What is this community about?" rows="3" maxlength="500"></textarea>
            </div>
            <button class="button button--primary" @onclick="CreateAsync" disabled="@(CreateBusy || string.IsNullOrWhiteSpace(NewName) || string.IsNullOrWhiteSpace(NewHandle))">
                @(CreateBusy ? "Creating…" : "Create community")
            </button>
            @if (CreateError is not null)
            {
                <div class="error" style="margin-top: 0.5rem;" role="alert">@CreateError</div>
            }
            @if (CreateSuccess)
            {
                <div class="success" style="margin-top: 0.5rem;" role="status">Community created!</div>
            }
        }
        else
        {
            <button class="button button--ghost" @onclick='() => ShowCreateForm = true'>+ Create a community</button>
        }
    </div>

    <div class="directory-toolbar">
        <div class="tab-bar" role="tablist" aria-label="Community sections">
            <a href="#following" id="tab-community-following" role="tab" aria-selected="@(ActiveTab == "following")" aria-controls="panel-community-following" class="tab @(ActiveTab == "following" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("following")'>Following</a>
            <a href="#mine" id="tab-community-mine" role="tab" aria-selected="@(ActiveTab == "mine")" aria-controls="panel-community-mine" class="tab @(ActiveTab == "mine" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("mine")'>My communities</a>
            <a href="#all" id="tab-community-all" role="tab" aria-selected="@(ActiveTab == "all")" aria-controls="panel-community-all" class="tab @(ActiveTab == "all" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("all")'>All on this instance</a>
            <a href="#all-known" id="tab-community-all-known" role="tab" aria-selected="@(ActiveTab == "all-known")" aria-controls="panel-community-all-known" class="tab @(ActiveTab == "all-known" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("all-known")'>All known</a>
        </div>
    </div>

    @if (Busy)
    {
        <div class="card-loading">
            <svg class="loading-spinner" viewBox="25 25 50 50" aria-hidden="true">
                <circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" />
            </svg>
            <span class="muted">Loading communities…</span>
        </div>
    }
    else if (Error is not null)
    {
        <div class="card"><div class="error" role="alert">@Error</div></div>
    }

    @if (DeleteError is not null)
    {
        <div class="card"><div class="error" role="alert">@DeleteError</div></div>
    }
    else if (LeaveError is not null)
    {
        <div class="card"><div class="error" role="alert">@LeaveError</div></div>
    }
    else if (Items is not null)
    {
        var shown = ActiveTab switch
        {
            "following" => (Following ?? LocalFollowing),
            "mine" => OwnedCommunities,
            "all-known" => AllKnown ?? [],
            _ => All
        };
        @if (shown.Count == 0)
        {
            <div class="card">
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                    @if (ActiveTab == "following")
                    {
                        <p>No communities followed yet.</p>
                        <p>Follow one from <a href="#all" @onclick:preventDefault @onclick='() => SwitchTab("all")'>all communities on this instance</a>, or create one above to get started.</p>
                    }
                    else if (ActiveTab == "mine")
                    {
                        <p>You don't own any communities yet.</p>
                        <p>Create one above to get started.</p>
                    }
                    else if (ActiveTab == "all-known")
                    {
                        <p>No communities known yet.</p>
                        <p>Follow or interact with a community on another instance to discover it here.</p>
                    }
                    else
                    {
                        <p>No communities on this instance yet.</p>
                        <p>Create one above to get started.</p>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="directory-cards">
                @foreach (var community in shown)
                {
                    var isCreator = Session.ActorId is { } me && community.AttributedTo is { } cAttr &&
                        cAttr.Any(a => (a is IObjectOrLink obj && obj.ResolveObjectIri() is { } oi && oi.Value == me.Value) ||
                                       (a is IObject o && o.Id is { Length: > 0 } oid && oid == me.Value));
                    <div class="community-card">
                        <ActorCard Actor="@community" ActorId="@community.Id" ShowModeration="false" ShowStats="true" ShowSummary="true">
                            <FollowButton TargetActor="@community" IsCommunity="true" FollowChanged="@FollowToggledAsync" />
                            @if (isCreator)
                            {
                                @if (DeleteTargetIri == community.Id)
                                {
                                    <span class="delete-confirm">
                                        <span class="muted">Delete this community?</span>
                                        <button type="button" class="button button--danger" disabled="@DeleteBusy" @onclick="() => DeleteCommunityAsync(community)">
                                            @(DeleteBusy ? "Deleting…" : "Confirm")
                                        </button>
                                        <button type="button" class="button button--secondary" disabled="@DeleteBusy" @onclick="() => DeleteTargetIri = null">Cancel</button>
                                    </span>
                                }
                                else
                                {
                                    <button type="button" class="button button--danger" @onclick="() => DeleteTargetIri = community.Id">Delete</button>
                                }
                                @if (IsCoOwner(community) && IsLastOwner(community))
                                {
                                    <span class="muted text-sm">You are the only owner</span>
                                }
                                else if (IsCoOwner(community))
                                {
                                    @if (LeaveTargetIri == community.Id)
                                    {
                                        <span class="delete-confirm">
                                            <span class="muted">Leave this community?</span>
                                            <button type="button" class="button button--secondary" disabled="@LeaveBusy" @onclick="() => LeaveCommunityAsync(community)">
                                                @(LeaveBusy ? "Leaving…" : "Confirm")
                                            </button>
                                            <button type="button" class="button button--secondary" disabled="@LeaveBusy" @onclick="() => LeaveTargetIri = null">Cancel</button>
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button" class="button button--secondary" @onclick="() => LeaveTargetIri = community.Id">Leave</button>
                                    }
                                }
                                @if (ActiveTab == "mine" && community.Id is { Length: > 0 } cid)
                                {
                                    <a href="@($"/community?iri={Uri.EscapeDataString(cid)}#peers")" class="muted manage-peers-link">Manage peers →</a>
                                }
                            }
                        </ActorCard>
                    </div>
                }
            </div>
        }
    }
}

@code {
    [Inject]
    private IActorSessionAccessor Session { get; set; } = default!;

    private IActivityPubClient? Client => Session.Client;

    private string ActiveTab { get; set; } = "following";

    private List<Group>? Items { get; set; }
    private bool Busy { get; set; }
    private string? Error { get; set; }

    /// <summary>
    /// The IRIs of the actors the signed-in actor follows (the full following collection). Empty
    /// when signed out or the collection cannot be read.
    /// </summary>
    private List<Iri> FollowingIris { get; set; } = [];

    /// <summary>
    /// The communities the signed-in actor follows (the <c>Group</c> documents among the following
    /// collection's targets, local or remote), in following order. Resolved lazily from the
    /// following IRIs + the cached local search so the Following tab is populated immediately after
    /// a follow toggle (the <see cref="FollowButton"/> invalidates the following cache, so the next
    /// read re-walks the collection).
    /// </summary>
    private List<Group>? Following { get; set; }

    private bool FollowingKnown { get; set; }

    /// <summary>
    /// Every community on this instance (the <c>local=true</c> actor search filtered to <c>Group</c>).
    /// </summary>
    private List<Group> All => Items ?? [];

    /// <summary>
    /// S98: every community the instance KNOWS — its own communities plus the cached REMOTE community
    /// Groups it has seen during federation (the <c>local=false</c> actor search, which the server merges
    /// with the community store's cached remote Groups via the S30 A8.2 path, filtered to <c>Group</c>).
    /// Populated alongside <see cref="Items"/> in <see cref="LoadAsync"/>; null until loaded.
    /// </summary>
    private List<Group>? AllKnown { get; set; }

    /// <summary>
    /// Fallback for the Following view when <see cref="Following"/> has not been resolved yet: the
    /// local communities whose IRI is in the following set.
    /// </summary>
    private List<Group> LocalFollowing =>
        Items?.Where(g => g.Id is { } id && FollowingIris.Any(f => string.Equals(f.Value, id, StringComparison.OrdinalIgnoreCase))).ToList()
        ?? [];

    /// <summary>
    /// The communities the signed-in actor owns (the <c>Group</c> documents among the local search
    /// whose <c>attributedTo</c> includes the actor). Shown in the "My communities" tab.
    /// </summary>
    private List<Group> OwnedCommunities =>
        Items is null || Session.ActorId is not { } me
            ? []
            : Items
                .Where(g => g.AttributedTo is { } attr &&
                    attr.Any(a => (a is IObjectOrLink obj && obj.ResolveObjectIri() is { } oi && string.Equals(oi.Value, me.Value, StringComparison.OrdinalIgnoreCase)) ||
                                  (a is IObject o && o.Id is { Length: > 0 } oid && string.Equals(oid, me.Value, StringComparison.OrdinalIgnoreCase))))
                .ToList();

    private Iri? InstanceBase
    {
        get
        {
            if (Session.ActorId is not { } actor)
            {
                return null;
            }

            const string marker = "/ap/v1";
            var value = actor.Value;
            var index = value.IndexOf(marker, StringComparison.Ordinal);
            return index >= 0 ? new Iri(value[..(index + marker.Length)]) : null;
        }
    }

    private string NewName { get; set; } = string.Empty;
    private string NewHandle { get; set; } = string.Empty;
    private string NewDescription { get; set; } = string.Empty;
    private bool ShowCreateForm { get; set; }
    private bool CreateBusy { get; set; }
    private string? CreateError { get; set; }
    private bool CreateSuccess { get; set; }

    private string? DeleteTargetIri { get; set; }
    private bool DeleteBusy { get; set; }
    private string? DeleteError { get; set; }

    private string? LeaveTargetIri { get; set; }
    private bool LeaveBusy { get; set; }
    private string? LeaveError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureReadyAsync();
        await LoadAsync();
    }

    private void SwitchTab(string tab)
    {
        ActiveTab = tab;
    }

    private async Task LoadAsync()
    {
        if (Client is not { } client || InstanceBase is not { } baseIri)
        {
            return;
        }

        Busy = true;
        Error = null;
        try
        {
            // Local-only: this page lists the instance's own communities (the directory's
            // "This instance" scope). The unqualified search returns every cached actor the
            // instance has ever stored (hundreds of remote accounts) and no local Group survives
            // the page's limit — which is why the page rendered empty.
            var results = new List<IObjectOrLink>();
            await foreach (var item in client.SearchAsync(
                                baseIri,
                                string.Empty,
                                new SearchOptions { Type = "Actor", LocalOnly = true }))
            {
                results.Add(item);
            }

            Items = results
                .OfType<Group>()
                .OrderBy(g => g.PreferredUsername ?? g.Id ?? string.Empty, StringComparer.OrdinalIgnoreCase)
                .ToList();

            // S98: the "All known" (federated) surface — this instance's communities PLUS the cached
            // remote community Groups the server has seen. The local=false actor search returns local
            // actors + cached remote actors, and the server merges in the community store's cached
            // remote Groups (S30 A8.2); filtering to Group leaves exactly the known communities.
            var allKnownResults = new List<IObjectOrLink>();
            await foreach (var item in client.SearchAsync(
                                baseIri,
                                string.Empty,
                                new SearchOptions { Type = "Actor", LocalOnly = false }))
            {
                allKnownResults.Add(item);
            }

            AllKnown = allKnownResults
                .OfType<Group>()
                .OrderBy(g => g.PreferredUsername ?? g.Id ?? string.Empty, StringComparer.OrdinalIgnoreCase)
                .ToList();

            FollowingIris = (await Ui.GetFollowingActorIrisAsync()).ToList();
            Following = await ResolveFollowingCommunitiesAsync();
            FollowingKnown = true;
        }
        catch (Exception)
        {
            Error = "We couldn't load the community list right now. Please check your connection and try again.";
        }
        finally
        {
            Busy = false;
        }
    }

    /// <summary>
    /// Re-reads the signed-in actor's following collection (after a follow/unfollow toggle) and
    /// re-renders so the Following view reflects the new state. The <see cref="FollowButton"/>
    /// invalidates the following cache before this runs, so the read below re-walks the collection.
    /// </summary>
    private async Task FollowToggledAsync()
    {
        FollowingIris = (await Ui.GetFollowingActorIrisAsync()).ToList();
        Following = await ResolveFollowingCommunitiesAsync();
        FollowingKnown = true;
    }

    /// <summary>
    /// Resolves the followed communities: every followed <c>Group</c> IRI that is present in the
    /// cached local search (the common case — a local community). A followed community that is NOT
    /// in the local search (a remote community, or one created moments ago before the search cache
    /// refreshed) is fetched by its IRI via the shared <see cref="UiContext.GetActorAsync"/> seam
    /// (which routes a remote actor through the same-origin proxy) and kept when it is a
    /// <c>Group</c> — so the Following tab is never missing a followed community. S4: this is the
    /// fetch-by-IRI fallback the method's doc comment always promised but the code never implemented
    /// (it only matched the local search cache, so a followed REMOTE community was silently dropped).
    /// </summary>
    private async Task<List<Group>> ResolveFollowingCommunitiesAsync()
    {
        if (FollowingIris.Count == 0)
        {
            return [];
        }

        // The local search cache covers every local community the instance has ever stored.
        var byIri = Items?
            .Where(g => g.Id is { Length: > 0 })
            .ToDictionary(g => g.Id!, g => g, StringComparer.OrdinalIgnoreCase);

        var found = new List<Group>();
        foreach (var iri in FollowingIris)
        {
            if (byIri is { } cache && cache.TryGetValue(iri.Value, out var local))
            {
                found.Add(local);
                continue;
            }

            // Not in the local search — a remote community (or a just-created local one the search
            // cache has not refreshed to). Fetch it by IRI; keep it only if it is a community (a
            // followed Person/Service is not a community and is filtered out).
            IObject? doc;
            try
            {
                doc = await Ui.GetActorAsync(iri);
            }
            catch
            {
                continue;
            }

            if (doc is Group group)
            {
                found.Add(group);
            }
        }

        return found;
    }

    private async Task CreateAsync()
    {
        if (Client is not { } client || Session.ActorId is not { } actorId)
        {
            return;
        }

        CreateBusy = true;
        CreateError = null;
        CreateSuccess = false;

        try
        {
            var result = await client.CreateCommunityAsync(actorId, NewHandle.Trim(), NewName.Trim(), NewDescription.Trim());
            if (result.IsSuccess)
            {
                CreateSuccess = true;
                NewName = string.Empty;
                NewHandle = string.Empty;
                NewDescription = string.Empty;
                ShowCreateForm = false;
                await LoadAsync();
            }
            else
            {
                CreateError = $"Failed to create community (HTTP {result.StatusCode}).";
            }
        }
        catch (Exception)
        {
            CreateError = "Something went wrong while creating the community. Please try again.";
        }
        finally
        {
            CreateBusy = false;
        }
    }

    private async Task DeleteCommunityAsync(Group community)
    {
        if (community.Id is not { Length: > 0 } id || Session.LocalModeration is not { } localModeration)
        {
            return;
        }

        DeleteBusy = true;
        DeleteError = null;
        try
        {
            var result = await localModeration.DeleteCommunityAsync(new Iri(id));
            if (result.IsSuccess)
            {
                DeleteTargetIri = null;
                await LoadAsync();
            }
            else
            {
                DeleteError = $"Failed to delete community (HTTP {result.StatusCode}).";
            }
        }
        catch (Exception)
        {
            DeleteError = "Something went wrong while deleting the community. Please try again.";
        }
        finally
        {
            DeleteBusy = false;
        }
    }

    private async Task LeaveCommunityAsync(Group community)
    {
        if (community.Id is not { Length: > 0 } id || Session.LocalModeration is not { } localModeration || Session.ActorId is not { } myIri)
        {
            return;
        }

        LeaveBusy = true;
        LeaveError = null;
        try
        {
            var result = await localModeration.DemoteCommunityOwnerAsync(new Iri(id), myIri);
            if (result.IsSuccess)
            {
                LeaveTargetIri = null;
                await LoadAsync();
            }
            else
            {
                LeaveError = $"Failed to leave community (HTTP {result.StatusCode}).";
            }
        }
        catch (Exception)
        {
            LeaveError = "Something went wrong while leaving the community. Please try again.";
        }
        finally
        {
            LeaveBusy = false;
        }
    }

    private bool IsCoOwner(Group community)
    {
        if (Session.ActorId is not { } me)
        {
            return false;
        }

        return community.AttributedTo is { } attr && attr.Any(a =>
            a is IObjectOrLink obj && obj.ResolveObjectIri() is { } oi && oi.Value == me.Value);
    }

    private bool IsLastOwner(Group community)
    {
        if (community.AttributedTo is not { } attr)
        {
            return true;
        }

        return attr.Count() <= 1;
    }
}
