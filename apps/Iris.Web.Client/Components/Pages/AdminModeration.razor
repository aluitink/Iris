@page "/admin/moderation"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Admin")]

<PageTitle>Admin · Moderation · Iris</PageTitle>

<h2>Moderation queue</h2>

@if (LoadError is not null)
{
    <div class="error">@LoadError</div>
}
else if (Flags is null)
{
    <div class="card profile-loading">
        <svg class="loading-spinner" viewBox="25 25 50 50" aria-hidden="true">
            <circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" />
        </svg>
        <span class="muted">Loading flags…</span>
    </div>
}
else
{
    <div class="card">
        @if (Flags.Count == 0)
        {
            <p class="muted">No flags on this instance.</p>
        }
        else
        {
            <p class="muted">@Flags.Count open flag(s)</p>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Flagged by</th>
                        <th>Actor</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var flag in Flags)
                    {
                        <tr>
                            <td>@ActorHandle(flag.FlaggerIri)</td>
                            <td><a href="/actor?iri=@Uri.EscapeDataString(flag.FlaggedIri)">@ActorHandle(flag.FlaggedIri)</a></td>
                            <td>@flag.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td>
                                <button class="btn btn--small" @onclick="() => DismissAsync(flag)" disabled="@Dismissed.Contains(flag)">
                                    @(Dismissed.Contains(flag) ? "Dismissed" : "Dismiss")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    private HttpClient _http = null!;
    private IReadOnlyList<FlagDto>? Flags { get; set; }
    private string? LoadError { get; set; }
    private readonly HashSet<FlagDto> Dismissed = new();

    [Inject] private IHttpClientFactory HttpFactory { get; set; } = default!;

    protected override void OnInitialized()
    {
        _http = HttpFactory.CreateClient("iris");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await _http.GetAsync("/local/v1/admin/flags");
            if (!response.IsSuccessStatusCode)
            {
                LoadError = $"Failed to load flags (HTTP {(int)response.StatusCode})";
                return;
            }
            var list = System.Text.Json.JsonSerializer.Deserialize<List<FlagDto>>(
                await response.Content.ReadAsStringAsync(),
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            Flags = list;
        }
        catch (Exception ex)
        {
            LoadError = ex.Message;
        }
    }

    private async Task DismissAsync(FlagDto flag)
    {
        try
        {
            var payload = System.Text.Json.JsonSerializer.Serialize(new { flag.FlaggerIri, flag.FlaggedIri });
            var content = new StringContent(payload, System.Text.Encoding.UTF8, "application/json");
            var response = await _http.PostAsync("/local/v1/admin/flags/dismiss", content);
            if (response.IsSuccessStatusCode)
            {
                Dismissed.Add(flag);
                Flags = Flags?.Where(f => f != flag).ToList();
            }
        }
        catch (Exception ex)
        {
            LoadError = ex.Message;
        }
    }

    private static string ActorHandle(string iri)
    {
        var uri = new Uri(iri);
        var segments = uri.Segments;
        return segments.Length > 1 ? segments[^1].TrimEnd('/') : iri;
    }

    private sealed record FlagDto(string FlaggerIri, string FlaggedIri, DateTimeOffset CreatedAt);
}
