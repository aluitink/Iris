@page "/directory"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Iris.Client
@using Iris.Core.Collections
@using Iris.Core.Identity
@using Iris.Web.Client.Accounts
@using Iris.Web.Client.Components
@using Iris.Web.Client.Ui
@using KristofferStrube.ActivityStreams
@using ActivityObject = KristofferStrube.ActivityStreams.Object
@using SearchPage = Iris.Core.Collections.CollectionPage

<PageTitle>Directory · Iris</PageTitle>

<p class="muted">
    Browse people and communities on this instance, or find someone on another server.
</p>

@if (Client is null)
{
    <div class="card"><p class="muted">Sign in to browse the directory.</p></div>
}
else
{
    <div class="card directory-external-lookup">
        <p class="muted">Find someone on another server (e.g. <code>user@mastodon.social</code>):</p>
        <div class="directory-external-form">
            <input type="text" class="directory-external-input" placeholder="user@domain"
                   value="@_externalQuery" @oninput="OnExternalInput" @onkeydown="OnExternalKeydown" />
            @if (_externalBusy)
            {
                <span class="directory-external-spinner" aria-hidden="true">
                    <svg class="loading-spinner" viewBox="25 25 50 50"><circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" /></svg>
                </span>
            }
        </div>
        @if (_externalError is not null)
        {
            <p class="directory-external-error" role="alert">@_externalError</p>
        }
        @if (_externalResult is { } found)
        {
            <div class="directory-external-result">
                <a href="@ActorIdentityHelper.ActorHref(new Iri(found.Id ?? string.Empty))" class="directory-external-link">
                    <ActorAvatar ActorIri="new Iri(found.Id ?? string.Empty)"
                                 DisplayName="@found.Name?.FirstOrDefault()"
                                 IconIriOverride="@ActorIdentityHelper.IconIri(found)"
                                 CssClass="directory-external-avatar" />
                    <span class="directory-external-name">
                        @((found.PreferredUsername ?? found.Id ?? "?").ToString())
                        @if (found.Name is { } names && names.Any())
                        {
                            <span class="muted"> — @names.FirstOrDefault()</span>
                        }
                    </span>
                </a>
            </div>
        }
    </div>

    <div class="directory-toolbar">
        <div class="tab-bar" role="tablist" aria-label="Directory sections">
            <a href="#people" id="tab-people" role="tab" aria-selected="@(ActiveTab == "people")" aria-controls="panel-people" class="tab @(ActiveTab == "people" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("people")'>People</a>
            <a href="#communities" id="tab-communities" role="tab" aria-selected="@(ActiveTab == "communities")" aria-controls="panel-communities" class="tab @(ActiveTab == "communities" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("communities")'>Communities</a>
        </div>
        <div class="directory-scope" role="group" aria-label="Directory scope">
            <button type="button" class="directory-scope-btn @(_localOnly ? "directory-scope-btn--active" : "")" @onclick="ToggleLocalOnly" aria-pressed="@_localOnly">This instance</button>
            <button type="button" class="directory-scope-btn @(!_localOnly ? "directory-scope-btn--active" : "")" @onclick="ToggleLocalOff" aria-pressed="@(!_localOnly)">All known</button>
        </div>
    </div>

    @if (Busy)
    {
        <div class="card card-loading">
            <svg class="loading-spinner" viewBox="25 25 50 50" aria-hidden="true">
                <circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" />
            </svg>
            <span class="muted">Loading…</span>
        </div>
    }
    else if (Error is not null)
    {
        <div class="card"><div class="error" role="alert">@Error</div></div>
    }
    else if (Actors is not null)
    {
        @if (ActiveTab == "people")
        {
            @if (People.Count == 0)
            {
                <div class="card">
                    <p class="muted">No local accounts yet. Be the first — <a href="/register">create an account</a>.</p>
                </div>
            }
            else
            {
                <div class="directory-cards">
                    @foreach (var person in People)
                    {
                        <DirectoryCard Actor="person" />
                    }
                </div>
                @if (HasMore)
                {
                    <div class="directory-pagination">
                        <div class="paged-collection-sentinel" @onclick="LoadMoreAsync" role="button" aria-label="Load more directory entries" tabindex="0"></div>
                        @if (LoadingMore)
                        {
                            <div class="card-loading card-loading-inline">
                                <svg class="loading-spinner" viewBox="25 25 50 50" aria-hidden="true">
                                    <circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" />
                                </svg>
                                <span class="muted">Loading…</span>
                            </div>
                        }
                        else
                        {
                            <button class="button button--ghost paged-collection-loadmore-fallback" @onclick="LoadMoreAsync" disabled="@LoadingMore">Load more</button>
                        }
                    </div>
                }
            }
        }
        else
        {
            @if (Communities.Count == 0)
            {
                <div class="card">
                    <p class="muted">No communities yet. <a href="/communities">Create one</a>.</p>
                </div>
            }
            else
            {
                <div class="directory-cards">
                    @foreach (var community in Communities)
                    {
                        <CommunityCard Community="community" />
                    }
                </div>
                @if (HasMore)
                {
                    <div class="directory-pagination">
                        <div class="paged-collection-sentinel" @onclick="LoadMoreAsync" role="button" aria-label="Load more directory entries" tabindex="0"></div>
                        @if (LoadingMore)
                        {
                            <div class="card-loading card-loading-inline">
                                <svg class="loading-spinner" viewBox="25 25 50 50" aria-hidden="true">
                                    <circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" />
                                </svg>
                                <span class="muted">Loading…</span>
                            </div>
                        }
                        else
                        {
                            <button class="button button--ghost paged-collection-loadmore-fallback" @onclick="LoadMoreAsync" disabled="@LoadingMore">Load more</button>
                        }
                    </div>
                }
            }
        }
    }
}

@code {
    [Inject]
    private IActorSessionAccessor Session { get; set; } = default!;

    [Inject]
    private UiContext Ui { get; set; } = default!;

    private IActivityPubClient? Client => Session.Client;

    private string ActiveTab { get; set; } = "people";
    private bool Busy { get; set; }
    private IReadOnlyList<Actor>? Actors { get; set; }
    private string? Error { get; set; }

    /// <summary>
    /// The directory scope: when true the list shows only this instance's own actors (the directory);
    /// when false it shows every actor the instance stores (local + cached remote — "all known actors").
    /// </summary>
    private bool _localOnly = true;

    // Paged-load state: the directory walks the /ap/v1/search result page by page (the shared
    // sentinel + Load-more pattern). The walk (SearchPagedAsync, one page per server page) is held in
    // _pageEnumerator; each "Load more" pulls the next page from it. HasMore is true until the server
    // stops offering a next page.
    private IAsyncEnumerator<SearchPage>? _pageEnumerator;
    private bool HasMore { get; set; }
    private bool LoadingMore { get; set; }

    private List<Actor> People => Actors?.Where(a => a is not Group).Cast<Actor>().ToList() ?? [];
    private List<Group> Communities => Actors?.OfType<Group>().ToList() ?? [];

    private string _externalQuery = string.Empty;
    private bool _externalBusy;
    private string? _externalError;
    private Actor? _externalResult;

    private void OnExternalInput(ChangeEventArgs e)
    {
        _externalQuery = e.Value?.ToString() ?? string.Empty;
        _externalResult = null;
        _externalError = null;
    }

    private async Task OnExternalKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _externalQuery.Length > 0 && !_externalBusy)
        {
            await LookupExternalAsync();
        }
    }

    /// <summary>
    /// Resolves a <c>user@domain</c> handle via WebFinger (through the home proxy) and fetches the
    /// actor document. The result is displayed as a card linking to the actor detail page.
    /// </summary>
    private async Task LookupExternalAsync()
    {
        var query = _externalQuery.Trim().TrimStart('@');
        if (query.Length == 0)
        {
            return;
        }

        var handle = ParseRemoteHandle(query);
        if (handle is null)
        {
            _externalError = "Enter a handle like <code>user@domain</code> or <code>!community@domain</code> (e.g. <code>alice@mastodon.social</code>, <code>!rust@lemmy.ml</code>).";
            _externalResult = null;
            return;
        }

        _externalBusy = true;
        _externalError = null;
        _externalResult = null;
        try
        {
            var user = handle.Value.user;
            var host = handle.Value.host;
            var preferGroup = handle.Value.preferGroup;

            // 1. WebFinger: resolve the account to an actor IRI (through the home proxy).
            var webfingerUrl = $"https://{host}/.well-known/webfinger?resource=acct:{user}@{host}";
            var proxyResult = await Session.ProxyGetAsync(
                webfingerUrl,
                "application/jrd+json, application/json; q=0.9",
                CancellationToken.None);

            if (!proxyResult.Succeeded)
            {
                // S95: a remote 404 means the host is reachable but the handle does not exist there
                // (say so); any other failure (unreachable host → proxy 502, rejection, not signed in)
                // is a genuine "could not reach".
                _externalError = proxyResult.NotFound
                    ? $"No account found on {host}. Check the handle and try again."
                    : $"Could not reach {host}. Check the domain and try again.";
                return;
            }

            if (proxyResult.Body is not { } webfingerBody)
            {
                _externalError = $"Could not reach {host}. Check the domain and try again.";
                return;
            }

            var actorIri = ParseWebFingerActorIri(webfingerBody, preferGroup);
            if (actorIri is null)
            {
                _externalError = $"No account found for {(preferGroup ? "!" : "@")}{user}@{host}.";
                return;
            }

            var resolvedIri = new Iri(actorIri.ToString()!);

            // 2. Fetch the actor document. S7: this MUST go through Ui.GetActorAsync — the shared
            // fetch path that routes a REMOTE actor through the same-origin proxy seam (a direct
            // cross-origin GET is CORS-/CSP-blocked in the browser, which is exactly the S7 fault:
            // the WebFinger + actor-doc proxy fetches both 200, yet the direct client read returns
            // nothing and the card never appears).
            var fetched = await Ui.GetActorAsync(resolvedIri);
            if (fetched is not Actor actorDoc)
            {
                _externalError = "Found the account but could not load their profile.";
                return;
            }
            _externalResult = actorDoc;
        }
        catch
        {
            _externalError = "Something went wrong. Please try again.";
        }
        finally
        {
            _externalBusy = false;
            // S7: the keydown handler awaits this method (async event handler), so Blazor re-renders
            // automatically once it returns. A fire-and-forget StateHasChanged() is a belt-and-braces
            // re-render (it is NOT awaited, so it cannot deadlock on the UI sync context).
            StateHasChanged();
        }
    }

    /// <summary>
    /// Parses a remote handle (<c>user@host</c>, <c>@user@host</c>, or <c>!community@host</c>) into
    /// its user, host, and preferGroup parts. The <c>preferGroup</c> flag is true when the input
    /// had a <c>!</c> prefix (Lemmy community handle). Returns null when the input is not a
    /// recognizable remote handle.
    /// </summary>
    private static (string user, string host, bool preferGroup)? ParseRemoteHandle(string query)
    {
        var q = query.Trim();
        var preferGroup = false;
        if (q.StartsWith('!'))
        {
            preferGroup = true;
            q = q[1..];
        }
        q = q.TrimStart('@');
        var atIndex = q.LastIndexOf('@');
        if (atIndex <= 0 || atIndex >= q.Length - 1)
        {
            return null;
        }

        var user = q[..atIndex];
        var host = q[(atIndex + 1)..];

        if (host.Length == 0 || (!host.Contains('.') && host != "localhost"))
        {
            return null;
        }

        if (user.Length == 0 || user.Contains('/', StringComparison.Ordinal))
        {
            return null;
        }

        return (user, host, preferGroup);
    }

    /// <summary>
    /// Parses a WebFinger response and extracts the actor IRI from the <c>self</c> link. When
    /// <paramref name="preferGroup"/> is true (Lemmy community handles), prefers a <c>Group</c>
    /// type over a <c>Person</c> type when both are present.
    /// </summary>
    private static Iri? ParseWebFingerActorIri(string json, bool preferGroup = false)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            if (!root.TryGetProperty("links", out var links) || links.ValueKind != System.Text.Json.JsonValueKind.Array)
            {
                return null;
            }

            Iri? fallback = null;
            foreach (var link in links.EnumerateArray())
            {
                var rel = link.TryGetProperty("rel", out var r) ? r.GetString() : null;
                var type = link.TryGetProperty("type", out var t) ? t.GetString() : null;
                if (rel is not "self")
                {
                    continue;
                }

                if (type is null || type.Contains("activity", StringComparison.OrdinalIgnoreCase) || type.Contains("ld+json", StringComparison.OrdinalIgnoreCase))
                {
                    var href = link.TryGetProperty("href", out var h) ? h.GetString() : null;
                    if (href is not null && Iri.TryParse(href, out var iri))
                    {
                        var properties = link.TryGetProperty("properties", out var p) ? p : default;
                        var apType = properties.ValueKind == System.Text.Json.JsonValueKind.Object
                            && properties.TryGetProperty("https://www.w3.org/ns/activitystreams#type", out var at)
                            ? at.GetString()
                            : null;

                        if (preferGroup && apType is not null)
                        {
                            if (apType.Equals("Group", StringComparison.OrdinalIgnoreCase))
                            {
                                return iri;
                            }
                        }

                        fallback ??= iri;
                    }
                }
            }

            return fallback;
        }
        catch
        {
            return null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // EnsureReadyAsync (WASM) loads the signing key before Client becomes non-null; it is a no-op
        // when signed out. When it does real work, the completed key load re-renders this component
        // (the session's client factory signals a state change), so the first actual load happens on
        // that re-render — not here, where Client would still be null and the page would be stuck on
        // the signed-out branch.
        await Session.EnsureReadyAsync();
        if (Client is not null)
        {
            await LoadActorsAsync();
        }
    }

    private void SwitchTab(string tab)
    {
        ActiveTab = tab;
    }

    private async Task ToggleLocalOnly()
    {
        if (_localOnly)
        {
            return;
        }

        _localOnly = true;
        await LoadActorsAsync();
    }

    private async Task ToggleLocalOff()
    {
        if (!_localOnly)
        {
            return;
        }

        _localOnly = false;
        await LoadActorsAsync();
    }

    private async Task LoadActorsAsync()
    {
        if (Client is not { } client || Session.ActorId is not { } actor)
        {
            return;
        }

        Busy = true;
        LoadingMore = false;
        Error = null;
        Actors = [];
        HasMore = false;
        await DisposePageEnumeratorAsync();
        try
        {
            const string marker = "/ap/v1";
            var value = actor.Value;
            var index = value.IndexOf(marker, StringComparison.Ordinal);
            Iri? baseIri = index >= 0 ? new Iri(value[..(index + marker.Length)]) : null;

            if (baseIri is null)
            {
                Error = "Could not determine the instance address.";
                return;
            }

            _pageEnumerator = client.SearchPagedAsync(
                baseIri.Value,
                string.Empty,
                new SearchOptions { Type = "Actor", LocalOnly = _localOnly, Limit = DirectoryPageSize })
                .GetAsyncEnumerator();

            if (!await _pageEnumerator.MoveNextAsync())
            {
                return;
            }

            AppendPage(_pageEnumerator.Current);
            HasMore = _pageEnumerator.Current.NextPage is not null;
            Actors = SortActors();
        }
        catch (Exception)
        {
            Error = "We couldn't load the directory. Please check your connection and try again.";
        }
        finally
        {
            Busy = false;
        }
    }

    /// <summary>
    /// Loads the next page of the directory (the sentinel / "Load more" action): pulls the next page
    /// from the search walk, appends its actors, and keeps <see cref="HasMore"/> true until the server
    /// stops offering a next page.
    /// </summary>
    private async Task LoadMoreAsync()
    {
        if (LoadingMore || !HasMore || _pageEnumerator is null || Actors is null)
        {
            return;
        }

        LoadingMore = true;
        Error = null;
        try
        {
            if (await _pageEnumerator.MoveNextAsync())
            {
                AppendPage(_pageEnumerator.Current);
                if (_pageEnumerator.Current.NextPage is not null)
                {
                    HasMore = true;
                }
                else
                {
                    HasMore = false;
                    await DisposePageEnumeratorAsync();
                }

                Actors = SortActors();
            }
            else
            {
                HasMore = false;
                await DisposePageEnumeratorAsync();
            }
        }
        catch (Exception)
        {
            Error = "We couldn't load more of the directory. Please try again.";
        }
        finally
        {
            LoadingMore = false;
        }
    }

    private void AppendPage(SearchPage page)
    {
        var actors = page.Items.OfType<Actor>().ToList();
        if (actors.Count > 0 && Actors is not null)
        {
            Actors = Actors.Concat(actors).ToList();
        }
    }

    private IReadOnlyList<Actor> SortActors()
        => (Actors ?? [])
            .OrderBy(a => a.PreferredUsername ?? a.Id ?? string.Empty, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private async Task DisposePageEnumeratorAsync()
    {
        if (_pageEnumerator is { } enumerator)
        {
            _pageEnumerator = null;
            await enumerator.DisposeAsync();
        }
    }

    private const int DirectoryPageSize = 100;
}
