@page "/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Iris.Client
@using Iris.Client.Collections
@using Iris.Core.Identity
@using Iris.Web.Client.Accounts
@using Iris.Web.Client.Ui
@using KristofferStrube.ActivityStreams

<PageTitle>Settings · Iris</PageTitle>

<h2>Settings</h2>

@if (Client is null)
{
    <div class="card"><p class="muted">Sign in to manage your settings.</p></div>
}
else
{
    <div class="tab-bar">
        <a href="#account" class="tab @(ActiveTab == "account" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("account")'>Account</a>
        <a href="#password" class="tab @(ActiveTab == "password" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("password")'>Password</a>
        <a href="#notifications" class="tab @(ActiveTab == "notifications" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("notifications")'>Notifications</a>
        <a href="#communities" class="tab @(ActiveTab == "communities" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("communities")'>Communities</a>
        <a href="#relays" class="tab @(ActiveTab == "relays" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("relays")'>Relays</a>
        <a href="#moderation" class="tab @(ActiveTab == "moderation" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("moderation")'>Moderation</a>
        <a href="#danger" class="tab tab--danger @(ActiveTab == "danger" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("danger")'>Danger</a>
    </div>

    @if (ActiveTab == "account")
    {
        <div class="card">
            <h3>Account</h3>
            @if (ActorDoc is not null)
            {
                <div class="settings-account-info">
                    <ActorProfile Actor="ActorDoc" ActorId="@(Session.ActorId?.Value)" />
                    <p class="muted" style="margin-top: 0.75rem;">
                        <a href="/profile">Edit your profile</a> to update your display name and description.
                    </p>
                </div>
            }
            else
            {
                <div class="card-loading">
                    <svg class="loading-spinner" viewBox="25 25 50 50" aria-hidden="true">
                        <circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" />
                    </svg>
                    <span class="muted">Loading…</span>
                </div>
            }
        </div>
    }
    else if (ActiveTab == "password")
    {
        <div class="card">
            <h3>Change password</h3>
            @if (PasswordError is not null)
            {
                <div class="error">@PasswordError</div>
            }
            @if (PasswordSuccess)
            {
                <div class="success">Password changed successfully.</div>
            }
            <div style="display: flex; flex-direction: column; gap: 0.75rem; max-width: 28rem;">
                <div>
                    <label class="label" for="current-password">Current password</label>
                    <input id="current-password" type="password" class="input" value="@CurrentPassword"
                           @onchange="e => CurrentPassword = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div>
                    <label class="label" for="new-password">New password</label>
                    <input id="new-password" type="password" class="input" value="@NewPassword"
                           @onchange="e => NewPassword = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div>
                    <label class="label" for="confirm-password">Confirm new password</label>
                    <input id="confirm-password" type="password" class="input" value="@ConfirmPassword"
                           @onchange="e => ConfirmPassword = e.Value?.ToString() ?? string.Empty" />
                </div>
                <button class="button" disabled="@PasswordBusy" @onclick="ChangePasswordAsync">
                    @(PasswordBusy ? "Changing…" : "Change password")
                </button>
            </div>
        </div>
    }
    else if (ActiveTab == "notifications")
    {
        <div class="card">
            <h3>Notifications</h3>
            @if (NotifBusy)
            {
                <div class="card-loading">
                    <svg class="loading-spinner" viewBox="25 25 50 50" aria-hidden="true">
                        <circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" />
                    </svg>
                    <span class="muted">Loading…</span>
                </div>
            }
            else if (NotifError is not null)
            {
                <div class="error">@NotifError</div>
            }
            else if (NotifPrefs is not null)
            {
                <h4>Notification types</h4>
                <p class="muted">Choose which types of activities you want to receive as notifications.</p>
                @foreach (var (type, label) in NotifTypeOptions)
                {
                    var isEnabled = !NotifPrefs.DisabledTypes.Contains(type);
                    <label class="notif-pref-row">
                        <input type="checkbox" checked="@isEnabled"
                               @onchange="e => ToggleNotifType(type, e.Value is bool b && b)" />
                        <span>@label</span>
                    </label>
                }

                <h4 style="margin-top: 1.5rem;">Muted actors</h4>
                <p class="muted">Notifications from these actors will be hidden.</p>
                @if (NotifPrefs.MutedActors.Count == 0)
                {
                    <p class="muted">No muted actors.</p>
                }
                else
                {
                    <div class="directory-list">
                        @foreach (var iri in NotifPrefs.MutedActors)
                        {
                            <div class="directory-item">
                                <div class="directory-item-body">
                                    <a href="@($"/actor?iri={Uri.EscapeDataString(iri)}")" class="object-actor-handle">@HandleFromIri(new Iri(iri))</a>
                                    <span class="muted" style="font-size: 0.85rem;">Muted</span>
                                </div>
                                <button class="button button--ghost" @onclick="() => RemoveMutedActor(iri)">Unmute</button>
                            </div>
                        }
                    </div>
                }
                <div style="margin-top: 1rem; display: flex; gap: 0.5rem;">
                    <input type="text" class="input" style="max-width: 20rem;" placeholder="Actor IRI (e.g. https://iris.luit.ink/ap/v1/u/bob)"
                           value="@MutedActorInput"
                           @onchange="e => MutedActorInput = e.Value?.ToString() ?? string.Empty" />
                    <button class="button" @onclick="AddMutedActor">Mute</button>
                </div>

                @if (NotifSaved)
                {
                    <div class="success" style="margin-top: 0.75rem;">Preferences saved.</div>
                }
            }
        </div>
    }
    else if (ActiveTab == "communities")
    {
        <div class="card">
            <h3>Your communities</h3>
            @if (CommunitiesBusy)
            {
                <div class="card-loading">
                    <svg class="loading-spinner" viewBox="25 25 50 50" aria-hidden="true">
                        <circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" />
                    </svg>
                    <span class="muted">Loading communities…</span>
                </div>
            }
            else if (CommunitiesError is not null)
            {
                <div class="error">@CommunitiesError</div>
            }
            else if (MemberCommunities is not null)
            {
                @if (MemberCommunities.Count == 0)
                {
                    <p class="muted">You are not a member of any communities yet. <a href="/communities">Browse communities</a> to find one.</p>
                }
                else
                {
                    <div class="directory-list">
                        @foreach (var community in MemberCommunities)
                        {
                            var name = community.Name?.FirstOrDefault() ?? "Unnamed";
                            var iri = community.Id;

                            <div class="directory-item">
                                <div class="directory-item-body">
                                    <a href="@($"/community?iri={Uri.EscapeDataString(iri ?? string.Empty)}")" class="object-actor-handle">@name</a>
                                    <span class="muted" style="font-size: 0.85rem;">Member</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    }
    else if (ActiveTab == "relays")
    {
        <div class="card">
            <h3>Relay subscriptions</h3>
            <p class="muted" style="margin-bottom: 1rem;">
                Relays are fan-out servers that receive a copy of your public posts.
                Subscribing to a relay makes your content available to other ActivityPub
                instances that follow that relay.
            </p>
            @if (RelaysBusy)
            {
                <div class="card-loading">
                    <svg class="loading-spinner" viewBox="25 25 50 50" aria-hidden="true">
                        <circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" />
                    </svg>
                    <span class="muted">Loading relays…</span>
                </div>
            }
            else if (RelaysError is not null)
            {
                <div class="error">@RelaysError</div>
            }
            else if (Relays is not null)
            {
                @if (Relays.Count == 0)
                {
                    <p class="muted">You are not subscribed to any relays.</p>
                }
                else
                {
                    <div class="directory-list">
                        @foreach (var relayIri in Relays)
                        {
                            <div class="directory-item">
                                <div class="directory-item-body">
                                    <a href="@relayIri.Value" target="_blank" rel="noopener noreferrer" class="object-actor-handle">@RelayHost(relayIri)</a>
                                    <span class="muted" style="font-size: 0.85rem;">@relayIri.Value</span>
                                </div>
                                <button class="button button--ghost" disabled="@RelaysBusy" @onclick="() => UnsubscribeRelayAsync(relayIri)">Remove</button>
                            </div>
                        }
                    </div>
                }

                <div style="margin-top: 1.25rem; display: flex; gap: 0.5rem;">
                    <input type="url" class="input" placeholder="https://relay.example.com" value="@RelayIriInput"
                           @onchange="e => RelayIriInput = e.Value?.ToString() ?? string.Empty" style="flex: 1;" />
                    <button class="button" disabled="@RelaysBusy" @onclick="SubscribeRelayAsync">Subscribe</button>
                </div>
            }
        </div>
    }
    else if (ActiveTab == "moderation")
    {
        <div class="card">
            <h3>Moderation</h3>
            @if (ModerationBusy)
            {
                <div class="card-loading">
                    <svg class="loading-spinner" viewBox="25 25 50 50" aria-hidden="true">
                        <circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" />
                    </svg>
                    <span class="muted">Loading moderation lists…</span>
                </div>
            }
            else if (ModerationError is not null)
            {
                <div class="error">@ModerationError</div>
            }
            else if (BlockedActors is not null || MutedActors is not null || FlaggedActors is not null)
            {
                <h4>Blocked</h4>
                @if (BlockedActors!.Count == 0)
                {
                    <p class="muted">You have not blocked anyone.</p>
                }
                else
                {
                    <div class="directory-list">
                        @foreach (var actorIri in BlockedActors)
                        {
                            <div class="directory-item">
                                <div class="directory-item-body">
                                    <a href="@($"/actor?iri={Uri.EscapeDataString(actorIri.Value)}")" class="object-actor-handle">@HandleFromIri(actorIri)</a>
                                    <span class="muted" style="font-size: 0.85rem;">Blocked</span>
                                </div>
                                <button class="button button--ghost" disabled="@ModerationBusy" @onclick="() => UnblockAsync(actorIri)">Unblock</button>
                            </div>
                        }
                    </div>
                }

                <h4 style="margin-top: 1.5rem;">Muted</h4>
                @if (MutedActors!.Count == 0)
                {
                    <p class="muted">You have not muted anyone.</p>
                }
                else
                {
                    <div class="directory-list">
                        @foreach (var actorIri in MutedActors)
                        {
                            <div class="directory-item">
                                <div class="directory-item-body">
                                    <a href="@($"/actor?iri={Uri.EscapeDataString(actorIri.Value)}")" class="object-actor-handle">@HandleFromIri(actorIri)</a>
                                    <span class="muted" style="font-size: 0.85rem;">Muted</span>
                                </div>
                                <button class="button button--ghost" disabled="@ModerationBusy" @onclick="() => UnmuteAsync(actorIri)">Unmute</button>
                            </div>
                        }
                    </div>
                }

                <h4 style="margin-top: 1.5rem;">Reported</h4>
                @if (FlaggedActors!.Count == 0)
                {
                    <p class="muted">You have not reported anyone.</p>
                }
                else
                {
                    <div class="directory-list">
                        @foreach (var actorIri in FlaggedActors)
                        {
                            <div class="directory-item">
                                <div class="directory-item-body">
                                    <a href="@($"/actor?iri={Uri.EscapeDataString(actorIri.Value)}")" class="object-actor-handle">@HandleFromIri(actorIri)</a>
                                    <span class="muted" style="font-size: 0.85rem;">Reported</span>
                                </div>
                                <button class="button button--ghost" disabled="@ModerationBusy" @onclick="() => UnflagAsync(actorIri)">Remove</button>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    }
    else if (ActiveTab == "danger")
    {
        <div class="card card--danger">
            <h3>Account deletion</h3>
            <p>Deleting your account is <strong>permanent and irreversible</strong>. All your posts will be
            removed, your profile will disappear, and you will be unable to log in. Followers will no
            longer see your content.</p>
            @if (DeleteError is not null)
            {
                <div class="error">@DeleteError</div>
            }
            @if (_deleteConfirm)
            {
                <p style="color: var(--color-danger, #c0392b); font-weight: bold;">
                    Are you absolutely sure? This cannot be undone.
                </p>
                <button class="button button--danger" disabled="@DeleteBusy" @onclick="DeleteAccountAsync">
                    Yes, permanently delete my account
                </button>
                <button class="button button--ghost" @onclick="() => _deleteConfirm = false">Cancel</button>
            }
            else
            {
                <button class="button button--danger" @onclick="() => _deleteConfirm = true">Delete my account</button>
            }
        </div>
    }
}

@code {
    [Inject]
    private IActorSessionAccessor Session { get; set; } = default!;

    [Inject]
    private UiContext Ui { get; set; } = default!;

    [Inject]
    private IHttpClientFactory HttpFactory { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private HttpClient _http = null!;

    private IActivityPubClient? Client => Session.Client;
    private ILocalModerationClient? LocalModeration => Session.LocalModeration;
    private string ActiveTab { get; set; } = "account";
    private IObject? ActorDoc { get; set; }
    private List<Group>? MemberCommunities { get; set; }
    private bool CommunitiesBusy { get; set; }
    private string? CommunitiesError { get; set; }
    private List<Iri>? BlockedActors { get; set; }
    private List<Iri>? MutedActors { get; set; }
    private List<Iri>? FlaggedActors { get; set; }
    private Dictionary<string, string>? BlockActivityIris { get; set; }
    private Dictionary<string, string>? FlagActivityIris { get; set; }
    private bool ModerationBusy { get; set; }
    private string? ModerationError { get; set; }
    private List<Iri>? Relays { get; set; }
    private string RelayIriInput { get; set; } = string.Empty;
    private bool RelaysBusy { get; set; }
    private string? RelaysError { get; set; }
    private string CurrentPassword { get; set; } = string.Empty;
    private string NewPassword { get; set; } = string.Empty;
    private string ConfirmPassword { get; set; } = string.Empty;
    private bool PasswordBusy { get; set; }
    private string? PasswordError { get; set; }
    private bool PasswordSuccess { get; set; }
    private bool _deleteConfirm;
    private bool DeleteBusy { get; set; }
    private string? DeleteError { get; set; }
    private NotifPrefsModel? NotifPrefs { get; set; }
    private bool NotifBusy { get; set; }
    private string? NotifError { get; set; }
    private bool NotifSaved { get; set; }
    private string MutedActorInput { get; set; } = string.Empty;

    private static readonly (string Type, string Label)[] NotifTypeOptions =
    [
        ("Follow", "New followers"),
        ("Like", "Likes on your posts"),
        ("Announce", "Boosts / shares"),
        ("Create", "Replies to your posts"),
    ];

    private Iri? InstanceBase
    {
        get
        {
            if (Session.ActorId is not { } actor)
            {
                return null;
            }

            const string marker = "/ap/v1";
            var value = actor.Value;
            var index = value.IndexOf(marker, StringComparison.Ordinal);
            return index >= 0 ? new Iri(value[..(index + marker.Length)]) : null;
        }
    }

    /// <summary>
    /// Primes the session's signing key so <c>Session.ActorId</c>/<c>Session.Client</c> resolve before
    /// the account tab renders.
    /// </summary>
    protected override void OnInitialized()
    {
        _http = HttpFactory.CreateClient("iris");
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureReadyAsync();
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        if (Session.ActorId is { } actorId && ActorDoc is null)
        {
            _ = LoadActorAsync(actorId);
        }
    }

    private async Task LoadActorAsync(Iri actorId)
    {
        try
        {
            ActorDoc = await Ui.GetActorAsync(actorId);
        }
        catch
        {
            // Non-fatal: the account tab will show the loading state.
        }

        StateHasChanged();
    }

    private void SwitchTab(string tab)
    {
        ActiveTab = tab;
        if (tab == "communities" && MemberCommunities is null && CommunitiesError is null)
        {
            _ = LoadMemberCommunitiesAsync();
        }
        if (tab == "relays" && Relays is null && RelaysError is null)
        {
            _ = LoadRelaysAsync();
        }
        if (tab == "moderation" && (BlockedActors is null || MutedActors is null || FlaggedActors is null) && ModerationError is null)
        {
            _ = LoadModerationAsync();
        }
        if (tab == "notifications" && NotifPrefs is null && NotifError is null)
        {
            _ = LoadNotifPrefsAsync();
        }
    }

    private string HandleFromIri(Iri actorIri)
    {
        const string marker = "/ap/v1/u/";
        var value = actorIri.Value;
        var index = value.IndexOf(marker, StringComparison.Ordinal);
        if (index < 0)
        {
            return value;
        }

        var handle = value[(index + marker.Length)..];
        var slash = handle.IndexOf('/');
        return slash >= 0 ? handle[..slash] : handle;
    }

    private async Task LoadModerationAsync()
    {
        if (Client is not { } client || Session.ActorId is not { } me)
        {
            return;
        }

        ModerationBusy = true;
        ModerationError = null;

        try
        {
            BlockedActors = await CollectIrisAsync(client.GetBlocksAsync(me));
            MutedActors = await CollectIrisAsync(client.GetMutesAsync(me));
            FlaggedActors = await CollectIrisAsync(client.GetFlagsAsync(me));
            (BlockActivityIris, FlagActivityIris) = await CollectActivityIrisAsync(client, me);
        }
        catch (Exception)
        {
            ModerationError = "That moderation action couldn't be completed. Please try again.";
        }
        finally
        {
            ModerationBusy = false;
        }

        StateHasChanged();
    }

    private static async Task<List<Iri>> CollectIrisAsync(IAsyncEnumerable<IObjectOrLink> items)
    {
        var result = new List<Iri>();
        await foreach (var item in items)
        {
            if (item is Link link && link.Href is { } href)
            {
                result.Add(new Iri(href.ToString()));
            }
        }

        return result;
    }

    private async Task<(Dictionary<string, string>, Dictionary<string, string>)> CollectActivityIrisAsync(
        IActivityPubClient client, Iri actorId)
    {
        var blockMap = new Dictionary<string, string>();
        var flagMap = new Dictionary<string, string>();

        try
        {
            await foreach (var item in client.GetCollectionItemsAsync(actorId.OutboxOf()))
            {
                if (item is not IObject activity || activity.Id is not { Length: > 0 } activityId)
                {
                    continue;
                }

                var type = activity is Block ? "Block" : activity is Flag ? "Flag" : null;
                var objectIri = activity is KristofferStrube.ActivityStreams.Activity act
                    ? act.Object?.FirstOrDefault()
                    : null;
                var targetValue = objectIri switch
                {
                    Link link => link.Href?.ToString(),
                    IObject obj => obj.Id,
                    _ => null,
                };

                if (targetValue is null)
                {
                    continue;
                }

                if (type == "Block")
                {
                    blockMap[targetValue] = activityId;
                }
                else if (type == "Flag")
                {
                    flagMap[targetValue] = activityId;
                }
            }
        }
        catch
        {
            // Best-effort: if the outbox read fails, the maps stay empty and
            // unblock/unflag will fall back to the target IRI.
        }

        return (blockMap, flagMap);
    }

    private async Task UnblockAsync(Iri target)
    {
        if (Client is not { } client || Session.ActorId is not { } me)
        {
            return;
        }

        ModerationBusy = true;
        ModerationError = null;

        try
        {
            var blockIri = BlockActivityIris is { } map && map.TryGetValue(target.Value, out var mintedId)
                ? new Iri(mintedId)
                : target;
            await client.UnblockAsync(me, blockIri);
            BlockedActors = BlockedActors is { } blocks
                ? blocks.Where(b => b != target).ToList()
                : [];
            if (BlockActivityIris is { } bm)
            {
                bm.Remove(target.Value);
            }
        }
        catch (Exception)
        {
            ModerationError = "That moderation action couldn't be completed. Please try again.";
        }
        finally
        {
            ModerationBusy = false;
        }

        StateHasChanged();
    }

    private async Task UnmuteAsync(Iri target)
    {
        if (LocalModeration is not { } mod || Session.ActorId is not { } me)
        {
            return;
        }

        ModerationBusy = true;
        ModerationError = null;

        try
        {
            await mod.UnmuteAsync(me, target);
            MutedActors = MutedActors is { } mutes
                ? mutes.Where(m => m != target).ToList()
                : [];
        }
        catch (Exception)
        {
            ModerationError = "That moderation action couldn't be completed. Please try again.";
        }
        finally
        {
            ModerationBusy = false;
        }

        StateHasChanged();
    }

    private async Task UnflagAsync(Iri target)
    {
        if (Client is not { } client || Session.ActorId is not { } me)
        {
            return;
        }

        ModerationBusy = true;
        ModerationError = null;

        try
        {
            var flagIri = FlagActivityIris is { } map && map.TryGetValue(target.Value, out var mintedId)
                ? new Iri(mintedId)
                : target;
            await client.UnflagAsync(me, flagIri);
            FlaggedActors = FlaggedActors is { } flags
                ? flags.Where(f => f != target).ToList()
                : [];
            if (FlagActivityIris is { } fm)
            {
                fm.Remove(target.Value);
            }
        }
        catch (Exception)
        {
            ModerationError = "That moderation action couldn't be completed. Please try again.";
        }
        finally
        {
            ModerationBusy = false;
        }

        StateHasChanged();
    }

    private async Task ChangePasswordAsync()
    {
        PasswordError = null;
        PasswordSuccess = false;

        if (NewPassword != ConfirmPassword)
        {
            PasswordError = "New password and confirmation do not match.";
            StateHasChanged();
            return;
        }

        PasswordBusy = true;

        try
        {
            var payload = System.Text.Json.JsonSerializer.Serialize(new { CurrentPassword, NewPassword });
            var content = new StringContent(payload, System.Text.Encoding.UTF8, "application/json");
            var response = await _http.PostAsync("/local/v1/account/password", content);
            if (response.IsSuccessStatusCode)
            {
                PasswordSuccess = true;
                CurrentPassword = string.Empty;
                NewPassword = string.Empty;
                ConfirmPassword = string.Empty;
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                using var doc = System.Text.Json.JsonDocument.Parse(body);
                PasswordError = doc.RootElement.TryGetProperty("error", out var err) ? err.GetString() : "Password change failed.";
            }
        }
        catch (Exception)
        {
            PasswordError = "Your password couldn't be changed. Please try again.";
        }
        finally
        {
            PasswordBusy = false;
        }

        StateHasChanged();
    }

    private async Task DeleteAccountAsync()
    {
        DeleteBusy = true;
        DeleteError = null;

        try
        {
            var response = await _http.DeleteAsync("/local/v1/account");
            if (response.IsSuccessStatusCode)
            {
                // Redirect to login after a short delay so the user sees the confirmation.
                await Task.Delay(500);
                Navigation.NavigateTo("/logout", forceLoad: true);
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                using var doc = System.Text.Json.JsonDocument.Parse(body);
                DeleteError = doc.RootElement.TryGetProperty("error", out var err) ? err.GetString() : "Deletion failed.";
            }
        }
        catch (Exception)
        {
            DeleteError = "Your account couldn't be deleted. Please try again.";
        }
        finally
        {
            DeleteBusy = false;
        }

        StateHasChanged();
    }

    private sealed class NotifPrefsModel
    {
        public HashSet<string> DisabledTypes { get; set; } = [];
        public HashSet<string> MutedActors { get; set; } = [];
    }

    private async Task LoadNotifPrefsAsync()
    {
        NotifBusy = true;
        NotifError = null;
        NotifSaved = false;

        try
        {
            var response = await _http.GetAsync("/local/v1/account/notification-preferences");
            if (!response.IsSuccessStatusCode)
            {
                NotifError = $"Failed to load preferences (HTTP {(int)response.StatusCode})";
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                using var doc = System.Text.Json.JsonDocument.Parse(body);
                var prefs = new NotifPrefsModel();
                if (doc.RootElement.TryGetProperty("disabledTypes", out var dt))
                {
                    foreach (var t in dt.EnumerateArray())
                    {
                        var s = t.GetString();
                        if (s is not null) prefs.DisabledTypes.Add(s);
                    }
                }
                if (doc.RootElement.TryGetProperty("mutedActors", out var ma))
                {
                    foreach (var a in ma.EnumerateArray())
                    {
                        var s = a.GetString();
                        if (s is not null) prefs.MutedActors.Add(s);
                    }
                }
                NotifPrefs = prefs;
            }
        }
        catch (Exception)
        {
            NotifError = "We couldn't load your notification preferences. Please try again.";
        }
        finally
        {
            NotifBusy = false;
        }

        StateHasChanged();
    }

    private void ToggleNotifType(string type, bool enabled)
    {
        if (NotifPrefs is null) return;
        if (enabled)
        {
            NotifPrefs.DisabledTypes.Remove(type);
        }
        else
        {
            NotifPrefs.DisabledTypes.Add(type);
        }
        _ = SaveNotifPrefsAsync();
    }

    private void AddMutedActor()
    {
        if (NotifPrefs is null || string.IsNullOrWhiteSpace(MutedActorInput)) return;
        NotifPrefs.MutedActors.Add(MutedActorInput.Trim());
        MutedActorInput = string.Empty;
        _ = SaveNotifPrefsAsync();
    }

    private void RemoveMutedActor(string iri)
    {
        if (NotifPrefs is null) return;
        NotifPrefs.MutedActors.Remove(iri);
        _ = SaveNotifPrefsAsync();
    }

    private async Task SaveNotifPrefsAsync()
    {
        if (NotifPrefs is null) return;
        NotifSaved = false;

        try
        {
            var payload = System.Text.Json.JsonSerializer.Serialize(new
            {
                disabledTypes = NotifPrefs.DisabledTypes.ToList(),
                mutedActors = NotifPrefs.MutedActors.ToList(),
            });
            var content = new StringContent(payload, System.Text.Encoding.UTF8, "application/json");
            var response = await _http.PutAsync("/local/v1/account/notification-preferences", content);
            NotifSaved = response.IsSuccessStatusCode;
        }
        catch (Exception)
        {
            NotifError = "Your notification preferences couldn't be saved. Please try again.";
        }

        StateHasChanged();
    }

    private async Task LoadRelaysAsync(bool bypassCache = false)
    {
        if (Client is not { } client || Session.ActorId is not { } me)
        {
            return;
        }

        RelaysBusy = true;
        RelaysError = null;

        try
        {
            var query = bypassCache ? new CollectionQuery { BypassCache = true } : null;
            Relays = await CollectIrisAsync(client.GetRelaysAsync(me, query));
        }
        catch (Exception)
        {
            RelaysError = "We couldn't load your relay list. Please try again.";
        }
        finally
        {
            RelaysBusy = false;
        }

        StateHasChanged();
    }

    private async Task SubscribeRelayAsync()
    {
        if (LocalModeration is not { } mod || Session.ActorId is not { } me)
        {
            return;
        }

        if (!Uri.TryCreate(RelayIriInput, UriKind.Absolute, out var uri) ||
            (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps))
        {
            RelaysError = "Please enter a valid http(s) URL.";
            StateHasChanged();
            return;
        }

        RelaysBusy = true;
        RelaysError = null;

        try
        {
            var relayIri = new Iri(uri.GetLeftPart(UriPartial.Authority));
            var result = await mod.SubscribeRelayAsync(me, relayIri);
            if (!result.IsSuccess)
            {
                RelaysError = $"Subscription failed (HTTP {(int)result.StatusCode}).";
            }
            else
            {
                RelayIriInput = string.Empty;
                await LoadRelaysAsync(bypassCache: true);
                return;
            }
        }
        catch (Exception)
        {
            RelaysError = "The relay couldn't be subscribed. Please check the URL and try again.";
        }
        finally
        {
            RelaysBusy = false;
        }

        StateHasChanged();
    }

    private async Task UnsubscribeRelayAsync(Iri relayIri)
    {
        if (LocalModeration is not { } mod || Session.ActorId is not { } me)
        {
            return;
        }

        RelaysBusy = true;
        RelaysError = null;

        try
        {
            var result = await mod.UnsubscribeRelayAsync(me, relayIri);
            if (!result.IsSuccess)
            {
                RelaysError = $"Unsubscribe failed (HTTP {(int)result.StatusCode}).";
            }
            else
            {
                await LoadRelaysAsync(bypassCache: true);
                return;
            }
        }
        catch (Exception)
        {
            RelaysError = "The relay couldn't be removed. Please try again.";
        }
        finally
        {
            RelaysBusy = false;
        }

        StateHasChanged();
    }

    private static string RelayHost(Iri relayIri)
    {
        if (Uri.TryCreate(relayIri.Value, UriKind.Absolute, out var uri))
        {
            return uri.Host;
        }

        return relayIri.Value;
    }

    private async Task LoadMemberCommunitiesAsync()
    {
        if (Client is not { } client || InstanceBase is not { } baseIri)
        {
            return;
        }

        CommunitiesBusy = true;
        CommunitiesError = null;

        try
        {
            var results = new List<IObjectOrLink>();
            await foreach (var item in client.SearchAsync(
                                baseIri,
                                string.Empty,
                                new SearchOptions { Type = "Actor" }))
            {
                results.Add(item);
            }

            var allCommunities = results
                .OfType<KristofferStrube.ActivityStreams.Object>()
                .Where(o => o is Group)
                .Cast<Group>()
                .OrderBy(g => g.Id ?? string.Empty, StringComparer.Ordinal)
                .ToList();

            var memberCommunities = new List<Group>();
            foreach (var community in allCommunities)
            {
                if (community.Id is { Length: > 0 } id && Iri.TryParse(id, out var communityIri))
                {
                    if (await Ui.IsMemberAsync(communityIri))
                    {
                        memberCommunities.Add(community);
                    }
                }
            }

            MemberCommunities = memberCommunities;
        }
        catch (Exception)
        {
            CommunitiesError = "We couldn't load your communities. Please try again.";
        }
        finally
        {
            CommunitiesBusy = false;
        }

        StateHasChanged();
    }
}
