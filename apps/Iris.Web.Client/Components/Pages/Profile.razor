@page "/profile"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Iris.Client
@using Iris.Core.Identity
@using Iris.Web.Client.Accounts
@using Iris.Web.Client.Components
@using Iris.Web.Client.Ui
@using KristofferStrube.ActivityStreams

<PageTitle>Profile · Iris</PageTitle>

@if (LoadError is not null)
{
    <div class="error" role="alert">@LoadError</div>
}
else
{
    @if (ActorDoc is not null)
    {
        <div class="profile-card-header">
            @if (_editing)
            {
                <ActorCard Actor="ActorDoc" ActorId="@(Session.ActorId?.Value)" ShowModeration="false" ShowStats="false" ShowSummary="true" />
                <EditProfileForm
                    InitialIconIri="@(GetIconIri())"
                    InitialName="@(ActorObj?.Name?.FirstOrDefault() ?? string.Empty)"
                    InitialSummary="@(ActorObj?.Summary?.FirstOrDefault() ?? string.Empty)"
                    InitialApproveFollowers="@(ActorObj?.GetManuallyApprovesFollowers() ?? false)"
                    Saving="_saving"
                    SaveError="@(SaveError)"
                    OnIconUpload="UploadIconAsync"
                    OnSubmit="SubmitEditAsync"
                    OnCancel="() => CancelEdit()" />
            }
            else
            {
                <ActorCard Actor="ActorDoc" ActorId="@(Session.ActorId?.Value)" ShowModeration="false" ShowStats="false" ShowSummary="true">
                    <button class="btn" @onclick:stopPropagation @onclick="StartEdit">Edit profile</button>
                </ActorCard>
            }
        </div>
    }
    else
    {
        <div class="card profile-loading">
            <svg class="loading-spinner" viewBox="25 25 50 50" aria-hidden="true">
                <circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" />
            </svg>
            <span class="muted">Loading your profile…</span>
        </div>
    }

    <div class="tab-bar" role="tablist" aria-label="Profile sections">
        <a href="#posts" id="tab-posts" role="tab" aria-selected="@(ActiveTab == "posts")" aria-controls="panel-posts" class="tab @(ActiveTab == "posts" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("posts")'>Your posts</a>
        <a href="#replies" id="tab-replies" role="tab" aria-selected="@(ActiveTab == "replies")" aria-controls="panel-replies" class="tab @(ActiveTab == "replies" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("replies")'>Replies</a>
        <a href="#likes" id="tab-likes" role="tab" aria-selected="@(ActiveTab == "likes")" aria-controls="panel-likes" class="tab @(ActiveTab == "likes" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("likes")'>Likes</a>
        <a href="#followers" id="tab-followers" role="tab" aria-selected="@(ActiveTab == "followers")" aria-controls="panel-followers" class="tab @(ActiveTab == "followers" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("followers")'>Followers</a>
        <a href="#following" id="tab-following" role="tab" aria-selected="@(ActiveTab == "following")" aria-controls="panel-following" class="tab @(ActiveTab == "following" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("following")'>Following</a>
        <a href="#communities" id="tab-communities" role="tab" aria-selected="@(ActiveTab == "communities")" aria-controls="panel-communities" class="tab @(ActiveTab == "communities" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("communities")'>Communities</a>
        @if (ApprovesFollowers)
        {
            <a href="#requests" id="tab-requests" role="tab" aria-selected="@(ActiveTab == "requests")" aria-controls="panel-requests" class="tab @(ActiveTab == "requests" ? "tab--active" : "")" @onclick:preventDefault @onclick='() => SwitchTab("requests")'>Requests@(FollowRequestCount is { } frc && frc > 0 ? $" ({frc})" : string.Empty)</a>
        }
    </div>

    @if (ActiveTab == "posts")
    {
        <div role="tabpanel" id="panel-posts" aria-labelledby="tab-posts">
        <PagedCollection
            Client="@OutboxClient"
            CollectionIri="@PostsIri"
            PageSize="5"
            ShowRefreshButton="true"
            ItemFilter="IsOwnContentItem"
            ItemTemplate="@PostTemplate"
            EmptyMessage="You haven't posted anything yet. Compose a note to get started." />
        </div>
    }
    else if (ActiveTab == "replies")
    {
        <div role="tabpanel" id="panel-replies" aria-labelledby="tab-replies">
        <PagedCollection
            Client="@OutboxClient"
            CollectionIri="@OutboxIri"
            PageSize="10"
            ShowRefreshButton="true"
            ItemFilter="IsReply"
            ItemTemplate="@PostTemplate"
            EmptyMessage="No replies to your posts yet." />
        </div>
    }
    else if (ActiveTab == "likes")
    {
        <div role="tabpanel" id="panel-likes" aria-labelledby="tab-likes">
        <PagedCollection
            Client="@OutboxClient"
            CollectionIri="@LikedIri"
            PageSize="10"
            ShowRefreshButton="true"
            ItemTemplate="@PostTemplate"
            ItemResolver="@LikesResolver"
            EmptyMessage="You haven't liked any posts yet." />
        </div>
    }
    else if (ActiveTab == "followers")
    {
        <div role="tabpanel" id="panel-followers" aria-labelledby="tab-followers">
        <ActorListPanel
            @ref="FollowersPanel"
            Client="@OutboxClient"
            CollectionIri="@FollowersIri"
            Title="Followers"
            EmptyMessage="No followers yet."
            FollowChanged="@OnFollowingSetChangedAsync" />
        </div>
    }
    else if (ActiveTab == "following")
    {
        <div role="tabpanel" id="panel-following" aria-labelledby="tab-following">
        <ActorListPanel
            @ref="FollowingPanel"
            Client="@OutboxClient"
            CollectionIri="@FollowingIri"
            Title="Following"
            EmptyMessage="Not following anyone yet."
            FollowChanged="@OnFollowingSetChangedAsync" />
        </div>
    }
    else if (ActiveTab == "communities")
    {
        <div role="tabpanel" id="panel-communities" aria-labelledby="tab-communities">
            <div class="card" style="margin-bottom: 0.5rem;">
                <a href="/communities" class="muted">Manage communities →</a>
            </div>
            @if (CommunitiesLoading)
            {
                <p class="muted">Loading communities…</p>
            }
            else if (CommunitiesError is not null)
            {
                <div class="error" role="alert">@CommunitiesError</div>
            }
            else if (FollowedCommunities is { Count: 0 })
            {
                <p class="muted">You haven't joined any communities yet. Browse <a href="/communities">all communities</a> to get started.</p>
            }
            else
            {
                <div class="directory-cards">
                    @foreach (var community in FollowedCommunities ?? [])
                    {
                        <div class="community-card">
                            <ActorCard Actor="@community" ActorId="@community.Id" ShowModeration="false" ShowStats="true" ShowSummary="true">
                                <FollowButton TargetActor="@community" IsCommunity="true" FollowChanged="@CommunitiesFollowToggledAsync" />
                            </ActorCard>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (ActiveTab == "requests")
    {
        <div class="card" role="tabpanel" id="panel-requests" aria-labelledby="tab-requests">
            @if (FollowRequestsLoading)
            {
                <p class="muted">Loading requests…</p>
            }
            else if (FollowRequestError is not null)
            {
                <div class="error" role="alert">@FollowRequestError</div>
            }
            else if (FollowRequestActors is { Count: 0 })
            {
                <p class="muted">No pending follow requests.</p>
            }
            else
            {
                @if (FollowRequestActors is { } actors)
                {
                    @foreach (var actorIri in actors)
                    {
                        <div class="follow-request-row">
                            <div class="follow-request-info">
                                <a href="@($"/actor?iri={Uri.EscapeDataString(actorIri)}")" class="follow-request-actor">@FollowDisplayHandle(actorIri)</a>
                                <span class="muted">wants to follow you</span>
                            </div>
                            <div class="follow-request-actions">
                                <button class="btn btn-primary btn-sm" disabled="@IsDecidingFollowRequest" @onclick="() => AcceptFollowRequestAsync(actorIri)">
                                    @(IsDecidingFollowRequest && DecidingFollowActorIri == actorIri ? "Accepting…" : "Accept")
                                </button>
                                <button class="btn btn-sm" disabled="@IsDecidingFollowRequest" @onclick="() => RejectFollowRequestAsync(actorIri)">
                                    @(IsDecidingFollowRequest && DecidingFollowActorIri == actorIri ? "Rejecting…" : "Reject")
                                </button>
                            </div>
                        </div>
                    }
                }
            }
        </div>
    }
}

@code {
    [Inject]
    private IActorSessionAccessor Session { get; set; } = default!;

    [Inject]
    private UiContext Ui { get; set; } = default!;

    private const string PostsKey = "profile-posts";
    private const string RepliesKey = "profile-replies";
    private const string LikesKey = "profile-likes";

    /// <summary>
    /// When <c>true</c> (set via <c>/profile?edit=true</c>, e.g. the Settings → Account "Edit your
    /// profile" link), the profile opens directly in edit mode once the actor document has loaded —
    /// the user skips the extra "Edit profile" click.
    /// </summary>
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "edit")]
    private bool? EditRequested { get; set; }

    private IObject? ActorDoc { get; set; }
    private string? LoadError { get; set; }
    private string? SaveError { get; set; }
    private bool _editing;
    private bool _saving;
    private bool _originalApproveFollowers;
    private bool _pendingEdit;
    private string ActiveTab { get; set; } = "posts";

    private Actor? ActorObj => ActorDoc as Actor;

    private bool ApprovesFollowers => ActorObj?.GetManuallyApprovesFollowers() == true;

    /// <summary>
    /// The actor's current avatar IRI (the first <c>icon</c>'s resolved IRI), or null when the actor has
    /// no icon. Mirrors <see cref="ActorProfile"/>'s icon resolution (an <see cref="IObject"/> icon by its
    /// <c>id</c>, an <see cref="ILink"/> icon by its <c>href</c>).
    /// </summary>
    private string? GetIconIri()
    {
        var actor = ActorObj;
        if (actor?.Icon is not { } icons)
        {
            return null;
        }

        foreach (var icon in icons)
        {
            var iri = icon is IObject { Id: { Length: > 0 } id } ? id
                : icon is ILink { Href: { } href } ? href.ToString()
                : null;
            if (iri is not null)
            {
                return iri;
            }
        }

        return null;
    }

    private IActivityPubClient? OutboxClient => Session.Client;
    private IActivityPubClient? InboxClient => Session.Client;

    private Iri? OutboxIri
        => Session.ActorId is { } actor ? actor.OutboxOf() : null;

    /// <summary>
    /// S78: the "Your posts" tab requests the outbox with <c>?type=content</c> so the server serves
    /// only content items (Create with Note/Article/Question, or Announce). Without this, a large
    /// outbox dominated by social activities (Follow, Like, Undo, Delete) and mirrored remote content
    /// buries the user's own posts deep in the collection, and the PagedCollection top-up (capped at
    /// 3 extra pages) never reaches them — the tab renders empty.
    /// </summary>
    private Iri? PostsIri
        => Session.ActorId is { } actor ? new Iri($"{actor.OutboxOf().Value}?type=content") : null;

    private Iri? InboxIri
        => Session.ActorId is { } actor ? actor.InboxOf() : null;

    private Iri? FollowersIri
        => Session.ActorId is { } actor ? actor.FollowersOf() : null;

    private Iri? FollowingIri
        => Session.ActorId is { } actor ? actor.FollowingOf() : null;

    /// <summary>
    /// The signed-in user's liked-collection IRI (S17: the Likes tab reads its own scoped
    /// <c>/liked</c> collection instead of filtering the full outbox, which triggered a
    /// multi-page fan-out on every tab switch).
    /// </summary>
    private Iri? LikedIri
        => Session.ActorId is { } actor ? actor.LikedOf() : null;

    /// <summary>
    /// Whether an outbox item is one of the signed-in user's **own** replies: a <c>Create</c> whose
    /// actor is the user and whose embedded object has an <c>inReplyTo</c>. The outbox is a mixed
    /// collection (the user's own activities interleaved with mirrored remote content), so scoping to
    /// the user's own author — not just "is a reply" — is what keeps other people's replies out of the
    /// Replies tab (93.3).
    /// </summary>
    private bool IsReply(IObjectOrLink item)
    {
        if (item is not Activity activity)
        {
            return false;
        }

        var type = activity.Type?.FirstOrDefault() ?? string.Empty;
        if (type != "Create")
        {
            return false;
        }

        var embedded = activity.Object?.FirstOrDefault() as IObject;
        if (embedded?.InReplyTo?.Any() != true)
        {
            return false;
        }

        return OutboxFilter.IsOwnContentItem(item, Session.ActorId);
    }

    /// <summary>
    /// Filters the outbox to the signed-in user's **own** content items: a <c>Create</c> of a
    /// Note/Article whose <c>actor</c> is the signed-in user. The server mirrors followed (remote)
    /// content into the local outbox as <c>Create</c> activities authored by the remote author, so a
    /// plain content-item check would surface foreign notes in "Your posts" (B-005). Social
    /// activities (Follow, Accept, Reject, Like, Announce, Undo, Delete) are also excluded.
    /// </summary>
    private bool IsOwnContentItem(IObjectOrLink item) => OutboxFilter.IsOwnContentItem(item, Session.ActorId);

    private RenderFragment<IObjectOrLink> PostTemplate
        => item => builder =>
        {
            builder.OpenComponent<ObjectView>(0);
            builder.AddComponentParameter(1, nameof(ObjectView.Item), item);
            builder.AddComponentParameter(2, nameof(ObjectView.ShowModeration), true);
            builder.CloseComponent();
        };

    /// <summary>
    /// S86: the actor's <c>liked</c> collection is served as bare object IRIs (<c>Link</c>s), and
    /// <see cref="ObjectView"/> renders a bare link as a raw IRI string — so the Likes tab showed raw
    /// links instead of the post content. This resolver (wired into the Likes tab's
    /// <c>PagedCollection</c> via <c>ItemResolver</c>) fetches each liked object's full document and
    /// substitutes it, so the standard <c>PostTemplate</c> renders the post. Items that are already
    /// full objects (not bare links) pass through unchanged; a failed fetch returns the original item
    /// (PagedCollection keeps it and renders the bare-IRI fallback rather than dropping it).
    /// </summary>
    private async Task<IObjectOrLink?> LikesResolver(IObjectOrLink item)
    {
        if (OutboxClient is null)
        {
            return item;
        }

        Iri? objectIri = null;
        if (item is IObject { Id: { Length: > 0 } id })
        {
            objectIri = new Iri(id);
        }
        else if (item is ILink { Href: { } href })
        {
            objectIri = new Iri(href.OriginalString);
        }

        if (objectIri is null)
        {
            return item;
        }

        var resolved = await OutboxClient.GetObjectAsync(objectIri.Value, CancellationToken.None);
        return resolved is null ? item : (IObjectOrLink)resolved;
    }

    private RenderFragment<IObjectOrLink> NotificationTemplate
        => item => builder =>
        {
            builder.OpenComponent<NotificationRow>(0);
            builder.AddComponentParameter(1, nameof(NotificationRow.Item), item);
            builder.AddComponentParameter(2, nameof(NotificationRow.SelfId), Session.ActorId);
            builder.CloseComponent();
        };

    private void SwitchTab(string tab)
    {
        ActiveTab = tab;
        StateHasChanged();

        // The follow-request queue is a local (non-paginated) read — load it lazily when the tab opens
        // (mirrors CommunityDetail's join-request load). The queue only exists when the actor has
        // manuallyApprovesFollowers set (the tab is hidden otherwise).
        if (tab == "requests" && ApprovesFollowers && FollowRequestActors is null)
        {
            _ = LoadFollowRequestsAsync();
        }

        if (tab == "communities" && FollowedCommunities is null)
        {
            _ = LoadFollowedCommunitiesAsync();
        }
    }

    private List<string>? FollowRequestActors { get; set; }
    private int? FollowRequestCount { get; set; }

    private ActorListPanel? FollowersPanel { get; set; }
    private ActorListPanel? FollowingPanel { get; set; }

    /// <summary>
    /// Re-fetches the Followers/Followers panels after a follow/unfollow changed the following set
    /// (S84). The panel refreshes itself for its own follow buttons; this handler covers a follow
    /// issued from elsewhere (directory, actor detail) while a panel tab is open, so the open panel
    /// also reflects the new state without a full reload.
    /// </summary>
    private async Task OnFollowingSetChangedAsync()
    {
        if (ActiveTab == "followers" && FollowersPanel is { } followers)
        {
            await followers.RefreshAsync();
        }
        else if (ActiveTab == "following" && FollowingPanel is { } following)
        {
            await following.RefreshAsync();
        }
    }
    private bool FollowRequestsLoading { get; set; }
    private string? FollowRequestError { get; set; }
    private bool IsDecidingFollowRequest { get; set; }
    private string? DecidingFollowActorIri { get; set; }

    private List<Group>? FollowedCommunities { get; set; }
    private bool CommunitiesLoading { get; set; }
    private string? CommunitiesError { get; set; }
    private List<Iri> _followingIris = [];
    private List<Group> _allLocalGroups = [];

    private async Task LoadFollowedCommunitiesAsync()
    {
        if (Session.Client is not { } client || Session.ActorId is not { } actorId)
        {
            return;
        }

        CommunitiesLoading = true;
        CommunitiesError = null;
        StateHasChanged();

        try
        {
            _followingIris = (await Ui.GetFollowingActorIrisAsync()).ToList();
            var marker = "/ap/v1";
            var index = actorId.Value.IndexOf(marker, StringComparison.Ordinal);
            Iri? baseIri = index >= 0 ? new Iri(actorId.Value[..(index + marker.Length)]) : null;

            _allLocalGroups = [];
            if (baseIri is { } instanceBase)
            {
                await foreach (var item in client.SearchAsync(
                                    instanceBase,
                                    string.Empty,
                                    new SearchOptions { Type = "Actor", LocalOnly = true }))
                {
                    if (item is Group group)
                    {
                        _allLocalGroups.Add(group);
                    }
                }
            }

            var localById = _allLocalGroups
                .Where(g => g.Id is { Length: > 0 })
                .ToDictionary(g => g.Id!, g => g, StringComparer.OrdinalIgnoreCase);

            var followed = new List<Group>();
            foreach (var iri in _followingIris)
            {
                if (localById.TryGetValue(iri.Value, out var local))
                {
                    followed.Add(local);
                    continue;
                }

                // S4: a followed community not in the local search is a REMOTE community (or a
                // just-created local one the search cache hasn't refreshed to). Fetch it by IRI
                // via the UiContext seam (which routes a remote actor through the same-origin
                // proxy) and keep it when it is a Group — so the Communities tab is never
                // missing a followed community.
                IObject? doc;
                try
                {
                    doc = await Ui.GetActorAsync(iri);
                }
                catch
                {
                    continue;
                }

                if (doc is Group group)
                {
                    followed.Add(group);
                }
            }

            FollowedCommunities = followed
                .OrderBy(g => g.PreferredUsername ?? g.Id ?? string.Empty, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (Exception)
        {
            CommunitiesError = "We couldn't load your communities right now. Please check your connection and try again.";
        }
        finally
        {
            CommunitiesLoading = false;
            StateHasChanged();
        }
    }

    private async Task CommunitiesFollowToggledAsync()
    {
        _followingIris = (await Ui.GetFollowingActorIrisAsync()).ToList();
        FollowedCommunities = _allLocalGroups
            .Where(g => g.Id is { Length: > 0 } id && _followingIris.Any(f => string.Equals(f.Value, id, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(g => g.PreferredUsername ?? g.Id ?? string.Empty, StringComparer.OrdinalIgnoreCase)
            .ToList();
        StateHasChanged();
    }

    private async Task LoadFollowRequestsAsync()
    {
        var localModeration = Session.LocalModeration;
        if (localModeration is null || Session.ActorId is not { } actorId)
        {
            return;
        }

        FollowRequestsLoading = true;
        FollowRequestError = null;
        StateHasChanged();

        try
        {
            var result = await localModeration.GetFollowRequestsAsync(actorId);
            if (result.IsSuccess)
            {
                var actors = System.Text.Json.JsonSerializer.Deserialize<List<string>>(result.Body)
                    ?? new List<string>();
                FollowRequestActors = actors;
                FollowRequestCount = actors.Count;
            }
            else
            {
                FollowRequestError = $"Failed to load requests (HTTP {result.StatusCode}).";
            }
        }
        catch (Exception)
        {
            FollowRequestError = "We couldn't load the follow requests. Please try again.";
        }
        finally
        {
            FollowRequestsLoading = false;
            StateHasChanged();
        }
    }

    private async Task AcceptFollowRequestAsync(string actorIri)
    {
        var localModeration = Session.LocalModeration;
        if (localModeration is null || Session.ActorId is not { } me)
        {
            return;
        }

        IsDecidingFollowRequest = true;
        DecidingFollowActorIri = actorIri;
        FollowRequestError = null;
        StateHasChanged();

        try
        {
            var result = await localModeration.AcceptFollowRequestAsync(me, new Iri(actorIri));
            if (result.IsSuccess)
            {
                await LoadFollowRequestsAsync();
            }
            else
            {
                FollowRequestError = $"Accept failed (HTTP {result.StatusCode}).";
            }
        }
        catch (Exception)
        {
            FollowRequestError = "The follow request couldn't be approved. Please try again.";
        }
        finally
        {
            IsDecidingFollowRequest = false;
            StateHasChanged();
        }
    }

    private async Task RejectFollowRequestAsync(string actorIri)
    {
        var localModeration = Session.LocalModeration;
        if (localModeration is null || Session.ActorId is not { } me)
        {
            return;
        }

        IsDecidingFollowRequest = true;
        DecidingFollowActorIri = actorIri;
        FollowRequestError = null;
        StateHasChanged();

        try
        {
            var result = await localModeration.RejectFollowRequestAsync(me, new Iri(actorIri));
            if (result.IsSuccess)
            {
                await LoadFollowRequestsAsync();
            }
            else
            {
                FollowRequestError = $"Reject failed (HTTP {result.StatusCode}).";
            }
        }
        catch (Exception)
        {
            FollowRequestError = "The follow request couldn't be rejected. Please try again.";
        }
        finally
        {
            IsDecidingFollowRequest = false;
            StateHasChanged();
        }
    }

    private static string FollowDisplayHandle(string actorIri)
    {
        try
        {
            var uri = new Uri(actorIri);
            var segments = uri.AbsolutePath.TrimEnd('/').Split('/');
            return segments.Length > 0 ? segments[^1] : "Unknown";
        }
        catch
        {
            return "Unknown";
        }
    }

    /// <summary>
    /// Primes the session's signing key (WASM cannot block on the key load during render). Once the
    /// load completes, re-render so <see cref="Session"/>/<see cref="OutboxClient"/> resolve and the
    /// actor document can be fetched. Without this, <c>Session.ActorId</c> is null on first render and
    /// the profile is stuck on "Loading your profile…".
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureReadyAsync();
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        if (EditRequested == true)
        {
            _pendingEdit = true;
        }

        if (Session.ActorId is { } actorId
            && ActorDoc is null
            && LoadError is null)
        {
            _ = LoadActorAsync(actorId);
        }
        else if (ActorDoc is not null && _pendingEdit)
        {
            ConsumePendingEdit();
        }
    }

    private async Task LoadActorAsync(Iri actorId)
    {
        try
        {
            var actor = await Ui.GetActorAsync(actorId);
            if (actor is not null)
            {
                ActorDoc = actor;
            }
            else
            {
                LoadError = "Your actor document could not be loaded.";
            }
        }
        catch
        {
            LoadError = "Your profile could not be loaded. Please refresh and try again.";
        }

        if (ActorDoc is not null && _pendingEdit)
        {
            ConsumePendingEdit();
        }

        StateHasChanged();
    }

    /// <summary>
    /// Starts edit mode once the actor document is available, if the page was opened with
    /// <c>?edit=true</c>. Consumes the one-shot flag so a later re-render (e.g. after a save) does
    /// not re-enter edit mode.
    /// </summary>
    private void ConsumePendingEdit()
    {
        _pendingEdit = false;
        _originalApproveFollowers = ActorObj?.GetManuallyApprovesFollowers() ?? false;
        _editing = true;
        SaveError = null;
    }

    private void StartEdit()
    {
        _originalApproveFollowers = ActorObj?.GetManuallyApprovesFollowers() ?? false;
        _editing = true;
        SaveError = null;
    }

    private void CancelEdit()
    {
        _editing = false;
        SaveError = null;
    }

    private async Task SubmitEditAsync(string name, string summary, bool approveFollowers, string? iconIri)
    {
        if (Session.ActorId is not { } actorId || Session.Client is not { } client)
        {
            return;
        }

        _saving = true;
        SaveError = null;
        StateHasChanged();

        try
        {
            var current = ActorObj;
            var updated = new Person
            {
                Id = actorId.Value,
                PreferredUsername = current?.PreferredUsername,
                Name = string.IsNullOrWhiteSpace(name) ? null : [name],
                Summary = string.IsNullOrWhiteSpace(summary) ? null : [summary],
            };

            // Set (or clear) the actor's icon (avatar). A non-null iconIri sets it; a null iconIri means
            // the user removed the avatar, so we send an **empty** icon array — the server's merge
            // interprets an empty array as "clear" (a missing field would leave the stored icon unchanged,
            // which is the safe behavior for a partial update that does not touch the icon).
            updated.Icon = string.IsNullOrWhiteSpace(iconIri)
                ? []
                : [new Link { Href = new Uri(iconIri) }];

            var result = await client.UpdateActorAsync(actorId, updated);
            if (!result.IsSuccess)
            {
                SaveError = $"Update failed (HTTP {result.StatusCode}).";
                return;
            }

            if (approveFollowers != _originalApproveFollowers)
            {
                var flagResult = await client.SetManuallyApprovesFollowersAsync(actorId, approveFollowers);
                if (!flagResult.IsSuccess)
                {
                    SaveError = $"Failed to update approval setting (HTTP {flagResult.StatusCode}).";
                    return;
                }
            }

            _editing = false;
            await LoadActorFreshAsync(actorId);
        }
        catch (Exception)
        {
            SaveError = "Your profile changes couldn't be saved. Please try again.";
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Uploads the chosen avatar file (via the session's cookie-auth media upload) and returns the upload
    /// result (the same-origin media IRI to set as the actor's <c>icon</c>). Returns null on failure (the
    /// form shows an error). The uploaded IRI is same-origin (served by this instance's media handler), so
    /// the avatar loads in the browser without a cross-origin fetch.
    /// </summary>
    private async Task<MediaUploadResult?> UploadIconAsync(IBrowserFile file)
    {
        if (Session.ActorId is not { } actorId)
        {
            return null;
        }

        try
        {
            var bytes = await ReadAvatarBytesAsync(file);
            return await Session.UploadMediaAsync(
                actorId,
                bytes,
                file.ContentType ?? "application/octet-stream",
                file.Name,
                CancellationToken.None);
        }
        catch
        {
            return null;
        }
    }

    /// <summary>
    /// Reads a browser file's bytes (capped at 10 MiB — matches the server's upload cap).
    /// </summary>
    private static async Task<byte[]> ReadAvatarBytesAsync(IBrowserFile file)
    {
        const long maxAvatarBytes = 10 * 1024 * 1024;
        await using var stream = file.OpenReadStream(maxAvatarBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        return ms.ToArray();
    }

    private async Task LoadActorFreshAsync(Iri actorId)
    {
        Ui.InvalidateActor(actorId);
        ActorDoc = null;
        await LoadActorAsync(actorId);
    }
}
