@page "/tag/{Tag}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Iris.Client
@using Iris.Core.Identity
@using Iris.Web.Client.Accounts
@using KristofferStrube.ActivityStreams
@using Microsoft.AspNetCore.Components

<PageTitle>Hashtag @Tag · Iris</PageTitle>

@if (Client is null)
{
    <div class="card"><p class="muted">Sign in to view this hashtag.</p></div>
}
else if (Busy)
{
    <div class="card community-loading">
        <svg class="loading-spinner" viewBox="25 25 50 50" aria-hidden="true">
            <circle class="loading-spinner-circle" cx="50" cy="50" r="20" fill="none" />
        </svg>
        <span class="muted">Loading #@Tag…</span>
    </div>
}
else
{
    <div class="card">
        <h2>#@Tag</h2>
        <p class="muted">
            @(Error is not null ? "This hashtag couldn't be loaded." : $"{Results?.Count ?? 0} post(s) with this tag.")
        </p>
        @if (Error is not null)
        {
            <div class="error" role="alert">@Error</div>
        }
        else if (Results is null || Results.Count == 0)
        {
            <div class="empty-state">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18" />
                </svg>
                <p>No posts with #@Tag yet.</p>
                <p>Be the first to use it in a post.</p>
            </div>
        }
        else
        {
            <ul class="object-list">
                @foreach (var item in Results)
                {
                    <li><ObjectView Item="item" ShowModeration="true" /></li>
                }
            </ul>
        }
    </div>
}

@code {
    [Inject]
    private IActorSessionAccessor Session { get; set; } = default!;

    [Parameter]
    public string Tag { get; set; } = string.Empty;

    private IActivityPubClient? Client => Session.Client;
    private bool Busy { get; set; }
    private IReadOnlyList<IObjectOrLink>? Results { get; set; }
    private string? Error { get; set; }
    private string? LoadedTag { get; set; }

    private static string NormalizeTag(string? tag)
    {
        var t = tag?.Trim() ?? string.Empty;
        return t.StartsWith("#", StringComparison.Ordinal) ? t : "#" + t;
    }

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureReadyAsync();

        var client = Client;
        if (client is null)
        {
            return;
        }

        if (InstanceBase is not { } baseIri)
        {
            return;
        }

        // A different tag is being shown (or this is the first load): re-run the search. Skip when the
        // tag is unchanged and results are already present so a re-render doesn't refire the query.
        var tag = NormalizeTag(Tag);
        if (LoadedTag is not null && LoadedTag == tag && (Results is not null || Error is not null))
        {
            return;
        }

        Busy = true;
        Error = null;
        Results = null;
        try
        {
            var results = new List<IObjectOrLink>();
            await foreach (var item in client.SearchAsync(
                               baseIri,
                               tag,
                               new SearchOptions { Type = "Note" }))
            {
                results.Add(item);
            }

            Results = results;
            LoadedTag = tag;
        }
        catch (Exception)
        {
            Error = "This hashtag couldn't be loaded. Please try again.";
            LoadedTag = tag;
        }
        finally
        {
            Busy = false;
            StateHasChanged();
        }
    }

    private Iri? InstanceBase
    {
        get
        {
            if (Session.ActorId is not { } actor)
            {
                return null;
            }

            const string marker = "/ap/v1";
            var value = actor.Value;
            var index = value.IndexOf(marker, StringComparison.Ordinal);
            return index >= 0 ? new Iri(value[..(index + marker.Length)]) : null;
        }
    }
}
