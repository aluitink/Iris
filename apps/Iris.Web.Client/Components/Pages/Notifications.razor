@page "/notifications"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Iris.Client
@using Iris.Core.Identity
@using Iris.Web.Client.Accounts
@using KristofferStrube.ActivityStreams

<PageTitle>Notifications · Iris</PageTitle>

<div class="page-header-row">
    <h2>Notifications</h2>
    <button class="btn btn--secondary" @onclick="OnMarkAllReadAsync" disabled="@_markingRead">
        @(_markingRead ? "Marking…" : "Mark all as read")
    </button>
</div>

<p class="muted">
    A unified "what happened to me" feed: the activities in your inbox (follows, follow requests,
    likes, boosts, replies, mentions), newest first — paged with next-link walking.
</p>

<PagedCollection
    @key="@InboxKey"
    Client="@Client"
    CollectionIri="@InboxIri"
    PageSize="10"
    ShowRefreshButton="true"
    ItemTemplate="@ItemTemplate">
    <EmptyContent>
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                <path d="M13.73 21a2 2 0 0 1-3.46 0" />
            </svg>
            <p>No notifications yet.</p>
            <p>When someone follows you, replies, or mentions you, it shows up here.</p>
        </div>
    </EmptyContent>
</PagedCollection>

@code {
    [Inject]
    private IActorSessionAccessor Session { get; set; } = default!;

    [Inject]
    private NotificationService NotificationService { get; set; } = default!;

    private bool _markingRead;

    private async Task OnMarkAllReadAsync()
    {
        if (Session.UserId is not { } uid)
        {
            return;
        }

        _markingRead = true;
        await NotificationService.MarkAllReadAsync(uid);
        _markingRead = false;
        StateHasChanged();
    }

    /// <summary>
    /// A stable <c>@key</c> for the inbox's <c>PagedCollection</c> (the notifications list is a single,
    /// fixed collection — the session actor's inbox — so the key is a constant).
    /// </summary>
    private const string InboxKey = "inbox";

    /// <summary>
    /// The client to dial (the signed-in session's client), or <c>null</c> when signed out.
    /// </summary>
    private IActivityPubClient? Client => Session.Client;

    /// <summary>
    /// The session actor's own IRI (used to recognize self-referential items), or <c>null</c> when
    /// signed out.
    /// </summary>
    private Iri? SelfIri => Session.ActorId;

    /// <summary>
    /// The inbox collection IRI (the session actor's <c>{actor}/inbox</c>), or <c>null</c> when signed
    /// out. Derived via <see cref="IriExtensions.InboxOf(Iri)"/>.
    /// </summary>
    private Iri? InboxIri
        => Session.ActorId is { } actor ? actor.InboxOf() : null;

    /// <summary>
    /// The per-item template for the notifications list: renders each inbox activity as a
    /// <see cref="NotificationRow"/> (the classified "who did what" line). Built as a
    /// <see cref="RenderFragment{T}"/> (a delegate), since a <c>RenderFragment&lt;T&gt;</c> child-element
    /// does not bind <c>T</c> the way a non-generic <c>RenderFragment</c> does.
    /// </summary>
    private RenderFragment<IObjectOrLink> ItemTemplate
        => item => builder =>
        {
            builder.OpenComponent<NotificationRow>(0);
            builder.AddComponentParameter(1, nameof(NotificationRow.Item), item);
            builder.AddComponentParameter(2, nameof(NotificationRow.SelfId), SelfIri);
            builder.CloseComponent();
        };
}
