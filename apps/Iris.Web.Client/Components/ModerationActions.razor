@using Iris.Core.Identity
@using Iris.Web.Client.Accounts
@using Iris.Web.Client.Ui
@using KristofferStrube.ActivityStreams

@inject UiContext Ui

@if (Client is null || LocalModeration is null || Session.ActorId is not { } me || TargetActorIri is null || IsSelf)
{
    return;
}

<div class="moderation-actions">
    @if (!IsBlocked && !IsMuted)
    {
        <button class="btn btn-sm button--warning" disabled="@Busy" @onclick="BlockAsync">Block</button>
        <button class="btn btn-sm button--ghost" disabled="@Busy" @onclick="MuteAsync">Mute</button>
        <button class="btn btn-sm button--ghost" disabled="@Busy" @onclick="FlagAsync">Report</button>
    }
    else
    {
        @if (IsBlocked)
        {
            <button class="btn btn-sm button--ghost" disabled="@Busy" @onclick="UnblockAsync">Unblock</button>
        }
        @if (IsMuted)
        {
            <button class="btn btn-sm button--ghost" disabled="@Busy" @onclick="UnmuteAsync">Unmute</button>
        }
    }
</div>

@code {
    [Inject]
    private IActorSessionAccessor Session { get; set; } = default!;

    [Parameter]
    public IObjectOrLink? TargetActor { get; set; }

    private string? _lastTargetIri;

    private IActivityPubClient? Client => Session.Client;
    private ILocalModerationClient? LocalModeration => Session.LocalModeration;

    private bool Busy { get; set; }
    private bool IsBlocked { get; set; }
    private bool IsMuted { get; set; }
    private string? _blockIri;
    private string? _flagIri;

    private Iri? TargetActorIri
    {
        get
        {
            if (TargetActor is IObject { Id: { Length: > 0 } id })
            {
                return new Iri(id);
            }

            return null;
        }
    }

    private bool IsSelf
    {
        get
        {
            if (Session.ActorId is not { } me || TargetActor is not IObject { Id: { Length: > 0 } targetId })
            {
                return false;
            }

            return string.Equals(me.Value, targetId, StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var target = TargetActorIri;
        if (target is not { } targetIri)
        {
            return;
        }

        var targetValue = targetIri.Value;
        if (_lastTargetIri == targetValue)
        {
            return;
        }

        _lastTargetIri = targetValue;
        IsBlocked = false;
        IsMuted = false;
        _blockIri = null;
        _flagIri = null;

        // The blocks/mutes state comes from the UiContext's per-circuit moderation cache: the first
        // card on a page walks the signed-in user's /blocks + /mutes collections once, and every
        // other card (N-1 of them) is an O(1) lookup instead of 2N redundant collection reads.
        (IsBlocked, IsMuted) = await Ui.GetModerationStateAsync(targetIri);
    }

    private async Task BlockAsync()
    {
        if (Client is not { } client || Session.ActorId is not { } me || TargetActorIri is not { } target)
        {
            return;
        }

        Busy = true;
        try
        {
            var result = await client.BlockAsync(me, target);
            if (result.IsSuccess)
            {
                IsBlocked = true;
                _blockIri = result.MintedId;
                Ui.InvalidateModeration();
            }
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task UnblockAsync()
    {
        if (Client is not { } client || Session.ActorId is not { } me || _blockIri is not { Length: > 0 } blockIri)
        {
            return;
        }

        Busy = true;
        try
        {
            var result = await client.UnblockAsync(me, new Iri(blockIri));
            if (result.IsSuccess)
            {
                IsBlocked = false;
                _blockIri = null;
                Ui.InvalidateModeration();
            }
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task MuteAsync()
    {
        if (LocalModeration is not { } localModeration || Session.ActorId is not { } me || TargetActorIri is not { } target)
        {
            return;
        }

        Busy = true;
        try
        {
            var result = await localModeration.MuteAsync(me, target);
            if (result.IsSuccess)
            {
                IsMuted = true;
                Ui.InvalidateModeration();
            }
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task UnmuteAsync()
    {
        if (LocalModeration is not { } localModeration || Session.ActorId is not { } me || TargetActorIri is not { } target)
        {
            return;
        }

        Busy = true;
        try
        {
            var result = await localModeration.UnmuteAsync(me, target);
            if (result.IsSuccess)
            {
                IsMuted = false;
                Ui.InvalidateModeration();
            }
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task FlagAsync()
    {
        if (Client is not { } client || Session.ActorId is not { } me || TargetActorIri is not { } target)
        {
            return;
        }

        Busy = true;
        try
        {
            var result = await client.FlagAsync(me, target);
            if (result.IsSuccess)
            {
                _flagIri = result.MintedId;
            }
        }
        finally
        {
            Busy = false;
        }
    }
}
