<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Iris.Web.Client</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Hot reload is not supported when the WASM app is served by a separate ASP.NET Core host
         (the .lib.module.js file is not produced). Disable it to avoid a 404 on load. -->
    <WasmEnableHotReload>false</WasmEnableHotReload>
    <!-- No PDB files: the WASM runtime requests .pdb downloads at startup, and the server's
          static-file middleware cannot serve them (extension maps to null content type). -->
    <DebugType>none</DebugType>
    <WasmDebugLevel>0</WasmDebugLevel>
    <!-- Aggressive WASM trimming: removes unused BCL assemblies (System.Private.Xml 3 MB,
         System.Data.Common 1 MB, DataContractSerialization 850 KB, etc.) and shrinks
         System.Private.CoreLib by 61%. The client uses crypto.subtle (Iris.WebCrypto) for
         signing, not the BCL crypto stack. No reflection in Iris.Core/Iris.Client/Iris.WebCrypto.
         BouncyCastle (5 MB, Ed25519 in Iris.Core) is retained — removing it requires a
         conditional-reference change to Iris.Core (future work). Gzipped: 38.6 MB -> 5.6 MB. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- Invariant globalization: the client does not need locale-specific formatting
         (dates/numbers use invariant culture). This eliminates the ICU data dependency
         that the trimmer's output would otherwise require at runtime. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>
      The Iris Blazor WebAssembly client: the product UI that runs in the browser. Talks to the
      Iris.Web server's ActivityPub API + auth endpoints via cookie-auth (same-origin). The signing
      key is loaded from the actor document's privateKey extension (served to the owner via cookie).
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <!-- Blazor Web components: provides <AntiforgeryToken /> for the /register + /login forms. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Authorization" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WASM client's appsettings.json (auto-included as Content by the SDK) carries
         Iris:AdvertiseBase, the instance's public FQDN base, so the session's SameOriginApHandler can
         rewrite FQDN-addressed requests to same-origin (the browser cannot sign or read a cross-origin
         ActivityPub request). Ensure it is copied to the WASM output (wwwroot). -->
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\src\Iris.Client.Extensions\Iris.Client.Extensions.csproj" />
    <ProjectReference Include="..\..\src\Iris.Client\Iris.Client.csproj" />
    <ProjectReference Include="..\..\src\Iris.Core\Iris.Core.csproj" />
    <ProjectReference Include="..\..\src\Iris.WebCrypto\Iris.WebCrypto.csproj" />
  </ItemGroup>







</Project>
