# Build context is the repository root; keep it lean so the Docker build is fast and does not pull in
# unrelated projects or local scratch. Both sample Dockerfiles (SampleServer, SampleBlazorClient) build
# from this root context, so both sample projects' sources must be present.
bin/
obj/
out/
artifacts/
TestResults/
coverage*.json
coverage*.xml
*.coverage
*.CoverableReport/
*.binlog
*.user
*.suo
.idea/
.vs/
.vscode/
.git/
.github/
.opencode/
.scratch/
.probe/
docs/
tests/
PLAN.md
.editorconfig
packages.lock.json
