<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Iris.Samples.SampleBlazorClient.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <Description>
      Integration tests: host the SampleServer and a second instance in-process (TestServer) and run
      the SampleBlazorClient pipeline (Basic-auth login → PEM key → pre-configured signed client →
      community feed → proxy fallback) against them.
    </Description>
    <!--
      The sample drives the (soft-deprecated) WebHostBuilder / IApplicationBuilder pipeline APIs, so
      the specific deprecation codes are suppressed here (test + sample projects only; production
      library code stays deprecation-clean).
    -->
    <NoWarn>$(NoWarn);ASPDEPR004;ASPDEPR008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\samples\SampleBlazorClient\SampleBlazorClient.csproj" />
    <ProjectReference Include="..\..\samples\SampleServer\SampleServer.csproj" />
    <ProjectReference Include="..\..\src\Iris.Client\Iris.Client.csproj" />
    <ProjectReference Include="..\..\src\Iris.Core\Iris.Core.csproj" />
    <ProjectReference Include="..\..\src\Iris.Server\Iris.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
