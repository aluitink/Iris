<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Iris.LiveInterop.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <Description>
      Opt-in live-interop test suite. Runtime-gated by IRIS_LIVE_INTEROP=1 + FQDN config; the default
      dotnet test run stays green (no contact with a live instance). See docs/reference/INTEROP_TEST_HARNESS.md.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iris.Testing\Iris.Testing.csproj" />
    <ProjectReference Include="..\..\src\Iris.Core\Iris.Core.csproj" />
    <ProjectReference Include="..\..\src\Iris.Client\Iris.Client.csproj" />
    <ProjectReference Include="..\..\src\Iris.Server\Iris.Server.csproj" />
    <ProjectReference Include="..\..\src\Iris.Server.InMemory\Iris.Server.InMemory.csproj" />
  </ItemGroup>

</Project>
